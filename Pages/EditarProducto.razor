@page "/producto/editar/{Id:int}"
@using BlazorKioscos_v1.Models
@using BlazorKioscos_v1.Services
@inject Supabase.Client Supabase
@inject NavigationManager Nav
@inject AppState State
@inject IJSRuntime JSRuntime
@inject PrecioService PrecioServ

<div class="container mt-3 ">
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-link text-dark p-0 me-3" @onclick="Volver">
            <i class="bi bi-arrow-left fs-4"></i>
        </button>
        <h3 class="mb-0">Editar</h3>
    </div>

    @if (modelo == null)
    {
        <p>Cargando datos...</p>
    }
    else
    {
        <div class="card shadow-sm border-0 p-3">
            <div class="mb-3">
                <label class="form-label fw-bold small">Código de Barras</label>
                <div class="input-group shadow-sm rounded border bg-white">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-barcode"></i></span>

                    <InputText class="form-control border-0 py-2"
                               @bind-Value="modelo.CodigoBarras"
                               placeholder="Escaneá o escribí el código" />

                    @* BOTÓN DEL ESCÁNER *@
                    <button type="button" class="btn btn-white border-0 text-primary" @onclick="AbrirScanner" title="Escanear código">
                        <i class="bi bi-qr-code-scan"></i>
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold small">Descripción / Nombre *</label>
                <InputText class="form-control" @bind-Value="modelo.Nombre" required />
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label fw-bold small text-primary">Precio Costo</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <InputNumber class="form-control" @bind-Value="modelo.PrecioCosto" TValue="decimal?" step="0.01" />
                    </div>
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label fw-bold small text-primary">Precio Venta (General)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <InputNumber class="form-control" @bind-Value="modelo.PrecioVenta" TValue="decimal?" step="0.01" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(nombreLista2))
                {
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold small text-success">@nombreLista2</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <InputNumber class="form-control" @bind-Value="modelo.PrecioLista2" TValue="decimal?" step="0.01" />
                        </div>
                    </div>
                }
                @* Stock Inicial *@
                <div class="mb-4 col-6">
                    <label class="form-label fw-bold small">Stock Actual</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
                        <InputNumber class="form-control" @bind-Value="modelo.StockActual" TValue="int" />
                    </div>
                </div>
            </div>
            @* Botones *@
            <div class="d-flex gap-2 justify-content-end border-top pt-3">
                <button type="button" class="btn btn-light rounded-pill px-4" @onclick="Volver">Cancelar</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="Guardar">
                    <i class="bi bi-check-lg me-1"></i> Guardar
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Producto? modelo;
    private string nombreLista2 = "";
    protected override async Task OnInitializedAsync()
    {
        // Buscamos el producto específico por su ID
        var response = await Supabase.From<Producto>()
            .Where(x => x.Id == Id)
            .Single();

        modelo = response;
      
        nombreLista2 = await PrecioServ.ObtenerNombreColumnaAsync(1,"precio_lista2") ?? "";
    }

    private async Task Guardar()
    {
        if (modelo != null)
        {
            // Actualizamos en Supabase
            await Supabase.From<Producto>().Update(modelo);
            Nav.NavigateTo("/productos"); // Volvemos a la lista
        }
    }
    
    private void Volver() => Nav.NavigateTo("/productos");
    private async Task AbrirScanner()
    {
        // Pasamos la referencia de ESTA página a JS
        var dotNetHelper = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("methodsJS.iniciarEscaneo", dotNetHelper);
    }
}