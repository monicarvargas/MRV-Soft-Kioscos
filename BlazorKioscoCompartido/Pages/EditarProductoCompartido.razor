@inject Supabase.Client SupaClient
@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State
@inject PrecioService PrecioServ
@using BlazorKioscoCompartido.Constants
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Components
@using System.Globalization

<PedidosEstilos />
<ConfigEstilos />
<ProductoEstilos />
<AvisosPagina @ref="avisos" />
<AltaRapida @ref="altaFamilia" OnCreado="FamiliaCreada" />
<AltaRapida @ref="altaProveedor" OnCreado="ProveedorCreado" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Editar producto"
                      Subtitulo="Actualizá los datos y los precios del artículo"
                      IconoClass="bi-pencil-square"
                      ColorBorde="primary"
                      ColorIcono="primary"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    @if (cargando)
    {
        <div class="pp-wrap">
            <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando datos del artículo...</p></div>
        </div>
    }
    else if (producto == null)
    {
        <div class="pp-wrap gp-card gp-card-pad">
            <div class="gp-empty">
                <span class="gp-bubble"><i class="bi bi-search"></i></span>
                <strong>No se encontró el producto</strong>
                <span>Puede que se haya borrado o que no haya conexión.</span>
                <button type="button" class="gp-btn gp-btn-outline" style="margin-top:.8rem" @onclick="Volver"><i class="bi bi-arrow-left"></i> Volver a productos</button>
            </div>
        </div>
    }
    else
    {
        <div class="pp-wrap pp-stack">

            @* ================= DATOS DEL ARTÍCULO ================= *@
            <section class="gp-card gp-card-pad">
                <div class="gp-card-head" style="flex-wrap:wrap">
                    <span class="gp-bubble"><i class="bi bi-box-seam-fill"></i></span>
                    <div class="cf-head-text">
                        <h2>Datos del artículo</h2>
                        <p>Código, nombre, categoría y cómo se vende.</p>
                    </div>
                    <span class="gp-chip pp-head-chip"><i class="bi bi-clock-history"></i> Modificado: @(producto.FechaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "sin registro")</span>
                    <label class="gp-switch pp-activo @(producto.Activo ? "is-on" : "is-off")" title="Inactivo: no aparece para vender ni en los pedidos. Se guarda al tocar Guardar cambios.">
                        <input type="checkbox" checked="@producto.Activo" @onchange="e => producto.Activo = (bool)e.Value!" />
                        <span class="gp-switch-track"></span>
                        <span class="gp-switch-text">@(producto.Activo ? "Activo" : "Inactivo")</span>
                    </label>
                </div>
                @if (!producto.Activo)
                {
                    <div class="gp-banner is-danger" style="margin-bottom:.8rem"><i class="bi bi-eye-slash-fill"></i><p><b>Producto inactivo:</b> no aparece para vender. Tocá <b>Guardar cambios</b> para que quede así.</p></div>
                }

                <div class="cf-grid">
                    <div>
                        <label class="cf-lbl">Código de barras</label>
                        <div class="pp-icon-input pp-codigo">
                            <i class="bi bi-upc-scan"></i>
                            <input type="text" class="gp-control" @bind="producto.CodigoBarras" />
                        </div>
                        @if (string.IsNullOrWhiteSpace(producto.CodigoBarras))
                        {
                            <button type="button" class="pp-crear-cod" disabled="@creandoCodigo" @onclick="CrearCodigoPropio"
                                    title="Para productos sueltos que no traen código (gomitas, fiambre...). Se guarda al tocar Guardar cambios.">
                                <i class="bi bi-magic"></i> @(creandoCodigo ? "Creando..." : "No tiene: crear un código")
                            </button>
                        }
                        else if (CodigoBarras.Armar(producto.CodigoBarras) != null)
                        {
                            <button type="button" class="pp-crear-cod" @onclick="ImprimirEtiqueta" title="Abre Códigos de barras con este producto listo para imprimir">
                                <i class="bi bi-printer"></i> Imprimir etiqueta con este código
                            </button>
                        }
                    </div>
                    <div class="cf-col-2 pp-nombre">
                        <label class="cf-lbl">Descripción / nombre *</label>
                        <input type="text" class="gp-control" @bind="producto.Nombre" />
                    </div>

                    <div>
                        <label class="cf-lbl">Familia / categoría</label>
                        <div class="sf-fila">
                            <select class="gp-control" @bind="producto.FamiliaId" @bind:after="CambioFamilia">
                                <option value="0">-- Elegí --</option>
                                @foreach (var fam in familias)
                                {
                                    <option value="@fam.Id">@fam.Nombre</option>
                                }
                            </select>
                            <button type="button" class="gp-btn gp-btn-soft gp-btn-icon" title="Nueva familia" @onclick="() => altaFamilia.Abrir(AltaRapida.Tipo.Familia)"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                    <SelectorSubfamilia FamiliaId="producto.FamiliaId" FamiliaNombre="@(familias.FirstOrDefault(f => f.Id == producto.FamiliaId)?.Nombre)" @bind-Value="producto.SubfamiliaId" @bind-Value:after="CambioGrupo" />
                    <div>
                        <label class="cf-lbl">Proveedor principal</label>
                        <div class="sf-fila">
                            <select class="gp-control" @bind="producto.ProveedorId">
                                <option value="0">-- Elegí --</option>
                                @foreach (var prov in proveedores)
                                {
                                    <option value="@prov.Id">@prov.Nombre</option>
                                }
                            </select>
                            <button type="button" class="gp-btn gp-btn-soft gp-btn-icon" title="Nuevo proveedor" @onclick="() => altaProveedor.Abrir(AltaRapida.Tipo.Proveedor)"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                    <div>
                        <label class="cf-lbl">Marca</label>
                        <input type="text" class="gp-control" placeholder="Ej: La Virginia" @bind="producto.Marca" />
                    </div>

                    <div class="cf-col-full">
                        <label class="cf-lbl">Se vende por</label>
                        <div class="gp-seg pp-units" role="group" aria-label="Unidad de medida">
                            @foreach (var unidad in Unidades.ParaElegir(State.UnidadesNegocio, producto.UnidadMedida))
                            {
                                <button type="button" class="@(EsUnidad(unidad) ? "is-active" : "")" @onclick="() => CambiarUnidad(unidad)">
                                    <i class="bi @IconoUnidad(unidad)"></i> @TextoUnidad(unidad)
                                </button>
                            }
                        </div>
                        @if (producto.IsMedidaKilos())
                        {
                            <div class="gp-hint" style="margin-top:.55rem"><i class="bi bi-info-circle-fill"></i> El costo y los precios de venta van <b>por kilo</b>. Al vender se pesa en gramos.</div>
                        }
                        else if (producto.IsMedidaGramos())
                        {
                            <div class="gp-hint" style="margin-top:.55rem"><i class="bi bi-info-circle-fill"></i> El costo se carga por kilo y el precio de venta se muestra cada 100 g.</div>
                        }
                    </div>
                </div>
            </section>

            @* ================= PRECIOS ================= *@
            <section class="gp-card gp-card-pad">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-currency-dollar"></i></span>
                    <div class="cf-head-text">
                        <h2>Precios</h2>
                        <p>Cambiá el costo o la utilidad y el precio de venta se calcula solo (o al revés).</p>
                    </div>
                </div>
                <PreciosProducto @ref="preciosRef" Producto="producto" NombreLista2="@nombreLista2" OnCambio="StateHasChanged" UtilidadSugerida="UtilidadDelGrupo" GrupoSugerido="@NombreGrupo" />

                @* Por mayor: ahora está dentro de PreciosProducto (se ve si la lista está tildada en Configuración) *@
            </section>

            @* ================= PRECIOS POR CANTIDAD (packs) ================= *@
            <PreciosPorCantidad @ref="preciosCantRef" Producto="producto" />

            @* ================= STOCK ================= *@
            <section class="gp-card gp-card-pad">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-boxes"></i></span>
                    <div class="cf-head-text">
                        <h2>Stock</h2>
                        <p>Cuánto tenés y cuándo avisarte que se está terminando @producto.ObtenerTituloModoPesoVenta().</p>
                    </div>
                </div>
                <div class="pp-stock">
                    <label class="pp-tile is-main">
                        <span class="pp-tile-label"><i class="bi bi-box-fill"></i> Stock actual @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                        <span class="sa-fila">
                            <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockActual" @bind:event="oninput" />
                            @if ((producto.StockActual ?? 0) > 0)
                            {
                                <button type="button" class="sa-mas" title="Sumar al stock (llegó mercadería)" @onclick="AbrirSumarStock" @onclick:preventDefault="true">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            }
                        </span>
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockActual)</span> }
                        <span class="pp-help">@(hayBultos && !producto.EsVentaPorPeso() ? "Unidades sueltas que tenés ahora (no bultos)" : "La cantidad que tenés ahora")</span>
                    </label>
                    <label class="pp-tile">
                        <span class="pp-tile-label"><i class="bi bi-graph-down-arrow"></i> Mínimo @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                        <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockMinimo" @bind:event="oninput" />
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockMinimo)</span> }
                        <span class="pp-help">Avisar si baja de esto</span>
                    </label>
                    <label class="pp-tile">
                        <span class="pp-tile-label"><i class="bi bi-bullseye"></i> Ideal @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                        <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockIdeal" @bind:event="oninput" />
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockIdeal)</span> }
                        <span class="pp-help">Si hay más de esta cantidad no pedir</span>
                    </label>
                </div>
            </section>

            @* ================= PROVEEDORES ================= *@
            <GestionProveedoresProducto @ref="gestionProvRef" ProductoId="@producto.Id" KioscoId="@State.KioscoId" UnidadesBultoProducto="@producto.BultoUnidades" OnBultosCambio="b => hayBultos = b" />

            @* ================= BOTONERA ================= *@
            <div class="pp-actions">
                <span class="pp-actions-info"><i class="bi bi-info-circle"></i> Los cambios se guardan al tocar “Guardar cambios”.</span>
                <button type="button" class="gp-btn gp-btn-soft" title="Crear otro producto igual (otro aroma, color, sabor...) con otro código" @onclick="DuplicarComoVariante"><i class="bi bi-copy"></i> Duplicar como variante</button>
                <button type="button" class="gp-btn gp-btn-outline" @onclick="Volver"><i class="bi bi-x-lg"></i> Cancelar</button>
                <button type="button" class="gp-btn gp-btn-ok" disabled="@guardando" @onclick="GuardarCambios">
                    @if (guardando)
                    {
                        <span class="gp-spinner" style="width:1.1rem;height:1.1rem;border-width:2px"></span> <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill"></i> <span>Guardar cambios</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@* ================= SUMAR AL STOCK (ventana) ================= *@
@if (sumarAbierto)
{
    <div class="sa-fondo" @onclick="() => sumarAbierto = false">
        <div class="sa-modal" @onclick:stopPropagation="true">
            <div class="sa-cab">
                <span class="sa-ico"><i class="bi bi-box-arrow-in-down"></i></span>
                <div>
                    <h3>Sumar al stock</h3>
                    <p>@producto.Nombre</p>
                </div>
            </div>

            <label class="sa-lbl">@(PesoEnKilos ? "¿Cuántos kilos llegaron?" : "¿Cuántas unidades llegaron?")</label>
            <div class="sa-input">
                <input @ref="saInput" type="number" inputmode="decimal" min="0" step="@(PesoEnKilos ? "0.001" : "1")"
                       placeholder="@(PesoEnKilos ? "Ej: 2,5" : "Ej: 24")" @bind="sumarCantidad" @bind:event="oninput"
                       @onkeydown="TeclaSumar" />
                <span>@(PesoEnKilos ? "kg" : "unid.")</span>
            </div>

            <div class="sa-cuenta">
                <div><small>Tenés</small><b>@TextoCant(producto.StockActual ?? 0)</b></div>
                <i class="bi bi-plus-circle-fill"></i>
                <div><small>Llegó</small><b>@TextoCant(SumarEnStock)</b></div>
                <i class="bi bi-arrow-right-circle-fill"></i>
                <div class="is-total"><small>Queda</small><b>@TextoCant((producto.StockActual ?? 0) + SumarEnStock)</b></div>
            </div>

            <div class="sa-botones">
                <button type="button" class="sa-btn is-no" @onclick="() => sumarAbierto = false">Cancelar</button>
                <button type="button" class="sa-btn is-ok" disabled="@(SumarEnStock <= 0)" @onclick="ConfirmarSumar"><i class="bi bi-check-lg"></i> Sumar</button>
            </div>
        </div>
    </div>
}

<style>
    .sa-fila { display: flex; align-items: center; gap: .4rem; }
    .sa-fila .pp-big { flex: 1 1 auto; min-width: 0; }
    .sa-mas { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 2.2rem; height: 2.2rem; border: 0; border-radius: 50%;
              background: #16a34a; color: #fff; font-size: 1.1rem; cursor: pointer; box-shadow: 0 2px 6px rgba(22,163,74,.35); }
    .sa-mas:hover { background: #15803d; }
    .sa-fondo { position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center; padding: 1rem; background: rgba(15,23,42,.55); }
    .sa-modal { width: 100%; max-width: 26rem; padding: 1.2rem; border-radius: 18px; background: #fff; border-top: 6px solid #16a34a; box-shadow: 0 20px 50px rgba(0,0,0,.3); font-family: inherit; }
    .sa-cab { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
    .sa-cab h3 { margin: 0; font-size: 1.15rem; font-weight: 900; color: #14532d; }
    .sa-cab p { margin: 0; font-size: .85rem; font-weight: 700; color: #64748b; }
    .sa-ico { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 2.6rem; height: 2.6rem; border-radius: 14px; background: #dcfce7; color: #16a34a; font-size: 1.3rem; }
    .sa-lbl { display: block; margin-bottom: .35rem; font-size: .8rem; font-weight: 800; color: #334155; }
    .sa-input { display: flex; align-items: center; border: 2px solid #86efac; border-radius: 12px; background: #f0fdf4; overflow: hidden; }
    .sa-input:focus-within { border-color: #16a34a; box-shadow: 0 0 0 3px #dcfce7; }
    .sa-input input { flex: 1 1 auto; min-width: 0; padding: .6rem .8rem; border: 0; background: transparent; font-size: 1.5rem; font-weight: 900; color: #0f172a; outline: none; }
    .sa-input span { padding: 0 .8rem; font-weight: 800; color: #16a34a; }
    .sa-cuenta { display: flex; align-items: center; justify-content: space-between; gap: .4rem; margin-top: 1rem; padding: .6rem .7rem; border-radius: 12px; background: #f8fafc; }
    .sa-cuenta div { display: flex; flex-direction: column; align-items: center; }
    .sa-cuenta small { font-size: .68rem; font-weight: 800; color: #64748b; text-transform: uppercase; }
    .sa-cuenta b { font-size: 1rem; font-weight: 900; color: #0f172a; }
    .sa-cuenta i { color: #94a3b8; }
    .sa-cuenta .is-total b { color: #16a34a; font-size: 1.2rem; }
    .sa-botones { display: flex; justify-content: flex-end; gap: .5rem; margin-top: 1.1rem; }
    .sa-btn { display: inline-flex; align-items: center; gap: .35rem; padding: .6rem 1.1rem; border-radius: 12px; border: 0; font-weight: 800; font-size: .95rem; cursor: pointer; }
    .sa-btn.is-no { background: #f1f5f9; color: #334155; }
    .sa-btn.is-ok { background: #16a34a; color: #fff; }
    .sa-btn.is-ok:disabled { opacity: .45; cursor: not-allowed; }
</style>

<style>
    .pp-activo { padding: .25rem .7rem .25rem .35rem; border-radius: 999px; font-weight: 800; }
    .pp-activo.is-on { background: #e3f6ea; }
    .pp-activo.is-on .gp-switch-text { color: #137a3a; }
    .pp-activo.is-off { background: #fde8e8; }
    .pp-activo.is-off .gp-switch-text { color: #b42318; }
</style>

@code {
    // ---------- Sumar al stock (sin hacer la cuenta a mano) ----------
    private bool sumarAbierto;
    private decimal? sumarCantidad;
    private ElementReference saInput;

    /// <summary>Por peso el stock se guarda en gramos: la cantidad se escribe en kilos (ej: 2,5).</summary>
    private bool PesoEnKilos => producto.IsMedidaGramos();
    private int SumarEnStock => (sumarCantidad ?? 0) <= 0 ? 0
        : (int)Math.Round(PesoEnKilos ? sumarCantidad!.Value * 1000m : sumarCantidad!.Value);
    private string TextoCant(int v) => PesoEnKilos ? KgAprox(v) : v.ToString("N0", argCulture);

    private async Task AbrirSumarStock()
    {
        sumarCantidad = null;
        sumarAbierto = true;
        StateHasChanged();
        await Task.Delay(50);
        try { await saInput.FocusAsync(); } catch { }
    }

    private void ConfirmarSumar()
    {
        if (SumarEnStock <= 0) return;
        int llego = SumarEnStock;
        producto.StockActual = (producto.StockActual ?? 0) + llego;
        sumarAbierto = false;
        avisos.Toast($"Se sumó {TextoCant(llego)}. Queda {TextoCant(producto.StockActual ?? 0)}. Tocá Guardar para que quede.", "exito", 4000);
    }

    private void TeclaSumar(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") ConfirmarSumar();
        else if (e.Key == "Escape") sumarAbierto = false;
    }

    [Parameter] public long Id { get; set; }

    private AvisosPagina avisos = default!;
    private Producto? producto;
    private bool cargando = true, guardando;

    private List<Familia> familias = new();
    private List<Proveedor> proveedores = new();

    // ---------- Alta rápida (familia / proveedor sin ir a Configuración) ----------
    private AltaRapida altaFamilia = default!;
    private AltaRapida altaProveedor = default!;

    private void FamiliaCreada((long Id, string Nombre) f)
    {
        if (!familias.Any(x => x.Id == f.Id))
        {
            familias.Add(new Familia { Id = f.Id, KioscoId = State.KioscoId, Nombre = f.Nombre });
            familias = familias.OrderBy(x => x.Nombre).ToList();
        }
        producto.FamiliaId = f.Id;
        producto.SubfamiliaId = null;
        avisos.Toast($"Familia {f.Nombre} lista", "exito", 1800);
    }

    // ---------- utilidad de la familia / subfamilia (Configuración → Familias, script 37) ----------
    private PreciosProducto? preciosRef;
    private List<Subfamilia> subfamiliasUtil = new();
    private decimal? utilAutomatica;   // la que se puso sola al elegir el grupo (si no se tocó, sigue al grupo)

    private decimal UtilidadDelGrupo => Subfamilia.Para(familias, subfamiliasUtil, producto?.FamiliaId, producto?.SubfamiliaId);

    private string NombreGrupo
    {
        get
        {
            var s = subfamiliasUtil.FirstOrDefault(x => x.Id == producto?.SubfamiliaId);
            if (s?.Utilidad != null) return s.Nombre;
            var f = familias.FirstOrDefault(x => x.Id == producto?.FamiliaId);
            return f?.Utilidad != null ? f.Nombre : "La general";
        }
    }

    private async Task CargarSubfamiliasUtil()
    {
        try { long k = State.KioscoId; subfamiliasUtil = (await SupaClient.From<Subfamilia>().Where(s => s.KioscoId == k).Get()).Models ?? new(); }
        catch { subfamiliasUtil = new(); }
    }

    private async Task CambioFamilia()
    {
        if (producto != null) producto.SubfamiliaId = null;
        await CambioGrupo();
    }

    /// <summary>Editar: no se cambia sola; si el grupo tiene otra utilidad se ofrece en el recuadro de precios.</summary>
    private async Task CambioGrupo()
    {
        if (producto?.SubfamiliaId is long sid && !subfamiliasUtil.Any(s => s.Id == sid)) await CargarSubfamiliasUtil();
    }


    private void ProveedorCreado((long Id, string Nombre) p)
    {
        if (!proveedores.Any(x => x.Id == p.Id))
        {
            proveedores.Add(new Proveedor { Id = p.Id, KioscoId = State.KioscoId, Nombre = p.Nombre });
            proveedores = proveedores.OrderBy(x => x.Nombre).ToList();
        }
        producto.ProveedorId = p.Id;
        avisos.Toast($"Proveedor {p.Nombre} listo", "exito", 1800);
    }
    // referencia al componente hijo para guardar relaciones
    private GestionProveedoresProducto? gestionProvRef;
    private PreciosPorCantidad? preciosCantRef;

    private CultureInfo argCulture = CultureInfo.GetCultureInfo("es-AR");
    private string nombreLista2 = "";

    protected override async Task OnInitializedAsync()
    {
        await PrecioServ.AsegurarReglasAsync(State.KioscoId);   // recargos de la Lista 2 del negocio
        try
        {
            var response = await SupaClient.From<Producto>().Where(p => p.Id == Id).Get();
            producto = response.Models.FirstOrDefault();
            if (producto != null)
            {
                subfamiliaOriginal = producto.SubfamiliaId;
                var responseFam = await SupaClient.From<Familia>().Where(f => f.KioscoId == State.KioscoId).Get();
                familias = responseFam.Models.OrderBy(f => f.Nombre).ToList();

                var responseProv = await SupaClient.From<Proveedor>().Where(p => p.KioscoId == State.KioscoId).Get();
                // sin los dados de baja (salvo el que ya tiene este producto, para no perderlo al guardar)
                proveedores = responseProv.Models.Where(p => p.EstaActivo() || p.Id == producto.ProveedorId).OrderBy(p => p.Nombre).ToList();

                nombreLista2 = await PrecioServ.ObtenerNombreColumnaAsync(State.KioscoId, "precio_lista2");
                await CargarSubfamiliasUtil();

                // 1. Validar Unidad de Medida si es null o vacía
                if (string.IsNullOrWhiteSpace(producto.UnidadMedida))
                {
                    producto.UnidadMedida = "UNIDAD";
                }

                // 2. Validar Familia / Categoría si es null
                if (!producto.FamiliaId.HasValue || producto.FamiliaId == 0)
                {
                    var familiaDefault = familias.FirstOrDefault(f =>
                        f.Nombre != null &&
                        (f.Nombre.Equals("PRODUCTO", StringComparison.OrdinalIgnoreCase) ||
                         f.Nombre.Equals("PRODUCTOS", StringComparison.OrdinalIgnoreCase) ||
                         f.Nombre.Equals("ARTICULOS", StringComparison.OrdinalIgnoreCase) ||
                         f.Nombre.Equals("ARTÍCULOS", StringComparison.OrdinalIgnoreCase)));

                    if (familiaDefault != null)
                    {
                        producto.FamiliaId = familiaDefault.Id;
                    }
                }
            }
        }
        catch
        {
            producto = null;
        }
        finally
        {
            cargando = false;
        }
    }

    // ---------- Unidad de medida ----------
    private bool EsUnidad(string u) => string.Equals(producto?.UnidadMedida, u, StringComparison.OrdinalIgnoreCase);

    private void CambiarUnidad(string unidad)
    {
        if (producto == null) return;
        producto.UnidadMedida = unidad;
        // Automatiza la propiedad VentaxPeso según la unidad elegida
        producto.VentaxPeso = producto.IsMedidaGramos() || producto.IsMedidaKilos();
    }

    private static string TextoUnidad(string u) => Unidades.Nombre(u);
    private static string IconoUnidad(string u) => Unidades.Icono(u);

    // ---------- Precio por mayor ----------
    private void CalcularPrecioVentaMargenXMayor(ChangeEventArgs e)
    {
        if (producto == null || !decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out decimal margen)) return;
        producto.UtilidadVentaxMayor = margen;
        producto.PrecioVentaxMayor = producto.CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadVentaxMayor, State);
    }

    private long? subfamiliaOriginal;

    // ---------- Código de barras ----------
    private bool creandoCodigo;
    private async Task CrearCodigoPropio()
    {
        creandoCodigo = true;
        try
        {
            producto.CodigoBarras = await CodigoBarras.CrearCodigoPropioAsync(SupaClient, State.KioscoId);
            avisos.Toast("Código creado. Tocá \"Guardar cambios\" para que quede guardado.", "exito", 4000);
        }
        catch (Exception ex) { avisos.Toast("No se pudo crear el código: " + ex.Message, "peligro"); }
        finally { creandoCodigo = false; }
    }

    private async Task ImprimirEtiqueta()
    {
        if (!await avisos.ConfirmarAsync("¿Ir a imprimir la etiqueta?", "Si cambiaste algo y no lo guardaste, se pierde. Guardá primero si hace falta.", "Ir a imprimir", "aviso", "Quedarme")) return;
        BlazorKioscoCompartido.Components.EtiquetasCodigos.Precargar(producto);
        Nav.NavigateTo("/carteles?tab=codigos");
    }

    // ---------- Guardar ----------
    private async Task GuardarCambios()
    {
        if (producto == null) return;
        if (string.IsNullOrWhiteSpace(producto.Nombre)) { avisos.Toast("Falta la descripción del producto.", "peligro"); return; }

        CompletarFamiliaYProveedor();
        guardando = true;
        try
        {
            // Asegurar que antes de guardar, los precios en kilos contengan los valores redondeados de 100g
            if (producto.PrecioCada100g())
            {
                bool igual = PrecioService.EsMismoPrecioDiaNoche(producto);   // mismo precio de día y de noche
                if (producto.UtilidadPV.HasValue && producto.UtilidadPV > 0)
                {
                    producto.PrecioVenta = producto.CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadPV, State);
                }
                PrecioService.ProcesarLista2Automatico(producto, State.KioscoId, State, igual);
            }

            producto.FechaActualizacion = DateTime.UtcNow;

            await SupaClient.From<Producto>().Where(p => p.Id == producto.Id).Update(producto);

            // se le sacó la subfamilia: el guardado normal no manda los vacíos, se borra aparte
            if (subfamiliaOriginal != null && producto.SubfamiliaId == null)
            {
                long idProd = producto.Id;
                await SupaClient.From<Producto>().Where(p => p.Id == idProd).Set(p => p.SubfamiliaId!, (object?)null).Update();
            }
            subfamiliaOriginal = producto.SubfamiliaId;

            // Guardar relaciones proveedores creadas/seleccionadas en el componente hijo
            if (gestionProvRef != null)
            {
                await gestionProvRef.GuardarCambiosProveedoresAsync(producto.Id);
            }

            // precios por cantidad (si falla, el producto ya quedó guardado)
            if (preciosCantRef != null)
            {
                try { await preciosCantRef.GuardarAsync(producto.Id); }
                catch (Exception exPc) { await avisos.InformarAsync("No se guardaron los precios por cantidad", exPc.Message, "aviso"); }
            }

            guardando = false;
            await avisos.GuardadoAsync(producto.Nombre, milisegundos: 1400);   // se ve que se guardó y vuelve a la lista
            Volver();
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron guardar los cambios", ex.Message, "peligro");
        }
        finally { guardando = false; }
    }

    // Stock en gramos: equivalente aproximado en kilos para que se entienda mejor (ej: 1250 → "1,25 kg")
    private string KgAprox(int? gramos) => ((gramos ?? 0) / 1000m).ToString("#,##0.###", argCulture) + " kg";

    // algún proveedor lo vende por bulto: el stock se aclara "x unidad" para no confundir
    private bool hayBultos;

    /// <summary>
    /// Si quedó sin familia o sin proveedor ("-- Elegí --"), se ponen los de siempre: ARTICULOS y PROVEEDOR.
    /// Así no falla al guardar (la base no acepta familia 0).
    /// </summary>
    private void CompletarFamiliaYProveedor()
    {
        if ((producto.FamiliaId ?? 0) <= 0)
        {
            var fam = familias.FirstOrDefault(f => f.Nombre != null &&
                (new[] { "ARTICULOS", "ARTÍCULOS", "ARTICULO", "ARTÍCULO" }).Contains(f.Nombre.Trim().ToUpperInvariant()));
            producto.FamiliaId = fam?.Id;          // si no existe, queda sin familia (no 0)
            producto.SubfamiliaId = null;
        }
        if ((producto.ProveedorId ?? 0) <= 0)
        {
            var prov = proveedores.FirstOrDefault(p => string.Equals(p.Nombre?.Trim(), ConfiguracionService.ProveedorDefault, StringComparison.OrdinalIgnoreCase));
            producto.ProveedorId = prov?.Id;       // si no existe, queda sin proveedor (no 0)
        }
    }

    private void Volver() => Nav.NavigateTo("/productos");

    /// <summary>Abre "Nuevo producto" con todo copiado de este (precios, familia, proveedores, bultos).</summary>
    private void DuplicarComoVariante()
    {
        var rutaNuevo = Nav.Uri.Contains("-desktop", StringComparison.OrdinalIgnoreCase) ? "/producto/nuevo-desktop" : "/producto/nuevo";
        Nav.NavigateTo($"{rutaNuevo}?copiarDe={Id}");
    }
