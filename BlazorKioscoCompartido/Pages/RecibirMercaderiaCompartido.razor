@using BlazorKioscoCompartido.Components
@using BlazorKioscoCompartido.Models
@using System.Globalization
@inject PrecioService PrecioServ
@inject Supabase.Client SupaClient
@inject AppState State

<AvisosPagina @ref="avisos" />

<div class="gp-scope">

@if (vista == VistaInicio)
{
    <!-- ===================== INICIO: ¿QUÉ SE RECIBE? ===================== -->
    <section class="gp-card gp-card-pad mb-3">
        <div class="gp-card-head">
            <span class="gp-bubble"><i class="bi bi-box-arrow-in-down"></i></span>
            <h2>¿Qué vas a recibir?</h2>
        </div>

        <div class="rm-start">
            <button type="button" class="rm-card @(panel == "boleta" ? "is-active" : "")" @onclick="NuevaBoleta">
                <span class="gp-bubble"><i class="bi bi-receipt"></i></span>
                <strong>Cargar una boleta</strong>
                <span>Papel o foto que mandó el proveedor</span>
            </button>
            <button type="button" class="rm-card @(panel == "pedidos" ? "is-active" : "")" @onclick='() => panel = "pedidos"'>
                <span class="gp-bubble"><i class="bi bi-truck"></i></span>
                <strong>Recibir un pedido</strong>
                <span>@(pedidosPorRecibir.Count) esperando</span>
            </button>
            <button type="button" class="rm-card @(panel == "listas" ? "is-active" : "")" @onclick='() => panel = "listas"'>
                <span class="gp-bubble"><i class="bi bi-calculator"></i></span>
                <strong>Lista de la calculadora</strong>
                <span>@(listasCerradas.Count) cerradas sin confirmar</span>
            </button>
        </div>
    </section>

    @if (cargandoOrigenes)
    {
        <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Buscando pedidos y listas...</p></div>
    }
    else if (panel == "pedidos")
    {
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head" style="margin-bottom:.9rem">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-truck"></i></span>
                <h2 style="font-size:1.1rem">Pedidos para recibir</h2>
            </div>
            @if (!pedidosPorRecibir.Any())
            {
                <div class="gp-empty">
                    <span class="gp-bubble"><i class="bi bi-check2-all"></i></span>
                    <strong>No hay pedidos esperando</strong>
                    <span>Los pedidos que armás en "Gestión de pedidos" aparecen acá cuando están enviados.</span>
                </div>
            }
            else
            {
                <div class="cm-compras">
                    @foreach (var p in pedidosPorRecibir)
                    {
                        <button type="button" class="cm-compra" @onclick="() => AbrirPedidoAsync(p)">
                            <b style="color:var(--gp-text)">@(string.IsNullOrWhiteSpace(p.NombreListado) ? "Pedido sin nombre" : p.NombreListado)</b>
                            <span>@NombreProveedor(p.ProveedorId)</span>
                            <span><i class="bi bi-calendar3"></i> @p.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            <b>$@p.MontoEstimado.ToString("N2", cultura)</b>
                            <span class="gp-pill @(p.Estado == "Pendiente" ? "is-pend" : "is-env")" style="align-self:flex-start">@p.Estado</span>
                        </button>
                    }
                </div>
            }
        </section>
    }
    else if (panel == "listas")
    {
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head" style="margin-bottom:.9rem">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-calculator"></i></span>
                <h2 style="font-size:1.1rem">Listas de la calculadora</h2>
            </div>
            @if (!listasCerradas.Any())
            {
                <div class="gp-empty">
                    <span class="gp-bubble"><i class="bi bi-check2-all"></i></span>
                    <strong>No hay listas para confirmar</strong>
                    <span>Cuando cierres una lista en la calculadora, aparece acá.</span>
                </div>
            }
            else
            {
                <div class="cm-compras">
                    @foreach (var c in listasCerradas)
                    {
                        <button type="button" class="cm-compra" @onclick="() => AbrirListaAsync(c)">
                            <span><i class="bi bi-calendar3"></i> @c.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            <b>$@c.TotalCompra.ToString("N2", cultura)</b>
                        </button>
                    }
                </div>
            }
        </section>
    }
}
else
{
    <!-- ===================== EDITOR ===================== -->
    <div class="gp-banner @(origen == CompraOrigen.Boleta ? "is-neutral" : "")">
        <i class="bi @(origen == CompraOrigen.Pedido ? "bi-truck" : origen == CompraOrigen.Calculadora ? "bi-calculator" : origen == CompraOrigen.Excel ? "bi-file-earmark-excel" : "bi-receipt")"></i>
        <p>@TextoOrigen</p>
        <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="VolverAlInicioAsync"><i class="bi bi-arrow-left"></i> Cambiar</button>
    </div>

    <!-- DATOS DE LA BOLETA -->
    <section class="gp-card gp-card-pad mb-3">
        <div class="gp-card-head">
            <span class="gp-bubble"><i class="bi bi-receipt"></i></span>
            <h2>Datos de la boleta</h2>
        </div>

        <div class="ing-grid">
            <div class="gp-field">
                <label class="gp-field-label" for="rmProv"><i class="bi bi-truck"></i> Proveedor</label>
                <select id="rmProv" class="gp-control" value="@proveedorId" @onchange="OnProveedorChanged">
                    <option value="0">-- Sin proveedor / compra varia --</option>
                    @foreach (var prov in listaProveedores.Where(p => !EsSinProveedor(p) && (p.EstaActivo() || p.Id == proveedorId)))
                    {
                        <option value="@prov.Id">@prov.Nombre</option>
                    }
                </select>
            </div>
            <div class="gp-field">
                <label class="gp-field-label" for="rmNro"><i class="bi bi-hash"></i> N° remito / factura</label>
                <input id="rmNro" type="text" class="gp-control" placeholder="Ej: 0001-000452" maxlength="40" @bind="numeroComprobante" />
            </div>
            <div class="gp-field">
                <label class="gp-field-label" for="rmFecha"><i class="bi bi-calendar-event"></i> Fecha de la boleta</label>
                <input id="rmFecha" type="date" class="gp-control" @bind="fechaCompra" />
            </div>
            <div class="gp-field">
                <label class="gp-field-label" for="rmTotal"><i class="bi bi-cash-coin"></i> Total de la boleta <small>(opcional)</small></label>
                <div class="ing-money">
                    <span>$</span>
                    <InputMonto id="rmTotal" class="gp-control" Placeholder="Para controlar lo cargado" @bind-Value="totalBoleta" />
                </div>
            </div>
        </div>
    </section>

    <!-- PRODUCTOS -->
    <section class="gp-card gp-card-pad">
        <div class="gp-card-head" style="margin-bottom:.9rem">
            <span class="gp-bubble"><i class="bi bi-boxes"></i></span>
            <h2>Productos recibidos</h2>
        </div>

        <div class="ing-search-row">
            <div class="gp-buscador" style="flex:1 1 280px; min-width:0">
                <BuscadorProducto CargarAlInicio="false"
                                  MostrarPrimeraLista="false"
                                  MostrarSegundaLista="false"
                                  OnProductoEncontrado="AgregarProducto" />
            </div>
            <button type="button" class="gp-btn gp-btn-ok-soft" style="height:3rem" @onclick="AbrirModalNuevoProducto">
                <i class="bi bi-plus-lg"></i> Producto nuevo
            </button>
        </div>

        @if (proveedorId > 0)
        {
            <div class="rm-codprov">
                <label for="rmCodProv"><i class="bi bi-upc-scan"></i> Código del proveedor</label>
                <input id="rmCodProv" type="text" class="gp-control" autocomplete="off" placeholder="El código que trae la boleta, y Enter"
                       @bind="codigoProvInput" @bind:event="oninput" @onkeyup="OnCodigoProvKeyUp" />
                <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="BuscarPorCodigoProveedorAsync"><i class="bi bi-search"></i></button>
            </div>
            @if (!string.IsNullOrEmpty(codigoProvPendiente))
            {
                <div class="gp-banner" style="margin:.6rem 0 0">
                    <i class="bi bi-link-45deg"></i>
                    <p>El código <b>@codigoProvPendiente</b> no está asociado a ningún producto de este proveedor. Elegí el producto arriba y se lo guardamos al confirmar.</p>
                    <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Descartar" @onclick="() => codigoProvPendiente = null"><i class="bi bi-x-lg"></i></button>
                </div>
            }
        }

        <div class="gp-filtros" style="margin:.9rem 0">
            <label class="gp-switch">
                <input type="checkbox" @bind="mostrarPrecios" />
                <span class="gp-switch-track"></span>
                <span class="gp-switch-text">Mostrar utilidad y precios de venta</span>
            </label>
            <div class="gp-hint">
                <i class="bi bi-lightbulb-fill"></i>
                <span>Tip: escaneá, escribí la cantidad, <b>Tab</b> y el costo. Cargá en el mismo orden que el papel.</span>
            </div>
        </div>

        <div class="gp-table-wrap gp-stack-wrap">
            <table class="gp-table gp-stack">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Producto</th>
                        <th class="t-center">Cantidad</th>
                        <th class="t-center">Costo ($)</th>
                        @if (mostrarPrecios)
                        {
                            <th class="t-center">Utilidad %</th>
                            <th class="t-center">Precio venta ($)</th>
                            @if (nombreLista2 != "")
                            {
                                <th class="t-center">Util. @nombreLista2 %</th>
                                <th class="t-center">@nombreLista2 ($)</th>
                            }
                        }
                        <th class="t-right">Subtotal costo</th>
                        <th class="t-center"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!items.Any())
                    {
                        <tr class="gp-empty-row">
                            <td colspan="10">
                                <div class="gp-empty">
                                    <span class="gp-bubble"><i class="bi bi-cart-x"></i></span>
                                    <strong>Todavía no hay productos</strong>
                                    <span>Escaneá un código o buscalo arriba. Si no existe, usá "Producto nuevo".</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            var esGramos = item.Producto.IsMedidaGramos();
                            decimal difCosto = item.CostoAnterior > 0 && item.CostoPV > 0 ? (item.CostoPV - item.CostoAnterior) / item.CostoAnterior * 100m : 0m;
                            <tr class="@(item.Impactado ? "is-off" : "")">
                                <td class="gp-td-code" data-label="Código">@(string.IsNullOrEmpty(item.Producto.CodigoBarras) ? "S/D" : item.Producto.CodigoBarras)</td>

                                <td class="gp-td-main" data-label="Producto">
                                    <div class="gp-product">@item.Producto.Nombre</div>
                                    @if (item.Impactado)
                                    {
                                        <span class="gp-pill is-env" style="margin-top:.25rem">Guardado</span>
                                    }
                                    @if (proveedorId > 0)
                                    {
                                        <input type="text" class="rm-codinput" placeholder="Cód. proveedor" maxlength="60" disabled="@item.Impactado"
                                               @bind="item.CodigoProveedor" onfocus="this.select()" />
                                    }
                                </td>

                                <td class="t-center" data-label="Cantidad">
                                    <div class="ing-cell">
                                        @if (item.CantidadPedida.HasValue)
                                        {
                                            <span class="ing-ant" style="background:var(--gp-primary-soft); border-color:var(--gp-primary-line); color:var(--gp-primary)">Pedido: @(item.PorBulto && item.UnidadesPorBulto > 1 && item.CantidadPedida % item.UnidadesPorBulto == 0 ? $"{item.CantidadPedida / item.UnidadesPorBulto} bto." : item.CantidadPedida.ToString())</span>
                                        }
                                        <span class="gp-muted" style="font-size:.72rem">Stock: @item.StockAnterior → @(item.StockAnterior + item.Cantidad)</span>
                                        @if (!esGramos && !item.Impactado)
                                        {
                                            <div class="rm-modo" role="group" aria-label="Cargar por unidad o por bulto">
                                                <button type="button" class="@(item.PorBulto ? "" : "is-active")" @onclick="() => CambiarModo(item, false)">Unid.</button>
                                                <button type="button" class="@(item.PorBulto ? "is-active" : "")" @onclick="() => CambiarModo(item, true)">Bulto</button>
                                            </div>
                                        }
                                        <input type="number" min="1" class="ing-input" style="width:5.2rem" @ref="refCantidadUltima" disabled="@item.Impactado"
                                               value="@(item.PorBulto ? item.Bultos : item.Cantidad)" @onchange="@(e => ActualizarCantidad(item, e))" onfocus="this.select()" />
                                        @if (item.PorBulto)
                                        {
                                            <span class="rm-bulto">
                                                x <input type="number" min="1" class="rm-bulto-n" disabled="@item.Impactado" title="Unidades que trae cada bulto"
                                                         value="@item.UnidadesPorBulto" @onchange="@(e => CambiarUnidadesBulto(item, e))" onfocus="this.select()" /> u.
                                                = <b>@item.Cantidad u.</b>
                                            </span>
                                        }
                                        @if (esGramos) { <small class="gp-muted" style="font-size:.7rem">(x Gr)</small> }
                                    </div>
                                </td>

                                <td class="t-center" data-label="Costo ($)">
                                    <div class="ing-cell">
                                        <span class="ing-ant">@(item.PorBulto ? "Ant. bulto" : "Ant"): $@((item.PorBulto ? item.CostoAnterior * item.UnidadesPorBulto : item.CostoAnterior).ToString("N2", cultura))</span>
                                        <input type="text" inputmode="decimal" class="ing-input cost js-monto" disabled="@item.Impactado"
                                               value="@CostoMostrar(item)" @onchange="@(e => ActualizarCosto(item, e))" onfocus="this.select()" />
                                        @if (esGramos) { <small class="gp-muted" style="font-size:.7rem">(x Kg)</small> }
                                        @if (item.PorBulto)
                                        {
                                            <small class="rm-bulto">x bulto · <b>$@item.CostoPV.ToString("N2", cultura) c/u</b></small>
                                        }
                                        @if (item.EsEstimado && !item.CostoEditado)
                                        {
                                            <span class="ing-delta" style="background:var(--gp-warn-soft); color:var(--gp-warn)">Costo estimado</span>
                                        }
                                        else if (Math.Abs(difCosto) >= 0.05m)
                                        {
                                            <span class="ing-delta @(difCosto > 0 ? "up" : "down")">@(difCosto > 0 ? "▲ +" : "▼ ")@difCosto.ToString("0.#", cultura)%</span>
                                        }
                                    </div>
                                </td>

                                @if (mostrarPrecios)
                                {
                                    <td class="t-center" data-label="Utilidad %">
                                        <div class="ing-cell">
                                            <span class="ing-ant">Ant: @item.UtilidadAnterior.ToString("N0")%</span>
                                            <input type="number" class="ing-input" disabled="@item.Impactado" @bind="item.UtilidadPV" @bind:after="() => RecalcularPrecios(item)" onfocus="this.select()" />
                                        </div>
                                    </td>

                                    <td class="t-center" data-label="Precio venta ($)">
                                        <div class="ing-cell">
                                            <span class="ing-ant">Ant: $@item.PrecioVentaAntes</span>
                                            <input type="text" inputmode="decimal" class="ing-input sale js-monto" disabled="@item.Impactado"
                                                   value="@Plata.Texto(ObtenerPrecioCalculadoMostrar(item.Producto, item.PrecioVentaCalculado))"
                                                   @onchange="@(e => ActualizarPrecioVenta(item, e))" onfocus="this.select()" />
                                            @if (esGramos) { <small class="gp-muted" style="font-size:.7rem">@item.Producto.ObtenerTextoModoPesoVentaCorto()</small> }
                                        </div>
                                    </td>

                                    @if (nombreLista2 != "")
                                    {
                                        <td class="t-center" data-label="@("Util. " + nombreLista2 + " %")">
                                            <div class="ing-cell">
                                                <span class="ing-ant">Ant: @item.UtilidadL2Anterior.ToString("N0")%</span>
                                                <input type="number" class="ing-input" disabled="@item.Impactado" @bind="item.UtilidadLista2" @bind:after="() => RecalcularPrecios(item)" onfocus="this.select()" />
                                            </div>
                                        </td>

                                        <td class="t-center" data-label="@nombreLista2">
                                            <div class="ing-cell">
                                                <span class="ing-ant">Ant: $@item.PrecioL2Antes</span>
                                                <input type="text" inputmode="decimal" class="ing-input sale js-monto" disabled="@item.Impactado"
                                                       value="@Plata.Texto(ObtenerPrecioCalculadoMostrar(item.Producto, item.PrecioVentaLista2Calculado))"
                                                       @onchange="@(e => ActualizarPrecioLista2(item, e))" onfocus="this.select()" />
                                                @if (esGramos) { <small class="gp-muted" style="font-size:.7rem">@item.Producto.ObtenerTextoModoPesoVentaCorto()</small> }
                                            </div>
                                        </td>
                                    }
                                }

                                <td class="t-right gp-money" data-label="Subtotal costo">$@item.SubtotalCosto.ToString("N2", cultura)</td>

                                <td class="gp-td-check t-center" data-label="">
                                    @if (!item.Impactado)
                                    {
                                        <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Quitar (no llegó / no va)" aria-label="Quitar" @onclick="() => EliminarItem(item)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>

    <!-- BARRA INFERIOR -->
    @if (items.Any())
    {
        <div class="ing-bar-wrap">
            <div class="gp-selbar ing-bar">
                <div class="ing-bar-info">
                    <div>
                        <span class="ing-bar-label">Total de la compra</span>
                        <span class="ing-bar-total">$@TotalCompra.ToString("N2", cultura)</span>
                    </div>
                    <div class="ing-bar-meta">
                        <span>@items.Count ítems · @items.Sum(i => i.Cantidad) unidades</span>
                        @if (estimadoOrigen > 0)
                        {
                            <span>Estimado: $@estimadoOrigen.ToString("N2", cultura)</span>
                        }
                        @if (HayTotalBoleta)
                        {
                            @if (Math.Abs(Diferencia) < 1m)
                            {
                                <span class="ing-chk ok"><i class="bi bi-check-circle-fill"></i> Coincide con la boleta</span>
                            }
                            else
                            {
                                <span class="ing-chk bad"><i class="bi bi-exclamation-triangle-fill"></i> Difiere $@Math.Abs(Diferencia).ToString("N2", cultura) de la boleta (@(Diferencia > 0 ? "cargaste de más" : "falta cargar"))</span>
                            }
                        }
                    </div>
                </div>
                <div class="gp-btn-group">
                    <button type="button" class="gp-btn gp-btn-ok" style="height:3rem" @onclick="ConfirmarAsync" disabled="@guardando">
                        @if (guardando)
                        {
                            <span class="gp-spinner" style="width:1rem;height:1rem;border-width:2px;border-color:rgba(255,255,255,.4);border-top-color:#fff"></span> <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i> <span>Confirmar ingreso</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}
</div>

<!-- VENTANA: ALTA RÁPIDA DE PRODUCTO -->
@if (mostrarModalNuevoProducto)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModalNuevoProducto">
        <div class="gp-modal" role="dialog" aria-modal="true" aria-labelledby="rmAltaTitulo" style="max-width: 30rem;"
             @onclick:stopPropagation="true" @onkeydown="OnAltaKey">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-box-seam"></i></span>
                <div>
                    <h3 id="rmAltaTitulo">Alta rápida de producto</h3>
                    <p>Se crea el producto y se suma a esta compra.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModalNuevoProducto"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <div class="gp-field" style="margin-bottom:.8rem">
                    <label class="gp-field-label" for="altaCodigo"><i class="bi bi-upc-scan"></i> Código de barras</label>
                    <input id="altaCodigo" type="text" class="gp-control" @bind="nuevoProducto.CodigoBarras" placeholder="Escaneá o ingresá el código" />
                </div>
                <div class="gp-field" style="margin-bottom:.8rem">
                    <label class="gp-field-label" for="altaNombre"><i class="bi bi-pencil-square"></i> Nombre del producto *</label>
                    <input id="altaNombre" type="text" class="gp-control" @bind="nuevoProducto.Nombre" placeholder="Ej: Galletitas Donas 100g" />
                </div>
                <div class="ing-alta-grid">
                    <div class="gp-field">
                        <label class="gp-field-label" for="altaCosto"><i class="bi bi-currency-dollar"></i> Precio costo</label>
                        <InputMonto id="altaCosto" class="gp-control" Inmediato="false" @bind-Value="nuevoProducto.PrecioCosto" />
                    </div>
                    <div class="gp-field">
                        <label class="gp-field-label" for="altaUtil"><i class="bi bi-percent"></i> Utilidad (%)</label>
                        <input id="altaUtil" type="number" step="any" class="gp-control" @bind="nuevoProducto.UtilidadPV" onfocus="this.select()" />
                    </div>
                </div>
            </div>
            <div class="gp-modal-foot">
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarModalNuevoProducto">Cancelar</button>
                <button type="button" class="gp-btn gp-btn-ok" disabled="@guardandoNuevo" @onclick="GuardarNuevoProductoYSumarALista">
                    <i class="bi bi-check2-circle"></i> Guardar y sumar a la compra
                </button>
            </div>
        </div>
    </div>
}

<style>
    .rm-start { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .8rem; }
    .rm-card { display: flex; flex-direction: column; align-items: flex-start; gap: .35rem; padding: 1rem; text-align: left; background: #fff; border: 1px solid var(--gp-line); border-radius: 16px; font: inherit; color: var(--gp-text); cursor: pointer; transition: border-color .15s, box-shadow .15s, background .15s; }
    .rm-card:hover { border-color: var(--gp-primary-line); box-shadow: 0 6px 18px rgba(22,33,72,.1); }
    .rm-card.is-active { background: var(--gp-primary-soft); border-color: var(--gp-primary); }
    .rm-card strong { font-size: 1.05rem; font-weight: 900; }
    .rm-card span:last-child { color: var(--gp-muted); font-size: .85rem; font-weight: 600; }
    .rm-codprov { display: flex; align-items: center; gap: .6rem; margin-top: .8rem; }
