    private void AbrirModalNuevoProducto()
    {
        nuevoProducto = new Producto
        {
            KioscoId = State.KioscoId,
            FamiliaId = null,
            Activo = true,
            UtilidadPV = 40
        };
        mostrarModalNuevoProducto = true;
    }

    private void CerrarModalNuevoProducto() => mostrarModalNuevoProducto = false;

    private async Task OnAltaKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CerrarModalNuevoProducto();
        await Task.CompletedTask;
    }

    private async Task GuardarNuevoProductoYSumarALista()
    {
        if (guardandoNuevo) return;

        if (string.IsNullOrWhiteSpace(nuevoProducto.Nombre))
        {
            await avisos.InformarAsync("Falta el nombre", "Ingresá un nombre para el nuevo producto.", "aviso");
            return;
        }

        try
        {
            guardandoNuevo = true;

            var codigo = nuevoProducto.CodigoBarras?.Trim();
            if (!string.IsNullOrEmpty(codigo))
            {
                long kiosco = State.KioscoId;
                var dup = await SupaClient.From<Producto>()
                    .Where(p => p.CodigoBarras == codigo && p.KioscoId == kiosco)
                    .Get();
                var yaExiste = dup.Models?.FirstOrDefault();

                if (yaExiste != null)
                {
                    if (await avisos.ConfirmarAsync("Ese código ya existe",
                            $"'{yaExiste.Nombre}' ya tiene ese código de barras. ¿Lo agregamos a la compra en vez de crear uno nuevo?",
                            "Agregar el existente", "aviso"))
                    {
                        AgregarProducto(yaExiste);
                        CerrarModalNuevoProducto();
                    }
                    return;
                }
            }

            nuevoProducto.CodigoBarras = string.IsNullOrEmpty(codigo) ? null : codigo;
            nuevoProducto.Nombre = nuevoProducto.Nombre.Trim();
            nuevoProducto.PrecioVenta = nuevoProducto.CalcularPrecioPorUtilidad(
                nuevoProducto.PrecioCosto ?? 0m,
                nuevoProducto.UtilidadPV ?? 40m,
                State);

            var res = await SupaClient.From<Producto>().Insert(nuevoProducto);
            var prodGuardado = res.Models.FirstOrDefault();

            if (prodGuardado != null)
            {
                AgregarProducto(prodGuardado);
                CerrarModalNuevoProducto();
                _ = avisos.GuardadoAsync($"Producto creado: {prodGuardado.Nombre}");
            }
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo dar de alta el producto", ex.Message, "peligro");
        }
        finally
        {
            guardandoNuevo = false;
        }
    }

    // ======================= CONFIRMAR =======================

    private async Task ConfirmarAsync()
    {
        if (!items.Any() || guardando) return;

        var pendientes = items.Where(i => !i.Impactado).ToList();
        int cantidadItems = pendientes.Count;
        int unidades = pendientes.Sum(i => i.Cantidad);
        int sinCosto = pendientes.Count(i => i.CostoPV <= 0);
        int costoSinRevisar = pendientes.Count(i => i.EsEstimado && !i.CostoEditado && i.CostoPV > 0);
        bool hayDiferencia = HayTotalBoleta && Math.Abs(Diferencia) >= 1m;

        // Boleta repetida: mismo proveedor y mismo número ya confirmados
        var nro = numeroComprobante?.Trim();
        string avisoRepetida = "";
        if (proveedorId > 0 && !string.IsNullOrEmpty(nro))
        {
            try
            {
                long kiosco = State.KioscoId;
                long prov = proveedorId;
                var rep = await SupaClient.From<CompraMayorista>()
                    .Where(c => c.KioscoId == kiosco)
                    .Where(c => c.ProveedorId == prov)
                    .Where(c => c.NumeroComprobante == nro)
                    .Where(c => c.Estado == CompraEstado.Confirmada)
                    .Get();

                var otra = rep.Models?.FirstOrDefault(c => compra == null || c.Id != compra.Id);
                if (otra != null)
                    avisoRepetida = $"\nATENCIÓN: ya se confirmó la boleta {nro} de este proveedor el {otra.Fecha.ToLocalTime():dd/MM/yyyy}. ¿Seguro que no es la misma?";
            }
            catch { /* el control es un aviso, no debe frenar la carga */ }
        }

        var mensaje = $"Se suma stock a {cantidadItems} productos ({unidades} unidades) y se actualizan costo y precios en {cantidadItems - sinCosto}.";
        if (sinCosto > 0) mensaje += $"\n{sinCosto} sin costo: solo suman stock.";
        if (costoSinRevisar > 0) mensaje += $"\n{costoSinRevisar} con costo estimado sin revisar.";
        if (hayDiferencia) mensaje += $"\nOjo: lo cargado difiere de la boleta en ${Math.Abs(Diferencia).ToString("N2", cultura)}.";
        mensaje += avisoRepetida;

        bool aviso = hayDiferencia || costoSinRevisar > 0 || avisoRepetida != "";
        if (!await avisos.ConfirmarAsync("¿Confirmar el ingreso?", mensaje, "Confirmar ingreso", aviso ? "aviso" : "exito")) return;

        guardando = true;
        int procesados = 0;
        var idsProcesados = new List<long>();

        try
        {
            // 1. Cabecera (se crea la primera vez y después se va actualizando)
            await GuardarCabeceraAsync();

            // 2. Renglones: nuevos se insertan, existentes se actualizan, quitados se borran
            foreach (var it in items.Where(i => !i.Impactado))
            {
                var det = ArmarDetalle(it);
                if (it.DetalleId.HasValue)
                {
                    det.Id = it.DetalleId.Value;
                    await SupaClient.From<CompraMayoristaDetalle>().Update(det);
                }
                else
                {
                    var res = await SupaClient.From<CompraMayoristaDetalle>().Insert(det);
                    it.DetalleId = res.Models?.FirstOrDefault()?.Id;
                }
            }

            foreach (var idQuitado in detallesQuitados.ToList())
            {
                await SupaClient.From<CompraMayoristaDetalle>().Where(d => d.Id == idQuitado).Delete();
                detallesQuitados.Remove(idQuitado);
            }

            // 3. Impacto en stock y precios (cada producto se marca al terminar: un reintento no suma dos veces)
            foreach (var it in items.Where(i => !i.Impactado).ToList())
            {
                var prod = it.Producto;
                prod.StockActual = (prod.StockActual ?? 0) + it.Cantidad;

                var query = SupaClient.From<Producto>()
                    .Where(p => p.Id == prod.Id && p.KioscoId == State.KioscoId)
                    .Set(p => p.StockActual, prod.StockActual);

                if (it.CostoPV > 0)
                {
                    prod.PrecioCosto = it.CostoPV;
                    prod.UtilidadPV = it.UtilidadPV;
                    prod.PrecioVenta = it.PrecioVentaCalculado;
                    prod.UtilidadLista2 = it.UtilidadLista2;
                    prod.PrecioLista2 = it.PrecioVentaLista2Calculado;

                    query = query
                        .Set(p => p.PrecioCosto, prod.PrecioCosto)
                        .Set(p => p.UtilidadPV, prod.UtilidadPV)
                        .Set(p => p.PrecioVenta, prod.PrecioVenta)
                        .Set(p => p.UtilidadLista2, prod.UtilidadLista2)
                        .Set(p => p.PrecioLista2, prod.PrecioLista2);
                }

                await query.Update();
                it.Impactado = true;
                procesados++;
                idsProcesados.Add(prod.Id);
            }

            // 4. Cierre: renglones procesados, cabecera confirmada, pedido recibido
            var idCompra = compra!.Id;
            await SupaClient.From<CompraMayoristaDetalle>()
                .Where(d => d.CompraId == idCompra)
                .Set(d => d.Procesado, true)
                .Update();

            compra.Estado = CompraEstado.Confirmada;
            compra.Procesado = true;
            compra.FechaConfirmada = DateTime.UtcNow;
            compra.TotalCompra = TotalCompra;
            await SupaClient.From<CompraMayorista>().Update(compra);

            if (pedidoOrigen != null)
            {
                var idPedido = pedidoOrigen.Id;
                await SupaClient.From<ListaPedido>().Where(p => p.Id == idPedido).Set(p => p.Estado, "Recibido").Update();
            }
        }
        catch (Exception ex)
        {
            guardando = false;
            await avisos.InformarAsync("La compra quedó a medias",
                $"Se guardaron {procesados} producto(s) y quedaron marcados como \"Guardado\". Podés volver a tocar \"Confirmar ingreso\": solo se procesan los que faltan, sin sumar dos veces.\n\nDetalle: {ex.Message}",
                "peligro");
            return;
        }

        // Todo guardado
        var totalGuardado = TotalCompra;
        var cantidadGuardada = items.Count;
        var provCompra = proveedorId;
        var itemsGuardados = items.ToList();

        guardando = false;
        await AsociarProveedorYCodigosAsync(provCompra, itemsGuardados);

        Reiniciar();
        vista = VistaInicio;
        panel = "";
        await CargarOrigenesAsync();
        await OnConfirmada.InvokeAsync();

        _ = avisos.GuardadoAsync($"Ingreso confirmado: {cantidadGuardada} productos por ${totalGuardado.ToString("N2", cultura)}");
    }

    private async Task GuardarCabeceraAsync()
    {
        var nro = numeroComprobante?.Trim();

        if (compra == null)
        {
            compra = new CompraMayorista
            {
                KioscoId = State.KioscoId,
                Fecha = DateTime.UtcNow,
                Origen = origen,
                Estado = CompraEstado.EnCurso,
                Procesado = false,
                PedidoId = pedidoOrigen?.Id
            };
        }

        compra.ProveedorId = proveedorId > 0 ? proveedorId : null;
        compra.NumeroComprobante = string.IsNullOrEmpty(nro) ? null : nro;
        compra.FechaCompra = fechaCompra;
        compra.TotalBoleta = HayTotalBoleta ? totalBoleta : null;
        compra.TotalCompra = TotalCompra;

        if (compra.Id == 0)
        {
            var res = await SupaClient.From<CompraMayorista>().Insert(compra);
            compra = res.Models.First();
        }
        else
        {
            await SupaClient.From<CompraMayorista>().Update(compra);
        }
    }

    private CompraMayoristaDetalle ArmarDetalle(ItemRecepcion it) => new CompraMayoristaDetalle
    {
        CompraId = compra!.Id,
        ProductoId = it.Producto.Id,
        CodigoBarras = it.Producto.CodigoBarras,
        NombreProducto = it.Producto.Nombre ?? "",
        PrecioCosto = it.CostoPV,
        Cantidad = it.Cantidad,
        Subtotal = it.SubtotalCosto,
        EsNuevo = false,
        Procesado = false,
        CodigoBarrasProveedor = string.IsNullOrWhiteSpace(it.CodigoProveedor) ? null : it.CodigoProveedor.Trim(),
        CostoAnterior = it.CostoAnterior,
        CantidadPedida = it.CantidadPedida,
        UnidadesPorBulto = it.PorBulto && it.UnidadesPorBulto > 1 ? it.UnidadesPorBulto : 1
    };

    /// <summary>
    /// Vincula el proveedor con cada producto (si todavía no estaban asociados) y guarda el código que usa el proveedor.
    /// No pisa un código que ya existía.
    /// </summary>
    private async Task AsociarProveedorYCodigosAsync(long idProveedor, List<ItemRecepcion> guardados)
    {
        if (idProveedor <= 0 || !guardados.Any()) return;

        try
        {
            long prov = idProveedor;
            var res = await SupaClient.From<ProductoProveedor>()
                .Where(r => r.IdProveedor == prov)
                .Where(r => r.IdKiosco == State.KioscoId)
                .Get();

            var existentes = (res.Models ?? new List<ProductoProveedor>())
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => g.First());

            var nuevas = new List<ProductoProveedor>();
            foreach (var it in guardados)
            {
                var codigo = string.IsNullOrWhiteSpace(it.CodigoProveedor) ? null : it.CodigoProveedor.Trim();
                int bulto = it.PorBulto && it.UnidadesPorBulto > 1 ? it.UnidadesPorBulto : 1;

                if (!existentes.TryGetValue(it.Producto.Id, out var rel))
                {
                    nuevas.Add(new ProductoProveedor
                    {
                        IdProducto = it.Producto.Id,
                        IdProveedor = idProveedor,
                        IdKiosco = State.KioscoId,
                        CodigoBarrasProveedor = codigo,
                        Habilitado = true,
                        UnidadesPorBulto = bulto
                    });
                    continue;
                }

                // Se compró por bulto y el proveedor tenía otro tamaño de bulto (o ninguno): se recuerda el nuevo
                if (bulto > 1 && rel.UnidadesPorBulto != bulto)
                {
                    long pidB = it.Producto.Id;
                    await SupaClient.From<ProductoProveedor>()
                        .Where(r => r.IdProveedor == prov)
                        .Where(r => r.IdProducto == pidB)
                        .Where(r => r.IdKiosco == State.KioscoId)
                        .Set(r => r.UnidadesPorBulto, bulto)
                        .Update();
                }
                if (codigo != null && string.IsNullOrWhiteSpace(rel.CodigoBarrasProveedor))
                {
                    long pid = it.Producto.Id;
                    await SupaClient.From<ProductoProveedor>()
                        .Where(r => r.IdProveedor == prov)
                        .Where(r => r.IdProducto == pid)
                        .Where(r => r.IdKiosco == State.KioscoId)
                        .Set(r => r.CodigoBarrasProveedor, codigo)
                        .Update();
                }
            }

            if (nuevas.Any())
                await SupaClient.From<ProductoProveedor>().Insert(nuevas);
        }
        catch (Exception ex)
        {
            // El stock y los precios ya quedaron guardados; solo falló la asociación
            await avisos.InformarAsync("La compra se guardó", "No se pudo asociar el proveedor y sus códigos a los productos: " + ex.Message, "aviso");
        }
    }

    public class ItemRecepcion
    {
        public Producto Producto { get; set; } = new();
        public int Cantidad { get; set; } = 1;
        public int? CantidadPedida { get; set; }
        public decimal CostoPV { get; set; }
        public decimal UtilidadPV { get; set; }
        public decimal PrecioVentaCalculado { get; set; }
        public decimal UtilidadLista2 { get; set; }
        public decimal PrecioVentaLista2Calculado { get; set; }
        public string? CodigoProveedor { get; set; }

        // Compra por bulto (Cantidad y CostoPV siguen siendo por unidad)
        public bool PorBulto { get; set; }
        public int UnidadesPorBulto { get; set; } = 1;
        public int Bultos { get; set; }

        // Estado del renglón
        public bool EsEstimado { get; set; }        // el costo viene de una estimación (pedido / calculadora)
        public bool CostoEditado { get; set; }      // el usuario ya lo revisó
        public long? DetalleId { get; set; }        // renglón ya guardado en la base
        public bool Impactado { get; set; }         // stock y precios ya actualizados

        // Valores que tenía el producto antes de esta compra (para mostrar "Ant:")
        public int StockAnterior { get; set; }
        public decimal CostoAnterior { get; set; }
        public decimal UtilidadAnterior { get; set; }
        public decimal UtilidadL2Anterior { get; set; }
        public string PrecioVentaAntes { get; set; } = "";
        public string PrecioL2Antes { get; set; } = "";

        public decimal SubtotalCosto =>
            Producto.IsMedidaGramos()
                ? (Cantidad / 1000m) * CostoPV
                : Cantidad * CostoPV;
    }
