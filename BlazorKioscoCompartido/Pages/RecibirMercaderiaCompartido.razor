@code {
    private const string VistaInicio = "inicio";
    private const string VistaEditor = "editor";

    /// <summary>Abre directo el editor con este pedido (botón "Recibir" del Gestor de pedidos).</summary>
    [Parameter] public long? PedidoIdInicial { get; set; }
    /// <summary>Abre directo el editor con esta lista cerrada de la calculadora.</summary>
    [Parameter] public long? CompraIdInicial { get; set; }
    /// <summary>Se confirmó una compra (la página principal refresca contadores).</summary>
    [Parameter] public EventCallback OnConfirmada { get; set; }

    private AvisosPagina avisos = default!;
    private readonly CultureInfo cultura = CultureInfo.GetCultureInfo("es-AR");

    // Navegación interna
    private string vista = VistaInicio;
    private string panel = "";
    private bool cargandoOrigenes = true;

    // Orígenes disponibles
    private List<ListaPedido> pedidosPorRecibir = new();
    private List<CompraMayorista> listasCerradas = new();
    private List<Proveedor> listaProveedores = new();

    // Compra en edición
    private string origen = CompraOrigen.Boleta;
    private CompraMayorista? compra;             // cabecera ya guardada (lista de calculadora, o una que se empezó a guardar)
    private ListaPedido? pedidoOrigen;
    private decimal estimadoOrigen;
    private List<ItemRecepcion> items = new();
    private List<long> detallesQuitados = new();

    private long proveedorId = 0;
    private string numeroComprobante = "";
    private DateTime fechaCompra = DateTime.Today;
    private decimal? totalBoleta;
    private bool mostrarPrecios = true;
    private bool guardando = false;
    private string nombreLista2 = "";

    // Relaciones producto <-> proveedor elegido
    private Dictionary<long, string?> relacionesProveedor = new();
    private Dictionary<long, int> bultosProveedor = new();     // producto → unidades que trae el bulto de este proveedor
    private string codigoProvInput = "";
    private string? codigoProvPendiente;

    // Alta rápida
    private bool mostrarModalNuevoProducto = false;
    private bool guardandoNuevo = false;
    private Producto nuevoProducto = new();

    // Foco al agregar
    private ElementReference refCantidadUltima;
    private bool enfocarUltimo;

    private decimal TotalCompra => items.Sum(i => i.SubtotalCosto);
    private bool HayTotalBoleta => totalBoleta.HasValue && totalBoleta.Value > 0;
    private decimal Diferencia => TotalCompra - (totalBoleta ?? 0m);

    private string TextoOrigen => origen switch
    {
        CompraOrigen.Pedido => $"Recibiendo el pedido \"{(string.IsNullOrWhiteSpace(pedidoOrigen?.NombreListado) ? "sin nombre" : pedidoOrigen!.NombreListado)}\". Corregí cantidades y costos con lo que dice la boleta; podés agregar o quitar productos.",
        CompraOrigen.Calculadora => "Lista de la calculadora (costos estimados). Completá los datos de la boleta si la tenés y revisá los costos.",
        CompraOrigen.Excel => "Factura importada desde Excel. Revisá cantidades y costos; al confirmar se suma el stock y se actualizan los precios.",
        _ => "Boleta nueva. Cargá los productos como figuran en el papel."
    };

    // ======================= INICIO =======================

    protected override async Task OnInitializedAsync()
    {
        await PrecioServ.AsegurarReglasAsync(State.KioscoId);   // recargos de la Lista 2 del negocio
        try { nombreLista2 = await PrecioServ.ObtenerNombreColumnaAsync(State.KioscoId, "precio_lista2"); }
        catch { nombreLista2 = ""; }

        await CargarOrigenesAsync();

        if (PedidoIdInicial.HasValue)
        {
            var p = pedidosPorRecibir.FirstOrDefault(x => x.Id == PedidoIdInicial.Value);
            if (p != null) await AbrirPedidoAsync(p);
        }
        else if (CompraIdInicial.HasValue)
        {
            var c = listasCerradas.FirstOrDefault(x => x.Id == CompraIdInicial.Value);
            if (c != null) await AbrirListaAsync(c);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (enfocarUltimo)
        {
            enfocarUltimo = false;
            try { await refCantidadUltima.FocusAsync(); } catch { /* sin foco no pasa nada */ }
        }
    }

    private async Task CargarOrigenesAsync()
    {
        try
        {
            cargandoOrigenes = true;
            long kiosco = State.KioscoId;

            var resProv = await SupaClient.From<Proveedor>().Where(p => p.KioscoId == kiosco).Get();
            listaProveedores = resProv.Models ?? new List<Proveedor>();

            var resPed = await SupaClient.From<ListaPedido>()
                .Where(p => p.KioscoId == kiosco)
                .Filter(p => p.Estado, Supabase.Postgrest.Constants.Operator.In, new List<object> { "Enviado", "Pendiente" })
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(60)
                .Get();
            pedidosPorRecibir = (resPed.Models ?? new List<ListaPedido>())
                .OrderByDescending(p => p.Estado == "Enviado")
                .ThenByDescending(p => p.Fecha)
                .ToList();

            var resListas = await SupaClient.From<CompraMayorista>()
                .Where(c => c.KioscoId == kiosco)
                .Where(c => c.Estado == CompraEstado.Cerrada)
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(60)
                .Get();
            listasCerradas = resListas.Models ?? new List<CompraMayorista>();
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron cargar los pedidos y listas", ex.Message, "peligro");
        }
        finally
        {
            cargandoOrigenes = false;
        }
    }

    private string NombreProveedor(long id) => listaProveedores.FirstOrDefault(p => p.Id == id)?.Nombre ?? "Proveedor N/D";

    private static bool EsSinProveedor(Proveedor p) =>
        string.Equals(p.Nombre?.Trim(), "SIN PROVEEDOR", StringComparison.OrdinalIgnoreCase);

    private void Reiniciar()
    {
        compra = null;
        pedidoOrigen = null;
        estimadoOrigen = 0;
        items = new();
        detallesQuitados = new();
        proveedorId = 0;
        numeroComprobante = "";
        fechaCompra = DateTime.Today;
        totalBoleta = null;
        relacionesProveedor = new();
        codigoProvInput = "";
        codigoProvPendiente = null;
        origen = CompraOrigen.Boleta;
    }

    private void NuevaBoleta()
    {
        Reiniciar();
        origen = CompraOrigen.Boleta;
        panel = "boleta";
        vista = VistaEditor;
    }

    private async Task VolverAlInicioAsync()
    {
        if (items.Any(i => !i.Impactado) && origen == CompraOrigen.Boleta)
        {
            if (!await avisos.ConfirmarAsync("¿Descartar lo cargado?", "La boleta todavía no se guardó: si volvés, se pierde lo que cargaste.", "Descartar")) return;
        }

        Reiniciar();
        vista = VistaInicio;
        panel = "";
        await CargarOrigenesAsync();
    }

    // ======================= ABRIR UN PEDIDO / UNA LISTA =======================

    private async Task<List<Producto>> CargarProductosPorIdsAsync(List<long> ids)
    {
        var lista = new List<Producto>();
        foreach (var tanda in ids.Chunk(100))
        {
            var criterio = tanda.Cast<object>().ToList();
            var res = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Filter(p => p.Id, Supabase.Postgrest.Constants.Operator.In, criterio)
                .Get();
            lista.AddRange(res.Models);
        }
        return lista;
    }

    private async Task AbrirPedidoAsync(ListaPedido pedido)
    {
        try
        {
            var idPedido = pedido.Id;
            var res = await SupaClient.From<ListaPedidoDetalle>().Where(d => d.PedidoId == idPedido).Get();
            var detalles = res.Models ?? new List<ListaPedidoDetalle>();

            var ids = detalles.Select(d => (long?)d.ProductoId).Where(x => x.HasValue && x.Value > 0).Select(x => x!.Value).Distinct().ToList();
            var productos = await CargarProductosPorIdsAsync(ids);

            Reiniciar();
            origen = CompraOrigen.Pedido;
            pedidoOrigen = pedido;
            estimadoOrigen = pedido.MontoEstimado;

            var provPedido = listaProveedores.FirstOrDefault(p => p.Id == pedido.ProveedorId);
            proveedorId = (provPedido != null && !EsSinProveedor(provPedido)) ? pedido.ProveedorId : 0;
            if (proveedorId > 0) await CargarRelacionesProveedorAsync();

            int omitidos = 0;
            foreach (var d in detalles)
            {
                var prod = productos.FirstOrDefault(p => p.Id == d.ProductoId);
                if (prod == null) { omitidos++; continue; }

                int cant = (int)Math.Round(d.CantidadComprar, MidpointRounding.AwayFromZero);
                if (cant < 1) cant = 1;

                // si se pidió por bulto: cantidad en bultos y costo del bulto → se pasan a unidades
                int nPedido = d.UnidadesPorBulto > 1 && !prod.EsVentaPorPeso() ? d.UnidadesPorBulto : 1;
                int unidades = cant * nPedido;
                decimal costoUnidad = nPedido > 1 ? Math.Round(d.PrecioCosto / nPedido, 4) : d.PrecioCosto;

                var item = ConstruirItem(prod, unidades, costoUnidad, estimado: true, cantidadPedida: unidades);
                item.CodigoProveedor = !string.IsNullOrWhiteSpace(d.CodigoBarrasProveedor) ? d.CodigoBarrasProveedor : CodigoRelacion(prod.Id);
                AplicarBulto(item, nPedido > 1 ? nPedido : BultoRelacion(prod.Id), soloSiExacto: true);
                items.Add(item);
            }

            vista = VistaEditor;
            if (omitidos > 0)
                await avisos.InformarAsync("Algunos productos no se trajeron", $"{omitidos} producto(s) del pedido ya no existen en el sistema.", "aviso");
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo abrir el pedido", ex.Message, "peligro");
        }
    }

    private async Task AbrirListaAsync(CompraMayorista lista)
    {
        try
        {
            var idCompra = lista.Id;
            var res = await SupaClient.From<CompraMayoristaDetalle>().Where(d => d.CompraId == idCompra).Get();
            var detalles = res.Models ?? new List<CompraMayoristaDetalle>();

            var ids = detalles.Where(d => d.ProductoId.HasValue && d.ProductoId.Value > 0).Select(d => d.ProductoId!.Value).Distinct().ToList();
            var productos = await CargarProductosPorIdsAsync(ids);

            Reiniciar();
            origen = lista.Origen ?? CompraOrigen.Calculadora;
            compra = lista;
            estimadoOrigen = lista.TotalCompra;
            proveedorId = lista.ProveedorId ?? 0;
            numeroComprobante = lista.NumeroComprobante ?? "";
            fechaCompra = lista.FechaCompra ?? DateTime.Today;
            totalBoleta = lista.TotalBoleta;
            if (proveedorId > 0) await CargarRelacionesProveedorAsync();

            int omitidos = 0;
            foreach (var d in detalles)
            {
                var prod = productos.FirstOrDefault(p => p.Id == d.ProductoId);
                if (prod == null) { omitidos++; continue; }

                // El costo de un Excel es el real de la factura; el de la calculadora es una estimación
                var item = ConstruirItem(prod, d.Cantidad, d.PrecioCosto, estimado: lista.Origen != CompraOrigen.Excel, cantidadPedida: d.CantidadPedida);
                item.DetalleId = d.Id;
                item.CodigoProveedor = !string.IsNullOrWhiteSpace(d.CodigoBarrasProveedor) ? d.CodigoBarrasProveedor : CodigoRelacion(prod.Id);
                AplicarBulto(item, d.UnidadesPorBulto > 1 ? d.UnidadesPorBulto : BultoRelacion(prod.Id), soloSiExacto: true);
                items.Add(item);
            }

            vista = VistaEditor;
            if (omitidos > 0)
                await avisos.InformarAsync("Algunos productos no se trajeron", $"{omitidos} renglón(es) no tenían un producto asociado y quedaron afuera. Podés agregarlos a mano.", "aviso");
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo abrir la lista", ex.Message, "peligro");
        }
    }

    // ======================= PROVEEDOR Y SUS CÓDIGOS =======================

    private async Task OnProveedorChanged(ChangeEventArgs e)
    {
        proveedorId = long.TryParse(e.Value?.ToString(), out long id) ? id : 0;
        codigoProvPendiente = null;
        relacionesProveedor = new();
        bultosProveedor = new();

        if (proveedorId > 0) await CargarRelacionesProveedorAsync();

        // Se completan los códigos (y el bulto) del proveedor nuevo en los productos ya cargados
        foreach (var it in items.Where(i => !i.Impactado))
        {
            it.CodigoProveedor = CodigoRelacion(it.Producto.Id);
            if (!it.PorBulto) AplicarBulto(it, BultoRelacion(it.Producto.Id), soloSiExacto: false);
        }
    }

    private async Task CargarRelacionesProveedorAsync()
    {
        try
        {
            long prov = proveedorId;
            var todas = new List<ProductoProveedor>();
            const int pagina = 1000;   // la base devuelve como máximo 1000 filas por consulta
            for (int desde = 0; ; desde += pagina)
            {
                var res = await SupaClient.From<ProductoProveedor>()
                    .Where(r => r.IdProveedor == prov)
                    .Where(r => r.IdKiosco == State.KioscoId)
                    .Range(desde, desde + pagina - 1)
                    .Get();
                var lote = res.Models ?? new List<ProductoProveedor>();
                todas.AddRange(lote);
                if (lote.Count < pagina) break;
            }

            relacionesProveedor = todas
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => g.First().CodigoBarrasProveedor);

            bultosProveedor = todas
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => Math.Max(1, g.First().UnidadesPorBulto));
        }
        catch (Exception ex)
        {
            relacionesProveedor = new();
            bultosProveedor = new();
            await avisos.InformarAsync("No se pudieron cargar los productos del proveedor", ex.Message, "aviso");
        }
    }

    private int BultoRelacion(long productoId) =>
        bultosProveedor.TryGetValue(productoId, out var n) && n > 1 ? n : 1;

    private string? CodigoRelacion(long productoId) =>
        relacionesProveedor.TryGetValue(productoId, out var cod) && !string.IsNullOrWhiteSpace(cod) ? cod : null;

    private async Task OnCodigoProvKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await BuscarPorCodigoProveedorAsync();
    }

    /// <summary>Busca por el código que usa el proveedor (el que trae la boleta).</summary>
    private async Task BuscarPorCodigoProveedorAsync()
    {
        var codigo = codigoProvInput?.Trim();
        if (string.IsNullOrEmpty(codigo)) return;

        var par = relacionesProveedor.FirstOrDefault(kv => string.Equals(kv.Value?.Trim(), codigo, StringComparison.OrdinalIgnoreCase));
        codigoProvInput = "";

        if (par.Key == 0)
        {
            // No está asociado: se recuerda el código y se lo asigna al próximo producto que se elija
            codigoProvPendiente = codigo;
            avisos.Toast("Código nuevo para este proveedor: elegí el producto", "info", 3500);
            return;
        }

        try
        {
            long pid = par.Key;
            var res = await SupaClient.From<Producto>()
                .Where(p => p.Id == pid)
                .Where(p => p.KioscoId == State.KioscoId)
                .Get();

            var prod = res.Models?.FirstOrDefault();
            if (prod != null) AgregarProducto(prod);
            else await avisos.InformarAsync("Producto no encontrado", "El producto asociado a ese código ya no existe.", "aviso");
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo buscar el producto", ex.Message, "peligro");
        }
    }

    // ======================= ÍTEMS =======================

    private ItemRecepcion ConstruirItem(Producto prod, int cantidad, decimal costo, bool estimado, int? cantidadPedida)
    {
        // Los valores "anteriores" se guardan ANTES de recalcular (el recálculo modifica el producto en memoria)
        var item = new ItemRecepcion
        {
            Producto = prod,
            Cantidad = cantidad < 1 ? 1 : cantidad,
            CantidadPedida = cantidadPedida,
            CostoPV = costo,
            UtilidadPV = prod.UtilidadPV ?? 40m,
            UtilidadLista2 = prod.UtilidadLista2 ?? 0m,
            EsEstimado = estimado,

            StockAnterior = prod.StockActual ?? 0,
            CostoAnterior = prod.PrecioCosto ?? 0m,
            UtilidadAnterior = prod.UtilidadPV ?? 0m,
            UtilidadL2Anterior = prod.UtilidadLista2 ?? 0m,
            PrecioVentaAntes = Convert.ToString(prod.ObtenerPrecioVentaMostrar("Principal", State, cultura), cultura) ?? "",
            PrecioL2Antes = nombreLista2 != "" ? Convert.ToString(prod.ObtenerPrecioVentaMostrar("Lista2", State, cultura), cultura) ?? "" : ""
        };

        if (costo > 0) RecalcularPrecios(item);
        return item;
    }

    private void AgregarProducto(Producto prod)
    {
        var existente = items.FirstOrDefault(i => i.Producto.Id == prod.Id);
        if (existente != null)
        {
            if (!existente.Impactado)
            {
                if (existente.PorBulto) { existente.Bultos++; existente.Cantidad = existente.Bultos * existente.UnidadesPorBulto; }
                else existente.Cantidad++;
            }
            if (!string.IsNullOrEmpty(codigoProvPendiente) && string.IsNullOrWhiteSpace(existente.CodigoProveedor))
            {
                existente.CodigoProveedor = codigoProvPendiente;
                codigoProvPendiente = null;
            }
            avisos.Toast(existente.PorBulto
                ? $"{prod.Nombre}: ya estaba, ahora son {existente.Bultos} bultos ({existente.Cantidad} u.)"
                : $"{prod.Nombre}: ya estaba, ahora son {existente.Cantidad}", "info", 2200);
            return;
        }

        var item = ConstruirItem(prod, 1, prod.PrecioCosto ?? 0m, estimado: false, cantidadPedida: null);
        item.CodigoProveedor = CodigoRelacion(prod.Id);
        AplicarBulto(item, BultoRelacion(prod.Id), soloSiExacto: false);   // si el proveedor lo vende por bulto, arranca en 1 bulto

        if (!string.IsNullOrEmpty(codigoProvPendiente))
        {
            item.CodigoProveedor = codigoProvPendiente;
            codigoProvPendiente = null;
        }

        items.Add(item);
        enfocarUltimo = true;
    }

    private void ActualizarCantidad(ItemRecepcion item, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int val) || val <= 0) return;

        if (item.PorBulto)
        {
            item.Bultos = val;
            item.Cantidad = val * item.UnidadesPorBulto;
        }
        else item.Cantidad = val;
    }

    // ======================= BULTOS =======================
    // Cantidad y CostoPV del renglón SIEMPRE quedan por unidad (lo que se suma al stock y lo que se guarda como costo).
    // En modo bulto solo cambia lo que se muestra y se escribe: cantidad de bultos y costo del bulto.

    /// <summary>Pasa el renglón a "por bulto" con n unidades por bulto. soloSiExacto: solo si la cantidad actual entra justa en bultos.</summary>
    private void AplicarBulto(ItemRecepcion item, int n, bool soloSiExacto)
    {
        if (n <= 1 || item.Impactado || item.Producto.EsVentaPorPeso()) return;

        if (soloSiExacto)
        {
            if (item.Cantidad % n != 0) return;
            item.Bultos = item.Cantidad / n;
        }
        else
        {
            item.Bultos = Math.Max(1, (int)Math.Round(item.Cantidad / (decimal)n, MidpointRounding.AwayFromZero));
        }

        item.UnidadesPorBulto = n;
        item.PorBulto = true;
        item.Cantidad = item.Bultos * n;
    }

    private void CambiarModo(ItemRecepcion item, bool porBulto)
    {
        if (item.Impactado || item.PorBulto == porBulto) return;

        if (porBulto)
        {
            var n = item.UnidadesPorBulto > 1 ? item.UnidadesPorBulto : BultoRelacion(item.Producto.Id);
            item.UnidadesPorBulto = n;
            item.PorBulto = true;
            item.Bultos = n > 1 ? Math.Max(1, (int)Math.Round(item.Cantidad / (decimal)n, MidpointRounding.AwayFromZero)) : Math.Max(1, item.Cantidad);
            item.Cantidad = item.Bultos * n;
            if (n <= 1) avisos.Toast("Completá cuántas unidades trae el bulto", "info", 2500);
        }
        else
        {
            item.PorBulto = false;   // la cantidad en unidades queda igual
        }
    }

    private void CambiarUnidadesBulto(ItemRecepcion item, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int n) || n < 1) return;

        // Lo que el usuario copió de la boleta es el costo del bulto: se mantiene y se reparte entre las nuevas unidades
        var costoBulto = item.CostoPV * item.UnidadesPorBulto;
        item.UnidadesPorBulto = n;
        item.Cantidad = item.Bultos * n;
        if (costoBulto > 0)
        {
            item.CostoPV = Math.Round(costoBulto / n, 4);
            AlCambiarCosto(item);
        }
    }

    /// <summary>Costo que se muestra en el input: el del bulto o el de la unidad (formato con punto para el input numérico).</summary>
    private string CostoMostrar(ItemRecepcion item)
    {
        var v = item.PorBulto ? item.CostoPV * item.UnidadesPorBulto : item.CostoPV;
        return Plata.Texto(Math.Round(v, 2));   // 3.000 · 1.500,50
    }

    private void ActualizarCosto(ItemRecepcion item, ChangeEventArgs e)
    {
        if (!Plata.TryLeer(e.Value, out decimal v) || v < 0) return;
        item.CostoPV = item.PorBulto && item.UnidadesPorBulto > 1 ? Math.Round(v / item.UnidadesPorBulto, 4) : v;
        AlCambiarCosto(item);
    }

    private void AlCambiarCosto(ItemRecepcion item)
    {
        item.CostoEditado = true;
        RecalcularPrecios(item);
    }

    private void ActualizarPrecioVenta(ItemRecepcion item, ChangeEventArgs e)
    {
        if (Plata.TryLeer(e.Value, out decimal val))
            item.PrecioVentaCalculado = item.Producto.PrecioCada100g() ? val * 10m : val;
    }

    private void ActualizarPrecioLista2(ItemRecepcion item, ChangeEventArgs e)
    {
        if (Plata.TryLeer(e.Value, out decimal val))
            item.PrecioVentaLista2Calculado = item.Producto.PrecioCada100g() ? val * 10m : val;
    }

    private void RecalcularPrecios(ItemRecepcion item)
    {
        if (item.CostoPV <= 0) return;

        bool igual = PrecioService.EraMismoPrecioDiaNoche(item.Producto);   // gomitas: mismo precio de día y de noche
        // Costo y utilidad al modelo temporal del producto para que el servicio pueda calcular
        item.Producto.PrecioCosto = item.CostoPV;
        item.Producto.UtilidadPV = item.UtilidadPV;

        item.PrecioVentaCalculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, item.UtilidadPV, State) ?? 0m;
        item.Producto.PrecioVenta = item.PrecioVentaCalculado;

        // Lista 2 automática (reglas del kiosco / recargos sobre el precio de venta)
        PrecioService.ProcesarLista2Automatico(item.Producto, State.KioscoId, State, igual);

        item.UtilidadLista2 = item.Producto.UtilidadLista2 ?? 0m;
        item.PrecioVentaLista2Calculado = item.Producto.PrecioLista2 ?? 0m;
    }

    private void EliminarItem(ItemRecepcion item)
    {
        items.Remove(item);
        if (item.DetalleId.HasValue) detallesQuitados.Add(item.DetalleId.Value);
    }

    private decimal? ObtenerPrecioCalculadoMostrar(Producto prod, decimal precioCalculado)
    {
        if (precioCalculado == 0m) return null;
        return prod.PrecioCada100g() ? precioCalculado / 10m : precioCalculado;
    }

