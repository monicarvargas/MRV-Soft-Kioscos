@using BlazorKioscoCompartido.Constants
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Components
@inject Supabase.Client SupaClient
@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State
@inject PrecioService PrecioServ
@using System.Globalization

<PedidosEstilos />
<ConfigEstilos />
<ProductoEstilos />
<AvisosPagina @ref="avisos" />
<AltaRapida @ref="altaFamilia" OnCreado="FamiliaCreada" />
<AltaRapida @ref="altaProveedor" OnCreado="ProveedorCreado" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Nuevo producto"
                      Subtitulo="Cargá un artículo nuevo al sistema"
                      IconoClass="bi-plus-circle-fill"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    <div class="pp-wrap pp-stack">

        @if (origen != null)
        {
            <div class="gp-banner" style="margin:0">
                <i class="bi bi-copy"></i>
                <p>Variante de <b>@origen.Nombre</b>: se copiaron los precios, la familia y los proveedores. Cambiá el <b>nombre</b> (aroma, color, sabor...) y escaneá el <b>código</b> de esta variante.</p>
            </div>
        }

        @* ================= DATOS DEL ARTÍCULO ================= *@
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head">
                <span class="gp-bubble"><i class="bi bi-box-seam-fill"></i></span>
                <div class="cf-head-text">
                    <h2>Datos del artículo</h2>
                    <p>Si escaneás un código que ya existe, te ofrezco abrirlo para editar.</p>
                </div>
            </div>

            <div class="cf-grid">
                <div>
                    <label class="cf-lbl">Código de barras</label>
                    <div class="pp-cod-fila">
                        <div class="pp-icon-input pp-codigo">
                            <i class="bi bi-upc-scan"></i>
                            <input type="text" class="gp-control" placeholder="Escaneá o escribí"
                                   value="@producto.CodigoBarras" @onchange="BuscarProductoPorCodigo" />
                        </div>
                        <BotonCamara OnCodigo="CodigoDeCamaraAsync" />
                    </div>
                    @if (string.IsNullOrWhiteSpace(producto.CodigoBarras))
                    {
                        <button type="button" class="pp-crear-cod" disabled="@creandoCodigo" @onclick="CrearCodigoPropio"
                                title="Para productos sueltos que no traen código (gomitas, fiambre...). Después imprimís la etiqueta en Carteles → Códigos de barras.">
                            <i class="bi bi-magic"></i> @(creandoCodigo ? "Creando..." : "No tiene: crear un código")
                        </button>
                    }
                </div>
                <div class="cf-col-2 pp-nombre">
                    <label class="cf-lbl">Descripción / nombre *</label>
                    <input type="text" class="gp-control" placeholder="Ej: Alfajor Milka 55g" @bind="producto.Nombre" />
                </div>

                <div>
                    <label class="cf-lbl">Familia / categoría</label>
                    <div class="sf-fila">
                        <select class="gp-control" @bind="producto.FamiliaId" @bind:after="CambioFamilia">
                            <option value="0">-- Elegí --</option>
                            @foreach (var fam in familias)
                            {
                                <option value="@fam.Id">@fam.Nombre</option>
                            }
                        </select>
                        <button type="button" class="gp-btn gp-btn-soft gp-btn-icon" title="Nueva familia" @onclick="() => altaFamilia.Abrir(AltaRapida.Tipo.Familia)"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
                <SelectorSubfamilia FamiliaId="producto.FamiliaId" FamiliaNombre="@(familias.FirstOrDefault(f => f.Id == producto.FamiliaId)?.Nombre)" @bind-Value="producto.SubfamiliaId" @bind-Value:after="CambioGrupo" />
                <div>
                    <label class="cf-lbl">Proveedor principal</label>
                    <div class="sf-fila">
                        <select class="gp-control" @bind="producto.ProveedorId">
                            <option value="0">-- Elegí --</option>
                            @foreach (var prov in proveedores)
                            {
                                <option value="@prov.Id">@prov.Nombre</option>
                            }
                        </select>
                        <button type="button" class="gp-btn gp-btn-soft gp-btn-icon" title="Nuevo proveedor" @onclick="() => altaProveedor.Abrir(AltaRapida.Tipo.Proveedor)"><i class="bi bi-plus-lg"></i></button>
                    </div>
                </div>
                <div>
                    <label class="cf-lbl">Marca</label>
                    <input type="text" class="gp-control" placeholder="Ej: Terrabusi" @bind="producto.Marca" />
                </div>

                <div class="cf-col-full">
                    <label class="cf-lbl">Se vende por</label>
                    <div class="gp-seg pp-units" role="group" aria-label="Unidad de medida">
                        @foreach (var unidad in Unidades.ParaElegir(State.UnidadesNegocio, producto.UnidadMedida))
                        {
                            <button type="button" class="@(EsUnidad(unidad) ? "is-active" : "")" @onclick="() => CambiarUnidad(unidad)">
                                <i class="bi @IconoUnidad(unidad)"></i> @TextoUnidad(unidad)
                            </button>
                        }
                    </div>
                    @if (producto.IsMedidaKilos())
                    {
                        <div class="gp-hint" style="margin-top:.55rem"><i class="bi bi-info-circle-fill"></i> El costo y los precios de venta van <b>por kilo</b>. Al vender se pesa en gramos.</div>
                    }
                    else if (producto.IsMedidaGramos())
                    {
                        <div class="gp-hint" style="margin-top:.55rem"><i class="bi bi-info-circle-fill"></i> El costo se carga por kilo y el precio de venta se muestra cada 100 g.</div>
                    }
                </div>
            </div>
        </section>

        @* ================= PRECIOS ================= *@
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head">
                <span class="gp-bubble"><i class="bi bi-currency-dollar"></i></span>
                <div class="cf-head-text">
                    <h2>Precios</h2>
                    <p>Cambiá el costo o la utilidad y el precio de venta se calcula solo (o al revés).</p>
                </div>
            </div>
            <PreciosProducto @ref="preciosRef" Producto="producto" OnCambio="StateHasChanged" UtilidadSugerida="UtilidadDelGrupo" GrupoSugerido="@NombreGrupo" />
        </section>

        @* ================= PRECIOS POR CANTIDAD (packs) ================= *@
        @if (listo)
        {
            <PreciosPorCantidad @ref="preciosCantRef" Producto="producto" CopiarDeProductoId="@(origen?.Id ?? 0)" />
        }

        @* ================= STOCK ================= *@
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head">
                <span class="gp-bubble"><i class="bi bi-boxes"></i></span>
                <div class="cf-head-text">
                    <h2>Stock inicial</h2>
                    <p>Cuánto tenés hoy y cuándo avisarte que se está terminando @producto.ObtenerTituloModoPesoVenta().</p>
                </div>
            </div>
            <div class="pp-stock">
                <label class="pp-tile is-main">
                    <span class="pp-tile-label"><i class="bi bi-box-fill"></i> Stock actual @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                    <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockActual" @bind:event="oninput" />
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockActual)</span> }
                    <span class="pp-help">@(hayBultos && !producto.EsVentaPorPeso() ? "Unidades sueltas que tenés ahora (no bultos)" : "La cantidad que tenés ahora")</span>
                </label>
                <label class="pp-tile">
                    <span class="pp-tile-label"><i class="bi bi-graph-down-arrow"></i> Mínimo @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                    <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockMinimo" @bind:event="oninput" />
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockMinimo)</span> }
                    <span class="pp-help">Avisar si baja de esto</span>
                </label>
                <label class="pp-tile">
                    <span class="pp-tile-label"><i class="bi bi-bullseye"></i> Ideal @if (hayBultos && !producto.EsVentaPorPeso()) { <span class="pp-xunidad">x unidad</span> }</span>
                    <input type="number" inputmode="numeric" class="pp-big" onfocus="this.select()" @bind="producto.StockIdeal" @bind:event="oninput" />
                        @if (producto.IsMedidaGramos()) { <span class="pp-kg">≈ @KgAprox(producto.StockIdeal)</span> }
                    <span class="pp-help">Si hay más de esta cantidad no pedir</span>
                </label>
            </div>
        </section>

        @* ================= PROVEEDORES ================= *@
        @if (listo)
        {
            <GestionProveedoresProducto @ref="gestionProvNuevoRef" ProductoId="@producto.Id" KioscoId="@State.KioscoId" UnidadesBultoProducto="@BultoParaProveedores" EnKilos="@producto.EsVentaPorPeso()" CopiarDeProductoId="@(origen?.Id ?? 0)" OnBultosCambio="b => hayBultos = b" />
        }
        <ProductoCreator @ref="productoCreatorRef" ProductoInput="producto" />

        @* ================= BOTONERA ================= *@
        <div class="pp-actions">
            <span class="pp-actions-info"><i class="bi bi-info-circle"></i> Los campos con * son obligatorios.</span>
            <button type="button" class="gp-btn gp-btn-outline" @onclick="Volver"><i class="bi bi-x-lg"></i> Cancelar</button>
            @if (origen != null)
            {
                <button type="button" class="gp-btn gp-btn-soft" disabled="@guardando" title="Guarda esta y abre otra variante igual para seguir cargando" @onclick="() => GuardarProducto(true)">
                    <i class="bi bi-plus-square"></i> Crear y cargar otra variante
                </button>
            }
            <button type="button" class="gp-btn gp-btn-ok" disabled="@guardando" @onclick="() => GuardarProducto(false)">
                @if (guardando)
                {
                    <span class="gp-spinner" style="width:1.1rem;height:1.1rem;border-width:2px"></span> <span>Guardando...</span>
                }
                else
                {
                    <i class="bi bi-plus-circle-fill"></i> <span>Crear producto</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? CodigoPrecargado { get; set; }
    /// <summary>Ruta de edición: "/producto/editar" en el celular, "/producto/editar-desktop" en la PC.</summary>
    [Parameter] public string RutaEditar { get; set; } = "/producto/editar";

    private AvisosPagina avisos = default!;
    private Producto producto = new();
    private Producto? origen;          // si se está creando una variante: el producto copiado
    private bool listo;                // los proveedores se cargan cuando ya se sabe si es variante
    private bool guardando;

    private List<Familia> familias = new();
    private List<Proveedor> proveedores = new();

    // ---------- Alta rápida (familia / proveedor sin ir a Configuración) ----------
    private AltaRapida altaFamilia = default!;
    private AltaRapida altaProveedor = default!;

    private void FamiliaCreada((long Id, string Nombre) f)
    {
        if (!familias.Any(x => x.Id == f.Id))
        {
            familias.Add(new Familia { Id = f.Id, KioscoId = State.KioscoId, Nombre = f.Nombre });
            familias = familias.OrderBy(x => x.Nombre).ToList();
        }
        producto.FamiliaId = f.Id;
        producto.SubfamiliaId = null;
        _ = CambioGrupo();
        avisos.Toast($"Familia {f.Nombre} lista", "exito", 1800);
    }

    // ---------- utilidad de la familia / subfamilia (Configuración → Familias, script 37) ----------
    private PreciosProducto? preciosRef;
    private List<Subfamilia> subfamiliasUtil = new();
    private decimal? utilAutomatica;   // la que se puso sola al elegir el grupo (si no se tocó, sigue al grupo)

    private decimal UtilidadDelGrupo => Subfamilia.Para(familias, subfamiliasUtil, producto?.FamiliaId, producto?.SubfamiliaId);

    private string NombreGrupo
    {
        get
        {
            var s = subfamiliasUtil.FirstOrDefault(x => x.Id == producto?.SubfamiliaId);
            if (s?.Utilidad != null) return s.Nombre;
            var f = familias.FirstOrDefault(x => x.Id == producto?.FamiliaId);
            return f?.Utilidad != null ? f.Nombre : "La general";
        }
    }

    private async Task CargarSubfamiliasUtil()
    {
        try { long k = State.KioscoId; subfamiliasUtil = (await SupaClient.From<Subfamilia>().Where(s => s.KioscoId == k).Get()).Models ?? new(); }
        catch { subfamiliasUtil = new(); }
    }

    private async Task CambioFamilia()
    {
        if (producto != null) producto.SubfamiliaId = null;
        await CambioGrupo();
    }

    /// <summary>Nuevo producto: si la utilidad no se escribió a mano, toma la del grupo elegido.</summary>
    private async Task CambioGrupo()
    {
        if (producto?.SubfamiliaId is long sid && !subfamiliasUtil.Any(s => s.Id == sid)) await CargarSubfamiliasUtil();
        if (producto == null) return;
        if ((producto.UtilidadPV ?? 0m) == 0m || producto.UtilidadPV == utilAutomatica)
        {
            var u = UtilidadDelGrupo;
            if (preciosRef != null) preciosRef.AplicarUtilidad(u); else producto.UtilidadPV = u;
            utilAutomatica = u;
        }
    }


    private void ProveedorCreado((long Id, string Nombre) p)
    {
        if (!proveedores.Any(x => x.Id == p.Id))
        {
            proveedores.Add(new Proveedor { Id = p.Id, KioscoId = State.KioscoId, Nombre = p.Nombre });
            proveedores = proveedores.OrderBy(x => x.Nombre).ToList();
        }
        producto.ProveedorId = p.Id;
        avisos.Toast($"Proveedor {p.Nombre} listo", "exito", 1800);
    }
    private CultureInfo argCulture = CultureInfo.GetCultureInfo("es-AR");

    // referencias a componentes
    private GestionProveedoresProducto? gestionProvNuevoRef;
    private PreciosPorCantidad? preciosCantRef;
    private ProductoCreator? productoCreatorRef;

    protected override async Task OnInitializedAsync()
    {
        var responseFam = await SupaClient.From<Familia>().Where(f => f.KioscoId == State.KioscoId).Get();
        familias = responseFam.Models.OrderBy(f => f.Nombre).ToList();

        producto = new Producto
        {
            KioscoId = State.KioscoId,
            CodigoBarras = CodigoPrecargado ?? "",
            FamiliaId = FamiliaPorDefecto(),
            PrecioCosto = 0,
            UtilidadPV = 0,
            PrecioVenta = 0,
            StockActual = 0,
            StockMinimo = 0,
            StockIdeal = 0,
            UnidadMedida = "UNIDAD",
            VentaxPeso = false,
            Activo = true,
        };

        var responseProv = await SupaClient.From<Proveedor>().Where(p => p.KioscoId == State.KioscoId).Get();
        proveedores = responseProv.Models.Where(p => p.EstaActivo()).OrderBy(p => p.Nombre).ToList();   // sin los dados de baja

        await CargarSubfamiliasUtil();
        producto.UtilidadPV = utilAutomatica = UtilidadDelGrupo;   // arranca con la del grupo (o 40%)

        await CargarVarianteAsync();   // una variante trae la utilidad del producto copiado
        if (origen != null) utilAutomatica = null;
        listo = true;
    }

    /// <summary>"/producto/nuevo?copiarDe=123": arranca con todo copiado del producto 123, menos el código y el stock.</summary>
    private async Task CargarVarianteAsync()
    {
        long copiarDe = 0;
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var par in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = par.Split('=', 2);
            if (kv.Length == 2 && kv[0].Equals("copiarDe", StringComparison.OrdinalIgnoreCase)) long.TryParse(kv[1], out copiarDe);
        }
        if (copiarDe <= 0) return;

        try
        {
            long k = State.KioscoId;
            var res = await SupaClient.From<Producto>().Where(p => p.Id == copiarDe).Where(p => p.KioscoId == k).Get();
            origen = res.Models.FirstOrDefault();
        }
        catch { origen = null; }
        if (origen == null) return;

        producto = new Producto
        {
            KioscoId = State.KioscoId,
            CodigoBarras = CodigoPrecargado ?? "",
            Nombre = origen.Nombre,
            Marca = origen.Marca,
            FamiliaId = origen.FamiliaId,
            SubfamiliaId = origen.SubfamiliaId,
            SinRedondeo = origen.SinRedondeo,
            AdmiteImporte = origen.AdmiteImporte,
            BultoPrecio = origen.BultoPrecio,
            BultoUnidades = origen.BultoUnidades,
            BultoFecha = origen.BultoFecha,
            ProveedorId = origen.ProveedorId,
            PrecioCosto = origen.PrecioCosto,
            UtilidadPV = origen.UtilidadPV,
            PrecioVenta = origen.PrecioVenta,
            PrecioLista2 = origen.PrecioLista2,
            UtilidadLista2 = origen.UtilidadLista2,
            PrecioLista3 = origen.PrecioLista3,
            UtilidadLista3 = origen.UtilidadLista3,
            PrecioVentaxMayor = origen.PrecioVentaxMayor,
            UtilidadVentaxMayor = origen.UtilidadVentaxMayor,
            CantxMayor = origen.CantxMayor,
            UnidadMedida = string.IsNullOrWhiteSpace(origen.UnidadMedida) ? "UNIDAD" : origen.UnidadMedida,
            VentaxPeso = origen.VentaxPeso,
            StockActual = 0,
            StockMinimo = origen.StockMinimo,
            StockIdeal = origen.StockIdeal,
            Activo = true,
        };
    }

    private long FamiliaPorDefecto()
    {
        var familiaDefault = familias.FirstOrDefault(f =>
            f.Nombre != null &&
            (f.Nombre.Equals("Articulo", StringComparison.OrdinalIgnoreCase) ||
             f.Nombre.Equals("Articulos", StringComparison.OrdinalIgnoreCase) ||
             f.Nombre.Equals("Artículo", StringComparison.OrdinalIgnoreCase) ||
             f.Nombre.Equals("Artículos", StringComparison.OrdinalIgnoreCase)));
        return familiaDefault?.Id ?? familias.FirstOrDefault()?.Id ?? 0;
    }

    /// <summary>
    /// Si quedó sin familia o sin proveedor ("-- Elegí --"), se ponen los de siempre: ARTICULOS y PROVEEDOR.
    /// Así no falla al guardar (la base no acepta familia 0).
    /// </summary>
    private void CompletarFamiliaYProveedor()
    {
        if ((producto.FamiliaId ?? 0) <= 0)
        {
            var fam = familias.FirstOrDefault(f => f.Nombre != null &&
                (new[] { "ARTICULOS", "ARTÍCULOS", "ARTICULO", "ARTÍCULO" }).Contains(f.Nombre.Trim().ToUpperInvariant()));
            producto.FamiliaId = fam?.Id;          // si no existe, queda sin familia (no 0)
            producto.SubfamiliaId = null;
        }
        if ((producto.ProveedorId ?? 0) <= 0)
        {
            var prov = proveedores.FirstOrDefault(p => string.Equals(p.Nombre?.Trim(), ConfiguracionService.ProveedorDefault, StringComparison.OrdinalIgnoreCase));
            producto.ProveedorId = prov?.Id;       // si no existe, queda sin proveedor (no 0)
        }
    }

    // ---------- Unidad de medida ----------
    private bool EsUnidad(string u) => string.Equals(producto.UnidadMedida, u, StringComparison.OrdinalIgnoreCase);

    private void CambiarUnidad(string unidad)
    {
        producto.UnidadMedida = unidad;
        producto.VentaxPeso = producto.IsMedidaGramos() || producto.IsMedidaKilos();
    }

    private static string TextoUnidad(string u) => Unidades.Nombre(u);
    private static string IconoUnidad(string u) => Unidades.Icono(u);

    // ---------- Código propio (productos sueltos sin código) ----------
    private bool creandoCodigo;
    private async Task CrearCodigoPropio()
    {
        creandoCodigo = true;
        try
        {
            producto.CodigoBarras = await CodigoBarras.CrearCodigoPropioAsync(SupaClient, State.KioscoId);
            avisos.Toast("Código creado. Al guardar, imprimí la etiqueta en Carteles → Códigos de barras.", "exito", 4000);
        }
        catch (Exception ex) { avisos.Toast("No se pudo crear el código: " + ex.Message, "peligro"); }
        finally { creandoCodigo = false; }
    }

    // ---------- Guardar ----------
    private async Task GuardarProducto(bool otraVariante)
    {
        if (string.IsNullOrWhiteSpace(producto.Nombre)) { avisos.Toast("Falta la descripción del producto.", "peligro"); return; }
        if (origen != null)
        {
            if (string.Equals(producto.Nombre?.Trim(), origen.Nombre?.Trim(), StringComparison.OrdinalIgnoreCase))
            { avisos.Toast("Cambiá el nombre: agregale el aroma, color o sabor de esta variante.", "peligro", 4500); return; }
            if (string.IsNullOrWhiteSpace(producto.CodigoBarras) || producto.CodigoBarras.Trim() == origen.CodigoBarras?.Trim())
            { avisos.Toast("Escaneá el código de barras de esta variante (no puede ser el mismo).", "peligro", 4500); return; }
        }

        CompletarFamiliaYProveedor();
        guardando = true;
        try
        {
            producto.FechaActualizacion = DateTime.UtcNow;
            producto.VentaxPeso = producto.IsMedidaGramos() || producto.IsMedidaKilos();

            long idGuardado = 0;

            if (productoCreatorRef != null)
            {
                idGuardado = await productoCreatorRef.CrearAsync();
            }
            else
            {
                var respuesta = await SupaClient.From<Producto>().Upsert(producto);
                var productoGuardado = respuesta?.Models?.FirstOrDefault() ?? producto;
                idGuardado = productoGuardado?.Id ?? producto.Id;
            }

            if (idGuardado <= 0)
            {
                await avisos.InformarAsync("No se pudo crear", "No se obtuvo el número del producto nuevo. Revisá la conexión y probá de nuevo.", "peligro");
                return;
            }

            if (gestionProvNuevoRef != null)
            {
                await gestionProvNuevoRef.GuardarCambiosProveedoresAsync(idGuardado);
            }

            // precios por cantidad (si falla, el producto ya quedó guardado)
            if (preciosCantRef != null)
            {
                try { await preciosCantRef.GuardarAsync(idGuardado); }
                catch (Exception exPc) { await avisos.InformarAsync("No se guardaron los precios por cantidad", exPc.Message, "aviso"); }
            }

            if (otraVariante && origen != null)
            {
                // recarga la página limpia, otra vez copiando del mismo producto
                _ = avisos.GuardadoAsync($"Creado: {producto.Nombre}", milisegundos: 1400);
                Nav.NavigateTo($"{new Uri(Nav.Uri).AbsolutePath}?copiarDe={origen.Id}&n={DateTime.Now.Ticks}", forceLoad: false);
                origen = null; listo = false;
                await OnInitializedAsync();
                return;
            }

            guardando = false;
            await avisos.GuardadoAsync($"Creado: {producto.Nombre}", milisegundos: 1400);   // se ve que se guardó y vuelve a la lista
            Volver();
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo crear", ex.Message, "peligro");
        }
        finally { guardando = false; }
    }

    // ---------- Código existente ----------
    /// <summary>Código leído con la cámara del celular: igual que si lo escribieran o pasaran el lector.</summary>
    private Task CodigoDeCamaraAsync(string codigo) => BuscarProductoPorCodigo(new ChangeEventArgs { Value = codigo });

    private async Task BuscarProductoPorCodigo(ChangeEventArgs e)
    {
        string codigoIngresado = e.Value?.ToString()?.Trim() ?? "";
        producto.CodigoBarras = codigoIngresado;
        if (string.IsNullOrWhiteSpace(codigoIngresado)) return;

        Producto? existente = null;
        try
        {
            var response = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Where(p => p.CodigoBarras == codigoIngresado)
                .Get();
            existente = response.Models.FirstOrDefault();
        }
        catch { /* sin conexión: se sigue cargando como nuevo */ }

        if (existente == null) return;

        if (await avisos.ConfirmarAsync("Ese código ya existe",
                $"Pertenece a: {existente.Nombre}\n¿Querés abrirlo para editarlo?", "Abrir para editar", "aviso", "Seguir cargando"))
        {
            Nav.NavigateTo($"{RutaEditar}/{existente.Id}");
        }
    }

    // Stock en gramos: equivalente aproximado en kilos para que se entienda mejor (ej: 1250 → "1,25 kg")
    private string KgAprox(int? gramos) => ((gramos ?? 0) / 1000m).ToString("#,##0.###", argCulture) + " kg";

    // algún proveedor lo vende por bulto: el stock se aclara "x unidad" para no confundir
    private bool hayBultos;

    /// <summary>El bulto del producto para completar el de los proveedores (por peso va en gramos; menos de 100 g es un dato viejo y no se usa).</summary>
    private int? BultoParaProveedores => producto.EsVentaPorPeso() && (producto.BultoUnidades ?? 0) < 100 ? null : producto.BultoUnidades;

    private void Volver() => Nav.NavigateTo("/productos");
}
