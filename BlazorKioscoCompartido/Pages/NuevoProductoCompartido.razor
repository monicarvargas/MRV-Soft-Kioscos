    private async Task GuardarProducto()
    {
        if (string.IsNullOrWhiteSpace(producto.Nombre)) return;

        producto.FechaActualizacion = DateTime.UtcNow;

        // Usar Upsert actualiza si ya existe o inserta si es nuevo
        await SupaClient.From<Producto>().Upsert(producto);

        Volver();
    }
    private async Task BuscarProductoPorCodigo(ChangeEventArgs e)
    {
        string codigoIngresado = e.Value?.ToString()?.Trim() ?? "";
        producto.CodigoBarras = codigoIngresado;

        // Si el campo quedó vacío, reseteamos el formulario
        if (string.IsNullOrWhiteSpace(codigoIngresado))
        {
            LimpiarFormulario(codigoIngresado);
            return;
        }

        try
        {
            // Buscamos si existe un producto con el mismo código de barras en el kiosco actual
            var response = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Where(p => p.CodigoBarras == codigoIngresado)
                .Single();

            if (response != null)
            {
                // ¡EXISTE! Autocompletamos la pantalla con los datos encontrados
                producto = response;
            }
            else
            {
                // NO EXISTE: Limpiamos los campos manteniendo el código tipeado
                LimpiarFormulario(codigoIngresado);
            }
        }
        catch (Exception)
        {
            // En caso de que no encuentre filas o de algún error de red
            LimpiarFormulario(codigoIngresado);
        }
    }

    private void LimpiarFormulario(string codigo)
    {
        producto = new Producto
        {
            KioscoId = State.KioscoId,
            CodigoBarras = codigo,
            Nombre = "",
            Marca = "",
            FamiliaId = 0,
            ProveedorId = 0,
            PrecioCosto = 0,
            UtilidadPV = 0,
            PrecioVenta = 0,
            UtilidadLista2 = 0,
            PrecioLista2 = 0,
            UtilidadLista3 = 0,
            PrecioLista3 = 0,
            UtilidadVentaxMayor = 0,
            PrecioVentaxMayor = 0,
            CantxMayor = 0,
            StockActual = 0,
            StockMinimo = 0,
            StockIdeal = 0,
            UnidadMedida = "",
            VentaxPeso = false
        };
    }
