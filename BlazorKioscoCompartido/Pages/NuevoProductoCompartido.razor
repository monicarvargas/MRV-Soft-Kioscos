@inject Supabase.Client SupaClient
@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State
@inject PrecioService PrecioServ
@using BlazorKioscoCompartido.Constants
@using BlazorKioscoCompartido.Models
@using System.Globalization

<div class="container-fluid px-3 py-2 bg-light min-vh-100 style-notebook mb-5">

    @* === ENCABEZADO === *@
    <div class="d-flex justify-content-between align-items-center mb-2 bg-white p-2 rounded-3 shadow-sm border-start border-success border-4">
        <div class="d-flex align-items-center">
            <div class="bg-success text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-plus-circle fs-4"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold text-dark-custom">Nuevo Producto</h4>
                <span class="text-success fw-bold text-uppercase x-small-text">Carga un nuevo artículo al sistema.</span>
            </div>
        </div>
    </div>

    <div class="row g-2">
        @* ======================================================= *@
        @* BLOQUE 1: DATOS PRINCIPALES                             *@
        @* ======================================================= *@
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-2 border-bottom">
                    <span class="fw-bold titulo-seccion text-success"><i class="bi bi-card-text me-2"></i>Datos Principales del Artículo</span>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label x-small-text fw-bold text-dark-custom mb-1">
                                <i class="bi bi-barcode me-1 text-success"></i>Código (Cód. Barra)
                            </label>
                            <div class="input-group border rounded-3 overflow-hidden border-secondary">
                                <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-upc"></i></span>
                                <input type="text"
                                       class="form-control border-0 fw-bold text-dark-custom fs-6"
                                       value="@producto.CodigoBarras"
                                       @onchange="BuscarProductoPorCodigo" />
                            </div>
                        </div>
                        <div class="col-12 col-md-8">
                            <label class="form-label x-small-text fw-bold text-dark-custom mb-1"><i class="bi bi-blockquote-left me-1 text-success"></i>Descripción / Nombre</label>
                            <div class="input-group border rounded-3 overflow-hidden border-secondary">
                                <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-tag"></i></span>
                                <input type="text" class="form-control border-0 fw-bold text-dark-custom fs-6" placeholder="Ej: Alfajor Milka 55g" @bind="producto.Nombre" />
                            </div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-12 col-md-4">
                            <label class="form-label x-small-text fw-bold text-dark-custom mb-1"><i class="bi bi-folder2 me-1 text-success"></i>Familia / Categoría</label>
                            <div class="input-group border rounded-3 overflow-hidden border-secondary">
                                <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-bookmark"></i></span>
                                <select class="form-select border-0 text-dark-custom fw-bold fs-6" @bind="producto.FamiliaId">
                                    <option value="0">-- Seleccione Familia --</option>
                                    @foreach (var fam in familias)
                                    {
                                        <option value="@fam.Id">@fam.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label x-small-text fw-bold text-dark-custom mb-1"><i class="bi bi-truck me-1 text-success"></i>Proveedor</label>
                            <div class="input-group border rounded-3 overflow-hidden border-secondary">
                                <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-person-badge"></i></span>
                                <select class="form-select border-0 text-dark-custom fw-bold fs-6" @bind="producto.ProveedorId">
                                    <option value="0">-- Seleccione Proveedor --</option>
                                    @foreach (var prov in proveedores)
                                    {
                                        <option value="@prov.Id">@prov.Nombre</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label x-small-text fw-bold text-dark-custom mb-1"><i class="bi bi-award me-1 text-success"></i>Marca</label>
                            <div class="input-group border rounded-3 overflow-hidden border-secondary">
                                <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-registered"></i></span>
                                <input type="text" class="form-control border-0 text-dark-custom fw-bold fs-6" placeholder="Ej: Terrabusi" @bind="producto.Marca" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ======================================================= *@
        @* BLOQUE 2: PRECIOS Y COSTOS (Mismo diseño lindo)         *@
        @* ======================================================= *@
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-3 card-rentabilidad">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-6 col-md-4">
                            <div class="p-2 border rounded-3 bg-white border-primary-custom shadow-sm">
                                <label class="form-label text-primary fw-bold mb-1 d-block fs-6 shadow-text">
                                    <i class="bi bi-currency-dollar"></i> Precio Costo ($)
                                </label>
                                <input type="text" class="form-control form-control-lg border-0 fw-black p-0 text-dark-custom fs-3"
                                       value="@((producto.PrecioCosto ?? 0).ToString("#,##0.00", argCulture))"
                                       @onchange="CalcularPrecioVentaCosto" />
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="p-2 border rounded-3 bg-white border-dark shadow-sm">
                                <label class="form-label text-dark-custom fw-bold mb-1 fs-6"><i class="bi bi-graph-up-arrow text-success"></i> Utilidad %</label>
                                <div class="input-group border-0">
                                    <input type="number" class="form-control border-0 fw-black p-0 text-dark-custom fs-3" @bind="producto.UtilidadPV" @oninput="CalcularPrecioVentaMargen" />
                                    <span class="bg-white border-0 text-dark-custom fw-black ps-1 fs-3">%</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-5 mt-2 mt-md-0">
                            <div class="p-2 border rounded-3 card-final-price shadow text-end pe-4">
                                <label class="form-label fw-black text-success text-uppercase mb-1 d-block fs-5"><i class="bi bi-cash-stack"></i> Precio Venta FINAL ($)</label>
                                <div class="d-flex align-items-center justify-content-end">
                                    <span class="fs-2 fw-black text-success me-2">$</span>
                                    <input type="text" class="form-control form-control-lg border-0 fw-black text-success text-end bg-transparent p-0 fs-2" style="width: 80%;"
                                           value="@((producto.PrecioVenta ?? 0).ToString("#,##0.00", argCulture))"
                                           @onchange="@(e => CalcularMargenDesdeVenta(e, "Principal"))" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* === TOGGLE PARA PANTALLAS CHICAS === *@
        <div class="col-12 d-md-none text-center my-1">
            <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-3 py-2 fw-bold bg-white shadow-sm"
                    @onclick="() => mostrarAvanzadoMobile = !mostrarAvanzadoMobile">
                <i class="bi @(mostrarAvanzadoMobile ? "bi-chevron-up" : "bi-sliders") me-1"></i>
                @(mostrarAvanzadoMobile ? "Ocultar Opciones Avanzadas" : "Ver Más Listas y Configurar Stock")
            </button>
        </div>

        @* ======================================================= *@
        @* SECCIÓN AVANZADA ADAPTATIVA                             *@
        @* ======================================================= *@
        <div class="col-12 @(mostrarAvanzadoMobile ? "d-block" : "d-none") d-md-block">
            <div class="row g-2">
                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white py-2 border-bottom">
                            <span class="fw-bold titulo-seccion text-info-custom"><i class="bi bi-tags text-info-custom me-2"></i>Listas Adicionales</span>
                        </div>
                        <div class="card-body p-3 bg-light-custom">

                            @if (nombreLista2 != "")
                            {
                                    <div class="row g-2 mb-3">
                                        <div class="col-6 col-md-3">
                                        <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Utilidad @nombreLista2 %</label>
                                        <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                            <input type="number" class="form-control border-0 fw-bold text-dark-custom fs-6" @bind="producto.UtilidadLista2" @oninput="CalcularPrecioVentaMargenLista2" />
                                            <span class="input-group-text bg-white border-0 text-dark-custom fw-bold">%</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label x-small-text fw-bold text-dark-custom mb-1">@nombreLista2</label>
                                        <div class="input-group border rounded-3 overflow-hidden bg-white border-dark">
                                            <span class="input-group-text bg-light border-0 text-dark-custom fw-bold">$</span>
                                            <input type="text" class="form-control border-0 fw-black text-dark-custom fs-6"
                                                   value="@((producto.PrecioLista2 ?? 0).ToString("#,##0.00", argCulture))"
                                                   @onchange="@(e => CalcularMargenDesdeVenta(e, "Lista2"))" />
                                        </div>
                                    </div>
                                    @* <div class="col-6 col-md-3">
                                        <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Utilidad L3 %</label>
                                        <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                            <input type="number" class="form-control border-0 fw-bold text-dark-custom fs-6" @bind="producto.UtilidadLista3" @oninput="CalcularPrecioVentaMargenLista3" />
                                            <span class="input-group-text bg-white border-0 text-dark-custom fw-bold">%</span>
                                        </div>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Precio Lista 3</label>
                                        <div class="input-group border rounded-3 overflow-hidden bg-white border-dark">
                                            <span class="input-group-text bg-light border-0 text-dark-custom fw-bold">$</span>
                                            <input type="text" class="form-control border-0 fw-black text-dark-custom fs-6"
                                                   value="@((producto.PrecioLista3 ?? 0).ToString("#,##0.00", argCulture))"
                                                   @onchange="@(e => CalcularMargenDesdeVenta(e, "Lista3"))" />
                                        </div>
                                    </div> *@
                                </div>
                            }
                            <div class="row g-2">
                                <div class="col-6 col-md-4">
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Utilidad x Mayor %</label>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                        <input type="number" class="form-control border-0 fw-bold text-dark-custom fs-6" @bind="producto.UtilidadVentaxMayor" @oninput="CalcularPrecioVentaMargenXMayor" />
                                        <span class="input-group-text bg-white border-0 text-dark-custom fw-bold">%</span>
                                    </div>
                                </div>
                                <div class="col-6 col-md-4">
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Precio x Mayor</label>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-dark">
                                        <span class="input-group-text bg-light border-0 text-dark-custom fw-bold">$</span>
                                        <input type="text" class="form-control border-0 fw-black text-dark-custom fs-6"
                                               value="@((producto.PrecioVentaxMayor ?? 0).ToString("#,##0.00", argCulture))"
                                               @onchange="@(e => CalcularMargenDesdeVenta(e, "XMayor"))" />
                                    </div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Cant x Mayor</label>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                        <span class="input-group-text bg-light border-0 text-dark-custom fw-bold"><i class="bi bi-boxes"></i></span>
                                        <input type="number" class="form-control border-0 fw-bold text-dark-custom fs-6" @bind="producto.CantxMayor" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card shadow-sm border-0 rounded-3">
                        <div class="card-header bg-white py-2 border-bottom">
                            <span class="fw-bold titulo-seccion text-success"><i class="bi bi-boxes me-2"></i>Inventario Inicial</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="row g-2 align-items-center">
                                <div class="col-6 col-md-3">
                                    @* <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Stock Inicial</label> *@
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-0">Stock Inicial</label>
                                    <div class="form-text text-muted mb-1" style="font-size: 0.75rem;">
                                        <i>(Indicar la cantidad existente)</i>
                                    </div>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-success border-2 shadow-sm">
                                        <span class="input-group-text bg-light border-0 text-success fw-bold"><i class="bi bi-box"></i></span>
                                        <input type="number" class="form-control border-0 fw-black text-success fs-5" @bind="producto.StockActual" />
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    @* <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Stock Mínimo</label> *@
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-0">Stock Mínimo</label>
                                    <div class="form-text text-muted mb-1" style="font-size: 0.75rem;">
                                        <i>(Avisar si el stock es menor a esta cantidad)</i>
                                    </div>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                        <span class="input-group-text bg-light border-0 text-dark-custom"><i class="bi bi-graph-down"></i></span>
                                        <input type="number" class="form-control border-0 text-dark-custom fw-bold fs-6" @bind="producto.StockMinimo" />
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                   @*  <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Stock Ideal(Si hay mas de esta cantidad no avisar)</label> *@
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-0">Stock Ideal</label>
                                    <div class="form-text text-muted mb-1" style="font-size: 0.75rem;">
                                        <i>(No avisar si el stock supera esta cantidad)</i>
                                    </div>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                        <span class="input-group-text bg-light border-0 text-dark-custom"><i class="bi bi-bullseye"></i></span>
                                        <input type="number" class="form-control border-0 text-dark-custom fw-bold fs-6" @bind="producto.StockIdeal" />
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label x-small-text fw-bold text-dark-custom mb-1">Unidad Medida</label>
                                    <div class="input-group border rounded-3 overflow-hidden bg-white border-secondary">
                                        <span class="input-group-text bg-light border-0 text-dark-custom"><i class="bi bi-rulers"></i></span>
                                        <select class="form-select border-0 text-dark-custom fw-bold fs-6" @bind="producto.UnidadMedida">
                                            <option value="">-- Seleccione unidad --</option>
                                            @foreach (var unidad in Unidades.Lista)
                                            {
                                                <option value="@unidad">@unidad</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="form-check mt-3 ps-4">
                                <input class="form-check-input border-dark fs-5" type="checkbox" id="checkVentaPeso" @bind="producto.VentaxPeso">
                                <label class="form-check-label text-dark-custom fw-black fs-6 ms-1" for="checkVentaPeso">
                                    <i class="bi bi-balance-scale text-primary me-1"></i> Venta por Peso / Fraccionado
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* === BOTONERA ADAPTADA (Al final del scroll en celular) === *@
    <div class="bg-white border-top rounded-3 p-3 d-flex justify-content-end gap-2 mt-3 shadow-sm">
        <button type="button" class="btn btn-secondary px-4 py-2 rounded-3 fw-bold" @onclick="Volver">
            <i class="bi bi-x-circle me-1"></i> Cancelar
        </button>
        <button type="button" class="btn btn-success px-5 py-2 rounded-3 fw-black shadow-sm fs-6"
                style="background-color: #00875a; border: none;" @onclick="GuardarProducto">
            <i class="bi bi-plus-circle-fill me-1"></i> CREAR PRODUCTO
        </button>
    </div>
</div>

<style>
    /* ... (Los mismos estilos .style-notebook, .fw-black, etc. de Editar) ... */
    .style-notebook {
        font-size: 0.95rem;
        color: #111111;
        padding-bottom: 30px;
    }

    .x-small-text {
        font-size: 0.82rem;
    }

    .fw-black {
        font-weight: 850;
    }

    .text-dark-custom {
        color: #111111 !important;
    }

    .text-info-custom {
        color: #007acc !important;
    }

    .bg-light-custom {
        background-color: #fcfcfc !important;
    }

    .titulo-seccion {
        font-size: 0.98rem;
        font-weight: 750;
    }

    .border-primary-custom {
        border-color: #0d6efd !important;
        border-width: 2px !important;
    }

    .card-rentabilidad {
        background-color: #f4f6f9;
        border: 1px solid #ced4da;
    }

    .card-final-price {
        background-color: #e8f5e9;
        border: 2px solid #2e7d32 !important;
    }
</style>

@code {
    [Parameter] public string? CodigoPrecargado { get; set; }

    private Producto producto = new();
    private bool mostrarAvanzadoMobile = false;

    private List<Familia> familias = new();
    private List<Proveedor> proveedores = new();
    private CultureInfo argCulture = CultureInfo.GetCultureInfo("es-AR");
    private string nombreLista2="";

    protected override async Task OnInitializedAsync()
    {
        producto = new Producto
        {
            KioscoId = State.KioscoId,
            CodigoBarras = CodigoPrecargado ?? "", // Mapea el código de barra automáticamente si viene de la URL
            PrecioCosto = 0,
            UtilidadPV = 0,
            PrecioVenta = 0,
            StockActual = 0,
            StockMinimo = 0,
            StockIdeal = 0
        };

        var responseFam = await SupaClient.From<Familia>().Where(f => f.KioscoId == State.KioscoId).Get();
        familias = responseFam.Models.OrderBy(f => f.Nombre).ToList();

        var responseProv = await SupaClient.From<Proveedor>().Where(p => p.KioscoId == State.KioscoId).Get();
        proveedores = responseProv.Models.OrderBy(p => p.Nombre).ToList();


        nombreLista2 = await PrecioServ.ObtenerNombreColumnaAsync(State.KioscoId, "precio_lista2");
    }

    // === MÉTODOS DE CÁLCULO IDÉNTICOS A EDICIÓN ===
    private void CalcularPrecioVentaCosto(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Currency, argCulture, out decimal costo))
        {
            producto.PrecioCosto = costo;
            RecalcularTodasLasListas();
        }
    }

    private void CalcularPrecioVentaMargen(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal margen)) return;
        producto.UtilidadPV = margen;
        producto.PrecioVenta = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadPV);
    }

    private void CalcularPrecioVentaMargenLista2(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal margen)) return;
        producto.UtilidadLista2 = margen;
        producto.PrecioLista2 = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadLista2);
    }

    private void CalcularPrecioVentaMargenLista3(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal margen)) return;
        producto.UtilidadLista3 = margen;
        producto.PrecioLista3 = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadLista3);
    }

    private void CalcularPrecioVentaMargenXMayor(ChangeEventArgs e)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out decimal margen)) return;
        producto.UtilidadVentaxMayor = margen;
        producto.PrecioVentaxMayor = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadVentaxMayor);
    }

    private void RecalcularTodasLasListas()
    {
        producto.PrecioVenta = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadPV);
        producto.PrecioLista2 = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadLista2);
        producto.PrecioLista3 = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadLista3);
        producto.PrecioVentaxMayor = CalcularPrecioPorUtilidad(producto.PrecioCosto, producto.UtilidadVentaxMayor);
    }

    private decimal? CalcularPrecioPorUtilidad(decimal? precioCosto, decimal? utilidadLista)
    {
        if (precioCosto == null || utilidadLista == null) return null;
        decimal precioSugerido = precioCosto.Value + (precioCosto.Value * (utilidadLista.Value / 100));
        return State.UsarRedondeo ? Math.Ceiling(precioSugerido / State.MultiploRedondeo) * State.MultiploRedondeo : Math.Round(precioSugerido, 2);
    }

    private void CalcularMargenDesdeVenta(ChangeEventArgs e, string tipoLista)
    {
        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Currency, argCulture, out decimal venta)) return;
        if (producto.PrecioCosto == null || producto.PrecioCosto == 0) { AsignarUtilidadYPrecio(tipoLista, venta, 0); return; }
        decimal margenCalculado = ((venta - producto.PrecioCosto.Value) / producto.PrecioCosto.Value) * 100;
        AsignarUtilidadYPrecio(tipoLista, venta, Math.Round(margenCalculado, 2));
    }

    private void AsignarUtilidadYPrecio(string tipoLista, decimal venta, decimal margen)
    {
        switch (tipoLista)
        {
            case "Principal": producto.PrecioVenta = venta; producto.UtilidadPV = margen; break;
            case "Lista2": producto.PrecioLista2 = venta; producto.UtilidadLista2 = margen; break;
            case "Lista3": producto.PrecioLista3 = venta; producto.UtilidadLista3 = margen; break;
            case "XMayor": producto.PrecioVentaxMayor = venta; producto.UtilidadVentaxMayor = margen; break;
        }
    }

    // private async Task GuardarProducto()
    // {
    //     if (string.IsNullOrWhiteSpace(producto.Nombre)) return;
