</style>

@code {
    [Parameter] public string RutaOrigenVentas { get; set; } = "/vender-desktop";
    [Parameter] public long PersonaId { get; set; } = 0;

    private bool cargando = false;
    private string mensajeError = "";

    private List<Persona> listaPersonas = new List<Persona>();
    private long personaSeleccionadaId = 0;

    private long formaPagoSeleccionada = 1;
    private string nombreFormaPagoSeleccionada = "Efectivo";
    private decimal montoEntregado = 0;

    // Clases auxiliares para estructurar los datos recuperados
    public class ProductoFiadoItem
    {
        public string NombreProducto { get; set; } = "";
        public decimal Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal { get; set; }
    }

    public class EntregaParcialItem
    {
        public DateTime Fecha { get; set; }
        public string NombreFormaPago { get; set; } = "";
        public decimal Monto { get; set; }
    }

    private List<ProductoFiadoItem> listaProductosFiados = new List<ProductoFiadoItem>();
    private List<EntregaParcialItem> historialEntregas = new List<EntregaParcialItem>();

    private decimal totalDeudaOriginal = 0;
    private decimal totalEntregadoPreviamente = 0;
    private decimal saldoPendienteActual => totalDeudaOriginal - totalEntregadoPreviamente;
    private decimal nuevoSaldo => saldoPendienteActual - montoEntregado;

    protected override async Task OnInitializedAsync()
    {
        await CargarPersonas();

        if (PersonaId > 0)
        {
            personaSeleccionadaId = PersonaId;
            await CargarCuentaCorrientePersona();
        }
    }

    private async Task CargarPersonas()
    {
        try
        {
            var res = await SupaClient.From<Persona>().Get();
            if (res.Models != null)
            {
                listaPersonas = res.Models.OrderBy(p => p.Nombre).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
        }
    }

    private async Task OnPersonaChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long id))
        {
            personaSeleccionadaId = id;
            await CargarCuentaCorrientePersona();
        }
    }

    private async Task CargarCuentaCorrientePersona()
    {
        if (personaSeleccionadaId == 0) return;

        cargando = true;
        mensajeError = "";
        listaProductosFiados.Clear();
        historialEntregas.Clear();
        totalDeudaOriginal = 0;
        totalEntregadoPreviamente = 0;

        try
        {
            // 1. Obtener todas las ventas registradas a nombre de la persona
            var resVentas = await SupaClient.From<Venta>()
                                .Where(v => v.PersonaId == personaSeleccionadaId)
                                .Get();

            var ventasPersona = resVentas.Models ?? new List<Venta>();

            // Separar las que son Deudas (FormaPagoId == 6 / Fiado) de los Pagos Parciales/Entregas (FormaPagoId != 6)
            var ventasFiadas = ventasPersona.Where(v => v.FormaPagoId == 6).ToList();
            var entregasRealizadas = ventasPersona.Where(v => v.FormaPagoId != 6 && (v.Pagado == false)).ToList();

            totalDeudaOriginal = ventasFiadas.Sum(v => v.Total);
            totalEntregadoPreviamente = entregasRealizadas.Sum(v => v.Total);

            // Cargar Historial de Entregas Parciales
            foreach (var e in entregasRealizadas)
            {
                historialEntregas.Add(new EntregaParcialItem
                {
                    Fecha = e.Fecha,
                    NombreFormaPago = ObtenerNombreMedio(e.FormaPagoId),
                    Monto = e.Total
                });
            }

            // 2. Obtener los detalles de los productos que integran esas ventas fiadas
            if (ventasFiadas.Any())
            {
                var movsFiados = ventasFiadas.Select(v => v.NumeroUnicoIdentificatorioMovimiento).Distinct().ToList();

                var resDetalles = await SupaClient.From<VentaDetalle>().Get();
                var detallesFiados = resDetalles.Models
                                        .Where(d => movsFiados.Contains(d.NumeroUnicoIdentificatorioMovimiento))
                                        .ToList();

                var productosIds = detallesFiados.Select(d => d.ProductoId).Distinct().ToList();
                var resProductos = await SupaClient.From<Producto>().Get();
                var dictProductos = resProductos.Models.ToDictionary(p => p.Id, p => p.Nombre);

                foreach (var d in detallesFiados)
                {
                    listaProductosFiados.Add(new ProductoFiadoItem
                    {
                        NombreProducto = dictProductos.ContainsKey(d.ProductoId) ? dictProductos[d.ProductoId] : "Producto #" + d.ProductoId,
                        Cantidad = d.Cantidad,
                        PrecioUnitario = d.PrecioUnitario,
                        Subtotal = d.Subtotal
                    });
                }
            }

            montoEntregado = saldoPendienteActual > 0 ? saldoPendienteActual : 0;
        }
        catch (Exception ex)
        {
            mensajeError = "Error al recuperar cuenta corriente: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerNombreMedio(long formaPagoId)
    {
        return formaPagoId switch
        {
            1 => "Efectivo",
            2 => "Mercado Pago",
            3 => "Transferencia",
            _ => "Otro"
        };
    }

    private void SeleccionarMedio(long id, string nombre)
    {
        formaPagoSeleccionada = id;
        nombreFormaPagoSeleccionada = nombre;
    }

    private void CargarMontoRapido(decimal monto)
    {
        montoEntregado = monto;
    }

    private void CargarSaldoTotal()
    {
        montoEntregado = saldoPendienteActual > 0 ? saldoPendienteActual : 0;
    }

    private async Task ProcesarCobroFiado()
    {
        if (montoEntregado <= 0)
        {
            mensajeError = "Ingrese un monto válido a cobrar.";
            return;
        }

        try
        {
            // Obtener número de movimiento unificado
            var respuestaRpc = await SupaClient.Rpc("obtener_proximo_movimiento", null);
            long numeroMovimientoUnico = Convert.ToInt64(respuestaRpc.Content);

            // Se registra el ingreso del dinero abonado/entregado parcial o totalmente
            var filaCobro = new Venta
            {
                NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                Fecha = DateTime.Today,
                Total = montoEntregado,
                FormaPagoId = formaPagoSeleccionada,
                KioscoId = State.KioscoId,
                UsuarioOperadorId = State.UsuarioId,
                PersonaId = personaSeleccionadaId,
                Pagado = true // El pago parcial/total entregado hoy ya ingresó
            };

            await SupaClient.From<Venta>().Insert(filaCobro);

            // Si la entrega salda la totalidad del saldo pendiente, se marcan las ventas de fiado como pagadas
            if (montoEntregado >= saldoPendienteActual)
            {
                var resVentasFiadas = await SupaClient.From<Venta>()
                                        .Where(v => v.PersonaId == personaSeleccionadaId && v.Pagado == false)
                                        .Get();

                if (resVentasFiadas.Models != null)
                {
                    foreach (var v in resVentasFiadas.Models)
                    {
                        v.Pagado = true;
                        await SupaClient.From<Venta>().Update(v);
                    }
                }
            }

            // Recargar la pantalla de la persona para refrescar los nuevos saldos
            await CargarCuentaCorrientePersona();
        }
        catch (Exception ex)
        {
            mensajeError = "Error al registrar el cobro del fiado: " + ex.Message;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo(RutaOrigenVentas);
    }
}