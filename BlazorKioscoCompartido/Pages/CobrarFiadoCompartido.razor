@inject BlazorKioscoCompartido.Services.AppState State
@inject NavigationManager Nav
@inject Supabase.Client SupaClient
@inject BlazorKioscoCompartido.Services.PrecioService PrecioServ
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Models.DTO
@using BlazorKioscoCompartido.Components
@using System.Globalization
@using BlazorKioscoCompartido.Services

<PedidosEstilos />
<ConfigEstilos />
<ProductoEstilos />
<VentasEstilos />
<AvisosPagina @ref="avisos" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Cobrar fiado"
                      Subtitulo="Cuenta corriente: entregas a cuenta y saldo"
                      IconoClass="bi-journal-bookmark-fill"
                      ColorBorde="danger"
                      ColorIcono="danger"
                      MostrarBotonAyuda="false"
                      RutaVolver="@RutaOrigenReporte" />

    <div class="vt-wrap vt-cols">
        @* ================= IZQUIERDA ================= *@
        <div class="vt-col">
            <section class="gp-card gp-card-pad">
                <div class="gp-card-head" style="margin-bottom:.7rem">
                    <span class="gp-bubble gp-bubble-sm" style="background:var(--gp-danger-soft); color:var(--gp-danger)"><i class="bi bi-person-fill"></i></span>
                    <div class="vt-head-text"><h2 style="font-size:1.05rem">Cliente</h2></div>
                </div>
                <select class="gp-control" @onchange="OnPersonaChanged" value="@personaSeleccionadaId">
                    <option value="0">-- Elegí a quién le cobrás --</option>
                    @foreach (var persona in listaPersonas.Where(p => p.Habilitado))
                    {
                        <option value="@persona.Id">@persona.Nombre</option>
                    }
                </select>
            </section>

            @if (personaSeleccionadaId == 0)
            {
                <section class="gp-card gp-card-pad">
                    <div class="gp-empty">
                        <span class="gp-bubble"><i class="bi bi-person-check"></i></span>
                        <strong>Elegí un cliente</strong>
                        <span>Vas a ver lo que debe, las entregas que ya hizo y el saldo.</span>
                    </div>
                </section>
            }
            else if (cargando)
            {
                <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando la cuenta corriente...</p></div>
            }
            else
            {
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head">
                        <span class="gp-bubble"><i class="bi bi-wallet2"></i></span>
                        <div class="vt-head-text">
                            <h2>Registrar una entrega</h2>
                            <p>Puede pagar todo o una parte. "Descontar" es para descontarle de lo que cobra (empleados).</p>
                        </div>
                    </div>
                    <MediosDePago ModoFiado="true" Restante="@Math.Max(0, saldoPendienteActual)" OnPagoCargado="AgregarPago" />
                </section>

                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head">
                        <span class="gp-bubble" style="background:var(--gp-danger-soft); color:var(--gp-danger)"><i class="bi bi-box-seam"></i></span>
                        <div class="vt-head-text">
                            <h2>Lo que debe</h2>
                            <p>@listaProductosFiados.Count producto(s) fiado(s)</p>
                        </div>
                    </div>
                    <DetalleArticulos Filas="FilasFiadas" AltoMaximo="320px" TextoVacio="No tiene productos fiados" />

                    @if (listaProductosFiados.Any(item => item.EsCombo == true))
                    {
                        <div class="cf-section"><i class="bi bi-boxes"></i> Contenido de los combos</div>
                        @foreach (var item in listaProductosFiados.Where(i => i.EsCombo == true))
                        {
                            <div style="margin:0 0 .6rem; padding-left:.7rem; border-left:3px solid var(--gp-ok-line)">
                                <div class="gp-muted" style="margin-bottom:.2rem">@item.NombreProducto</div>
                                <DetalleComboView ComboId="@item.ProductoId" />
                            </div>
                        }
                    }
                </section>
            }
        </div>

        @* ================= DERECHA ================= *@
        <div class="vt-col">
            @if (personaSeleccionadaId > 0 && !cargando)
            {
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.8rem">
                        <span class="gp-bubble gp-bubble-sm"><i class="bi bi-clock-history"></i></span>
                        <div class="vt-head-text"><h2 style="font-size:1.05rem">Entregas</h2><p>Las anteriores y las que cargás ahora.</p></div>
                    </div>
                    @if (!pagosAgregados.Any())
                    {
                        <div class="gp-hint"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> No hizo entregas a cuenta todavía.</div>
                    }
                    else
                    {
                        <ul class="vt-pagos">
                            @foreach (var entrega in pagosAgregados)
                            {
                                bool esNueva = entrega.NumeroUnicoIdentificatorio == 0;
                                <li class="vt-pago @(esNueva ? "" : "is-hist")">
                                    <i class="bi @(esNueva ? "bi-plus-circle-fill" : "bi-check-circle-fill")" style="@(esNueva ? "" : "color:var(--gp-ok)")"></i>
                                    <div class="vt-pago-info">
                                        <b>@entrega.NombreFormaPago</b>
                                        <small>@(esNueva ? "Nueva · se guarda al confirmar" : entrega.Fecha.ToString("dd/MM/yyyy"))</small>
                                    </div>
                                    <span class="vt-pago-monto">$ @entrega.Monto.ToString("N2")</span>
                                    @if (esNueva)
                                    {
                                        <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" title="Quitar" @onclick="() => RemoverPago(entrega)"><i class="bi bi-x-lg"></i></button>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </section>

                @if (difHorario > 0 || difDia > 0)
                {
                    <section class="gp-card gp-card-pad">
                        <div class="gp-card-head" style="margin-bottom:.7rem">
                            <span class="gp-bubble gp-bubble-sm" style="background:var(--gp-warn-soft); color:var(--gp-warn)"><i class="bi bi-graph-up-arrow"></i></span>
                            <div class="vt-head-text"><h2 style="font-size:1.05rem">Aumentaron los precios</h2><p>Elegí cómo le cobrás lo que debe.</p></div>
                        </div>
                        <div class="cfp-opciones @(HayOpcionDia ? "is-tres" : "")">
                            <button type="button" class="cfp-op @(!cobrarActualizado ? "is-active" : "")" @onclick='() => ElegirPrecio("")'>
                                <span>Precio de cuando lo sacó</span>
                                <b>$ @totalDeudaOriginal.ToString("N2")</b>
                            </button>
                            @if (difHorario > 0)
                            {
                                <button type="button" class="cfp-op is-hoy @(cobrarActualizado && modoPrecioHoy == "horario" ? "is-active" : "")" @onclick='() => ElegirPrecio("horario")'
                                        title="Cada cosa con la lista del horario en que la sacó (ej: lo de la noche, a precio noche de hoy)">
                                    <span>Hoy, según el horario en que lo sacó</span>
                                    <b>$ @((totalDeudaOriginal + difHorario).ToString("N2"))</b>
                                    <small>+ $ @difHorario.ToString("N2")</small>
                                </button>
                            }
                            @if (HayOpcionDia)
                            {
                                <button type="button" class="cfp-op is-hoy @(cobrarActualizado && modoPrecioHoy == "dia" ? "is-active" : "")" @onclick='() => ElegirPrecio("dia")'
                                        title="Todo con el precio de venta de hoy (el de día, el más barato)">
                                    <span>Hoy, todo a precio de día</span>
                                    <b>$ @((totalDeudaOriginal + difDia).ToString("N2"))</b>
                                    <small>+ $ @difDia.ToString("N2")</small>
                                </button>
                            }
                        </div>
                        @if (cobrarActualizado)
                        {
                            <div class="gp-hint" style="margin-top:.6rem; font-size:.8rem"><i class="bi bi-info-circle-fill" style="color:var(--gp-primary)"></i> Al registrar el cobro se suma a su cuenta un "ajuste por aumento" de $ @diferenciaAumento.ToString("N2"). Las ventas viejas no se modifican.</div>
                        }
                    </section>
                }

                <div class="vt-caja">
                    <span class="vt-caja-label">Deuda acumulada@(cobrarActualizado && diferenciaAumento > 0 ? " (a precio de hoy)" : "")</span>
                    <div class="vt-caja-total" style="color:#fff">$ @TotalACobrar.ToString("N2")</div>

                    <div class="vt-caja-filas">
                        <div class="vt-caja-fila"><span>Entregas anteriores</span><b>$ @TotalEntregasAnteriores.ToString("N2")</b></div>
                        <div class="vt-caja-fila"><span>Entrega de hoy</span><b class="is-ok">$ @TotalEntregaHoy.ToString("N2")</b></div>
                    </div>

                    <div class="vt-caja-vuelto">
                        <span class="vt-caja-label">@(saldoPendienteActual < 0 ? "Pagó de más" : "Saldo que queda")</span>
                        <strong style="color:@(saldoPendienteActual < 0 ? "#ff8a9a" : saldoPendienteActual == 0 ? "#7ee2b8" : "#ffd27a")">
                            $ @Math.Abs(saldoPendienteActual).ToString("N2")
                        </strong>
                        @if (saldoPendienteActual == 0 && TotalACobrar > 0)
                        {
                            <small style="color:#7ee2b8; font-weight:800">¡Deuda saldada!</small>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="gp-banner is-danger"><i class="bi bi-exclamation-octagon-fill"></i><p>@mensajeError</p></div>
                    }

                    <button type="button" class="gp-btn gp-btn-ok" disabled="@(guardando || TotalEntregaHoy <= 0)" @onclick="ProcesarCobroFiado">
                        @if (guardando)
                        {
                            <span class="gp-spinner" style="width:1.1rem;height:1.1rem;border-width:2px"></span> <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i> <span>Registrar cobro</span>
                        }
                    </button>
                    @if (TotalEntregaHoy <= 0)
                    {
                        <div style="margin-top:.6rem; color:rgba(255,255,255,.7); font-size:.82rem; font-weight:600">Cargá primero la entrega de hoy (forma de pago + monto + "Cargar").</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .cfp-opciones { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .cfp-opciones.is-tres { grid-template-columns: repeat(3, 1fr); }
    @@media (max-width: 575.98px) { .cfp-opciones.is-tres { grid-template-columns: 1fr; } }
    .cfp-op { display: flex; flex-direction: column; align-items: flex-start; gap: .1rem; padding: .65rem .75rem; border: 2px solid var(--gp-line); border-radius: 14px; background: #fff; color: var(--gp-text); font: inherit; text-align: left; cursor: pointer; }
    .cfp-op span { color: var(--gp-muted); font-size: .74rem; font-weight: 800; }
    .cfp-op b { font-size: 1.1rem; font-weight: 900; }
    .cfp-op small { color: var(--gp-warn); font-weight: 800; font-size: .74rem; }
    .cfp-op.is-active { border-color: var(--gp-primary); background: var(--gp-primary-soft); }
    .cfp-op.is-hoy.is-active { border-color: var(--gp-warn); background: var(--gp-warn-soft); }
    .cfp-op.is-hoy.is-active b { color: var(--gp-warn); }
</style>

@code {
    [Parameter] public string RutaOrigenReporte { get; set; } = "/reportedeudores";
    [Parameter] public long PersonaId { get; set; } = 0;

    private AvisosPagina avisos = default!;
    private string mensajeError = "";
    private bool guardando;

    public class PagoTemporal
    {
        public long NumeroUnicoIdentificatorio { get; set; }   // > 0: ya está guardado en la base (entrega anterior)
        public DateTime Fecha { get; set; }
        public long FormaPagoId { get; set; }
        public string NombreFormaPago { get; set; } = "";
        public decimal Monto { get; set; }
    }

    private List<PagoTemporal> pagosAgregados = new List<PagoTemporal>();
    private List<Persona> listaPersonas = new List<Persona>();
    private long personaSeleccionadaId = 0;
    private bool cargando = false;

    public class ProductoFiadoItem
    {
        public string NombreProducto { get; set; } = "";
        public decimal Cantidad { get; set; }
        public decimal PrecioUnitario { get; set; }
        public decimal Subtotal { get; set; }
        public string UnidadMedida { get; set; } = "unidad";
        public bool? EsCombo { get; set; } = false;
        public long ProductoId { get; set; }
        public DateTime Fecha { get; set; }
        public bool EsVario { get; set; }
        public decimal SubtotalHoy { get; set; }
    }

    private List<ProductoFiadoItem> listaProductosFiados = new List<ProductoFiadoItem>();
    private decimal totalDeudaOriginal = 0;

    // ----- precios actualizados -----
    // totalDeudaOriginal = lo que figura en sus fiados (precio de cuando lo sacó + ajustes que ya se hicieron)
    // deudaPrecioHoy     = esos mismos fiados recalculados a precio de hoy
    private decimal deudaPrecioHoy = 0;
    private decimal diferenciaAumento = 0;     // solo si aumentó
    private bool cobrarActualizado = false;    // lo elige el dueño
    // Precio de hoy: "horario" = cada fiado con la lista del horario en que se sacó (noche → precio noche de hoy)
    //                "dia"     = todo con el precio de venta de hoy (el de día)
    private string modoPrecioHoy = "horario";
    private decimal difHorario, difDia;
    private bool HayOpcionDia => difDia > 0 && Math.Abs(difDia - difHorario) >= 1;

    private void ElegirPrecio(string modo)
    {
        cobrarActualizado = modo != "";
        if (modo != "") modoPrecioHoy = modo;
        diferenciaAumento = !cobrarActualizado ? (difHorario > 0 ? difHorario : difDia)
                          : modoPrecioHoy == "dia" ? difDia : difHorario;
    }

    /// <summary>Lista de precios que correspondía cuando se sacó ese fiado (según la hora de la venta).</summary>
    private string ColumnaDeLaVenta(long mov)
    {
        var v = ventasFiadas.FirstOrDefault(x => x.NumeroUnicoIdentificatorioMovimiento == mov && x.HoraVenta != null);
        if (v?.HoraVenta is not DateTime h) return "precio_venta";
        var local = h.Kind == DateTimeKind.Utc ? h.ToLocalTime() : h;
        return BlazorKioscoCompartido.Services.PrecioService.ColumnaSegunMomento(State.KioscoId, local) ?? "precio_venta";
    }
    private decimal TotalACobrar => totalDeudaOriginal + (cobrarActualizado ? diferenciaAumento : 0);

    private decimal totalEntregadoPreviamente => pagosAgregados.Sum(p => p.Monto);
    private decimal saldoPendienteActual => TotalACobrar - totalEntregadoPreviamente;
    private decimal TotalEntregasAnteriores => pagosAgregados.Where(p => p.NumeroUnicoIdentificatorio > 0).Sum(p => p.Monto);
    private decimal TotalEntregaHoy => pagosAgregados.Where(p => p.NumeroUnicoIdentificatorio == 0).Sum(p => p.Monto);

    private List<PagosParcialesxDeudasDTO> ListPagosParcialesEnDB = new();
    private List<Venta> ventasFiadas = new();

    private List<DetalleArticulos.FilaArticulo> FilasFiadas => listaProductosFiados.Select(i => new DetalleArticulos.FilaArticulo
    {
        ProductoId = i.ProductoId,
        Nombre = i.NombreProducto,
        UnidadMedida = i.UnidadMedida,
        Cantidad = i.Cantidad,
        PrecioUnitario = i.PrecioUnitario,
        Subtotal = i.Subtotal,
        EsCombo = i.EsCombo == true,
        EsVario = i.EsVario,
        Extra = string.Join(" · ", new[]
        {
            i.Fecha > DateTime.MinValue ? "Fiado el " + i.Fecha.ToString("dd/MM/yyyy") : null,
            i.SubtotalHoy > i.Subtotal ? $"hoy vale $ {i.SubtotalHoy:N2}" : null
        }.Where(t => t != null))
    }).ToList();

    protected override async Task OnInitializedAsync()
    {
        // solo el dueño cobra / ve deudas (ni encargado ni vendedor, aunque escriban la dirección a mano)
        if (!Roles.VeFiado(State.UsuarioRol)) { Nav.NavigateTo("/productos"); return; }

        await CargarPersonas();

        if (PersonaId > 0)
        {
            personaSeleccionadaId = PersonaId;
            await CargarCuentaCorrientePersona();
        }
    }

    private async Task CargarPersonas()
    {
        try
        {
            var res = await SupaClient.From<Persona>().Where(f => f.KioscoId == State.KioscoId).Get();
            listaPersonas = (res.Models ?? new()).OrderBy(p => p.Nombre).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes: {ex.Message}");
        }
    }

    private async Task OnPersonaChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out long id))
        {
            personaSeleccionadaId = id;
            await CargarCuentaCorrientePersona();
        }
    }

    private async Task CargarCuentaCorrientePersona()
    {
        if (personaSeleccionadaId == 0) return;

        cargando = true;
        await PrecioServ.AsegurarReglasAsync(State.KioscoId);   // horarios de las listas (precio noche)
        mensajeError = "";
        listaProductosFiados.Clear();
        pagosAgregados.Clear();
        totalDeudaOriginal = 0;
        deudaPrecioHoy = 0;
        diferenciaAumento = 0;
        difHorario = 0; difDia = 0; modoPrecioHoy = "horario";
        cobrarActualizado = false;

        try
        {
            long kioscoId = State.KioscoId;
            // 1. Obtener todas las ventas registradas a nombre de la persona
            var resVentas = await SupaClient.From<Venta>()
                                        .Where(v => v.KioscoId == kioscoId)
                                        .Where(v => v.PersonaId == personaSeleccionadaId)
                                        .Get();

            var ventasPersona = resVentas.Models ?? new List<Venta>();


            // cuando el monto de la venta es negativo, significa que es un pago parcial/entrega de dinero que reduce la deuda
            ventasFiadas = ventasPersona.Where(v => v.Pagado == false).ToList();

            var respuesta_pp = await SupaClient
                .From<PagosParcialesxDeudasDTO>()
                .Where(x => x.KioscoId == kioscoId)
                .Where(x => x.PersonaId == personaSeleccionadaId)
                .Get();

            ListPagosParcialesEnDB = respuesta_pp.Models ?? new List<PagosParcialesxDeudasDTO>();


            totalDeudaOriginal = ventasFiadas.Sum(v => v.Total);

            // Cargar Historial de Entregas Parciales
            foreach (var e in ListPagosParcialesEnDB)
            {
                var nombrePagoEntregado = e.FormaPagoNombre.Equals("Fiado", StringComparison.OrdinalIgnoreCase) ? "Descontado" : e.FormaPagoNombre;
                pagosAgregados.Add(new PagoTemporal
                {
                    Fecha = e.Fecha,
                    NombreFormaPago = nombrePagoEntregado, // <-- Obtener el nombre de la forma de pago desde la venta
                    Monto = Math.Abs(e.TotalPagoEntregado),
                    NumeroUnicoIdentificatorio = e.NumeroUnicoIdentificatorioMovimiento, // <-- Asignar el NumeroUnicoIdentificatorio para identificar que ya está registrado en la BD
                    FormaPagoId = e.FormaPagoId
                });
            }

            // 2. Obtener los detalles de los productos que integran esas ventas fiadas
            if (ventasFiadas.Any())
            {
                var movsFiados = ventasFiadas.Select(v => v.NumeroUnicoIdentificatorioMovimiento).Distinct().ToList();

                // Solo los renglones de ESAS ventas (antes se traían todos los de la base y Supabase corta en 1000 filas)
                var detallesFiados = new List<VentaDetalle>();
                foreach (var tanda in movsFiados.Chunk(100))
                {
                    var criterio = tanda.Cast<object>().ToList();
                    var resDet = await SupaClient.From<VentaDetalle>()
                        .Filter(x => x.NumeroUnicoIdentificatorioMovimiento, Supabase.Postgrest.Constants.Operator.In, criterio)
                        .Get();
                    detallesFiados.AddRange(resDet.Models ?? new List<VentaDetalle>());
                }

                var productosIds = detallesFiados.Select(d => d.ProductoId).Distinct().ToList();

                // Solo los productos involucrados en la deuda que pertenezcan al kiosco
                var dictProductos = new Dictionary<long, Producto>();
                foreach (var tanda in productosIds.Chunk(100))
                {
                    var criterio = tanda.Cast<object>().ToList();
                    var resProd = await SupaClient.From<Producto>()
                        .Where(x => x.KioscoId == State.KioscoId)
                        .Filter(x => x.Id, Supabase.Postgrest.Constants.Operator.In, criterio)
                        .Get();
                    foreach (var p in resProd.Models ?? new List<Producto>()) dictProductos[p.Id] = p;
                }

                foreach (var d in detallesFiados)
                {
                    var existeProducto = dictProductos.TryGetValue(d.ProductoId, out var prod);

                    string nombreProd = existeProducto ? prod.Nombre : "Producto #" + d.ProductoId;

                    // Si la unidad de medida es nula o vacía, toma "unidad" por defecto
                    string unidadProd = (existeProducto && !string.IsNullOrWhiteSpace(prod.UnidadMedida))
                                        ? prod.UnidadMedida
                                        : "unidad";

                    listaProductosFiados.Add(new ProductoFiadoItem
                    {
                        NombreProducto = nombreProd,
                        UnidadMedida = unidadProd, // <-- Asignación de la Unidad de Medida
                        Cantidad = d.Cantidad,
                        PrecioUnitario = d.PrecioUnitario,
                        Subtotal = d.Subtotal,
                        EsCombo = prod != null ? prod.EsCombo : false,
                        ProductoId = prod != null ? prod.Id : 0,
                        Fecha = d.FechaCreacion,
                        SubtotalHoy = existeProducto ? Math.Max(d.Subtotal, SubtotalPrecioHoy(prod!, d.Cantidad, ColumnaDeLaVenta(d.NumeroUnicoIdentificatorioMovimiento))) : d.Subtotal
                    });
                }

                // Productos "varios" fiados (no tienen precio en la lista: valen lo mismo hoy)
                var varios = new List<ProductoVarioVenta>();
                foreach (var tanda in movsFiados.Chunk(100))
                {
                    var criterio = tanda.Cast<object>().ToList();
                    var resVar = await SupaClient.From<ProductoVarioVenta>()
                        .Where(x => x.KioscoId == kioscoId)
                        .Filter(x => x.NumeroUnicoIdentificatorioMovimiento, Supabase.Postgrest.Constants.Operator.In, criterio)
                        .Get();
                    varios.AddRange(resVar.Models ?? new List<ProductoVarioVenta>());
                }
                foreach (var v in varios)
                {
                    listaProductosFiados.Add(new ProductoFiadoItem
                    {
                        NombreProducto = v.NombreProducto ?? "Varios",
                        UnidadMedida = "unidad",
                        Cantidad = v.Cantidad,
                        PrecioUnitario = v.PrecioUnitario,
                        Subtotal = v.Subtotal,
                        SubtotalHoy = v.Subtotal,
                        EsVario = true,
                        Fecha = v.FechaCreacion
                    });
                }

                // Cada fiado se recalcula en proporción a cuánto subieron sus productos.
                // (Si en esa compra pagó una parte en efectivo, solo se actualiza la parte fiada.)
                // Es la misma cuenta que hace la vista vw_resumen_deudores.
                var hist = new Dictionary<long, decimal>();
                var hoy = new Dictionary<long, decimal>();      // según el horario en que lo sacó
                var hoyDia = new Dictionary<long, decimal>();   // todo a precio de día
                foreach (var d in detallesFiados)
                {
                    dictProductos.TryGetValue(d.ProductoId, out var prod);
                    long mv = d.NumeroUnicoIdentificatorioMovimiento;
                    decimal sh = prod != null ? Math.Max(d.Subtotal, SubtotalPrecioHoy(prod, d.Cantidad, ColumnaDeLaVenta(mv))) : d.Subtotal;
                    decimal sd = prod != null ? Math.Max(d.Subtotal, SubtotalPrecioHoy(prod, d.Cantidad, "precio_venta")) : d.Subtotal;
                    hist[mv] = hist.GetValueOrDefault(mv) + d.Subtotal;
                    hoy[mv] = hoy.GetValueOrDefault(mv) + sh;
                    hoyDia[mv] = hoyDia.GetValueOrDefault(mv) + sd;
                }
                foreach (var v in varios)
                {
                    long mv = v.NumeroUnicoIdentificatorioMovimiento;
                    hist[mv] = hist.GetValueOrDefault(mv) + v.Subtotal;
                    hoy[mv] = hoy.GetValueOrDefault(mv) + v.Subtotal;
                    hoyDia[mv] = hoyDia.GetValueOrDefault(mv) + v.Subtotal;
                }

                // Lo que ya se entregó a cada deuda (lo reparte la base, FIFO): eso no se actualiza;
                // solo lo que falta pagar se lleva a precio de hoy.
                var aplicado = new Dictionary<long, decimal>();
                try
                {
                    var ids = ventasFiadas.Select(v => v.Id).Cast<object>().ToList();
                    foreach (var tanda in ids.Chunk(100))
                    {
                        var resApl = await SupaClient.From<FiadoAplicacion>()
                            .Filter(x => x.DeudaVentaId, Supabase.Postgrest.Constants.Operator.In, tanda.ToList())
                            .Get();
                        foreach (var ap in resApl.Models ?? new())
                            aplicado[ap.DeudaVentaId] = aplicado.GetValueOrDefault(ap.DeudaVentaId) + ap.Monto;
                    }
                }
                catch { /* sin el SQL 22 se calcula como antes */ }

                decimal deudaHoyDia = 0;
                foreach (var venta in ventasFiadas)
                {
                    decimal ya = Math.Min(aplicado.GetValueOrDefault(venta.Id), venta.Total);
                    // un ajuste ya está "a precio de hoy" (el aumento se cuenta en las otras deudas): solo suma lo entregado
                    if (venta.EsAjustePrecio == true) { deudaPrecioHoy += ya; deudaHoyDia += ya; continue; }
                    decimal h = hist.GetValueOrDefault(venta.NumeroUnicoIdentificatorioMovimiento);
                    decimal a = hoy.GetValueOrDefault(venta.NumeroUnicoIdentificatorioMovimiento);
                    decimal ad = hoyDia.GetValueOrDefault(venta.NumeroUnicoIdentificatorioMovimiento);
                    decimal falta = venta.Total - ya;
                    deudaPrecioHoy += ya + (h > 0 ? falta * a / h : falta);
                    deudaHoyDia += ya + (h > 0 ? falta * ad / h : falta);
                }
                deudaPrecioHoy = Math.Round(deudaPrecioHoy, 2);
                difHorario = Math.Max(0, deudaPrecioHoy - totalDeudaOriginal);
                difDia = Math.Max(0, Math.Round(deudaHoyDia, 2) - totalDeudaOriginal);
                if (difHorario < 1) difHorario = 0;   // centavos: no vale la pena
                if (difDia < 1) difDia = 0;
                modoPrecioHoy = difHorario > 0 ? "horario" : "dia";
                ElegirPrecio("");
            }

        }
        catch (Exception ex)
        {
            mensajeError = "Error al recuperar cuenta corriente: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
    private async Task ProcesarCobroFiado()
    {
        if (guardando) return;                                  // evita guardar dos veces con un doble toque
        if (!pagosAgregados.Any(p => p.NumeroUnicoIdentificatorio == 0)) return;   // sin un pago nuevo no hay nada que registrar
        guardando = true;
        mensajeError = "";

        try
        {

            long kioscoId = State.KioscoId;
            long? personaId = personaSeleccionadaId > 0 ? personaSeleccionadaId : null;

            // ==========================================
            // 0. COBRAR A PRECIO DE HOY: se agrega un fiado de "ajuste por aumento"
            //    (las ventas viejas no se tocan; el ajuste entra en el FIFO como una deuda más)
            // ==========================================
            if (cobrarActualizado && diferenciaAumento > 0)
            {
                if (!await avisos.ConfirmarAsync("¿Cobrar a precio de hoy?",
                        $"Se suma $ {diferenciaAumento:N2} a la deuda por aumento de precios.", "Sí, actualizar", "aviso"))
                {
                    return;
                }

                var rpcAjuste = await SupaClient.Rpc("obtener_proximo_movimiento", null);
                long movAjuste = Convert.ToInt64(rpcAjuste.Content);
                long formaPagoFiado = await FormaPagoFiadoIdAsync();

                var resAjuste = await SupaClient.From<Venta>().Insert(new Venta
                {
                    NumeroUnicoIdentificatorioMovimiento = movAjuste,
                    Fecha = DateTime.Today,
                    Total = diferenciaAumento,
                    FormaPagoId = formaPagoFiado,
                    KioscoId = kioscoId,
                    UsuarioOperadorId = State.UsuarioId,
                    PersonaId = personaId,
                    Pagado = false,
                    EsAjustePrecio = true
                });
                var ajuste = resAjuste.Models.FirstOrDefault();
                if (ajuste != null) ventasFiadas.Add(ajuste);
                totalDeudaOriginal += diferenciaAumento;
                diferenciaAumento = 0;
                cobrarActualizado = false;
            }

            // ==========================================
            // 1. REGISTRAR PAGOS NUEVOS (Si existen)
            // ==========================================
            var pagosNuevos = pagosAgregados.Where(p => p.NumeroUnicoIdentificatorio == 0).ToList();

            if (pagosNuevos.Any())
            {
                var respuestaRpc = await SupaClient.Rpc("obtener_proximo_movimiento", null);
                long numeroMovimientoUnico = Convert.ToInt64(respuestaRpc.Content);

                var nuevasVentasPago = pagosNuevos.Select(pago => new Venta
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    Fecha = DateTime.Today,
                    Total = Math.Abs(pago.Monto) * (-1), // Ingreso de dinero (negativo)
                    FormaPagoId = pago.FormaPagoId,
                    KioscoId = kioscoId,
                    UsuarioOperadorId = State.UsuarioId,
                    PersonaId = personaId,
                    Pagado = true
                }).ToList();

                // Inserción masiva de los pagos nuevos
                await SupaClient.From<Venta>().Insert(nuevasVentasPago);
            }

            // ==========================================
            // 2. APLICAR LAS ENTREGAS A LAS DEUDAS (FIFO)
            //    Lo hace la base, todo junto o nada (_sql\22.fiado_fifo.sql): una entrega puede saldar
            //    varias deudas y una deuda puede necesitar varias entregas. Al cargar la entrega se
            //    recalcula sola; se llama igual por las dudas. No se agregan renglones en ventas.
            // ==========================================
            if (personaId is long idPersona)
                await SupaClient.Rpc("recalcular_fiado", new Dictionary<string, object> { { "p_persona", idPersona } });

            Nav.NavigateTo(RutaOrigenReporte);
        }
        catch (Exception ex)
        {
            var msg = ex.Message ?? "";
            mensajeError = msg.Contains("recalcular_fiado") || msg.Contains("PGRST202")
                ? "La entrega se guardó, pero falta preparar la base: hay que correr el script 22.fiado_fifo.sql en Supabase."
                : "Error al guardar el cobro: " + msg;
        }
        finally
        {
            guardando = false;
        }
    }
    private void AgregarPago(MediosDePago.PagoCargado p)
    {
        mensajeError = "";
        pagosAgregados.Add(new PagoTemporal
        {
            FormaPagoId = p.FormaPagoId,
            Fecha = DateTime.Today,
            NombreFormaPago = p.NombreMostrar,
            Monto = p.Monto
        });
    }

    /// <summary>
    /// Lo que vale hoy esa cantidad (en los productos por peso la cantidad está en gramos y el precio es por kilo).
    /// Si la cantidad llega al mínimo por mayor, se usa el precio por mayor de hoy (si no, una compra
    /// por mayor parecía un "aumento"). Es la misma cuenta que la vista vw_resumen_deudores (SQL 21).
    /// </summary>
    private decimal SubtotalPrecioHoy(Producto prod, decimal cantidad, string columna = "precio_venta")
    {
        // precio de hoy de la lista que corresponde (día o noche); por kilo en los productos por peso
        decimal precio = BlazorKioscoCompartido.Services.PrecioService.PrecioSegunLista(prod, columna, State.KioscoId);
        if (prod.EsVentaPorPeso()) return precio / 1000m * cantidad;

        int minimo = prod.CantxMayor ?? 0;
        decimal porMayor = prod.PrecioVentaxMayor ?? 0;
        if (minimo > 1 && porMayor > 0 && cantidad >= minimo) precio = porMayor;
        return precio * cantidad;
    }

    /// <summary>La forma de pago "Fiado" del negocio (si no existe, la del último fiado).</summary>
    private async Task<long> FormaPagoFiadoIdAsync()
    {
        try
        {
            var res = await SupaClient.From<FormaPago>().Where(f => f.KioscoId == State.KioscoId).Get();
            var fiado = (res.Models ?? new()).FirstOrDefault(f => string.Equals(f.Nombre?.Trim(), "FIADO", StringComparison.OrdinalIgnoreCase));
            if (fiado != null) return fiado.Id;
        }
        catch { }
        return ventasFiadas.OrderByDescending(v => v.NumeroUnicoIdentificatorioMovimiento).Select(v => v.FormaPagoId).FirstOrDefault();
    }

    /// <summary>Solo se pueden quitar las entregas nuevas: las anteriores ya están guardadas y entran en la cuenta.</summary>
    private void RemoverPago(PagoTemporal pago)
    {
        if (pago.NumeroUnicoIdentificatorio == 0) pagosAgregados.Remove(pago);
    }
