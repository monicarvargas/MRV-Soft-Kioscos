@inject BlazorKioscoCompartido.Services.AppState State
@implements IDisposable
@inject CarritoService Carrito
@inject NavigationManager Nav
@inject Supabase.Client SupaClient
@inject IJSRuntime JS
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Components
@using System.Globalization
@using BlazorKioscoCompartido.Services
@using BlazorKioscoCompartido.Services.SinInternet

<PedidosEstilos />
<ConfigEstilos />
<ProductoEstilos />
<VentasEstilos />
<AvisosPagina @ref="avisos" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Cobrar"
                      Subtitulo="Elegí cómo paga el cliente"
                      IconoClass="bi-credit-card-2-front-fill"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="@RutaOrigenVentas" />

    @if (State.KioscoId == 0 || State.CarritoActual == null || !State.CarritoActual.Any())
    {
        <div class="vt-wrap gp-card gp-card-pad">
            <div class="gp-empty">
                <span class="gp-bubble"><i class="bi bi-cart-x"></i></span>
                <strong>No hay una venta para cobrar</strong>
                <span>Cargá los productos en Vender y después tocá "Cobrar".</span>
                <button type="button" class="gp-btn gp-btn-primary" style="margin-top:.8rem" @onclick="VolverAVender"><i class="bi bi-arrow-left"></i> Ir a Vender</button>
            </div>
        </div>
    }
    else
    {
        @if (SinInternet)
        {
            <div class="vt-wrap gp-banner" style="margin-bottom:.8rem; background:var(--gp-warn-soft); border-color:var(--gp-warn-line); color:var(--gp-warn)">
                <i class="bi bi-wifi-off"></i>
                <p><b>Sin internet:</b> la venta se guarda en esta PC y se sube sola cuando vuelva internet. Sin internet no se puede fiar.</p>
            </div>
        }
        <div class="vt-wrap vt-cols">
            @* ================= IZQUIERDA ================= *@
            <div class="vt-col">
                @* Cliente (solo si el plan incluye fiado; sin internet no se fía) *@
                @if (State.Tiene(FuncionesPlan.Fiado) && !SinInternet)
                {
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.7rem">
                        <span class="gp-bubble gp-bubble-sm"><i class="bi bi-person-badge-fill"></i></span>
                        <div class="vt-head-text">
                            <h2 style="font-size:1.05rem">Cliente</h2>
                            <p>Para fiar, elegí primero el cliente: ahí aparece la forma de pago Fiado.</p>
                        </div>
                    </div>
                    <select class="gp-control" style="@(FaltaClienteParaFiado ? "border-color:var(--gp-danger); box-shadow:0 0 0 3px var(--gp-danger-soft)" : "")" @bind="personaSeleccionadaId">
                        <option value="0">-- Consumidor final --</option>
                        @foreach (var persona in listaPersonas.Where(p => p.Habilitado))
                        {
                            <option value="@persona.Id">@persona.Nombre</option>
                        }
                    </select>
                    @if (FaltaClienteParaFiado)
                    {
                        <div class="gp-hint" style="margin-top:.5rem; color:var(--gp-danger)"><i class="bi bi-exclamation-triangle-fill" style="color:var(--gp-danger)"></i> Hay un pago con Fiado: elegí a quién se le fía.</div>
                    }
                </section>
                }

                @* Forma de pago *@
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head">
                        <span class="gp-bubble"><i class="bi bi-wallet2"></i></span>
                        <div class="vt-head-text">
                            <h2>Forma de pago</h2>
                            <p>Se puede pagar con más de una: cargá cada parte.</p>
                        </div>
                    </div>
                    <MediosDePago Restante="@Math.Max(0, Restante)" OnPagoCargado="AgregarPago" PermitirFiado="@(personaSeleccionadaId > 0)" />
                </section>

                @* Productos *@
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head">
                        <span class="gp-bubble"><i class="bi bi-cart3"></i></span>
                        <div class="vt-head-text">
                            <h2>Productos (@State.CarritoActual.Count)</h2>
                        </div>
                        <button type="button" class="gp-btn gp-btn-outline gp-btn-sm vt-head-right" @onclick="VolverAVender"><i class="bi bi-pencil"></i> Modificar</button>
                    </div>
                    <DetalleArticulos Filas="FilasCarrito" AltoMaximo="320px" />

                    @if (!SinInternet && State.CarritoActual.Any(item => item.Producto.EsCombo == true))
                    {
                        <div class="cf-section"><i class="bi bi-boxes"></i> Contenido de los combos</div>
                        @foreach (var item in State.CarritoActual.Where(i => i.Producto.EsCombo == true))
                        {
                            <div style="margin:0 0 .6rem; padding-left:.7rem; border-left:3px solid var(--gp-ok-line)">
                                <div class="gp-muted" style="margin-bottom:.2rem">@item.Producto.Nombre</div>
                                <DetalleComboView ComboId="@item.Producto.Id" />
                            </div>
                        }
                    }
                </section>
            </div>

            @* ================= DERECHA ================= *@
            <div class="vt-col">
                @* Pagos cargados *@
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.8rem">
                        <span class="gp-bubble gp-bubble-sm"><i class="bi bi-receipt"></i></span>
                        <div class="vt-head-text"><h2 style="font-size:1.05rem">Pagos cargados</h2></div>
                    </div>
                    @if (!pagosAgregados.Any())
                    {
                        <div class="gp-hint"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> Todavía no cargaste ningún pago. Elegí la forma de pago y tocá "Cargar".</div>
                    }
                    else
                    {
                        <ul class="vt-pagos">
                            @foreach (var p in pagosAgregados)
                            {
                                <li class="vt-pago">
                                    <i class="bi @BlazorKioscoCompartido.Services.Utilidades.ObtenerIconoFormaPago(p.NombreFormaPago)"></i>
                                    <div class="vt-pago-info"><b>@p.NombreFormaPago</b></div>
                                    <span class="vt-pago-monto">$ @p.Monto.ToString("N2")</span>
                                    <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" title="Quitar" @onclick="() => RemoverPago(p)"><i class="bi bi-x-lg"></i></button>
                                </li>
                            }
                        </ul>
                    }
                </section>

                @* Caja *@
                <div class="vt-caja">
                    <span class="vt-caja-label">Total a cobrar</span>
                    <div class="vt-caja-total">$ @State.TotalVentaActual.ToString("N2")</div>
                    @if (PrecioDiaAplicado)
                    {
                        <div style="margin:-.2rem 0 .6rem; color:#7ee2b8; font-size:.82rem; font-weight:800">
                            <i class="bi bi-sun-fill"></i> Fiado: se cobra a precio de día (- $ @ahorroPrecioDia.ToString("N2"))
                        </div>
                    }

                    <div class="vt-caja-filas">
                        <div class="vt-caja-fila"><span>Pagado</span><b>$ @TotalIngresado.ToString("N2")</b></div>
                        <div class="vt-caja-fila">
                            <span>Falta</span>
                            <b class="@(Restante > 0 ? "is-falta" : "is-ok")">$ @(Restante > 0 ? Restante.ToString("N2") : "0,00")</b>
                        </div>
                    </div>

                    <div class="vt-caja-vuelto">
                        <span class="vt-caja-label">Vuelto</span>
                        <strong>$ @VueltoCalculado.ToString("N2")</strong>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="gp-banner is-danger"><i class="bi bi-exclamation-octagon-fill"></i><p>@mensajeError</p></div>
                    }

                    <div class="tk-opc">
                        <label class="tk-sw" title="Imprime el ticket en la impresora de rollo al confirmar (queda guardado en este equipo)">
                            <input type="checkbox" checked="@imprimirTicket" @onchange="CambiarTicket" />
                            <i class="bi bi-receipt"></i> Imprimir ticket
                        </label>
                        @if (imprimirTicket)
                        {
                            <select class="tk-ancho" value="@anchoTicket" @onchange="CambiarAncho" title="Ancho del rollo">
                                <option value="58">Rollo 58 mm</option>
                                <option value="80">Rollo 80 mm</option>
                            </select>
                        }
                    </div>

                    <button type="button" class="gp-btn gp-btn-ok" data-atajo="F4" title="F4" disabled="@(guardando || TotalIngresado < State.TotalVentaActual || !pagosAgregados.Any())" @onclick="ProcesarCobro">
                        @if (guardando)
                        {
                            <span class="gp-spinner" style="width:1.1rem;height:1.1rem;border-width:2px"></span> <span>Guardando...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-circle-fill"></i> <span>Confirmar venta</span>
                        }
                    </button>
                </div>

                <button type="button" class="gp-btn gp-btn-danger-soft" @onclick="CancelarVentaAsync"><i class="bi bi-x-circle"></i> Cancelar toda la venta</button>
            </div>
        </div>
    }
</div>

@* ===== TICKET: es lo único que sale en la impresión ===== *@
@if (ticket != null)
{
    <div class="tk-ticket" style="width:@(anchoTicket)mm; font-size:@(anchoTicket >= 80 ? "10pt" : "8.5pt")">
        <div class="tk-c tk-neg">@ticket.Negocio</div>
        <div class="tk-c">@ticket.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
        @if (!string.IsNullOrWhiteSpace(ticket.Cliente)) { <div class="tk-c">Cliente: @ticket.Cliente</div> }
        <div class="tk-sep"></div>
        @foreach (var l in ticket.Lineas)
        {
            <div class="tk-item">@l.Nombre</div>
            <div class="tk-fila"><span>@l.Detalle</span><span>$ @Plata(l.Subtotal)</span></div>
        }
        <div class="tk-sep"></div>
        <div class="tk-fila tk-total"><span>TOTAL</span><span>$ @Plata(ticket.Total)</span></div>
        @foreach (var p in ticket.Pagos)
        {
            <div class="tk-fila"><span>@p.Nombre</span><span>$ @Plata(p.Monto)</span></div>
        }
        @if (ticket.Vuelto > 0)
        {
            <div class="tk-fila"><span>Vuelto</span><span>$ @Plata(ticket.Vuelto)</span></div>
        }
        <div class="tk-sep"></div>
        <div class="tk-c">¡Gracias por su compra!</div>
        <div class="tk-c tk-chico">Comprobante no válido como factura</div>
    </div>

    <style>
        @@media print {
            @@page { size: @(anchoTicket)mm auto; margin: 0; }
            html, body { margin: 0 !important; padding: 0 !important; background: #fff !important; }
            body * { visibility: hidden !important; }
            .tk-ticket, .tk-ticket * { visibility: visible !important; }
            .tk-ticket { display: block !important; position: absolute; left: 0; top: 0; }
        }
    </style>
}

<style>
    .tk-opc { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin: .2rem 0 .7rem; }
    .tk-sw { display: inline-flex; align-items: center; gap: .45rem; margin: 0; color: #cfd6ea; font-weight: 700; font-size: .88rem; cursor: pointer; }
    .tk-sw input { width: 1.1rem; height: 1.1rem; accent-color: #22c55e; }
    .tk-ancho { border: 1px solid rgba(255,255,255,.25); border-radius: 8px; background: rgba(255,255,255,.08); color: #fff; font-size: .8rem; font-weight: 700; padding: .2rem .4rem; }
    .tk-ancho option { color: #1b2540; }
    .tk-ticket { display: none; padding: 2mm 3mm 6mm; background: #fff; color: #000; font-family: "Courier New", Consolas, monospace; line-height: 1.25; }
    .tk-c { text-align: center; }
    .tk-neg { font-weight: 900; font-size: 1.25em; text-transform: uppercase; }
    .tk-chico { font-size: .8em; }
    .tk-sep { border-top: 1px dashed #000; margin: 1.5mm 0; }
    .tk-item { text-transform: uppercase; word-break: break-word; }
    .tk-fila { display: flex; justify-content: space-between; gap: 2mm; }
    .tk-fila span:last-child { white-space: nowrap; }
    .tk-total { font-weight: 900; font-size: 1.2em; }
</style>

@code {
    [Parameter] public string RutaOrigenVentas { get; set; } = "/vender-desktop";

    // ===================== TICKET (impresora de rollo angosto) =====================
    private sealed record LineaTicket(string Nombre, string Detalle, decimal Subtotal);
    private sealed record PagoTicket(string Nombre, decimal Monto);
    private sealed record DatosTicket(string Negocio, DateTime Fecha, string? Cliente, List<LineaTicket> Lineas, decimal Total, List<PagoTicket> Pagos, decimal Vuelto);

    private bool imprimirTicket;      // se recuerda en este equipo
    private int anchoTicket = 58;     // 58 u 80 mm
    private DatosTicket? ticket;
    private const string ClaveTicket = "mrv_imprimir_ticket", ClaveAncho = "mrv_ancho_ticket";

    private static string Plata(decimal v) => v.ToString("N2", CultureInfo.GetCultureInfo("es-AR"));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            imprimirTicket = await JS.InvokeAsync<string?>("localStorage.getItem", ClaveTicket) == "1";
            if (int.TryParse(await JS.InvokeAsync<string?>("localStorage.getItem", ClaveAncho), out var a) && (a == 58 || a == 80)) anchoTicket = a;
            if (imprimirTicket) StateHasChanged();
        }
        catch { /* sin almacenamiento del navegador: queda apagado */ }
    }

    private async Task CambiarTicket(ChangeEventArgs e)
    {
        imprimirTicket = e.Value is bool b && b;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveTicket, imprimirTicket ? "1" : "0"); } catch { }
    }

    private async Task CambiarAncho(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var a) && (a == 58 || a == 80)) anchoTicket = a;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ClaveAncho, anchoTicket.ToString()); } catch { }
    }

    /// <summary>Foto de la venta para el ticket (antes de vaciar el carrito).</summary>
    private DatosTicket ArmarTicket(decimal vuelto)
    {
        var c = CultureInfo.GetCultureInfo("es-AR");
        var lineas = (State.CarritoActual ?? new()).Select(i =>
        {
            string detalle = !i.EsProductoVario && i.Producto.EsVentaPorPeso()
                ? $"{i.Cantidad:N0} g"
                : $"{i.Cantidad} x $ {i.PrecioUnitario.ToString("N2", c)}";
            return new LineaTicket(i.Producto.Nombre ?? "", detalle, i.Subtotal);
        }).ToList();
        var cliente = personaSeleccionadaId > 0 ? listaPersonas.FirstOrDefault(p => p.Id == personaSeleccionadaId)?.Nombre : null;
        return new DatosTicket(State.NombreNegocio ?? "", DateTime.Now, cliente, lineas, State.TotalVentaActual,
            PagosAGuardar().Select(p => new PagoTicket(p.NombreFormaPago, p.Monto)).ToList(), vuelto);
    }

    private async Task ImprimirTicketAsync(DatosTicket datos)
    {
        ticket = datos;
        StateHasChanged();
        await Task.Delay(120);   // que se dibuje el ticket antes de abrir la impresión
        try { await JS.InvokeVoidAsync("print"); }
        catch { avisos.Toast("No se pudo abrir la impresión del ticket.", "peligro"); }
    }

    private AvisosPagina avisos = default!;
    private string mensajeError = "";
    private bool guardando;

    public class PagoTemporal
    {
        public long FormaPagoId { get; set; }
        public string NombreFormaPago { get; set; } = "";
        public decimal Monto { get; set; }
    }

    private List<PagoTemporal> pagosAgregados = new();
    private List<Persona> listaPersonas = new();
    private long personaSeleccionadaId = 0;

    private decimal TotalIngresado => pagosAgregados.Sum(p => p.Monto);
    private decimal Restante => State.TotalVentaActual - TotalIngresado;

    private static bool EsFiado(string? nombre) => string.Equals(nombre?.Trim(), "FIADO", StringComparison.OrdinalIgnoreCase);
    private static bool EsEfectivo(string? nombre) => (nombre ?? "").Contains("efectivo", StringComparison.OrdinalIgnoreCase);

    private bool FaltaClienteParaFiado => personaSeleccionadaId == 0 && pagosAgregados.Any(p => EsFiado(p.NombreFormaPago));

    private List<DetalleArticulos.FilaArticulo> FilasCarrito => (State.CarritoActual ?? new()).Select(i => new DetalleArticulos.FilaArticulo
    {
        ProductoId = i.Producto.Id,
        Nombre = i.Producto.Nombre ?? "",
        UnidadMedida = i.Producto.UnidadMedida,
        Cantidad = i.Cantidad,
        PrecioUnitario = i.PrecioUnitario,
        Subtotal = i.Subtotal,
        EsVario = i.EsProductoVario,
        EsCombo = i.Producto.EsCombo == true
    }).ToList();

    private decimal VueltoCalculado
    {
        get
        {
            if (TotalIngresado <= State.TotalVentaActual) return 0;
            decimal vueltoBruto = TotalIngresado - State.TotalVentaActual;

            if (State.UsarRedondeo && State.MultiploRedondeo > 0)
            {
                decimal resto = vueltoBruto % State.MultiploRedondeo;
                return vueltoBruto - resto;
            }
            return vueltoBruto;
        }
    }

    /// <summary>ETAPA 7: sin internet (o entró sin internet) la venta se guarda en la PC.</summary>
    private static bool SinInternet => VentaSinInternet.Actual?.ModoLimitado == true;

    protected override async Task OnInitializedAsync()
    {
        if (SinInternet) return;   // sin internet no se fía: no hacen falta los clientes
        await CargarPersonas();
    }

    private async Task CargarPersonas()
    {
        try
        {
            var res = await SupaClient.From<Persona>().Where(f => f.KioscoId == State.KioscoId).Get();
            listaPersonas = (res.Models ?? new()).OrderBy(p => p.Nombre).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes/personas: {ex.Message}");
        }
    }

    private async Task AgregarPago(MediosDePago.PagoCargado p)
    {
        mensajeError = "";
        decimal monto = p.Monto;

        if (EsFiado(p.Nombre))
        {
            // Si la venta va con otra lista (ej: noche) se PREGUNTA a qué precio se fía. Antes era siempre precio de día.
            decimal restanteAntes = Restante;
            decimal ahorro = AhorroSiPrecioDia();
            if (ahorro > 0 && !PrecioDiaAplicado)
            {
                var colAhora = BlazorKioscoCompartido.Services.PrecioService.ColumnaSegunMomento(State.KioscoId, DateTime.Now) ?? "precio_lista2";
                var lista = BlazorKioscoCompartido.Services.PrecioService.NombreLista(State.KioscoId, colAhora == "precio_venta" ? "precio_lista2" : colAhora);
                if (string.IsNullOrWhiteSpace(lista)) lista = "noche";
                decimal total = State.TotalVentaActual;
                bool aDia = await avisos.ConfirmarAsync("¿A qué precio se fía?",
                    $"La venta va con precio {lista}: $ {total:N2}. A precio de día sería $ {total - ahorro:N2} ($ {ahorro:N2} menos).",
                    $"Precio de día ($ {total - ahorro:N2})", "aviso", $"Precio {lista} ($ {total:N2})");
                if (aDia) AplicarPrecioDia();
            }
            if (PrecioDiaAplicado && monto >= restanteAntes) monto = Math.Max(0, Restante);   // era "lo que falta": se ajusta al nuevo total
            if (monto <= 0) { avisos.Toast("No queda nada por cobrar.", "info"); return; }
        }

        pagosAgregados.Add(new PagoTemporal { FormaPagoId = p.FormaPagoId, NombreFormaPago = p.Nombre, Monto = monto });
    }

    private void RemoverPago(PagoTemporal pago)
    {
        pagosAgregados.Remove(pago);
        if (EsFiado(pago.NombreFormaPago) && !pagosAgregados.Any(x => EsFiado(x.NombreFormaPago)))
            QuitarPrecioDia();
    }

    // ===================== PRECIO DE DÍA PARA EL FIADO =====================
    // Se guarda el precio que tenía cada producto para poder volver atrás si se quita el fiado.
    private readonly Dictionary<ItemCarrito, decimal> preciosAntesDelFiado = new();
    private decimal ahorroPrecioDia = 0;
    private bool PrecioDiaAplicado => preciosAntesDelFiado.Any();

    /// <summary>Cuánto bajaría la venta si todo fuera a precio de día (0 = ya está a precio de día).</summary>
    private decimal AhorroSiPrecioDia()
    {
        if (State.CarritoActual == null) return 0;
        decimal ahorro = 0;
        foreach (var item in State.CarritoActual.Where(i => !i.EsProductoVario))
        {
            decimal precioDia = item.Producto.PrecioVenta ?? 0;
            if (precioDia > 0 && precioDia < item.PrecioUnitario)
            {
                decimal antes = item.Subtotal;
                decimal guardado = item.PrecioUnitario;
                item.PrecioUnitario = precioDia;
                ahorro += antes - item.Subtotal;
                item.PrecioUnitario = guardado;
            }
        }
        return Math.Max(0, ahorro);
    }

    private void AplicarPrecioDia()
    {
        if (PrecioDiaAplicado || State.CarritoActual == null) return;
        decimal totalAntes = State.TotalVentaActual;

        foreach (var item in State.CarritoActual.Where(i => !i.EsProductoVario))
        {
            decimal precioDia = item.Producto.PrecioVenta ?? 0;
            if (precioDia > 0 && precioDia < item.PrecioUnitario)
            {
                preciosAntesDelFiado[item] = item.PrecioUnitario;
                item.PrecioUnitario = precioDia;
            }
        }

        if (PrecioDiaAplicado)
        {
            State.TotalVentaActual = State.CarritoActual.Sum(i => i.Subtotal);
            ahorroPrecioDia = totalAntes - State.TotalVentaActual;
            avisos.Toast($"Fiado: precio de día. El total bajó $ {ahorroPrecioDia:N2}", "info", 3500);
        }
    }

    /// <summary>Si sale de la página sin confirmar (flecha de volver, menú), los precios vuelven a los de la lista del horario.</summary>
    public void Dispose() => QuitarPrecioDia();

    private void QuitarPrecioDia()
    {
        if (!PrecioDiaAplicado || State.CarritoActual == null) return;
        foreach (var kv in preciosAntesDelFiado) kv.Key.PrecioUnitario = kv.Value;
        preciosAntesDelFiado.Clear();
        ahorroPrecioDia = 0;
        State.TotalVentaActual = State.CarritoActual.Sum(i => i.Subtotal);
    }

    private async Task CancelarVentaAsync()
    {
        if (!await avisos.ConfirmarAsync("¿Cancelar toda la venta?", "Se borran los productos y los pagos cargados.", "Cancelar venta", "peligro", "Seguir cobrando")) return;
        pagosAgregados.Clear();
        Carrito.Vaciar();
        State.CarritoActual = null;
        State.TotalVentaActual = 0;
        Nav.NavigateTo(RutaOrigenVentas);
    }

    private void VolverAVender()
    {
        QuitarPrecioDia();   // en Vender se sigue con los precios de la lista del horario
        Nav.NavigateTo(RutaOrigenVentas);
    }

    /// <summary>
    /// Lo que se guarda de cada pago. Si el cliente entregó de más, ese excedente es VUELTO y no es venta:
    /// se descuenta del efectivo (y si no hubo efectivo, del último pago). Antes se guardaba lo entregado,
    /// y una compra de $3.200 pagada con $5.000 quedaba como venta de $5.000.
    /// </summary>
    private List<PagoTemporal> PagosAGuardar()
    {
        var lista = pagosAgregados.Select(p => new PagoTemporal { FormaPagoId = p.FormaPagoId, NombreFormaPago = p.NombreFormaPago, Monto = p.Monto }).ToList();
        decimal exceso = lista.Sum(p => p.Monto) - State.TotalVentaActual;
        if (exceso <= 0) return lista;

        foreach (var p in lista.Where(x => EsEfectivo(x.NombreFormaPago)).Reverse().Concat(Enumerable.Reverse(lista)))
        {
            if (exceso <= 0) break;
            var q = Math.Min(p.Monto, exceso);
            p.Monto -= q;
            exceso -= q;
        }
        return lista.Where(p => p.Monto > 0).ToList();
    }

    private async Task ProcesarCobro()
    {
        if (guardando) return;   // evita guardar dos veces con un doble toque
        mensajeError = "";
        if (!pagosAgregados.Any()) return;

        if (FaltaClienteParaFiado)
        {
            mensajeError = "Elegí el cliente: hay una parte que queda fiada.";
            return;
        }

        guardando = true;
        decimal vuelto = VueltoCalculado;
        datosTicket = imprimirTicket ? ArmarTicket(vuelto) : null;

        // ETAPA 7: sin internet se guarda en la PC
        if (SinInternet)
        {
            await GuardarSinInternetAsync(vuelto);
            return;
        }

        try
        {
            long numeroMovimientoUnico;
            try
            {
                var respuestaRpc = await SupaClient.Rpc("obtener_proximo_movimiento", null);
                numeroMovimientoUnico = Convert.ToInt64(respuestaRpc.Content);
            }
            catch (Exception exRed) when (VentaSinInternet.Actual != null && VentaSinInternet.EsErrorDeRed(exRed)
                                          && !pagosAgregados.Any(p => EsFiado(p.NombreFormaPago)))
            {
                // se cortó internet ANTES de guardar nada: la venta queda en la PC (no se guarda a medias)
                VentaSinInternet.Actual.MarcarSinConexion();
                await GuardarSinInternetAsync(vuelto);
                return;
            }

            // --- 1. Cabeceras: una fila de venta por cada forma de pago (cobros mixtos) ---
            foreach (var pago in PagosAGuardar())
            {
                bool esFiado = EsFiado(pago.NombreFormaPago);

                var filaVenta = new Venta
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    Fecha = DateTime.Today,
                    Total = pago.Monto,
                    FormaPagoId = pago.FormaPagoId,
                    KioscoId = State.KioscoId,
                    UsuarioOperadorId = State.UsuarioId,
                    PersonaId = personaSeleccionadaId > 0 ? personaSeleccionadaId : null,
                    Pagado = !esFiado
                };
                await SupaClient.From<Venta>().Insert(filaVenta);
            }

            // --- 2. Separar los productos normales de los "varios" (sin código) ---
            var itemsNormales = State.CarritoActual!.Where(i => !i.EsProductoVario).ToList();
            var itemsVarios = State.CarritoActual!.Where(i => i.EsProductoVario).ToList();

            // --- 3. Detalle de productos y descuento de stock / límite de combos ---
            if (itemsNormales.Any())
            {
                var detallesProductos = itemsNormales.Select(item => new VentaDetalle
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    ProductoId = item.Producto.Id,
                    Cantidad = item.Cantidad,
                    PrecioUnitario = item.PrecioUnitario,
                    Subtotal = item.Subtotal,
                }).ToList();

                await SupaClient.From<VentaDetalle>().Insert(detallesProductos);

                foreach (var item in itemsNormales)
                {
                    if (item.Producto.EsCombo == true)
                    {
                        // Combo: se descuenta el stock de cada producto que lo compone
                        var resDetallesCombo = await SupaClient
                            .From<ComboDetalle>()
                            .Where(d => d.ComboId == item.Producto.Id)
                            .Get();

                        foreach (var det in resDetallesCombo.Models ?? new())
                        {
                            long cantidadADescontar = (long)(det.Cantidad * item.Cantidad);

                            var productoIngrediente = await SupaClient
                                .From<Producto>()
                                .Where(p => p.Id == det.ProductoHijoId && p.KioscoId == State.KioscoId)
                                .Single();

                            if (productoIngrediente != null)
                            {
                                productoIngrediente.StockActual -= (int)cantidadADescontar;
                                if (productoIngrediente.StockActual < 0) productoIngrediente.StockActual = 0;

                                await SupaClient
                                    .From<Producto>()
                                    .Where(p => p.Id == productoIngrediente.Id && p.KioscoId == State.KioscoId)
                                    .Set(p => p.StockActual, productoIngrediente.StockActual)
                                    .Update();
                            }
                        }

                        // Límite de unidades de la promo
                        if (item.Producto.LimiteUnidadesCombo.HasValue)
                        {
                            item.Producto.LimiteUnidadesCombo -= (int)item.Cantidad;
                            if (item.Producto.LimiteUnidadesCombo < 0) item.Producto.LimiteUnidadesCombo = 0;

                            await SupaClient
                                .From<Producto>()
                                .Where(p => p.Id == item.Producto.Id && p.KioscoId == State.KioscoId)
                                .Set(p => p.LimiteUnidadesCombo, item.Producto.LimiteUnidadesCombo)
                                .Update();
                        }
                    }
                    else
                    {
                        // Producto normal: unidades, o gramos si es por peso
                        item.Producto.StockActual -= item.Cantidad;

                        await SupaClient
                            .From<Producto>()
                            .Where(p => p.Id == item.Producto.Id && p.KioscoId == State.KioscoId)
                            .Set(p => p.StockActual, item.Producto.StockActual)
                            .Update();
                    }
                }
            }

            // --- 4. Productos "varios" (sin código) ---
            if (itemsVarios.Any())
            {
                var registrosVarios = itemsVarios.Select(item => new ProductoVarioVenta
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    NombreProducto = item.Producto.Nombre,
                    Subtotal = item.Subtotal,
                    KioscoId = State.KioscoId,
                    Cantidad = item.Cantidad,
                    PrecioUnitario = item.PrecioUnitario,
                    FechaCreacion = DateTime.Today
                }).ToList();

                await SupaClient.From<ProductoVarioVenta>().Insert(registrosVarios);
            }

            // --- Limpieza ---
            pagosAgregados.Clear();
            Carrito.Vaciar();
            State.CarritoActual = null;
            State.TotalVentaActual = 0;
        }
        catch (Exception ex)
        {
            mensajeError = "Error al guardar el cobro: " + ex.Message;
            guardando = false;
            return;
        }

        guardando = false;
        if (datosTicket != null) await ImprimirTicketAsync(datosTicket);
        if (vuelto > 0)
            await avisos.InformarAsync("Venta guardada", $"Vuelto para el cliente: $ {vuelto:N2}", "exito", "Listo");

        Nav.NavigateTo(RutaOrigenVentas);
    }

    private DatosTicket? datosTicket;   // la venta que se está guardando (si se imprime ticket)

    /// <summary>
    /// ETAPA 7: guarda la venta en un archivo de la PC. Se sube sola cuando vuelve internet
    /// (con su hora real, sin duplicarse, y ahí se descuenta el stock).
    /// </summary>
    private async Task GuardarSinInternetAsync(decimal vuelto)
    {
        var off = VentaSinInternet.Actual;
        if (off == null)
        {
            mensajeError = "No hay internet y esta app no puede guardar ventas sin internet.";
            guardando = false;
            return;
        }
        if (pagosAgregados.Any(p => EsFiado(p.NombreFormaPago)))
        {
            mensajeError = "Sin internet no se puede fiar. Quitá el pago con Fiado.";
            guardando = false;
            return;
        }

        try
        {
            var carrito = State.CarritoActual ?? new();
            var venta = new VentaPendiente
            {
                KioscoId = State.KioscoId,
                UsuarioId = State.UsuarioId,
                UsuarioNombre = State.UsuarioNombre,
                Fecha = new DateTimeOffset(DateTime.Today),
                Hora = DateTimeOffset.Now,
                Total = State.TotalVentaActual,
                Pagos = PagosAGuardar().Select(p => new PagoPendiente { FormaPagoId = p.FormaPagoId, Nombre = p.NombreFormaPago, Monto = p.Monto }).ToList(),
                Items = carrito.Where(i => !i.EsProductoVario).Select(i => new ItemPendiente
                {
                    ProductoId = i.Producto.Id,
                    Nombre = i.Producto.Nombre,
                    Cantidad = i.Cantidad,
                    PrecioUnitario = i.PrecioUnitario,
                    Subtotal = i.Subtotal
                }).ToList(),
                Varios = carrito.Where(i => i.EsProductoVario).Select(i => new VarioPendiente
                {
                    Nombre = i.Producto.Nombre,
                    Cantidad = i.Cantidad,
                    PrecioUnitario = i.PrecioUnitario,
                    Subtotal = i.Subtotal
                }).ToList()
            };
            off.GuardarPendiente(venta);

            pagosAgregados.Clear();
            Carrito.Vaciar();
            State.CarritoActual = null;
            State.TotalVentaActual = 0;
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo guardar la venta en la PC: " + ex.Message;
            guardando = false;
            return;
        }

        guardando = false;
        if (datosTicket != null) await ImprimirTicketAsync(datosTicket);
        await avisos.InformarAsync("Venta guardada en la PC",
            (vuelto > 0 ? $"Vuelto para el cliente: $ {vuelto:N2}. " : "") + "Se sube sola cuando vuelva internet.",
            "exito", "Listo");
        Nav.NavigateTo(RutaOrigenVentas);
    }
}
