    .style-notebook input:focus, .style-notebook select:focus {
        border-color: #000000 !important;
        box-shadow: 0 0 0 0.2rem rgba(0,0,0,0.1) !important;
    }
</style>

@code {
    [Parameter] public string RutaOrigenVentas { get; set; } = "/vender-desktop";
    private string mensajeError = "";
    public class PagoTemporal
    {
        public long FormaPagoId { get; set; }
        public string NombreFormaPago { get; set; }
        public decimal Monto { get; set; }
    }

    private List<PagoTemporal> pagosAgregados = new List<PagoTemporal>();
    private List<Persona> listaPersonas = new List<Persona>();
    private long personaSeleccionadaId = 0;

    private long formaPagoSeleccionada = 1;
    private string nombreFormaPagoSeleccionada = "Efectivo";
    private decimal montoAIngresar;

    private decimal TotalIngresado => pagosAgregados.Sum(p => p.Monto);
    private decimal Restante => State.TotalVentaActual - TotalIngresado;

    private decimal VueltoCalculado
    {
        get
        {
            if (TotalIngresado <= State.TotalVentaActual) return 0;
            decimal vueltoBruto = TotalIngresado - State.TotalVentaActual;

            if (State.UsarRedondeo && State.MultiploRedondeo > 0)
            {
                decimal resto = vueltoBruto % State.MultiploRedondeo;
                return vueltoBruto - resto;
            }
            return vueltoBruto;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        montoAIngresar = State.TotalVentaActual;
        await CargarPersonas();
    }

    private async Task CargarPersonas()
    {
        try
        {
            var res = await SupaClient.From<Persona>().Get();
            if (res.Models != null)
            {
                listaPersonas = res.Models.OrderBy(p => p.Nombre).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar clientes/personas: {ex.Message}");
        }
    }

    private void SeleccionarMedio(long id, string nombre)
    {
        formaPagoSeleccionada = id;
        nombreFormaPagoSeleccionada = nombre;
        montoAIngresar = Restante > 0 ? Restante : 0;
    }

    private void CargarMontoRapido(decimal monto)
    {
        montoAIngresar = monto;
    }

    private void AgregarPago()
    {
        if (montoAIngresar <= 0) return;

        pagosAgregados.Add(new PagoTemporal
        {
            FormaPagoId = formaPagoSeleccionada,
            NombreFormaPago = nombreFormaPagoSeleccionada,
            Monto = montoAIngresar
        });

        montoAIngresar = Restante > 0 ? Restante : 0;
    }

    private void RemoverPago(PagoTemporal pago)
    {
        pagosAgregados.Remove(pago);
        montoAIngresar = Restante > 0 ? Restante : 0;
    }

    private void CancelarVenta()
    {
        pagosAgregados.Clear();
        Carrito.Vaciar();
        State.CarritoActual = null;
        State.TotalVentaActual = 0;
        Nav.NavigateTo(RutaOrigenVentas);
    }

    private void VolverAVender()
    {
        Nav.NavigateTo(RutaOrigenVentas);
    }

    
    private async Task ProcesarCobro()
    {
        try
        {
            if (!pagosAgregados.Any()) return;

            bool tieneFiado = pagosAgregados.Any(p => p.FormaPagoId == 6);
            if (tieneFiado && personaSeleccionadaId == 0)
            {
                mensajeError = "Atención: Debe seleccionar un cliente para registrar una venta fiada.";
                return;
            }

            var respuestaRpc = await SupaClient.Rpc("obtener_proximo_movimiento", null);
            long numeroMovimientoUnico = Convert.ToInt64(respuestaRpc.Content);

            // 1. Guardar las formas de pago / cabeceras de venta
            foreach (var pago in pagosAgregados)
            {
                bool esFiado = pago.FormaPagoId == 6;

                var filaVenta = new Venta
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    Fecha = DateTime.Today,
                    Total = pago.Monto,
                    FormaPagoId = pago.FormaPagoId,
                    KioscoId = State.KioscoId,
                    UsuarioOperadorId = State.UsuarioId,
                    PersonaId = personaSeleccionadaId > 0 ? personaSeleccionadaId : null,
                    Pagado = !esFiado
                };
                await SupaClient.From<Venta>().Insert(filaVenta);
            }

            // 2. Separar los ítems normales de los productos varios
            var itemsNormales = State.CarritoActual.Where(i => !i.EsProductoVario).ToList();
            var itemsVarios = State.CarritoActual.Where(i => i.EsProductoVario).ToList();

            // 3. Insertar detalles normales y decrementar stock de cada producto
            if (itemsNormales.Any())
            {
                var detallesProductos = itemsNormales.Select(item => new VentaDetalle
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    ProductoId = item.Producto.Id,
                    Cantidad = item.Cantidad,
                    PrecioUnitario = item.PrecioUnitario,
                    Subtotal = item.Subtotal,
                }).ToList();

                await SupaClient.From<VentaDetalle>().Insert(detallesProductos);

                // === 3.1 DECREMENTAR STOCK DE PRODUCTOS ===
                foreach (var item in itemsNormales)
                {
                    // Si la propiedad de stock en tu modelo Producto se llama 'Stock' o 'CantidadStock':
                    item.Producto.StockActual -= item.Cantidad;

                    // Actualizamos la fila del producto en Supabase
                    await SupaClient
                        .From<Producto>()
                        .Where(p => p.Id == item.Producto.Id)
                        .Set(p => p.StockActual, item.Producto.StockActual)
                        .Update();
                }
            }

            // 4. Insertar los productos varios en la tabla 'productos_varios_ventas'
            if (itemsVarios.Any())
            {
                var registrosVarios = itemsVarios.Select(item => new ProductoVarioVenta
                {
                    NumeroUnicoIdentificatorioMovimiento = numeroMovimientoUnico,
                    NombreProducto = item.Producto.Nombre,
                    Subtotal = item.Subtotal,
                    KioscoId = State.KioscoId,
                    Cantidad = item.Cantidad,
                    PrecioUnitario = item.PrecioUnitario,
                    FechaCreacion = DateTime.Today
                }).ToList();

                await SupaClient.From<ProductoVarioVenta>().Insert(registrosVarios);
            }

            // Limpieza y redirección
            pagosAgregados.Clear();
            Carrito.Vaciar();
            State.CarritoActual = null;
            State.TotalVentaActual = 0;

            Nav.NavigateTo(RutaOrigenVentas);
        }
        catch (Exception ex)
        {
            mensajeError = "Error al guardar el cobro: " + ex.Message;
        }
    }
}