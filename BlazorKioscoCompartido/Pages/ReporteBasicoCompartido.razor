@using BlazorKioscoCompartido.Services
@using BlazorKioscoCompartido.Services.Reportes
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Models.DTO
@inject AppState State // Para obtener el KioscoId actual dinámicamente
@inject ReporteRecaudacionDiariaService ReporteRecaudacionDiariaService

<div class="container py-3">
    <div class="card shadow-sm border-0 rounded-4 max-width-card mx-auto">

        @* === ENCABEZADO === *@
        <div class="card-header bg-primary text-white text-center py-3 rounded-top-4">
            <h5 class="mb-0 fw-bold">💰 Consulta de Recaudación Diaria</h5>
        </div>

        <div class="card-body p-3 p-md-4">

            @* === SELECTOR DE FECHA Y BOTÓN EN GRILLA RESPONSIVA === *@
            <div class="row g-3 align-items-end mb-3">
                <div class="col-12 col-md-7">
                    <label for="fechaReporte" class="form-label fw-bold text-secondary small mb-1">
                        Seleccione una Fecha:
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-calendar3"></i>
                        </span>
                        <input type="date"
                               id="fechaReporte"
                               class="form-control border-start-0 ps-0"
                               @bind="fechaSeleccionada" />
                    </div>
                </div>

                <div class="col-12 col-md-5">
                    <button class="btn btn-success w-100 py-2 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                            @onclick="CalcularRecaudacion"
                            disabled="@cargando">
                        @if (cargando)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Procesando...</span>
                        }
                        else
                        {
                            <i class="bi bi-search"></i>
                            <span>Consultar</span>
                        }
                    </button>
                </div>
            </div>

            @* === RESULTADOS (TOTAL Y DESGLOSE POR FORMA DE PAGO) === *@
            @if (busquedaRealizada)
            {
                <div class="mt-4">

                    @* Tarjeta Destacada de Total General *@
                    <div class="bg-primary text-white rounded-4 p-3 text-center mb-4 shadow-sm">
                        <span class="d-block text-white-50 text-uppercase fw-bold small mb-1">
                            Total General Recaudado
                        </span>
                        <h2 class="display-6 fw-bold mb-0">
                            $ @totalRecaudado.ToString("N2")
                        </h2>
                    </div>

                    @* Desglose por Formas de Pago *@
                    <h6 class="fw-bold text-secondary mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-wallet2 text-primary"></i>
                        <span>Desglose por Medio de Pago:</span>
                    </h6>

                    @if (desgloseFormasPago != null && desgloseFormasPago.Any())
                    {
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden shadow-sm">
                            @foreach (var item in desgloseFormasPago)
                            {
                                bool esFiado = !string.IsNullOrEmpty(item.FormaPago) &&
                                (item.FormaPago.ToLower().Contains("fiado") || item.FormaPago.ToLower().Contains("crédito") || item.FormaPago.ToLower().Contains("credito"));

                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @(esFiado ? "bi-exclamation-triangle-fill text-danger" : "bi-credit-card-2-front text-primary") fs-5"></i>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@item.FormaPago</span>
                                            @if (esFiado)
                                            {
                                                <small class="text-danger fw-semibold d-block mt-n1" style="font-size: 0.75rem;">
                                                    ⚠️ No contabilizado
                                                </small>
                                            }
                                        </div>
                                    </div>

                                    @if (esFiado)
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger fw-bold fs-6 px-3 py-2 rounded-pill border border-danger border-opacity-25">
                                            $ @item.Total.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold fs-6 px-3 py-2 rounded-pill border border-success border-opacity-25">
                                            $ @item.Total.ToString("N2")
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light text-center border rounded-3 py-3 text-muted mb-0">
                            No se encontraron registros de cobro para este día.
                        </div>
                    }

                </div>
            }

        </div>
    </div>
</div>

<style>
    .max-width-card {
        max-width: 550px;
    }
</style>

@code {
    private DateTime fechaSeleccionada = DateTime.Today;
    private decimal totalRecaudado = 0m;
    private List<RecaudacionPorFormaPagoDto> desgloseFormasPago = new();
    private bool cargando = false;
    private bool busquedaRealizada = false;

    protected override async Task OnInitializedAsync()
    {
        await CalcularRecaudacion();
    }

    private async Task CalcularRecaudacion()
    {
        cargando = true;
        busquedaRealizada = false;

        try
        {
            long kioscoId = State.KioscoId;
            if (kioscoId == 0) kioscoId = 1;

            // Obtenemos el total general y la lista desglosada
            totalRecaudado = await ReporteRecaudacionDiariaService.ObtenerRecaudacionPorDia(fechaSeleccionada, kioscoId);
            desgloseFormasPago = await ReporteRecaudacionDiariaService.ObtenerRecaudacionPorFormaPago(fechaSeleccionada, kioscoId);

            busquedaRealizada = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al calcular la recaudación: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}