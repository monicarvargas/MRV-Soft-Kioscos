@using BlazorKioscoCompartido.Services
@using BlazorKioscoCompartido.Services.Reportes
@using BlazorKioscoCompartido.Components
@inject AppState State
@inject ReporteRecaudacionDiariaService Reporte
@inject IJSRuntime JS
@inject AsistenciaService Asistencia
@inject NavigationManager Nav

<PedidosEstilos />
<VentasEstilos />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Recaudación del día"
                      Subtitulo="Lo que entró a la caja, lo fiado y lo que vendió cada uno"
                      IconoClass="bi-calendar-check-fill"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="@RutaVolver" />

    <div class="vt-wrap" style="display:flex; flex-direction:column; gap:1rem">

        @* ================= FECHA ================= *@
        <section class="gp-card gp-card-pad">
            <div class="rd-fecha">
                <button type="button" class="gp-btn gp-btn-outline gp-btn-icon" title="Día anterior" @onclick="() => CambiarDia(-1)"><i class="bi bi-chevron-left"></i></button>
                <input type="date" class="gp-control" @bind="fecha" @bind:after="Cargar" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <button type="button" class="gp-btn gp-btn-outline gp-btn-icon" title="Día siguiente" disabled="@(fecha >= DateTime.Today)" @onclick="() => CambiarDia(1)"><i class="bi bi-chevron-right"></i></button>
                @if (fecha != DateTime.Today)
                {
                    <button type="button" class="gp-btn gp-btn-soft" @onclick="IrAHoy">Hoy</button>
                }
                <span class="rd-dia">@NombreDia</span>
            </div>
        </section>

        @if (cargando)
        {
            <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Calculando...</p></div>
        }
        else if (!string.IsNullOrEmpty(error))
        {
            <div class="gp-banner is-danger"><i class="bi bi-exclamation-octagon-fill"></i><p>@error</p></div>
        }
        else if (r != null)
        {
            @* 1) Total recaudado y, al lado, por medio de pago *@
            <div class="vt-cols rd-arriba">
                <div class="vt-col">
                    @* ================= TOTAL ================= *@
                    <div class="vt-caja">
                        <span class="vt-caja-label">Total recaudado</span>
                        <div class="vt-caja-total" style="color:#fff">$ @r.TotalRecaudado.ToString("N2")</div>
                        <div class="vt-caja-filas">
                            <div class="vt-caja-fila"><span>Ventas cobradas (@Ventas(r.CantidadVentas))</span><b>$ @r.VentasCobradas.ToString("N2")</b></div>
                            <div class="vt-caja-fila"><span>Cobros de deudas</span><b class="is-ok">$ @r.CobrosDeudas.ToString("N2")</b></div>
                        </div>
                        <div style="margin-top:.7rem; color:rgba(255,255,255,.7); font-size:.8rem; font-weight:600">
                            <i class="bi bi-info-circle"></i> Solo la plata que entró: no cuenta lo fiado ni lo descontado a empleados.
                            @if (turnos.Any(t => t.Activo))
                            {
                                <br /><i class="bi bi-moon-stars"></i> <span>El día va de turno a turno: lo vendido a la madrugada cuenta para el turno noche del día anterior.</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="vt-col">
                    @* ================= MEDIOS DE PAGO ================= *@
                    <section class="gp-card gp-card-pad">
                        <div class="gp-card-head" style="margin-bottom:.7rem">
                            <span class="gp-bubble gp-bubble-sm"><i class="bi bi-wallet2"></i></span>
                            <div class="vt-head-text"><h2 style="font-size:1.05rem">Por medio de pago</h2><p>Para controlar la caja y las transferencias.</p></div>
                        </div>
                        @if (!r.Medios.Any())
                        {
                            <div class="gp-hint"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> No entró plata este día.</div>
                        }
                        else
                        {
                            <ul class="rd-lista">
                                @foreach (var m in r.Medios)
                                {
                                    <li>
                                        <i class="bi @Utilidades.ObtenerIconoFormaPago(m.Nombre) rd-ico"></i>
                                        <div class="rd-txt">
                                            <b>@m.Nombre</b>
                                            @if (m.CobrosDeudas > 0)
                                            {
                                                <small>Ventas $ @m.Ventas.ToString("N2") · Deudas $ @m.CobrosDeudas.ToString("N2")</small>
                                            }
                                        </div>
                                        <span class="rd-monto">$ @m.Total.ToString("N2")</span>
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>
            </div>

            @* 2) Por turno *@
            @if (porTurno.Any())
            {
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.7rem">
                        <span class="gp-bubble gp-bubble-sm"><i class="bi bi-clock-fill"></i></span>
                        <div class="vt-head-text"><h2 style="font-size:1.05rem">Por turno</h2><p>Según la hora de cada venta. El turno noche cuenta entero para el día en que empezó. Por empleado, con las formas de pago que confirmó.</p></div>
                    </div>
                    <div class="rt-turnos">
                        @foreach (var t in porTurno)
                        {
                            <article class="rt-turno @(t.TotalVendido + t.CobrosDeudas == 0 ? "is-vacio" : "")">
                                @* totales del turno: en violeta, para que se distingan del detalle por empleado *@
                                <div class="rt-totales">
                                <div class="rt-head">
                                    <div><b>@t.Nombre</b><small>@t.Rango</small></div>
                                    <strong>$ @t.TotalRecaudado.ToString("N2")</strong>
                                </div>
                                <div class="rt-filas">
                                    <span>Cobrado <b>$ @t.Cobrado.ToString("N2")</b></span>
                                    @if (t.CobrosDeudas > 0) { <span>Deudas <b>$ @t.CobrosDeudas.ToString("N2")</b></span> }
                                    @if (t.Fiado > 0) { <span class="warn">Fiado <b>$ @t.Fiado.ToString("N2")</b></span> }
                                    <span>@Ventas(t.CantidadVentas)</span>
                                </div>
                                @if (t.PorMedio.Any())
                                {
                                    <div class="rt-chips">
                                        @foreach (var m in t.PorMedio.OrderByDescending(x => x.Value))
                                        {
                                            <span class="rt-chip"><i class="bi @Utilidades.ObtenerIconoFormaPago(m.Key)"></i> @m.Key $ @m.Value.ToString("N2")</span>
                                        }
                                    </div>
                                }
                                </div>
                                @if (t.Empleados.Any())
                                {
                                    @* cada empleado del turno: lo que vendió y las formas de pago que confirmó *@
                                    <div class="rt-emps">
                                        @foreach (var e in t.Empleados.Values.OrderByDescending(x => x.TotalVendido + x.CobrosDeudas))
                                        {
                                            <div class="rt-emp">
                                                <div class="rt-emp-head">
                                                    <span><i class="bi bi-person-fill"></i> <b>@e.Nombre</b> <small>· @Ventas(e.CantidadVentas)</small></span>
                                                    <span class="rt-emp-caja" title="Cobrado + cobros de deudas: lo que tendría que tener en la caja">Caja <b>$ @e.EnCaja.ToString("N2")</b></span>
                                                </div>
                                                <div class="rt-chips">
                                                    @foreach (var m in e.PorMedio.OrderByDescending(x => x.Value))
                                                    {
                                                        <span class="rt-chip @(EsFiado(m.Key) ? "is-fiado" : "")"><i class="bi @Utilidades.ObtenerIconoFormaPago(m.Key)"></i> @m.Key $ @m.Value.ToString("N2")</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>
                </section>
            }

            @* 3) Por empleado *@
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.7rem">
                        <span class="gp-bubble gp-bubble-sm"><i class="bi bi-person-badge-fill"></i></span>
                        <div class="vt-head-text"><h2 style="font-size:1.05rem">Por empleado</h2><p>Lo que vendió y cobró cada usuario.</p></div>
                    </div>
                    @if (!r.Empleados.Any())
                    {
                        <div class="gp-hint"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> No hubo movimientos este día.</div>
                    }
                    else
                    {
                        <div class="rd-emps rd-emps-lista">
                            @foreach (var e in r.Empleados)
                            {
                                <article class="rd-emp">
                                    <div class="rd-emp-head">
                                        <span class="rd-avatar">@Inicial(e.Nombre)</span>
                                        <div class="rd-txt">
                                            <b>@e.Nombre</b>
                                            <small>@Ventas(e.CantidadVentas)</small>
                                        </div>
                                        <div class="rd-emp-total">
                                            <span>Vendió</span>
                                            <b>$ @e.TotalVendido.ToString("N2")</b>
                                        </div>
                                    </div>
                                    <div class="rd-emp-filas">
                                        <div><span>Cobrado</span><b>$ @e.Cobrado.ToString("N2")</b></div>
                                        <div><span>Fiado</span><b class="@(e.Fiado > 0 ? "warn" : "")">$ @e.Fiado.ToString("N2")</b></div>
                                        @if (e.CobrosDeudas > 0)
                                        {
                                            <div><span>Cobró deudas</span><b>$ @e.CobrosDeudas.ToString("N2")</b></div>
                                        }
                                        @if (e.Descontado > 0)
                                        {
                                            <div><span>Descontó</span><b>$ @e.Descontado.ToString("N2")</b></div>
                                        }
                                        <div class="rd-caja"><span>Tiene que tener en caja</span><b>$ @e.EnCaja.ToString("N2")</b></div>
                                    </div>
                                    @if (e.PorMedio.Any())
                                    {
                                        <div class="rt-chips" title="Formas de pago que confirmó (ventas y cobros de deudas)">
                                            @foreach (var m in e.PorMedio.OrderByDescending(x => x.Value))
                                            {
                                                <span class="rt-chip @(EsFiado(m.Key) ? "is-fiado" : "")"><i class="bi @Utilidades.ObtenerIconoFormaPago(m.Key)"></i> @m.Key $ @m.Value.ToString("N2")</span>
                                            }
                                        </div>
                                    }

                                    @if (e.Ventas.Any())
                                    {
                                        <button type="button" class="gp-btn gp-btn-soft gp-btn-sm rd-ver" @onclick="() => AbrirVentas(e)">
                                            <i class="bi bi-bag-check-fill"></i> Ver qué vendió (@Ventas(e.CantidadVentas))
                                        </button>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>

            @* 4) Lo fiado (no entró plata) *@
                @* ================= NO ENTRA EN LA CAJA ================= *@
                <section class="gp-card gp-card-pad">
                    <div class="gp-card-head" style="margin-bottom:.7rem">
                        <span class="gp-bubble gp-bubble-sm" style="background:var(--gp-warn-soft); color:var(--gp-warn)"><i class="bi bi-journal-bookmark-fill"></i></span>
                        <div class="vt-head-text"><h2 style="font-size:1.05rem">No entró plata</h2><p>Se muestra aparte, no suma al total.</p></div>
                    </div>
                    <div class="rd-mini">
                        <div><span>Vendido fiado</span><b class="warn">$ @r.Fiado.ToString("N2")</b></div>
                        <div><span>Descontado a empleados</span><b>$ @r.Descontado.ToString("N2")</b></div>
                    </div>
                </section>
        }
    </div>
</div>

@* ===================== MODAL: LO QUE VENDIÓ UN EMPLEADO ===================== *@
@if (empModal != null)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarVentas">
        <div class="gp-modal vt-modal-grande rd-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-person-badge-fill"></i></span>
                <div>
                    <h3>@empModal.Nombre</h3>
                    <p>@Roles.Legible(empModal.Rol) · @NombreDia · @Ventas(empModal.CantidadVentas) · $ @empModal.TotalVendido.ToString("N2")</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarVentas"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="rd-modal-barra">
                <div class="gp-seg" role="group">
                    <button type="button" class="@(!porProducto ? "is-active" : "")" @onclick="() => porProducto = false"><i class="bi bi-receipt"></i> Por venta</button>
                    <button type="button" class="@(porProducto ? "is-active" : "")" @onclick="() => porProducto = true"><i class="bi bi-box-seam"></i> Por producto</button>
                </div>
                <div class="gp-search rd-buscar">
                    <i class="bi bi-search"></i>
                    <input type="text" class="gp-control" placeholder="Buscar producto..." @bind="filtroProd" @bind:event="oninput" />
                </div>
            </div>

            <div class="gp-modal-body rd-modal-body">
                @if (!empModal.ProductosCargados)
                {
                    <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando lo que vendió...</p></div>
                }
                else if (!porProducto)
                {
                    var tickets = TicketsFiltrados;
                    if (!tickets.Any())
                    {
                        <div class="gp-hint"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> No hay ventas con ese producto.</div>
                    }
                    <div class="rd-tickets">
                        @foreach (var t in tickets)
                        {
                            <div class="rd-ticket @(t.TieneFiado ? "is-fiado" : "")">
                                <div class="rd-ticket-head">
                                    <span class="rd-hora"><i class="bi bi-clock"></i> @HoraLocal(t)</span>
                                    <span class="rd-forma">@t.FormaPago</span>
                                    <b>$ @t.Total.ToString("N2")</b>
                                </div>
                                @foreach (var it in t.Items)
                                {
                                    <div class="rd-item">
                                        <span class="rd-cant">@DetalleArticulos.TextoCantidad(it.Cantidad, it.Unidad)</span>
                                        <span class="rd-nom">@(it.EsVario ? it.Nombre + " (varios)" : it.Nombre)</span>
                                        <span class="rd-pu">$ @it.PrecioUnitario.ToString("N2") @(Utilidades.EsMedidaGramos(it.Unidad) ? "/kg" : "c/u")</span>
                                        <b class="rd-sub">$ @it.Subtotal.ToString("N2")</b>
                                    </div>
                                }
                                @if (!t.Items.Any())
                                {
                                    <div class="rd-item"><span class="rd-nom gp-muted">Sin detalle de productos</span></div>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    var grupos = AgruparFiltrado;
                    <div class="rd-ticket">
                        <div class="rd-item rd-item-cab">
                            <span>Cant.</span><span>Producto</span><span>Precio</span><span>Total</span>
                        </div>
                        @foreach (var g in grupos)
                        {
                            <div class="rd-item">
                                <span class="rd-cant">@DetalleArticulos.TextoCantidad(g.Cantidad, g.Unidad)</span>
                                <span class="rd-nom">@g.Nombre</span>
                                <span class="rd-pu">$ @g.PrecioUnitario.ToString("N2") @(Utilidades.EsMedidaGramos(g.Unidad) ? "/kg" : "c/u")</span>
                                <b class="rd-sub">$ @g.Subtotal.ToString("N2")</b>
                            </div>
                        }
                        @if (!grupos.Any())
                        {
                            <div class="rd-item"><span class="rd-nom gp-muted">No hay productos con ese nombre</span></div>
                        }
                    </div>
                    <div class="gp-hint" style="margin-top:.5rem; font-size:.78rem"><i class="bi bi-info-circle" style="color:var(--gp-primary)"></i> Si un producto se vendió a distintos precios (ej: de día y de noche) aparece en renglones separados.</div>
                }
            </div>

            <div class="gp-modal-foot rd-modal-foot">
                <span>Cobrado <b>$ @empModal.Cobrado.ToString("N2")</b> · Fiado <b>$ @empModal.Fiado.ToString("N2")</b></span>
                <button type="button" class="gp-btn gp-btn-primary" @onclick="CerrarVentas">Cerrar</button>
            </div>
        </div>
    </div>
}

<style>
    .rt-turnos { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: .6rem; }
    .rt-turno { padding: .75rem; border: 1px solid var(--gp-line); border-radius: 14px; background: #fff; }
    .rt-turno.is-vacio { opacity: .55; }
    /* totales del turno (violeta): se distinguen del detalle por empleado */
    .rt-totales { margin: -.75rem -.75rem 0; padding: .75rem; border-radius: 14px 14px 0 0;
                  background: linear-gradient(180deg, #efe9fc, #f6f2fe); border-bottom: 2px solid #d8ccf5; }
    .rt-totales .rt-head b { color: #4b2f9a; }
    .rt-totales .rt-head small { color: #7a68b0; }
    .rt-totales .rt-filas { color: #6b5aa3; }
    .rt-totales .rt-chip { background: #fff; color: #4b2f9a; border: 1px solid #ddd2f6; }
    .rt-totales .rt-chip i { color: #6d4fd1; }
    .rt-head { display: flex; justify-content: space-between; align-items: flex-start; gap: .5rem; }
    .rt-head b { display: block; font-weight: 900; }
    .rt-head small { color: var(--gp-muted); font-weight: 700; font-size: .75rem; }
    .rt-head strong { color: var(--gp-ok); font-weight: 900; font-size: 1.15rem; white-space: nowrap; }
    .rt-filas { display: flex; flex-wrap: wrap; gap: .25rem .8rem; margin-top: .45rem; color: var(--gp-muted); font-size: .8rem; font-weight: 600; }
    .rt-filas b { color: var(--gp-text); }
    .rt-filas .warn b { color: var(--gp-warn); }
    .rt-chips { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .5rem; }
    .rt-chip { display: inline-flex; align-items: center; gap: .3rem; padding: .1rem .5rem; border-radius: 999px; background: #f0f2f9; font-size: .72rem; font-weight: 700; }
    .rt-emps { display: flex; flex-direction: column; gap: .2rem; margin-top: .55rem; padding-top: .45rem; border-top: 1px dashed var(--gp-line); font-size: .82rem; }
    .rt-emps i { color: var(--gp-primary); }
    .rt-emp { display: flex; flex-direction: column; padding: .35rem 0; }
    .rt-emp + .rt-emp { border-top: 1px dotted var(--gp-line); }
    .rt-emp-head { display: flex; justify-content: space-between; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .rt-emp-head small { color: var(--gp-muted); font-weight: 600; }
    .rt-emp-caja { color: var(--gp-muted); font-size: .78rem; font-weight: 700; }
    .rt-emp-caja b { color: var(--gp-ink, #1b2540); }
    .rt-emp .rt-chips { margin-top: .3rem; }
    .rt-chip.is-fiado { background: #fff4dc; color: #8a5a00; }
    .rd-fecha { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
    .rd-fecha .gp-control { width: auto; min-width: 10.5rem; height: 2.6rem; font-weight: 800; }
    .rd-dia { margin-left: auto; color: var(--gp-muted); font-weight: 800; font-size: .9rem; text-transform: capitalize; }

    .rd-mini { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
    .rd-mini div { display: flex; flex-direction: column; padding: .6rem .75rem; border-radius: 12px; background: #f6f7fb; }
    .rd-mini span { color: var(--gp-muted); font-size: .74rem; font-weight: 700; }
    .rd-mini b { font-size: 1.1rem; font-weight: 900; }
    .rd-mini b.warn, .rd-emp-filas b.warn { color: var(--gp-warn); }

    .rd-lista { display: flex; flex-direction: column; gap: .4rem; margin: 0; padding: 0; list-style: none; }
    .rd-lista li { display: flex; align-items: center; gap: .7rem; padding: .6rem .75rem; border: 1px solid var(--gp-line); border-radius: 12px; }
    .rd-ico { flex: none; color: var(--gp-primary); font-size: 1.2rem; }
    .rd-txt { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
    .rd-txt b { font-weight: 800; font-size: .92rem; }
    .rd-txt small { color: var(--gp-muted); font-weight: 600; font-size: .75rem; }
    .rd-monto { flex: none; font-weight: 900; color: var(--gp-ok); }

    .rd-emps { display: flex; flex-direction: column; gap: .6rem; }
    .rd-emps.rd-emps-grilla { display: grid; grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr)); align-items: start; }
    .rd-arriba > .vt-col > .vt-caja, .rd-arriba > .vt-col > .gp-card { height: 100%; }
    .rd-emp { padding: .75rem; border: 1px solid var(--gp-line); border-radius: 14px; }
    .rd-emp-head { display: flex; align-items: center; gap: .65rem; }
    .rd-avatar { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--gp-primary-soft); color: var(--gp-primary); font-weight: 900; }
    .rd-emp-total { flex: none; display: flex; flex-direction: column; align-items: flex-end; }
    .rd-emp-total span { color: var(--gp-muted); font-size: .7rem; font-weight: 700; }
    .rd-emp-total b { font-weight: 900; font-size: 1.05rem; }
    .rd-emp-filas { display: grid; grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr)); gap: .4rem; margin-top: .65rem; }
    .rd-emp-filas div { display: flex; flex-direction: column; padding: .45rem .6rem; border-radius: 10px; background: #f6f7fb; }
    .rd-emp-filas span { color: var(--gp-muted); font-size: .7rem; font-weight: 700; }
    .rd-emp-filas b { font-weight: 900; font-size: .9rem; }
    .rd-emp-filas .rd-caja { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: center; background: var(--gp-ok-soft); }
    .rd-emp-filas .rd-caja b { color: var(--gp-ok); font-size: 1rem; }

    .rd-ver { width: 100%; justify-content: center; margin-top: .6rem; }

    /* Por empleado: uno debajo del otro, cada uno en una fila a lo ancho */
    .rd-emps-lista { display: flex; flex-direction: column; gap: .6rem; }
    @@media (min-width: 900px) {
        .rd-emps-lista .rd-emp { display: grid; grid-template-columns: minmax(16rem, 1.2fr) minmax(0, 3fr) auto; align-items: center; gap: 1rem; }
        .rd-emps-lista .rd-emp-head { gap: .8rem; padding-right: .4rem; }
        .rd-emps-lista .rd-txt b { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
