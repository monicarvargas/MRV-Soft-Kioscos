@code {
    [Parameter] public string RutaVolver { get; set; } = "/productos";

    private DateTime fecha = DateTime.Today;
    private ResumenDia? r;
    private bool cargando;
    private string error = "";

    private string NombreDia => fecha == DateTime.Today ? "Hoy"
        : fecha == DateTime.Today.AddDays(-1) ? "Ayer"
        : fecha.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-AR"));

    // diferencia del equipo con UTC en minutos (Argentina: 180). Se toma del navegador,
    // porque la app del celular no siempre conoce la zona horaria.
    private int? minutosUtc;

    // ----- turnos -----
    private List<Turno> turnos = new();
    private List<FilaTurno> porTurno = new();

    private bool EsAdmin => Roles.VeRecaudacion(State.UsuarioRol);   // el dueño (y los perfiles a los que se lo habilitó)

    protected override async Task OnInitializedAsync()
    {
        // los empleados no ven la recaudación (aunque escriban la dirección a mano)
        if (!EsAdmin) { Nav.NavigateTo("/productos"); return; }

        try { minutosUtc = await JS.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()"); } catch { }
        try { turnos = await Asistencia.GetTurnos(State.KioscoId); } catch { turnos = new(); }
        await Cargar();
    }

    private string HoraLocal(TicketVenta t)
    {
        if (t.HoraUtc == null) return "sin hora";
        var local = minutosUtc.HasValue ? t.HoraUtc.Value.AddMinutes(-minutosUtc.Value) : t.HoraUtc.Value.ToLocalTime();
        return local.ToString("HH:mm");
    }

    private async Task CambiarDia(int dias)
    {
        var nueva = fecha.AddDays(dias);
        if (nueva > DateTime.Today) return;
        fecha = nueva;
        await Cargar();
    }

    private async Task IrAHoy()
    {
        fecha = DateTime.Today;
        await Cargar();
    }

    private async Task Cargar()
    {
        if (State.KioscoId == 0 || !EsAdmin) return;   // antes, sin negocio, mostraba los datos del negocio 1
        cargando = true;
        error = "";
        try
        {
            // con turnos, el día va de turno a turno (la madrugada es del turno noche del día anterior)
            r = await Reporte.ObtenerResumenDelDia(fecha, State.KioscoId, turnos, minutosUtc ?? 180);
            porTurno = turnos.Any(t => t.Activo)
                ? await Reporte.ObtenerPorTurnoAsync(fecha, State.KioscoId, turnos, minutosUtc ?? 180)
                : new();
        }
        catch (Exception ex)
        {
            error = "No se pudo calcular el reporte: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    // ----- productos vendidos por empleado (modal) -----
    private FilaEmpleado? empModal;
    private bool porProducto;
    private string filtroProd = "";

    private async Task AbrirVentas(FilaEmpleado e)
    {
        empModal = e;
        porProducto = false;
        filtroProd = "";
        if (!e.ProductosCargados)
        {
            StateHasChanged();
            try { await Reporte.CargarProductosAsync(e, State.KioscoId); }
            catch (Exception ex) { empModal = null; error = "No se pudieron cargar los productos: " + ex.Message; }
        }
    }

    private void CerrarVentas() => empModal = null;

    private bool CoincideFiltro(ItemVendido i) => string.IsNullOrWhiteSpace(filtroProd) || i.Nombre.Contains(filtroProd.Trim(), StringComparison.OrdinalIgnoreCase);

    private List<TicketVenta> TicketsFiltrados => empModal == null ? new()
        : string.IsNullOrWhiteSpace(filtroProd) ? empModal.Ventas
        : empModal.Ventas.Where(t => t.Items.Any(CoincideFiltro)).ToList();

    private List<ItemVendido> AgruparFiltrado => empModal == null ? new() : Agrupar(empModal).Where(CoincideFiltro).ToList();

    /// <summary>Suma las cantidades del mismo producto vendido al mismo precio.</summary>
    private static List<ItemVendido> Agrupar(FilaEmpleado e) => e.Ventas
        .SelectMany(t => t.Items)
        .GroupBy(i => (i.Nombre, i.PrecioUnitario, i.Unidad))
        .Select(g => new ItemVendido
        {
            Nombre = g.Key.Nombre, PrecioUnitario = g.Key.PrecioUnitario, Unidad = g.Key.Unidad,
            Cantidad = g.Sum(x => x.Cantidad), Subtotal = g.Sum(x => x.Subtotal)
        })
        .OrderByDescending(i => i.Subtotal)
        .ToList();

    private static string Ventas(int n) => n == 1 ? "1 venta" : $"{n} ventas";
    private static bool EsFiado(string? forma) => string.Equals(forma?.Trim(), "FIADO", StringComparison.OrdinalIgnoreCase);
    private static string Inicial(string n) => string.IsNullOrWhiteSpace(n) ? "?" : n.Trim()[..1].ToUpper();
}
