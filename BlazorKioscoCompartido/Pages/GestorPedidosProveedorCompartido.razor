    // ======================= DETALLE DEL PEDIDO =======================

    private async Task AbrirDetalleAsync(ListaPedido pedido)
    {
        errorDetalle = null;
        pedidoDetalle = pedido;
        detalleItems = new();
        cargandoDetalle = true;

        try
        {
            var idPedido = pedido.Id;
            var res = await SupaClient.From<ListaPedidoDetalle>()
                .Where(d => d.PedidoId == idPedido)
                .Get();

            detalleItems = res.Models.OrderBy(d => d.NombreProducto).ToList();
        }
        catch (Exception ex)
        {
            errorDetalle = "No se pudo cargar el detalle: " + ex.Message;
        }
        finally
        {
            cargandoDetalle = false;
        }
    }

    private void CerrarDetalle()
    {
        pedidoDetalle = null;
        detalleItems = new();
        errorDetalle = null;
    }

    private async Task CambiarNombreAsync(ChangeEventArgs e)
    {
        if (pedidoDetalle == null) return;
        errorDetalle = null;

        var nuevo = e.Value?.ToString()?.Trim() ?? "";

        try
        {
            var idPedido = pedidoDetalle.Id;
            await SupaClient.From<ListaPedido>()
                .Where(p => p.Id == idPedido)
                .Set(p => p.NombreListado, nuevo)
                .Update();

            pedidoDetalle.NombreListado = nuevo;
            avisos.Toast("Nombre actualizado", "exito", 2000);
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo cambiar el nombre", ex.Message, "peligro");
        }
    }

    private async Task CambiarCantidadAsync(ListaPedidoDetalle d, ChangeEventArgs e)
    {
        if (!puedeEditar) return;
        errorDetalle = null;

        if (!decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out decimal nueva) || nueva <= 0)
        {
            await avisos.InformarAsync("Cantidad incorrecta", "La cantidad tiene que ser un número mayor a 0.", "aviso");
            StateHasChanged();
            return;
        }

        // El subtotal se recalcula en proporción, así respeta la misma fórmula con la que se guardó (unidades o gramos)
        decimal nuevoSubtotal = d.CantidadComprar > 0
            ? Math.Round(d.SubtotalEstimado / d.CantidadComprar * nueva, 2)
            : Math.Round(nueva * d.PrecioCosto, 2);

        try
        {
            var idDetalle = d.Id;
            await SupaClient.From<ListaPedidoDetalle>()
                .Where(x => x.Id == idDetalle)
                .Set(x => x.CantidadComprar, nueva)
                .Set(x => x.SubtotalEstimado, nuevoSubtotal)
                .Update();

            d.CantidadComprar = nueva;
            d.SubtotalEstimado = nuevoSubtotal;

            await ActualizarMontoPedidoAsync();
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo cambiar la cantidad", ex.Message, "peligro");
        }
    }

    private async Task EliminarProductoAsync(ListaPedidoDetalle d)
    {
        if (!puedeEditar || pedidoDetalle == null) return;
        errorDetalle = null;

        bool esUltimo = detalleItems.Count == 1;
        var titulo = esUltimo ? "Es el último producto" : "¿Quitar del pedido?";
        var mensaje = esUltimo
            ? $"'{d.NombreProducto}' es el último producto: se va a eliminar todo el pedido."
            : $"Se va a quitar '{d.NombreProducto}' de este pedido.";

        if (!await avisos.ConfirmarAsync(titulo, mensaje, esUltimo ? "Eliminar pedido" : "Quitar")) return;

        try
        {
            if (esUltimo)
            {
                await BorrarPedidoAsync(pedidoDetalle);
                avisos.Toast("Pedido eliminado", "exito", 2500);
                return;
            }

            var idDetalle = d.Id;
            await SupaClient.From<ListaPedidoDetalle>()
                .Where(x => x.Id == idDetalle)
                .Delete();

            detalleItems.Remove(d);
            await ActualizarMontoPedidoAsync();
            avisos.Toast("Producto quitado del pedido", "exito", 2500);
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo quitar el producto", ex.Message, "peligro");
        }
    }

    private async Task ActualizarMontoPedidoAsync()
    {
        if (pedidoDetalle == null) return;

        var total = detalleItems.Sum(x => x.SubtotalEstimado);
        var idPedido = pedidoDetalle.Id;

        await SupaClient.From<ListaPedido>()
            .Where(p => p.Id == idPedido)
            .Set(p => p.MontoEstimado, total)
            .Update();

        pedidoDetalle.MontoEstimado = total;
    }

    // ======================= COLUMNAS DEL DOCUMENTO =======================

    private static List<string> ParsearColumnas(string? csv) =>
        (csv ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(k => ColumnasDisponibles.Any(c => c.Key == k))
            .Distinct()
            .ToList();

    /// <summary>Columnas a usar para un proveedor: la de "solo esta vez", si no la guardada, si no la de por defecto.</summary>
    private List<string> ObtenerColumnas(long provId)
    {
        if (columnasTemporales.TryGetValue(provId, out var temporal)) return temporal;

        var guardadas = ParsearColumnas(proveedores.FirstOrDefault(p => p.Id == provId)?.ColumnasPedido);
        return guardadas.Any() ? guardadas : ColumnasPorDefecto.ToList();
    }

    private void AbrirColumnasSeleccion()
    {
        var provIds = pedidos
            .Where(p => pedidosSeleccionados.Contains(p.Id))
            .Select(p => p.ProveedorId);

        AbrirColumnas(provIds);
    }

    private void AbrirColumnas(IEnumerable<long> provIds)
    {
        errorColumnas = null;
        edicionColumnas = new();

        foreach (var id in provIds.Distinct())
        {
            var activas = ObtenerColumnas(id);
            var lista = new List<ColumnaEditable>();

            // Primero las activas, en su orden; después el resto (destildadas)
            foreach (var key in activas)
            {
                var def = ColumnasDisponibles.First(c => c.Key == key);
                lista.Add(new ColumnaEditable { Key = def.Key, Etiqueta = def.Etiqueta, Activa = true });
            }
            foreach (var def in ColumnasDisponibles.Where(c => !activas.Contains(c.Key)))
            {
                lista.Add(new ColumnaEditable { Key = def.Key, Etiqueta = def.Etiqueta, Activa = false });
            }

            edicionColumnas[id] = lista;
        }

        mostrarModalColumnas = edicionColumnas.Any();
    }

    private void CerrarModalColumnas()
    {
        mostrarModalColumnas = false;
        errorColumnas = null;
    }

    private void MoverColumna(List<ColumnaEditable> lista, int indice, int direccion)
    {
        int destino = indice + direccion;
        if (destino < 0 || destino >= lista.Count) return;

        (lista[indice], lista[destino]) = (lista[destino], lista[indice]);
    }

    private bool TryLeerEdicion(out Dictionary<long, List<string>> resultado)
    {
        resultado = new();
        errorColumnas = null;

        foreach (var par in edicionColumnas)
        {
            var keys = par.Value.Where(c => c.Activa).Select(c => c.Key).ToList();
            if (!keys.Any())
            {
                errorColumnas = $"Elegí al menos una columna para {obtenerNombreProveedor(par.Key)}.";
                return false;
            }
            resultado[par.Key] = keys;
        }
        return true;
    }

    private void AplicarColumnasSoloEstaVez()
    {
        if (!TryLeerEdicion(out var elegidas)) return;

        foreach (var par in elegidas)
            columnasTemporales[par.Key] = par.Value;

        mostrarModalColumnas = false;
    }

    private async Task GuardarColumnasEnProveedorAsync()
    {
        if (!TryLeerEdicion(out var elegidas)) return;

        try
        {
            foreach (var par in elegidas)
            {
                var idProv = par.Key;
                var csv = string.Join(",", par.Value);

                await SupaClient.From<Proveedor>()
                    .Where(p => p.Id == idProv)
                    .Set(p => p.ColumnasPedido, csv)
                    .Update();

                var prov = proveedores.FirstOrDefault(p => p.Id == idProv);
                if (prov != null) prov.ColumnasPedido = csv;

                columnasTemporales.Remove(idProv);
            }

            mostrarModalColumnas = false;
            _ = avisos.GuardadoAsync("Columnas guardadas para el proveedor");
        }
        catch (Exception ex)
        {
            errorColumnas = "No se pudieron guardar las columnas: " + ex.Message;
        }
    }

    // ======================= EXPORTAR A WORD / PDF =======================

    private async Task<IJSObjectReference> ObtenerModuloAsync()
    {
        // El archivo vive en el proyecto compartido (RCL), por eso se pide con la ruta _content/<NombreDelProyecto>/
        // El "?v=2" obliga al navegador a bajar la versión nueva; subir el número cada vez que se cambie descargas.js
        jsModulo ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/BlazorKioscoCompartido/js/descargas.js?v=2");
        return jsModulo;
    }

    private async Task ExportarAsync(List<ListaPedido> lista, bool word)
    {
        if (!lista.Any()) return;

        exportando = true;
        errorGeneral = null;
        errorDetalle = null;

        try
        {
            var detalles = await CargarDetallesAsync(lista);
            var js = await ObtenerModuloAsync();
            var archivo = NombreArchivo(lista);

            if (word)
            {
                var html = ConstruirDocumentoHtml(lista, detalles, true);
                await js.InvokeVoidAsync("descargarArchivo", archivo + ".doc", "application/msword", html);
            }
            else
            {
                // El PDF se arma y se descarga directo (sin cuadro de impresión)
                var datos = ConstruirDatosPdf(lista, detalles, archivo + ".pdf");
                await js.InvokeVoidAsync("generarPdf", datos);
            }

            avisos.Toast(word ? "Word descargado" : "PDF descargado", "exito");
        }
        catch (Exception ex)
        {
            await MostrarError("No se pudo generar el documento", ex.Message);
        }
        finally
        {
            exportando = false;
        }
    }

    private string NombreArchivo(List<ListaPedido> lista)
    {
        var provs = lista.Select(p => p.ProveedorId).Distinct().ToList();
        var nombre = provs.Count == 1 && !EsSinProveedor(obtenerNombreProveedor(provs[0]))
            ? $"Pedido {obtenerNombreProveedor(provs[0])}"
            : "Pedido";

        nombre += " " + DateTime.Now.ToString("yyyy-MM-dd");

        foreach (var c in System.IO.Path.GetInvalidFileNameChars())
            nombre = nombre.Replace(c, '_');

        return nombre;
    }

    private static string ClaseColumna(DefColumna c) =>
        c.Numerica ? "num" : c.Key == "codigo_proveedor" ? "cod" : "";

    private static bool EsSinProveedor(string nombre) =>
        string.Equals(nombre?.Trim(), "SIN PROVEEDOR", StringComparison.OrdinalIgnoreCase);

    private static string H(string? texto) => WebUtility.HtmlEncode(texto ?? "");

    /// <summary>
    /// Arma un solo documento con todos los pedidos recibidos: un título por proveedor
    /// y, debajo, un bloque por cada listado (Lácteos, Galletitas, etc.) con su tabla de productos.
    /// El mismo HTML sirve para Word (.doc) y para imprimir / guardar como PDF.
    /// </summary>
    private string ConstruirDocumentoHtml(List<ListaPedido> lista, Dictionary<long, List<ListaPedidoDetalle>> detalles, bool paraWord)
    {
        var cult = CultureInfo.GetCultureInfo("es-AR");
        var sb = new StringBuilder();

        sb.Append("<html");
        if (paraWord)
            sb.Append(" xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'");
        sb.Append("><head><meta charset='utf-8'><title>Pedido</title>");
        if (paraWord)
            sb.Append("<!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]-->");

        sb.Append("<style>");
        sb.Append("body{font-family:Calibri,Arial,sans-serif;font-size:11pt;color:#000;}");
        sb.Append("h1{font-size:18pt;margin:0 0 6pt 0;}");
        sb.Append("h2{font-size:13pt;margin:16pt 0 2pt 0;background:#e9ecef;padding:3pt 6pt;}");
        sb.Append(".meta{color:#555;font-size:9pt;margin:0 0 4pt 0;}");
        sb.Append("table{border-collapse:collapse;width:100%;}");
        sb.Append("th,td{border:1px solid #999;padding:3pt 6pt;font-size:10.5pt;}");
        sb.Append("th{background:#f1f3f5;text-align:left;}");
        sb.Append(".num{text-align:right;width:70pt;}");
        sb.Append(".cod{width:110pt;}");
        sb.Append("tr{page-break-inside:avoid;}");
        sb.Append("@page{margin:1.5cm;}");
        sb.Append("</style></head><body>");

        bool primero = true;
        foreach (var grupo in lista.GroupBy(p => p.ProveedorId))
        {
            var nombreProv = obtenerNombreProveedor(grupo.Key);
            var estilo = primero ? "" : " style='page-break-before:always'";
            primero = false;

            var titulo = EsSinProveedor(nombreProv) ? "Listado de pedido" : $"Pedido a {nombreProv}";
            sb.Append($"<h1{estilo}>{H(titulo)}</h1>");

            // Columnas de este proveedor (en el orden elegido)
            var cols = ObtenerColumnas(grupo.Key)
                .Select(k => ColumnasDisponibles.First(c => c.Key == k))
                .ToList();

            foreach (var p in grupo.OrderBy(x => x.Fecha))
            {
                sb.Append($"<h2>{H(TituloPedido(p))}</h2>");
                sb.Append($"<p class='meta'>Fecha del pedido: {p.Fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)}</p>");
                sb.Append("<table><thead><tr>");
                foreach (var c in cols)
                {
                    sb.Append($"<th class='{ClaseColumna(c)}'>{H(c.Titulo)}</th>");
                }
                sb.Append("</tr></thead><tbody>");

                var filas = detalles.TryGetValue(p.Id, out var f) ? f : new List<ListaPedidoDetalle>();
                if (!filas.Any())
                {
                    sb.Append($"<tr><td colspan='{cols.Count}'>Sin productos</td></tr>");
                }

                foreach (var d in filas)
                {
                    sb.Append("<tr>");
                    foreach (var c in cols)
                    {
                        string valor = ValorColumna(c.Key, d, cult);
                        sb.Append($"<td class='{ClaseColumna(c)}'>").Append(H(valor)).Append("</td>");
                    }
                    sb.Append("</tr>");
                }

                sb.Append("</tbody></table>");
            }
        }

        sb.Append("</body></html>");
        return sb.ToString();
    }

    // ======================= DATOS PARA LOS DOCUMENTOS =======================

    private async Task<Dictionary<long, List<ListaPedidoDetalle>>> CargarDetallesAsync(List<ListaPedido> lista)
    {
        // Una consulta por pedido para no chocar con el límite de filas
        var detalles = new Dictionary<long, List<ListaPedidoDetalle>>();
        foreach (var p in lista)
        {
            var idPedido = p.Id;
            var res = await SupaClient.From<ListaPedidoDetalle>()
                .Where(d => d.PedidoId == idPedido)
                .Get();

            detalles[p.Id] = res.Models.OrderBy(d => d.NombreProducto).ToList();
        }
        return detalles;
    }

    private static string ValorColumna(string key, ListaPedidoDetalle d, CultureInfo cult) => key switch
    {
        "codigo_proveedor" => string.IsNullOrWhiteSpace(d.CodigoBarrasProveedor) ? "-" : d.CodigoBarrasProveedor!,
        "producto" => d.NombreProducto ?? "",
        "cantidad" => d.UnidadesPorBulto > 1
            ? $"{d.CantidadComprar.ToString("0.##", cult)} {BlazorKioscoCompartido.Constants.TiposBulto.Texto(d.TipoBulto, d.UnidadesPorBulto, d.CantidadComprar)}"   // al proveedor no se le dice cuántas unidades (es un dato interno)
            : !BlazorKioscoCompartido.Constants.TiposBulto.EsSuelto(d.TipoBulto, d.UnidadesPorBulto)
            ? $"{d.CantidadComprar.ToString("0.##", cult)} {BlazorKioscoCompartido.Constants.TiposBulto.Texto(d.TipoBulto, d.UnidadesPorBulto, d.CantidadComprar)}"
            : d.CantidadComprar.ToString("0.##", cult),
        "costo" => d.PrecioCosto.ToString("N2", cult),
        "subtotal" => d.SubtotalEstimado.ToString("N2", cult),
        _ => ""
    };

    // Ancho de cada columna en el PDF (0 = ocupa el resto)
    private static int AnchoPdf(string key) => key switch
    {
        "codigo_proveedor" => 100,
        "cantidad" => 90,
        "costo" or "subtotal" => 85,
        _ => 0
    };

    /// <summary>Mismos datos que el Word (columnas por proveedor, un bloque por listado), pero para armar el PDF en el navegador.</summary>
    private object ConstruirDatosPdf(List<ListaPedido> lista, Dictionary<long, List<ListaPedidoDetalle>> detalles, string archivo)
    {
        var cult = CultureInfo.GetCultureInfo("es-AR");

        var grupos = lista.GroupBy(p => p.ProveedorId).Select(grupo =>
        {
            var nombreProv = obtenerNombreProveedor(grupo.Key);
            var cols = ObtenerColumnas(grupo.Key)
                .Select(k => ColumnasDisponibles.First(c => c.Key == k))
                .ToList();

            return new
            {
                titulo = EsSinProveedor(nombreProv) ? "Listado de pedido" : $"Pedido a {nombreProv}",
                columnas = cols.Select(c => new { titulo = c.Titulo, numerica = c.Numerica, ancho = AnchoPdf(c.Key) }).ToList(),
                pedidos = grupo.OrderBy(x => x.Fecha).Select(p => new
                {
                    titulo = TituloPedido(p),
                    fecha = p.Fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture),
                    filas = (detalles.TryGetValue(p.Id, out var f) ? f : new List<ListaPedidoDetalle>())
                        .Select(d => cols.Select(c => ValorColumna(c.Key, d, cult)).ToList())
                        .ToList()
                }).ToList()
            };
        }).ToList();

        return new { archivo, grupos };
    }

    // ======================= CERRAR / ELIMINAR PEDIDO =======================

    private Task MostrarError(string titulo, string detalle) =>
        avisos.InformarAsync(titulo, detalle, "peligro");

    /// <summary>Marca el pedido como "Enviado": desde ese momento queda solo para consulta.</summary>
    private async Task CerrarPedidoAsync(ListaPedido pedido)
    {
        if (pedido.Estado != "Pendiente") return;
        errorGeneral = null;
        errorDetalle = null;

        var mensaje = $"'{TituloPedido(pedido)}' pasa a \"Enviado\" y ya no se van a poder modificar sus productos.";
        if (!await avisos.ConfirmarAsync("¿Cerrar el pedido?", mensaje, "Cerrar pedido", "exito")) return;

        try
        {
            var idPedido = pedido.Id;
            await SupaClient.From<ListaPedido>()
                .Where(x => x.Id == idPedido)
                .Set(x => x.Estado, "Enviado")
                .Update();

            pedido.Estado = "Enviado";
            FiltrarPorEstado(filtroEstado);   // si se está viendo "Pendientes", sale de la lista
            _ = avisos.GuardadoAsync("Pedido cerrado: marcado como enviado");
        }
        catch (Exception ex)
        {
            await MostrarError("No se pudo cerrar el pedido", ex.Message);
        }
    }

    /// <summary>Elimina el listado completo (con confirmación).</summary>
    private async Task EliminarListadoAsync(ListaPedido pedido)
    {
        errorGeneral = null;
        errorDetalle = null;

        var aviso = pedido.Estado == "Enviado" ? "Este pedido ya fue enviado.\n" : "";
        var mensaje = $"{aviso}Se va a eliminar '{TituloPedido(pedido)}' con todos sus productos. No se puede deshacer.";
        if (!await avisos.ConfirmarAsync("¿Eliminar el listado?", mensaje, "Eliminar")) return;

        try
        {
            await BorrarPedidoAsync(pedido);
            avisos.Toast("Listado eliminado", "exito");
        }
        catch (Exception ex)
        {
            await MostrarError("No se pudo eliminar el listado", ex.Message);
        }
    }

    /// <summary>Borra el pedido y sus renglones, sin preguntar.</summary>
    private async Task BorrarPedidoAsync(ListaPedido pedido)
    {
        var idPedido = pedido.Id;

        await SupaClient.From<ListaPedidoDetalle>().Where(x => x.PedidoId == idPedido).Delete();
        await SupaClient.From<ListaPedido>().Where(p => p.Id == idPedido).Delete();

        pedidos.RemoveAll(p => p.Id == idPedido);
        pedidosSeleccionados.Remove(idPedido);

        if (pedidoDetalle?.Id == idPedido) CerrarDetalle();
        FiltrarPorEstado(filtroEstado);
    }

    public async ValueTask DisposeAsync()
    {
        if (jsModulo != null)
        {
            try { await jsModulo.DisposeAsync(); } catch { /* el circuito ya pudo haberse cerrado */ }
        }
    }
}
