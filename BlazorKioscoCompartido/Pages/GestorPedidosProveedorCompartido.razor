@using BlazorKioscoCompartido.Components
@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Models.DTO
@using System.Globalization
@using System.Net
@using System.Text
@inject BlazorKioscoCompartido.Services.AppState State
@inject Supabase.Client SupaClient
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@implements IAsyncDisposable

<PedidosEstilos />
<AvisosPagina @ref="avisos" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Gestión de Pedidos a Proveedor"
                      Subtitulo="Armar los pedidos a los proveedores"
                      IconoClass="bi-plus-circle"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    <!-- PESTAÑAS PRINCIPALES -->
    <div class="gp-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(pestanaActiva == "armar")"
                class="gp-tab @(pestanaActiva == "armar" ? "is-active" : "")" @onclick='() => CambiarPestana("armar")'>
            <i class="bi bi-cart-plus"></i> <span>Armar / Editar pedido</span>
        </button>
        <button type="button" role="tab" aria-selected="@(pestanaActiva != "armar")"
                class="gp-tab @(pestanaActiva != "armar" ? "is-active" : "")" @onclick='() => CambiarPestana("historial")'>
            <i class="bi bi-journal-text"></i> <span>Historial y envíos</span>
            @if (pedidosPendientesCount > 0)
            {
                <span class="gp-count">@pedidosPendientesCount</span>
            }
        </button>
    </div>

    @if (pestanaActiva == "armar")
    {
        <!-- PESTAÑA 1: ARMAR PEDIDO -->
        <ArmarPedidosAProveedor OnPedidoGuardado="OnPedidoGuardado" />
    }
    else if (pedidoDetalle != null)
    {
        <!-- PESTAÑA 2 (vista de detalle de un pedido) -->
        <section class="gp-card gp-card-pad">
            <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="CerrarDetalle">
                <i class="bi bi-arrow-left"></i> Volver al historial
            </button>

            <div class="gp-detail-head">
                <div class="gp-detail-title">
                    <label class="gp-label" for="gpTituloListado">Nombre del listado</label>
                    <input id="gpTituloListado" type="text" class="gp-title-input" maxlength="80" placeholder="Poné un nombre (Ej: Lácteos)"
                           value="@pedidoDetalle.NombreListado" @onchange="CambiarNombreAsync" />
                    <div class="gp-meta">
                        <span class="gp-chip"><i class="bi bi-truck"></i> @obtenerNombreProveedor(pedidoDetalle.ProveedorId)</span>
                        <span class="gp-chip"><i class="bi bi-calendar3"></i> @pedidoDetalle.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="gp-pill @ClasePill(pedidoDetalle.Estado)">@pedidoDetalle.Estado</span>
                    </div>
                </div>

                <div class="gp-detail-actions">
                    <button type="button" class="gp-btn gp-btn-outline" title="Elegir columnas del documento"
                            @onclick="() => AbrirColumnas(new[] { pedidoDetalle.ProveedorId })">
                        <i class="bi bi-layout-three-columns"></i> Columnas
                    </button>
                    <button type="button" class="gp-btn gp-btn-ok-soft" disabled="@exportando"
                            @onclick="() => ExportarAsync(new List<ListaPedido> { pedidoDetalle }, true)">
                        <i class="bi bi-file-earmark-word"></i> Word
                    </button>
                    <button type="button" class="gp-btn gp-btn-soft" disabled="@exportando"
                            @onclick="() => ExportarAsync(new List<ListaPedido> { pedidoDetalle }, false)">
                        <i class="bi bi-file-earmark-pdf"></i> PDF
                    </button>
                    <span class="gp-sep"></span>
                    @if (pedidoDetalle.Estado == "Pendiente")
                    {
                        <button type="button" class="gp-btn gp-btn-ok" title="Marcar el pedido como enviado"
                                @onclick="() => CerrarPedidoAsync(pedidoDetalle)">
                            <i class="bi bi-check2-circle"></i> Cerrar pedido
                        </button>
                    }
                    @if (pedidoDetalle.Estado == "Enviado")
                    {
                        <button type="button" class="gp-btn gp-btn-ok" title="Cargar la mercadería que llegó de este pedido"
                                @onclick="() => RecibirPedido(pedidoDetalle)">
                            <i class="bi bi-box-arrow-in-down"></i> Recibir mercadería
                        </button>
                    }
                    <button type="button" class="gp-btn gp-btn-danger-soft" title="Eliminar este listado"
                            @onclick="() => EliminarListadoAsync(pedidoDetalle)">
                        <i class="bi bi-trash"></i> Eliminar listado
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorDetalle))
            {
                <div class="gp-banner is-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <p>@errorDetalle</p>
                    <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="() => AbrirDetalleAsync(pedidoDetalle)"><i class="bi bi-arrow-clockwise"></i> Reintentar</button>
                </div>
            }

            @if (!puedeEditar)
            {
                <div class="gp-banner is-neutral">
                    <i class="bi bi-lock-fill"></i>
                    <p>Este pedido ya fue enviado: solo se puede consultar.</p>
                </div>
            }

            <div class="gp-table-wrap gp-stack-wrap">
                <table class="gp-table gp-stack">
                    <thead>
                        <tr>
                            <th>Cód. proveedor</th>
                            <th>Producto</th>
                            <th class="t-center">Cantidad</th>
                            <th class="t-right">Costo est.</th>
                            <th class="t-right">Subtotal est.</th>
                            @if (puedeEditar)
                            {
                                <th class="t-center"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (cargandoDetalle)
                        {
                            <tr class="gp-empty-row">
                                <td colspan="6">
                                    <div class="gp-empty"><span class="gp-spinner"></span><span>Cargando detalle...</span></div>
                                </td>
                            </tr>
                        }
                        else if (!detalleItems.Any())
                        {
                            <tr class="gp-empty-row">
                                <td colspan="6">
                                    <div class="gp-empty">
                                        <span class="gp-bubble"><i class="bi bi-box-seam"></i></span>
                                        <strong>Sin productos</strong>
                                        <span>Este pedido no tiene productos.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var d in detalleItems)
                            {
                                <tr>
                                    <td class="gp-td-code" data-label="Cód. proveedor">@(string.IsNullOrWhiteSpace(d.CodigoBarrasProveedor) ? "-" : d.CodigoBarrasProveedor)</td>
                                    <td class="gp-td-main" data-label="Producto"><span class="gp-product">@d.NombreProducto</span></td>
                                    <td class="t-center" data-label="Cantidad">
                                        @if (puedeEditar)
                                        {
                                            <input type="number" min="0" step="any" class="gp-input-sm gp-input-buy gp-input-qty"
                                                   value="@d.CantidadComprar.ToString(CultureInfo.InvariantCulture)"
                                                   @onchange="e => CambiarCantidadAsync(d, e)" />
                                        }
                                        else
                                        {
                                            <strong>@d.CantidadComprar.ToString("0.##")</strong>
                                        }
                                        @if (d.UnidadesPorBulto > 1)
                                        {
                                            <div class="gp-sub">@BlazorKioscoCompartido.Constants.TiposBulto.Texto(d.TipoBulto, d.UnidadesPorBulto, d.CantidadComprar) x @d.UnidadesPorBulto = @((d.CantidadComprar * d.UnidadesPorBulto).ToString("0.##")) u.</div>
                                        }
                                        else if (!BlazorKioscoCompartido.Constants.TiposBulto.EsSuelto(d.TipoBulto, d.UnidadesPorBulto))
                                        {
                                            <div class="gp-sub">@BlazorKioscoCompartido.Constants.TiposBulto.Texto(d.TipoBulto, d.UnidadesPorBulto, d.CantidadComprar)</div>
                                        }
                                    </td>
                                    <td class="t-right gp-num" data-label="Costo est.">
                                        $@d.PrecioCosto.ToString("N2")
                                        @if (d.UnidadesPorBulto > 1)
                                        {
                                            <div class="gp-sub">x @BlazorKioscoCompartido.Constants.TiposBulto.Texto(d.TipoBulto, d.UnidadesPorBulto, 1)</div>
                                        }
                                    </td>
                                    <td class="t-right gp-money" data-label="Subtotal est.">$@d.SubtotalEstimado.ToString("N2")</td>
                                    @if (puedeEditar)
                                    {
                                        <td class="t-center gp-td-actions" data-label="">
                                            <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Quitar del pedido"
                                                    @onclick="() => EliminarProductoAsync(d)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (detalleItems.Any())
            {
                <div class="gp-totalbar">
                    <span>@detalleItems.Count producto(s) · Total estimado</span>
                    <strong>$@(detalleItems.Sum(x => x.SubtotalEstimado).ToString("N2"))</strong>
                </div>
            }
        </section>
    }
    else
    {
        <!-- PESTAÑA 2: HISTORIAL Y ACCIONES DE ENVÍO -->
        <section class="gp-card gp-card-pad">

            <div class="gp-toolbar">
                <div class="gp-seg" role="group" aria-label="Filtrar por estado">
                    <button type="button" class="@(filtroEstado == "Pendiente" ? "is-active" : "")" @onclick='() => FiltrarPorEstado("Pendiente")'>
                        <span class="gp-dot is-pend"></span> Pendientes <span class="gp-n">@pedidos.Count(p => p.Estado == "Pendiente")</span>
                    </button>
                    <button type="button" class="@(filtroEstado == "Enviado" ? "is-active" : "")" @onclick='() => FiltrarPorEstado("Enviado")'>
                        <span class="gp-dot is-env"></span> Enviados <span class="gp-n">@pedidos.Count(p => p.Estado == "Enviado")</span>
                    </button>
                    <button type="button" class="@(filtroEstado == "Recibido" ? "is-active" : "")" @onclick='() => FiltrarPorEstado("Recibido")'>
                        <span class="gp-dot is-rec"></span> Recibidos <span class="gp-n">@pedidos.Count(p => p.Estado == "Recibido")</span>
                    </button>
                    <button type="button" class="@(filtroEstado == "Todos" ? "is-active" : "")" @onclick='() => FiltrarPorEstado("Todos")'>
                        <span class="gp-dot"></span> Todos <span class="gp-n">@pedidos.Count</span>
                    </button>
                </div>

                <div class="gp-search">
                    <i class="bi bi-search"></i>
                    <input type="text" class="gp-control" placeholder="Buscar por listado o proveedor..."
                           @bind="busquedaHistorial" @bind:event="oninput" @bind:after="AplicarBusquedaHistorial" />
                    @if (!string.IsNullOrEmpty(busquedaHistorial))
                    {
                        <button type="button" class="gp-search-clear" title="Borrar búsqueda" @onclick="LimpiarBusquedaHistorial"><i class="bi bi-x-lg"></i></button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorGeneral))
            {
                <div class="gp-banner is-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <p>@errorGeneral</p>
                    <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="CargarProveedoresYPedidosAsync"><i class="bi bi-arrow-clockwise"></i> Reintentar</button>
                </div>
            }

            <!-- TABLA DE LISTAS GUARDADAS -->
            <div class="gp-table-wrap gp-stack-wrap">
                <table class="gp-table gp-stack">
                    <thead>
                        <tr>
                            <th class="gp-th-check">
                                <input class="gp-check" type="checkbox" title="Seleccionar todos" aria-label="Seleccionar todos"
                                       checked="@TodosSeleccionados" @onchange="ToggleTodos" />
                            </th>
                            <th>Fecha</th>
                            <th>Listado</th>
                            <th>Proveedor</th>
                            <th class="t-right">Monto est.</th>
                            <th class="t-center">Estado</th>
                            <th class="t-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!pedidosFiltrados.Any())
                        {
                            <tr class="gp-empty-row">
                                <td colspan="7">
                                    <div class="gp-empty">
                                        <span class="gp-bubble"><i class="bi bi-journal-x"></i></span>
                                        <strong>No hay pedidos</strong>
                                        <span>@(string.IsNullOrWhiteSpace(busquedaHistorial) ? "No hay pedidos en esta sección." : "Ningún pedido coincide con la búsqueda.")</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in pedidosFiltrados)
                            {
                                <tr class="@(pedidosSeleccionados.Contains(p.Id) ? "is-selected" : "")">
                                    <td class="gp-td-check" data-label="">
                                        <input class="gp-check" type="checkbox" aria-label="Seleccionar pedido"
                                               checked="@pedidosSeleccionados.Contains(p.Id)"
                                               @onchange="e => TogglePedido(p.Id, e)" />
                                    </td>
                                    <td class="gp-nowrap" data-label="Fecha">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="gp-td-main" data-label="Listado">
                                        @if (string.IsNullOrWhiteSpace(p.NombreListado))
                                        {
                                            <span class="gp-muted">Sin nombre</span>
                                        }
                                        else
                                        {
                                            <span class="gp-product">@p.NombreListado</span>
                                        }
                                    </td>
                                    <td data-label="Proveedor"><strong>@(obtenerNombreProveedor(p.ProveedorId))</strong></td>
                                    <td class="t-right gp-money" data-label="Monto est.">$@p.MontoEstimado.ToString("N2")</td>
                                    <td class="t-center" data-label="Estado">
                                        <span class="gp-pill @ClasePill(p.Estado)">@p.Estado</span>
                                    </td>
                                    <td class="t-center gp-td-actions" data-label="">
                                        <div class="gp-cell-actions">
                                            <button type="button" class="gp-btn gp-btn-soft gp-btn-sm gp-btn-icon" title="Ver detalle del pedido"
                                                    @onclick="() => AbrirDetalleAsync(p)">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                            @if (p.Estado == "Pendiente")
                                            {
                                                <button type="button" class="gp-btn gp-btn-ok-soft gp-btn-sm gp-btn-icon" title="Cerrar pedido (marcar como enviado)"
                                                        @onclick="() => CerrarPedidoAsync(p)">
                                                    <i class="bi bi-check2-circle"></i>
                                                </button>
                                            }
                                            @if (p.Estado == "Enviado")
                                            {
                                                <button type="button" class="gp-btn gp-btn-ok-soft gp-btn-sm gp-btn-icon" title="Recibir mercadería de este pedido"
                                                        @onclick="() => RecibirPedido(p)">
                                                    <i class="bi bi-box-arrow-in-down"></i>
                                                </button>
                                            }
                                            <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Eliminar listado"
                                                    @onclick="() => EliminarListadoAsync(p)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- BARRA PARA AGRUPAR LOS PEDIDOS TILDADOS EN UN SOLO DOCUMENTO -->
            @if (pedidosSeleccionados.Any())
            {
                <div class="gp-selbar">
                    <div class="gp-selinfo">
                        <b>@pedidosSeleccionados.Count</b>
                        <span>pedido(s) seleccionado(s) para un solo documento</span>
                    </div>
                    <div class="gp-btn-group">
                        <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" title="Elegir columnas del documento" @onclick="AbrirColumnasSeleccion">
                            <i class="bi bi-layout-three-columns"></i> Columnas
                        </button>
                        <button type="button" class="gp-btn gp-btn-ok gp-btn-sm" disabled="@exportando" @onclick="() => ExportarSeleccionadosAsync(true)">
                            <i class="bi bi-file-earmark-word"></i> Word
                        </button>
                        <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" disabled="@exportando" @onclick="() => ExportarSeleccionadosAsync(false)">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </button>
                        <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm" @onclick="LimpiarSeleccion">Limpiar</button>
                    </div>
                </div>
            }
        </section>
    }
</div>

@if (mostrarModalColumnas)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModalColumnas">
        <div class="gp-modal" role="dialog" aria-modal="true" aria-labelledby="gpColsTitulo" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-layout-three-columns"></i></span>
                <div>
                    <h3 id="gpColsTitulo">Columnas del documento</h3>
                    <p>Tildá las columnas que querés ver y ordenalas con las flechas. Cada proveedor tiene las suyas.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModalColumnas"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                @foreach (var par in edicionColumnas)
                {
                    var listaCols = par.Value;
                    <div class="gp-colgroup">
                        <div class="gp-colgroup-title"><i class="bi bi-truck"></i> @obtenerNombreProveedor(par.Key)</div>
                        <ul class="gp-collist">
                            @for (int i = 0; i < listaCols.Count; i++)
                            {
                                var idx = i;
                                var col = listaCols[i];
                                var orden = listaCols.Take(i + 1).Count(c => c.Activa);
                                <li class="gp-colitem @(col.Activa ? "" : "is-off")">
                                    <label>
                                        <input class="gp-check" type="checkbox" @bind="col.Activa" />
                                        <span>@col.Etiqueta</span>
                                    </label>
                                    @if (col.Activa)
                                    {
                                        <span class="gp-ord" title="Posición en el documento">@orden</span>
                                    }
                                    else
                                    {
                                        <span class="gp-ord is-empty"></span>
                                    }
                                    <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Subir" disabled="@(idx == 0)"
                                            @onclick="() => MoverColumna(listaCols, idx, -1)">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Bajar" disabled="@(idx == listaCols.Count - 1)"
                                            @onclick="() => MoverColumna(listaCols, idx, 1)">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorColumnas))
                {
                    <div class="gp-banner is-danger" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><p>@errorColumnas</p></div>
                }
            </div>
            <div class="gp-modal-foot">
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarModalColumnas">Cancelar</button>
                <button type="button" class="gp-btn gp-btn-outline" title="Vale hasta que salgas de esta pantalla" @onclick="AplicarColumnasSoloEstaVez">Usar solo esta vez</button>
                <button type="button" class="gp-btn gp-btn-primary" @onclick="GuardarColumnasEnProveedorAsync">Guardar para el proveedor</button>
            </div>
        </div>
    </div>
}

@code {
    private AvisosPagina avisos = default!;
    private string busquedaHistorial = "";

    /// <summary>Ruta de la página de compras al mayorista (el pedido se abre con ?pedido=ID). Ajustala a tu ruta real.</summary>
    [Parameter] public string RutaRecibir { get; set; } = "/compras-mayorista";

    private string pestanaActiva = "armar";
    private string filtroEstado = "Pendiente";

    private List<ListaPedido> pedidos = new();
    private List<ListaPedido> pedidosFiltrados = new();
    private List<Proveedor> proveedores = new();

    // Pedidos tildados para agrupar en un solo documento
    private HashSet<long> pedidosSeleccionados = new();
    private bool exportando = false;
    private string? errorGeneral;

    // Vista de detalle de un pedido
    private ListaPedido? pedidoDetalle;
    private List<ListaPedidoDetalle> detalleItems = new();
    private bool cargandoDetalle = false;
    private string? errorDetalle;

    private IJSObjectReference? jsModulo;

    // ---------- Columnas del documento (por proveedor) ----------
    private sealed record DefColumna(string Key, string Etiqueta, string Titulo, bool Numerica);

    private static readonly List<DefColumna> ColumnasDisponibles = new()
    {
        new("codigo_proveedor", "Código del proveedor", "Código", false),
        new("producto",         "Producto",             "Producto", false),
        new("cantidad",         "Cantidad",             "Cantidad", true),
        new("costo",            "Costo estimado",       "Costo est.", true),
        new("subtotal",         "Subtotal estimado",    "Subtotal est.", true),
    };

    // Si el proveedor no tiene nada guardado se usan estas
    private static readonly string[] ColumnasPorDefecto = { "codigo_proveedor", "producto", "cantidad" };

    private sealed class ColumnaEditable
    {
        public string Key { get; set; } = "";
        public string Etiqueta { get; set; } = "";
        public bool Activa { get; set; }
    }

    private bool mostrarModalColumnas = false;
    private string? errorColumnas;
    private Dictionary<long, List<ColumnaEditable>> edicionColumnas = new();

    // Columnas elegidas con "Usar solo esta vez" (no se guardan en la base)
    private Dictionary<long, List<string>> columnasTemporales = new();

    private int pedidosPendientesCount => pedidos.Count(p => p.Estado == "Pendiente");

    // Solo se puede modificar un pedido que todavía no se envió
    private bool puedeEditar => pedidoDetalle?.Estado == "Pendiente";

    private bool TodosSeleccionados =>
        pedidosFiltrados.Any() && pedidosFiltrados.All(p => pedidosSeleccionados.Contains(p.Id));

    protected override async Task OnInitializedAsync()
    {
        await CargarProveedoresYPedidosAsync();
    }

    private async Task CargarProveedoresYPedidosAsync()
    {
        try
        {
            errorGeneral = null;

            var resProv = await SupaClient.From<Proveedor>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Get();
            proveedores = resProv.Models.ToList();

            var resPedidos = await SupaClient.From<ListaPedido>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Get();

            pedidos = resPedidos.Models.ToList();
            FiltrarPorEstado(filtroEstado);
        }
        catch (Exception ex)
        {
            errorGeneral = "No se pudieron cargar los pedidos: " + ex.Message;
        }
    }

    // Lo llama el componente de armado cuando se guardó un pedido: solo refresca el historial
    private async Task OnPedidoGuardado()
