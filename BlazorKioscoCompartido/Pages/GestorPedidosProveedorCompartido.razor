    private void FiltrarPorEstado(string estado)
    {
        filtroEstado = estado;
        var baseLista = estado == "Todos" ? pedidos : pedidos.Where(p => p.Estado == estado).ToList();

        var texto = Normalizar(busquedaHistorial);
        pedidosFiltrados = string.IsNullOrWhiteSpace(texto)
            ? baseLista.ToList()
            : baseLista.Where(p => Normalizar($"{p.NombreListado} {obtenerNombreProveedor(p.ProveedorId)} {p.Fecha:dd/MM/yyyy}").Contains(texto)).ToList();

        // Si quedan tildados pedidos que ya no se ven, se destildan
        pedidosSeleccionados.IntersectWith(pedidosFiltrados.Select(p => p.Id));
    }

    private void AplicarBusquedaHistorial() => FiltrarPorEstado(filtroEstado);

    private void LimpiarBusquedaHistorial()
    {
        busquedaHistorial = "";
        FiltrarPorEstado(filtroEstado);
    }

    private static string Normalizar(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var d = s.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(d.Length);
        foreach (var c in d)
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark) sb.Append(c);
        return sb.ToString().ToLowerInvariant().Trim();
    }

    private string obtenerNombreProveedor(long provId)
    {
        return proveedores.FirstOrDefault(p => p.Id == provId)?.Nombre ?? "Proveedor N/D";
    }

    private static string TituloPedido(ListaPedido p) =>
        string.IsNullOrWhiteSpace(p.NombreListado)
            ? $"Pedido del {p.Fecha.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture)}"
            : p.NombreListado!;

