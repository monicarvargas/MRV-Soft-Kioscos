    private decimal? ObtenerPrecioCalculadoMostrar(Producto prod, decimal precioCalculado)
    {
        if (precioCalculado == 0m) return null; // Retorna null para que el input quede vacío si no hay precio

        if (prod != null && prod.IsMedidaGramos())
        {
            return precioCalculado / 10m;
        }
        return precioCalculado;
    }
    public class ItemIngresoModel
    {
        public Producto Producto { get; set; } = new();
        public int Cantidad { get; set; } = 1;
        public decimal CostoPV { get; set; }
        public decimal UtilidadPV { get; set; }
        public decimal PrecioVentaCalculado { get; set; }
        public decimal UtilidadLista2 { get; set; }
        public decimal PrecioVentaLista2Calculado { get; set; }
        // public decimal SubtotalCosto => Cantidad * CostoPV;
        public decimal SubtotalCosto =>
        (Producto != null && Producto.IsMedidaGramos())
            ? (Cantidad / 1000m) * CostoPV
            : Cantidad * CostoPV;
    }
