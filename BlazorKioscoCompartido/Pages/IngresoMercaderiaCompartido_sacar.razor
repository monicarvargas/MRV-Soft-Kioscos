    private async Task GuardarIngresoCompraAsync()
    {
        if (!itemsCompra.Any()) return;

        guardando = true;
        mensajeError = null;

        try
        {
            // Guardamos estos datos antes de limpiar la pantalla (se usan al final)
            var proveedorCompra = proveedorId;
            var idsProductos = itemsCompra.Select(i => i.Producto.Id).Distinct().ToList();

            foreach (var item in itemsCompra)
            {
                var prod = item.Producto;

                // 1. Convertir cantidad si el producto mide en gramos (1200g -> 1.2kg)
                // int cantidadAIncrementar = (prod != null && prod.IsMedidaGramos())
                //     ? item.Cantidad / 1000
                //     : item.Cantidad;

                // 2. Incrementar stock
                prod.StockActual = (prod.StockActual ?? 0) + item.Cantidad;

                // 3. Definir la consulta de Supabase
                var query = SupaClient.From<Producto>()
                    .Where(p => p.Id == prod.Id && p.KioscoId == State.KioscoId)
                    .Set(p => p.StockActual, prod.StockActual);

                // 4. Si ingresó un precio de costo mayor a cero, actualizamos precios y utilidades
                if (item.CostoPV > 0)
                {
                    prod.PrecioCosto = item.CostoPV;
                    prod.UtilidadPV = item.UtilidadPV;
                    // Actualizar stock e incrementarlo
                    prod.StockActual = (prod.StockActual ?? 0) + item.Cantidad;
                    prod.PrecioVenta = item.PrecioVentaCalculado;
                    prod.UtilidadLista2 = item.UtilidadLista2;
                    prod.PrecioLista2 = item.PrecioVentaLista2Calculado;


                    query = query
                        .Set(p => p.PrecioCosto, prod.PrecioCosto)
                        .Set(p => p.UtilidadPV, prod.UtilidadPV)
                        .Set(p => p.PrecioVenta, prod.PrecioVenta)
                        .Set(p => p.UtilidadLista2, prod.UtilidadLista2)
                        .Set(p => p.PrecioLista2, prod.PrecioLista2);
                }

                // 5. Ejecutar actualización
                await query.Update();
            }

            // Limpieza al terminar
            itemsCompra.Clear();
            numeroComprobante = "";
            proveedorId = 0;

            // Asociar el proveedor de la compra a los productos (solo los que aún no lo tienen)
            if (proveedorCompra > 0)
            {
                try
                {
                    await AsociarProveedorAProductosAsync(proveedorCompra, idsProductos);
                }
                catch (Exception ex)
                {
                    // El stock y los precios ya quedaron guardados; solo falló la asociación
                    mensajeError = "La compra se guardó, pero no se pudo asociar el proveedor a los productos: " + ex.Message;
                }
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al procesar el ingreso de mercadería: " + ex.Message;
        }
        finally
        {
            guardando = false;
        }
    }
    /// <summary>
    /// Vincula el proveedor con cada producto en productos_proveedores, solo si todavía no existe la relación.
    /// No toca las relaciones existentes (ni su código de barras ni si están habilitadas).
    /// </summary>
    private async Task AsociarProveedorAProductosAsync(long idProveedor, List<long> idsProductos)
    {
        // Relaciones que ya existen entre este proveedor y los productos del kiosco
        var res = await SupaClient.From<ProductoProveedor>()
            .Where(r => r.IdProveedor == idProveedor && r.IdKiosco == State.KioscoId)
            .Get();

        var yaAsociados = res.Models.Select(r => r.IdProducto).ToHashSet();

        var nuevas = idsProductos
            .Where(id => !yaAsociados.Contains(id))
            .Select(id => new ProductoProveedor
            {
                IdProducto = id,
                IdProveedor = idProveedor,
                IdKiosco = State.KioscoId,
                CodigoBarrasProveedor = null,   // el código se carga después desde el producto
                Habilitado = true
            })
            .ToList();

        if (nuevas.Any())
        {
            await SupaClient.From<ProductoProveedor>().Insert(nuevas);
        }
    }

