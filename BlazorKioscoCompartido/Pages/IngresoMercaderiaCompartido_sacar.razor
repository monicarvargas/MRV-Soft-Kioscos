    //         decimal precioVenta = prod.PrecioCosto * prod.UtilidadPV ?? 0m;

    //         itemsCompra.Add(new ItemIngresoModel
    //         {
    //             Producto = prod,
    //             Cantidad = 1,
    //             CostoPV = costoPV,
    //             UtilidadPV = utilidad1,
    //             UtilidadLista2 = utilidad2,
    //             PrecioVentaCalculado = precioVenta,
    //             PrecioVentaLista2Calculado = 0m
    //         });
    //     }
    // }
    private void AgregarProductoALaLista(Producto prod)
    {
        var existente = itemsCompra.FirstOrDefault(i => i.Producto.Id == prod.Id);
        if (existente != null)
        {
            existente.Cantidad++;
        }
        else
        {
            // 1. Obtenemos costo y utilidades que vienen del producto (o BD / Alta Rápida)
            decimal costo = prod.PrecioCosto ?? 0m;
            decimal utilidad1 = prod.UtilidadPV ?? 0m;
            decimal utilidad2 = prod.UtilidadLista2 ?? 0m;

            // 2. Creamos el ítem asignando el costo ingresado
            var nuevoItem = new ItemIngresoModel
            {
                Producto = prod,
                Cantidad = 1,
                CostoPV = costo,
                UtilidadPV = utilidad1,
                UtilidadLista2 = utilidad2,
                PrecioVentaCalculado = 0m,
                PrecioVentaLista2Calculado = 0m
            };

            // 3. Si el producto ya traía un costo, recalculamos los precios de venta inmediatamente
            if (costo > 0)
            {
                RecalcularPrecios(nuevoItem);
            }

            itemsCompra.Add(nuevoItem);
        }
    }
    private void ActualizarCantidad(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val) && val > 0)
            item.Cantidad = val;
    }

    private void ActualizarCosto(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, cultura, out decimal val))
        {
            item.CostoPV = val;
            RecalcularPrecios(item);
        }
    }

    private void ActualizarMargen(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, cultura, out decimal val))
        {
            item.UtilidadPV = val;
            item.PrecioVentaCalculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, val, State) ?? 0m;
        }
    }

    private void ActualizarUtilidadLista2(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, cultura, out decimal val))
        {
            item.UtilidadLista2 = val;
            item.PrecioVentaLista2Calculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, val, State) ?? 0m;
        }
    }

    private void ActualizarPrecioVenta(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, cultura, out decimal val))
        {
            // Si se vende por gramos, lo multiplicamos por 10 para guardar el precio por kilo entero en el modelo
            item.PrecioVentaCalculado = (item.Producto != null && item.Producto.IsMedidaGramos()) ? val * 10m : val;
        }
    }

    private void ActualizarPrecioLista2(ItemIngresoModel item, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Any, cultura, out decimal val))
        {
            item.PrecioVentaLista2Calculado = (item.Producto != null && item.Producto.IsMedidaGramos()) ? val * 10m : val;
        }
    }

    // private void RecalcularPrecios(ItemIngresoModel item)
    // {
    //     if (item.CostoPV > 0)
    //     {
    //         // Calcular Precio Venta Lista 1
    //         item.PrecioVentaCalculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, item.UtilidadPV, State) ?? 0m;

    //         // Calcular Precio Venta Lista 2 solo si la utilidad es mayor a 0
    //         if (item.UtilidadLista2 > 0)
    //         {
    //             item.PrecioVentaLista2Calculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, item.UtilidadLista2, State) ?? 0m;
    //         }
    //         else
    //         {
    //             item.PrecioVentaLista2Calculado = 0m;
    //         }
    //     }
    // }
    private void RecalcularPrecios(ItemIngresoModel item)
    {
        if (item.CostoPV > 0)
        {
            // 1. Asignar costo y utilidad al modelo temporal del producto para que el servicio pueda calcularlo
            item.Producto.PrecioCosto = item.CostoPV;
            item.Producto.UtilidadPV = item.UtilidadPV;

            // 2. Calcular Precio Venta Lista 1
            item.PrecioVentaCalculado = item.Producto.CalcularPrecioPorUtilidad(item.CostoPV, item.UtilidadPV, State) ?? 0m;
            item.Producto.PrecioVenta = item.PrecioVentaCalculado;

            // 3. Ejecutar la lógica automática de Lista 2 (Reglas del Kiosco / Recargos sobre Precio Venta)
            // PrecioService.ProcesarLista2Automatico(item.Producto, (int)State.KioscoId);
            PrecioService.ProcesarLista2Automatico(item.Producto, State.KioscoId, State);

            // 4. Copiar los valores automáticos calculados por el servicio al ItemIngresoModel
            item.UtilidadLista2 = item.Producto.UtilidadLista2 ?? 0m;
            item.PrecioVentaLista2Calculado = item.Producto.PrecioLista2 ?? 0m;
        }
    }
    private void EliminarItem(ItemIngresoModel item) => itemsCompra.Remove(item);

    // --- LÓGICA DE ALTA RÁPIDA DE PRODUCTO NUEVO ---
    private void AbrirModalNuevoProducto()
    {
        nuevoProducto = new Producto
        {
            KioscoId = State.KioscoId,
            FamiliaId = null,
            Activo = true,
            UtilidadPV = 40
        };
        mostrarModalNuevoProducto = true;
    }

    private void CerrarModalNuevoProducto() => mostrarModalNuevoProducto = false;

