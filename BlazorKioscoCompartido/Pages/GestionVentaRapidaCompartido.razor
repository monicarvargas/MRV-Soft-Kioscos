@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Services
@using BlazorKioscoCompartido.Components
@using static Supabase.Postgrest.Constants
@inject Supabase.Client SupaClient
@inject BlazorKioscoCompartido.Services.AppState State

<PedidosEstilos />
<ConfigEstilos />
<VentasEstilos />
<AvisosPagina @ref="avisos" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Venta rápida y combos"
                      Subtitulo="Los botones que usás en caja para vender sin buscar"
                      IconoClass="bi-lightning-charge-fill"
                      ColorBorde="warning"
                      ColorIcono="warning"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    <div class="vt-wrap" style="display:flex; flex-direction:column; gap:1rem">
        <PestanasPromos Activa="rapida" RutaCombos="@RutaCombos" AntesDeSalir="ConfirmarSalirAsync" />

        @* ================= CATEGORÍAS ================= *@
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head">
                <span class="gp-bubble"><i class="bi bi-grid-fill"></i></span>
                <div class="vt-head-text">
                    <h2>Categorías</h2>
                    <p>Son los botones grandes que aparecen al tocar "Venta rápida" en Vender.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-primary gp-btn-sm vt-head-right" @onclick="AbrirModalNuevaCategoria"><i class="bi bi-plus-lg"></i> Nueva</button>
            </div>

            @if (cargandoCategorias)
            {
                <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando categorías...</p></div>
            }
            else if (!listaCategorias.Any())
            {
                <div class="gp-empty">
                    <span class="gp-bubble"><i class="bi bi-lightning"></i></span>
                    <strong>Todavía no hay categorías</strong>
                    <span>Creá la primera (ej: GOLOSINAS, HELADOS, PAN) y después agregale productos.</span>
                </div>
            }
            else
            {
                <div class="vr-cats">
                    @foreach (var cat in listaCategorias)
                    {
                        <button type="button" class="vr-cat @(cat.Id == categoriaSeleccionadaId ? "is-active" : "")" @onclick="() => CambiarCategoriaAsync(cat.Id)">
                            <i class="bi @(string.IsNullOrWhiteSpace(cat.Icono) ? "bi-tag-fill" : cat.Icono)"></i>
                            <span>@cat.Nombre</span>
                        </button>
                    }
                </div>
            }
        </section>

        @if (categoriaSeleccionadaId > 0)
        {
            @* ================= BOTONERA DE LA CATEGORÍA ================= *@
            <section class="gp-card gp-card-pad">
                <div class="gp-card-head" style="flex-wrap:wrap">
                    <span class="gp-bubble"><i class="bi @IconoActual"></i></span>
                    <div class="vt-head-text">
                        <h2>@CategoriaActualNombre</h2>
                        <p>@ProductosDeLaCategoria.Count(p => p.MostrarEnVentaRapida) visible(s) · el orden es el de la pantalla de venta</p>
                    </div>
                    <div class="vt-head-right vr-head-btns">
                        <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" @onclick="AbrirModalAgregar"><i class="bi bi-plus-lg"></i> Agregar productos</button>
                        <button type="button" class="gp-btn gp-btn-soft gp-btn-sm gp-btn-icon" title="Editar categoría" @onclick="AbrirModalEditarCategoria"><i class="bi bi-pencil-fill"></i></button>
                        <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Eliminar categoría" @onclick="EliminarCategoriaActualAsync"><i class="bi bi-trash3-fill"></i></button>
                    </div>
                </div>

                @if (!ProductosDeLaCategoria.Any())
                {
                    <div class="gp-empty">
                        <span class="gp-bubble"><i class="bi bi-plus-square-dotted"></i></span>
                        <strong>Sin productos</strong>
                        <span>Tocá "Agregar productos", buscalos (o elegí una familia) y tildá los que quieras.</span>
                        <button type="button" class="gp-btn gp-btn-primary" style="margin-top:.8rem" @onclick="AbrirModalAgregar"><i class="bi bi-plus-lg"></i> Agregar productos</button>
                    </div>
                }
                else
                {
                    <ul class="vr-lista">
                        @{ var lista = ProductosDeLaCategoria; }
                        @for (int i = 0; i < lista.Count; i++)
                        {
                            var index = i;
                            var prod = lista[index];
                            <li class="vr-item @(prod.MostrarEnVentaRapida ? "" : "is-off")">
                                <span class="gp-ord">@(index + 1)</span>
                                <div class="vr-item-info">
                                    <b>@prod.Nombre</b>
                                    <small>@(string.IsNullOrWhiteSpace(prod.CodigoBarras) ? "Sin código" : prod.CodigoBarras)@(prod.MostrarEnVentaRapida ? "" : " · oculto")</small>
                                </div>
                                <label class="gp-switch cf-switch-sm" title="Mostrar en la venta rápida">
                                    <input type="checkbox" checked="@prod.MostrarEnVentaRapida" @onchange="e => CambiarVisibilidad(prod, (bool)e.Value!)" />
                                    <span class="gp-switch-track"></span>
                                </label>
                                <div class="cf-order">
                                    <button type="button" class="gp-btn gp-btn-outline gp-btn-sm gp-btn-icon" title="Subir" disabled="@(index == 0)" @onclick="() => MoverPosicion(index, -1)"><i class="bi bi-arrow-up"></i></button>
                                    <button type="button" class="gp-btn gp-btn-outline gp-btn-sm gp-btn-icon" title="Bajar" disabled="@(index == lista.Count - 1)" @onclick="() => MoverPosicion(index, 1)"><i class="bi bi-arrow-down"></i></button>
                                </div>
                                <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Quitar de la categoría" @onclick="() => QuitarDeCategoria(prod)"><i class="bi bi-x-lg"></i></button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }

        @* ================= BARRA DE GUARDADO ================= *@
        @if (productosModificadosIds.Any())
        {
            <div class="gp-selbar">
                <div class="gp-selinfo"><b>@productosModificadosIds.Count</b> cambio(s) sin guardar</div>
                <div class="gp-btn-group">
                    <button type="button" class="gp-btn gp-btn-ghost" @onclick="DescartarCambiosAsync">Descartar</button>
                    <button type="button" class="gp-btn gp-btn-ok" disabled="@guardando" @onclick="GuardarCambiosEnLoteAsync">
                        <i class="bi bi-check-lg"></i> @(guardando ? "Guardando..." : "Guardar cambios")
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@* ===================== MODAL: NUEVA / EDITAR CATEGORÍA ===================== *@
@if (mostrarModalCategoria)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModalCategoria">
        <div class="gp-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi @(editandoCategoriaId == 0 ? "bi-folder-plus" : "bi-pencil-square")"></i></span>
                <div>
                    <h3>@(editandoCategoriaId == 0 ? "Nueva categoría" : "Editar categoría")</h3>
                    <p>Nombre corto: entra en un botón.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModalCategoria"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <label class="cf-lbl">Nombre</label>
                <input type="text" class="gp-control" maxlength="40" placeholder="Ej: GOMITAS, HELADOS, PAN..." @bind="nombreCategoria" />

                <label class="cf-lbl" style="margin-top:1rem">Ícono</label>
                <div class="vr-iconos">
                    @foreach (var ic in Iconos)
                    {
                        <button type="button" class="vr-icono @(iconoCategoria == ic.Clase ? "is-active" : "")" title="@ic.Nombre" @onclick="() => iconoCategoria = ic.Clase">
                            <i class="bi @ic.Clase"></i>
                            <span>@ic.Nombre</span>
                        </button>
                    }
                </div>
            </div>
            <div class="gp-modal-foot">
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarModalCategoria">Cancelar</button>
                <button type="button" class="gp-btn gp-btn-ok" disabled="@guardando" @onclick="GuardarCategoriaAsync"><i class="bi bi-check-lg"></i> Guardar</button>
            </div>
        </div>
    </div>
}

@* ===================== MODAL: AGREGAR PRODUCTOS (mismo buscador que Carteles / Códigos de barras) ===================== *@
@if (mostrarModalAgregar)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModalAgregar">
        <div class="gp-modal vr-modal-agregar" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi @IconoActual"></i></span>
                <div>
                    <h3>Agregar productos a @CategoriaActualNombre</h3>
                    <p>Buscá por nombre, marca o código, o elegí una familia. Tildá los que quieras: se suman al final. Si ya estaban en otra categoría, se pasan a esta.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModalAgregar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <BuscadorMultiple EstaElegido="@(id => EstaEnLaCategoria(id))" OnAlternar="AlternarEnCategoria" OnAgregarTodos="AgregarVariosACategoria" />
            </div>
            <div class="gp-modal-foot">
                <span class="vr-modal-cuenta"><i class="bi bi-check2-square"></i> @ProductosDeLaCategoria.Count(p => p.MostrarEnVentaRapida) en @CategoriaActualNombre</span>
                <button type="button" class="gp-btn gp-btn-ok" @onclick="CerrarModalAgregar"><i class="bi bi-check-lg"></i> Listo</button>
            </div>
        </div>
    </div>
}

<style>
    .vr-head-btns { display: flex; flex-wrap: wrap; gap: .4rem; }
    .vr-modal-agregar { max-width: 56rem; }
    .vr-modal-agregar .gp-modal-body { min-height: 18rem; }
    .vr-modal-cuenta { margin-right: auto; align-self: center; color: var(--gp-muted); font-weight: 800; font-size: .88rem; }
    .vr-cats { display: flex; flex-wrap: wrap; gap: .5rem; }
    .vr-cat { display: inline-flex; align-items: center; gap: .5rem; height: 2.8rem; padding: 0 1rem; border: 2px solid var(--gp-line); border-radius: 14px; background: #fff; color: var(--gp-text); font: inherit; font-weight: 900; font-size: .88rem; text-transform: uppercase; cursor: pointer; transition: border-color .15s, background .15s; }
    .vr-cat i { color: var(--gp-primary); font-size: 1.1rem; }
    .vr-cat:hover { border-color: var(--gp-primary-line); }
    .vr-cat.is-active { border-color: var(--gp-primary); background: var(--gp-primary); color: #fff; box-shadow: 0 6px 14px rgba(22,33,72,.2); }
    .vr-cat.is-active i { color: #fff; }

    .vr-lista { display: grid; grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr)); gap: .5rem; margin: 0; padding: 0; list-style: none; }
    .vr-item { display: flex; align-items: center; gap: .6rem; padding: .55rem .65rem; border: 1px solid var(--gp-line); border-radius: 12px; background: #fff; }
    .vr-item.is-off { background: #f7f8fc; }
    .vr-item.is-off .vr-item-info b { color: #9aa3bd; }
    .vr-item-info { flex: 1 1 auto; min-width: 0; }
    .vr-item-info b { display: block; font-weight: 800; font-size: .88rem; text-transform: uppercase; line-height: 1.25; }
    .vr-item-info small { color: var(--gp-muted); font-weight: 600; font-size: .76rem; }

    .vr-iconos { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.4rem, 1fr)); gap: .45rem; }
    .vr-icono { display: flex; flex-direction: column; align-items: center; gap: .25rem; padding: .6rem .3rem; border: 2px solid var(--gp-line); border-radius: 12px; background: #fff; color: var(--gp-muted); font: inherit; font-size: .72rem; font-weight: 800; cursor: pointer; }
    .vr-icono i { font-size: 1.4rem; color: var(--gp-text); }
    .vr-icono.is-active { border-color: var(--gp-primary); background: var(--gp-primary-soft); color: var(--gp-primary); }
    .vr-icono.is-active i { color: var(--gp-primary); }

    @@media (max-width: 575.98px) {
        .vr-lista { grid-template-columns: 1fr; }
        .vr-head-btns { width: 100%; }
        .vr-head-btns .gp-btn-primary { flex: 1 1 auto; }
        .vr-item { flex-wrap: wrap; }
        .vr-item-info { flex: 1 1 calc(100% - 2.5rem); }
    }
</style>

@code {
    [Parameter] public string RutaCombos { get; set; } = "/gestion-combo";

    private AvisosPagina avisos = default!;
    private List<CategoriaVentaRapida> listaCategorias = new();
    private List<Producto> productosAsignados = new();
    private HashSet<long> productosModificadosIds = new();

    private long categoriaSeleccionadaId;
    private bool cargandoCategorias = true;
    private bool guardando = false;

    // modal de categoría (nueva o edición)
    private bool mostrarModalCategoria = false;
    private long editandoCategoriaId = 0;
    private string nombreCategoria = "";
    private string iconoCategoria = "bi-tag-fill";

    private sealed record IconoDef(string Clase, string Nombre);
    private static readonly IconoDef[] Iconos =
    {
        new("bi-tag-fill", "Etiqueta"), new("bi-candy", "Golosinas"), new("bi-emoji-smile", "Gomitas"),
        new("bi-ice-cream", "Helados"), new("bi-cup-straw", "Bebidas"), new("bi-cup-hot-fill", "Café"),
        new("bi-basket-fill", "Almacén"), new("bi-egg-fried", "Comida"), new("bi-box-seam", "Varios"),
        new("bi-heart-fill", "Favoritos"), new("bi-star-fill", "Ofertas"), new("bi-fire", "Lo más vendido")
    };

    private CategoriaVentaRapida? CategoriaActual => listaCategorias.FirstOrDefault(c => c.Id == categoriaSeleccionadaId);
    private string CategoriaActualNombre => CategoriaActual?.Nombre ?? "Categoría";
    private string IconoActual => string.IsNullOrWhiteSpace(CategoriaActual?.Icono) ? "bi-tag-fill" : CategoriaActual!.Icono!;

    /// <summary>Los productos de la categoría elegida (visibles y ocultos), en el orden de la venta rápida.</summary>
    private List<Producto> ProductosDeLaCategoria => productosAsignados
        .Where(p => p.CategoriaVentaRapidaId == categoriaSeleccionadaId)
        .OrderBy(p => p.OrdenVentaRapida == 0 ? int.MaxValue : p.OrdenVentaRapida)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasAsync(null);
    }

    // ======================= CATEGORÍAS =======================
    private async Task CargarCategoriasAsync(long? seleccionar)
    {
        cargandoCategorias = true;
        try
        {
            // solo las de ESTE negocio (antes se veían las de todos)
            var res = await SupaClient.From<CategoriaVentaRapida>()
                .Where(x => x.KioscoId == State.KioscoId)
                .Where(x => x.Habilitado == true)
                .Order("orden", Ordering.Ascending)
                .Get();

            listaCategorias = res.Models ?? new List<CategoriaVentaRapida>();
            var id = seleccionar ?? (listaCategorias.Any(c => c.Id == categoriaSeleccionadaId) ? categoriaSeleccionadaId : listaCategorias.FirstOrDefault()?.Id ?? 0);
            await SeleccionarCategoriaAsync(id);
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron cargar las categorías", ex.Message, "peligro");
        }
        finally
        {
            cargandoCategorias = false;
        }
    }

    private async Task CambiarCategoriaAsync(long catId)
    {
        if (catId == categoriaSeleccionadaId) return;
        if (!await ConfirmarSalirAsync()) return;
        await SeleccionarCategoriaAsync(catId);
    }

    /// <summary>Si hay cambios sin guardar, pregunta antes de perderlos.</summary>
    private async Task<bool> ConfirmarSalirAsync()
    {
        if (!productosModificadosIds.Any()) return true;
        return await avisos.ConfirmarAsync("Tenés cambios sin guardar", "Si seguís, se pierden. ¿Querés descartarlos?", "Descartar cambios", "aviso", "Quedarme");
    }

    private async Task SeleccionarCategoriaAsync(long catId)
    {
        categoriaSeleccionadaId = catId;
        productosModificadosIds.Clear();
        productosAsignados = new();
        if (catId > 0) await CargarProductosDeCategoriaAsync();
    }

    private async Task CargarProductosDeCategoriaAsync()
    {
        try
        {
            long cat = categoriaSeleccionadaId;
            // todos los de la categoría (también los ocultos, para poder volver a mostrarlos)
            var res = await SupaClient.From<Producto>()
                .Where(x => x.KioscoId == State.KioscoId)
                .Where(x => x.CategoriaVentaRapidaId == cat)
                .Order("orden_venta_rapida", Ordering.Ascending)
                .Get();

            productosAsignados = res.Models ?? new List<Producto>();
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron cargar los productos", ex.Message, "peligro");
        }
    }

    // ======================= MODAL AGREGAR =======================
    private bool mostrarModalAgregar;
    private void AbrirModalAgregar() => mostrarModalAgregar = true;
    private void CerrarModalAgregar() => mostrarModalAgregar = false;

    /// <summary>¿Ya está (visible) en la categoría elegida? → aparece tildado en el buscador.</summary>
    private bool EstaEnLaCategoria(long id) =>
        productosAsignados.Any(p => p.Id == id && p.CategoriaVentaRapidaId == categoriaSeleccionadaId && p.MostrarEnVentaRapida);

    /// <summary>Tildar = agregar a la categoría · destildar = sacarlo.</summary>
    private void AlternarEnCategoria(Producto prod)
    {
        var existente = productosAsignados.FirstOrDefault(p => p.Id == prod.Id && p.CategoriaVentaRapidaId == categoriaSeleccionadaId);
        if (existente != null && existente.MostrarEnVentaRapida) { QuitarDeCategoria(existente); return; }
        AsignarProductoACategoria(prod);
    }

    private void AgregarVariosACategoria(List<Producto> productos)
    {
        int n = 0;
        foreach (var p in productos.Where(p => !EstaEnLaCategoria(p.Id))) { AsignarProductoACategoria(p, avisar: false); n++; }
        avisos.Toast(n == 0 ? "Ya estaban todos en " + CategoriaActualNombre : $"{n} producto(s) agregados a {CategoriaActualNombre}", "exito", 2500);
    }

    // ======================= PRODUCTOS DE LA CATEGORÍA =======================
    private void AsignarProductoACategoria(Producto prod, bool avisar = true)
    {
        if (categoriaSeleccionadaId <= 0) return;

        var existente = productosAsignados.FirstOrDefault(p => p.Id == prod.Id);
        if (existente != null && existente.CategoriaVentaRapidaId == categoriaSeleccionadaId)
        {
            existente.MostrarEnVentaRapida = true;
            existente.OrdenVentaRapida = existente.OrdenVentaRapida == 0 ? ProductosDeLaCategoria.Count + 1 : existente.OrdenVentaRapida;
            RegistrarModificacion(existente.Id);
            ReindexarOrdenLocal();
            if (avisar) avisos.Toast($"{prod.Nombre} ya estaba en {CategoriaActualNombre}", "info", 2200);
            return;
        }

        var anterior = listaCategorias.FirstOrDefault(c => c.Id == prod.CategoriaVentaRapidaId && c.Id != categoriaSeleccionadaId);

        var p = existente ?? prod;
        p.CategoriaVentaRapidaId = categoriaSeleccionadaId;
        p.MostrarEnVentaRapida = true;
        p.OrdenVentaRapida = ProductosDeLaCategoria.Count + 1;
        if (existente == null) productosAsignados.Add(p);

        RegistrarModificacion(p.Id);
        ReindexarOrdenLocal();
        if (avisar) avisos.Toast(anterior != null ? $"{prod.Nombre}: pasó de {anterior.Nombre} a {CategoriaActualNombre}" : $"{prod.Nombre} agregado", "exito", 2500);
    }

    private void CambiarVisibilidad(Producto prod, bool activo)
    {
        prod.MostrarEnVentaRapida = activo;
        RegistrarModificacion(prod.Id);
    }

    private void QuitarDeCategoria(Producto prod)
    {
        // queda en la lista en memoria (para guardar el cambio), pero sin categoría
        prod.MostrarEnVentaRapida = false;
        prod.CategoriaVentaRapidaId = null;
        prod.OrdenVentaRapida = 0;

        RegistrarModificacion(prod.Id);
        ReindexarOrdenLocal();
    }

    private void MoverPosicion(int indexActual, int desplazamiento)
    {
        var lista = ProductosDeLaCategoria;
        int nuevoIndex = indexActual + desplazamiento;
        if (nuevoIndex < 0 || nuevoIndex >= lista.Count) return;

        var a = lista[indexActual];
        var b = lista[nuevoIndex];
        (a.OrdenVentaRapida, b.OrdenVentaRapida) = (b.OrdenVentaRapida, a.OrdenVentaRapida);
        RegistrarModificacion(a.Id);
        RegistrarModificacion(b.Id);
        ReindexarOrdenLocal();
    }

    /// <summary>Deja el orden prolijo: 1, 2, 3...</summary>
    private void ReindexarOrdenLocal()
    {
        var lista = ProductosDeLaCategoria;
        for (int i = 0; i < lista.Count; i++)
        {
            if (lista[i].OrdenVentaRapida != i + 1)
            {
                lista[i].OrdenVentaRapida = i + 1;
                RegistrarModificacion(lista[i].Id);
            }
        }
    }

    private void RegistrarModificacion(long productoId) => productosModificadosIds.Add(productoId);

    private async Task DescartarCambiosAsync()
    {
        productosModificadosIds.Clear();
        await CargarProductosDeCategoriaAsync();
    }

    private async Task GuardarCambiosEnLoteAsync()
    {
        if (!productosModificadosIds.Any()) return;
        guardando = true;

        try
        {
            var modificados = productosAsignados.Where(p => productosModificadosIds.Contains(p.Id)).ToList();

            foreach (var prod in modificados)
            {
                await SupaClient.From<Producto>()
                    .Where(p => p.Id == prod.Id).Where(p => p.KioscoId == State.KioscoId)
                    .Set(p => p.CategoriaVentaRapidaId, prod.CategoriaVentaRapidaId)
                    .Set(p => p.MostrarEnVentaRapida, prod.MostrarEnVentaRapida)
                    .Set(p => p.OrdenVentaRapida, prod.OrdenVentaRapida)
                    .Update();
            }

            productosModificadosIds.Clear();
            await CargarProductosDeCategoriaAsync();
            _ = avisos.GuardadoAsync("Venta rápida guardada");
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo guardar", ex.Message, "peligro");
        }
        finally
        {
            guardando = false;
        }
    }

    // ======================= ABM DE CATEGORÍAS =======================
    private void AbrirModalNuevaCategoria()
    {
        editandoCategoriaId = 0;
        nombreCategoria = "";
        iconoCategoria = "bi-tag-fill";
        mostrarModalCategoria = true;
    }

    private void AbrirModalEditarCategoria()
    {
        var cat = CategoriaActual;
        if (cat == null) return;
        editandoCategoriaId = cat.Id;
        nombreCategoria = cat.Nombre;
        iconoCategoria = string.IsNullOrWhiteSpace(cat.Icono) ? "bi-tag-fill" : cat.Icono;
        mostrarModalCategoria = true;
    }

    private void CerrarModalCategoria() => mostrarModalCategoria = false;

    private async Task GuardarCategoriaAsync()
    {
        var nombre = nombreCategoria?.Trim().ToUpper() ?? "";
        if (nombre == "") { avisos.Toast("Poné un nombre para la categoría.", "peligro"); return; }
        if (listaCategorias.Any(c => c.Id != editandoCategoriaId && string.Equals(c.Nombre, nombre, StringComparison.OrdinalIgnoreCase)))
        { avisos.Toast("Ya hay una categoría con ese nombre.", "peligro"); return; }

        guardando = true;
        try
        {
            long seleccionar;
            if (editandoCategoriaId == 0)
            {
                var nuevaCat = new CategoriaVentaRapida
                {
                    Nombre = nombre,
                    Icono = iconoCategoria,
                    Orden = (listaCategorias.Any() ? listaCategorias.Max(c => c.Orden) : 0) + 1,
                    Habilitado = true,
                    KioscoId = State.KioscoId
                };
                var respuesta = await SupaClient.From<CategoriaVentaRapida>().Insert(nuevaCat);
                seleccionar = respuesta.Models.FirstOrDefault()?.Id ?? categoriaSeleccionadaId;
                _ = avisos.GuardadoAsync("Categoría creada");
            }
            else
            {
                long id = editandoCategoriaId;
                await SupaClient.From<CategoriaVentaRapida>()
                    .Where(c => c.Id == id).Where(c => c.KioscoId == State.KioscoId)
                    .Set(c => c.Nombre, nombre)
                    .Set(c => c.Icono, iconoCategoria)
                    .Update();
                seleccionar = id;
                _ = avisos.GuardadoAsync("Categoría actualizada");
            }

            mostrarModalCategoria = false;
            if (seleccionar != categoriaSeleccionadaId && !await ConfirmarSalirAsync()) seleccionar = categoriaSeleccionadaId;
            await CargarCategoriasAsync(seleccionar);
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo guardar la categoría", ex.Message, "peligro");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task EliminarCategoriaActualAsync()
    {
        var cat = CategoriaActual;
        if (cat == null) return;

        int visibles = ProductosDeLaCategoria.Count(p => p.MostrarEnVentaRapida);
        if (visibles > 0)
        {
            await avisos.InformarAsync("No se puede eliminar", $"{cat.Nombre} tiene {visibles} producto(s). Quitalos primero (y guardá).", "aviso");
            return;
        }
        if (!await avisos.ConfirmarAsync($"¿Eliminar {cat.Nombre}?", "Se borra la categoría de la venta rápida.", "Eliminar")) return;

        guardando = true;
        try
        {
            long id = cat.Id;
            // los productos ocultos que quedaban en esta categoría se liberan
            await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId).Where(p => p.CategoriaVentaRapidaId == id)
                .Set(p => p.CategoriaVentaRapidaId, (long?)null)
                .Set(p => p.MostrarEnVentaRapida, false)
                .Update();

            await SupaClient.From<CategoriaVentaRapida>().Where(c => c.Id == id).Where(c => c.KioscoId == State.KioscoId).Delete();
            avisos.Toast("Categoría eliminada", "exito");
            productosModificadosIds.Clear();
            await CargarCategoriasAsync(0);
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo eliminar", ex.Message, "peligro");
        }
        finally
        {
            guardando = false;
        }
    }
}
