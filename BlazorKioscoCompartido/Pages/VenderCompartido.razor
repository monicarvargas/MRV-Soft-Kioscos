@using BlazorKioscoCompartido.Components
@using BlazorKioscoCompartido.Services
@using BlazorKioscoCompartido.Models
@using System.Globalization
@using static Supabase.Postgrest.Constants
@using BlazorKioscoCompartido.Services.SinInternet
@inject Supabase.Client SupaClient
@inject CarritoService Carrito
@inject NavigationManager Nav
@inject PrecioService PrecioServ
@inject BlazorKioscoCompartido.Services.AppState State
@implements IDisposable

<PedidosEstilos />
<ConfigEstilos />
<ProductoEstilos />
<VentasEstilos />
<AvisosPagina @ref="avisos" />

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Vender"
                      Subtitulo="Escaneá o buscá los productos"
                      IconoClass="bi-cash-stack"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    <div class="vt-wrap" style="display:flex; flex-direction:column; gap:1rem">

        @* ================= BUSCADOR Y ACCESOS ================= *@
        <section class="gp-card gp-card-pad vt-search">
            <div class="gp-buscador">
                <BuscadorProducto @ref="buscadorRef"
                                  OnProductoEncontrado="AgregarAlCarrito"
                                  OnProductoNoEncontrado="AlNoEncontrar"
                                  CargarAlInicio="false"
                                  MostrarPrimeraLista="mostrarPrimeraLista"
                                  MostrarSegundaLista="mostrarSegundaLista"
                                  ColumnaActiva="@columnaPrecioActiva" />
            </div>
            <div class="vt-accesos">
                @if (State.Tiene(FuncionesPlan.VentaRapida))
                {
                    <button type="button" class="gp-btn gp-btn-soft gp-btn-sm" @onclick="AbrirModalCategorias"><i class="bi bi-lightning-charge-fill"></i> Venta rápida</button>
                }
                <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick='() => AbrirModalVentaVarios("")'><i class="bi bi-pencil-square"></i> Producto sin código</button>
                @if (!string.IsNullOrEmpty(nombreListaActiva))
                {
                    <span class="vt-lista" title="Según el horario se cobra con otra lista de precios"><i class="bi bi-moon-stars-fill"></i> Lista @nombreListaActiva</span>
                }
            </div>
        </section>

        @* ================= CARRITO ================= *@
        <section class="gp-card gp-card-pad">
            <div class="gp-card-head">
                <span class="gp-bubble"><i class="bi bi-cart3"></i></span>
                <div class="vt-head-text">
                    <h2>Venta actual</h2>
                    <p>@Carrito.Items.Count producto(s)</p>
                </div>
                @if (Carrito.Items.Any())
                {
                    <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm vt-head-right" @onclick="VaciarCarritoAsync"><i class="bi bi-trash3"></i> Vaciar</button>
                }
            </div>

            @if (!Carrito.Items.Any())
            {
                <div class="gp-empty">
                    <span class="gp-bubble"><i class="bi bi-cart-plus"></i></span>
                    <strong>Todavía no hay productos</strong>
                    <span>Escaneá un código o buscalo arriba. Si el producto no está cargado, usá "Producto sin código".</span>
                </div>
            }
            else
            {
                <ul class="vt-items">
                    @foreach (var item in Carrito.Items)
                    {
                        bool esPesable = EsProductoPesable(item.Producto);
                        <li class="vt-item">
                            <div class="vt-item-info">
                                <div class="vt-item-name">
                                    @if (item.EsProductoVario) { <span class="vt-tag vario">VARIOS</span> }
                                    @if (esPesable) { <span class="vt-tag peso"><i class="bi bi-speedometer2"></i> PESO</span> }
                                    @if (item.Producto.EsCombo == true) { <span class="vt-tag combo">COMBO</span> }
                                    @item.Producto.Nombre
                                </div>
                                <div class="vt-item-sub">
                                    $ @item.PrecioUnitario.ToString("N2") @(esPesable ? "por kilo" : "c/u")
                                    @if (item.EsPorMayor)
                                    {
                                        <span class="vt-tag mayor"><i class="bi bi-boxes"></i> X MAYOR</span>
                                    }
                                    else if (item.TienePorMayor)
                                    {
                                        <span class="vt-mayor-hint">· llevando @item.Producto.CantxMayor o más: $ @item.Producto.PrecioVentaxMayor!.Value.ToString("N2") c/u</span>
                                    }
                                    @if (item.UsaEscalas)
                                    {
                                        <span class="vt-tag mayor" title="Precio por cantidad"><i class="bi bi-boxes"></i> @item.DetalleEscalas</span>
                                    }
                                    @if (item.Sugerencia is { } sug)
                                    {
                                        <button type="button" class="vt-sugerencia" title="Sumar al carrito" @onclick="() => item.Cantidad += sug.Mas">
                                            <i class="bi bi-lightbulb-fill"></i>
                                            Llevando @(sug.Mas == 1 ? "1 más" : sug.Mas + " más") paga $ @sug.Total.ToString("N0")@(sug.Ahorro > 0 ? " (ahorra $ " + sug.Ahorro.ToString("N0") + ")" : " (lo mismo)")
                                            <b>+@sug.Mas</b>
                                        </button>
                                    }
                                    else if (item.Escalas?.Any() == true && !item.UsaEscalas)
                                    {
                                        <span class="vt-mayor-hint">· @(TextoEscalas(item.Escalas))</span>
                                    }
                                </div>
                            </div>

                            <div class="vt-item-qty">
                                @if (esPesable)
                                {
                                    <button type="button" class="vt-peso" title="Cambiar el peso" @onclick="() => EditarPeso(item)">
                                        <i class="bi bi-pencil"></i> @FormatearCantidadPesable(item.Cantidad)
                                    </button>
                                }
                                else
                                {
                                    <div class="vt-qty">
                                        <button type="button" aria-label="Uno menos" @onclick="() => DecrementarCantidad(item)"><i class="bi bi-dash-lg"></i></button>
                                        <input type="number" min="1" inputmode="numeric" value="@item.Cantidad" onfocus="this.select()"
                                               @onchange="@(e => ActualizarCantidadManual(item, e.Value))" />
                                        <button type="button" aria-label="Uno más" @onclick="() => item.Cantidad++"><i class="bi bi-plus-lg"></i></button>
                                    </div>
                                }
                            </div>

                            <div class="vt-subtotal">$ @item.Subtotal.ToString("N2")</div>

                            <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon vt-item-del" title="Quitar" @onclick="() => Carrito.Eliminar(item)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
        </section>

        @* ================= TOTAL Y COBRO ================= *@
        @if (Carrito.Items.Any())
        {
            <div class="vt-totalbar @(EsCelular ? "is-fija" : "")">
                <div>
                    <span class="vt-totalbar-label">Total</span>
                    <span class="vt-totalbar-num">$ @Carrito.Total.ToString("N2")</span>
                </div>
                <button type="button" class="gp-btn gp-btn-ok" data-atajo="F4" @onclick="FinalizarVenta">
                    <span>Cobrar</span> @if (!EsCelular) { <kbd class="vt-atajo">F4</kbd> } <i class="bi bi-arrow-right-circle-fill"></i>
                </button>
            </div>
            @if (EsCelular)
            {
                <div class="vt-espacio"></div>
            }
        }
    </div>
</div>

@* ===================== MODAL: PRODUCTO SIN CÓDIGO (VARIOS) ===================== *@
@if (mostrarModalVarios)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModales">
        <div class="gp-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-pencil-square"></i></span>
                <div>
                    <h3>Producto sin código</h3>
                    <p>Para vender algo que no está cargado en el sistema.@(string.IsNullOrEmpty(codigoNoEncontrado) ? "" : $" El código {codigoNoEncontrado} no existe.")</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModales"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <label class="cf-lbl">¿Qué estás vendiendo?</label>
                <input type="text" class="gp-control" maxlength="80" placeholder="Ej: Cargador de celular" @bind="descripcionVarios" />

                <div class="cf-grid" style="margin-top:.9rem">
                    <div>
                        <label class="cf-lbl">Precio por unidad</label>
                        <div class="vt-addon">
                            <span>$</span>
                            <InputMonto class="gp-control vt-big-input ok" Placeholder="0" Value="precioVarios" ValueChanged="v => precioVarios = v ?? 0" />
                        </div>
                    </div>
                    <div>
                        <label class="cf-lbl">Cantidad</label>
                        <div class="vt-qty" style="width:100%; justify-content:space-between">
                            <button type="button" @onclick="() => cantidadVarios = Math.Max(1, cantidadVarios - 1)"><i class="bi bi-dash-lg"></i></button>
                            <input type="number" min="1" inputmode="numeric" style="flex:1 1 auto" @bind="cantidadVarios" @bind:event="oninput" />
                            <button type="button" @onclick="() => cantidadVarios++"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    </div>
                </div>

                <div class="vt-calc">
                    <span>Total de este producto</span>
                    <strong>$ @((precioVarios * Math.Max(1, cantidadVarios)).ToString("N2"))</strong>
                </div>
            </div>
            <div class="gp-modal-foot">
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarModales">Cancelar</button>
                <button type="button" class="gp-btn gp-btn-ok" disabled="@(precioVarios <= 0 || cantidadVarios <= 0)" @onclick="ConfirmarVentaVarios">
                    <i class="bi bi-cart-plus-fill"></i> Agregar a la venta
                </button>
            </div>
        </div>
    </div>
}

@* ===================== MODAL: VENTA RÁPIDA - CATEGORÍAS ===================== *@
@if (mostrarModalCategorias)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModales">
        <div class="gp-modal" role="dialog" aria-modal="true" style="max-width:40rem" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-lightning-charge-fill"></i></span>
                <div>
                    <h3>Venta rápida</h3>
                    <p>Elegí una categoría.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModales"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                @if (!listaCategorias.Any())
                {
                    <div class="gp-empty">
                        <span class="gp-bubble"><i class="bi bi-lightning"></i></span>
                        <strong>No hay categorías de venta rápida</strong>
                        <span>Armalas en "Gestión Venta Rápida".</span>
                    </div>
                }
                else
                {
                    <div class="vt-cats">
                        @foreach (var cat in listaCategorias)
                        {
                            <button type="button" class="vt-cat" @onclick="() => SeleccionarCategoria(cat)">
                                <i class="@(string.IsNullOrEmpty(cat.Icono) ? "bi bi-tag" : cat.Icono)"></i>
                                <span>@cat.Nombre</span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ===================== MODAL: VENTA RÁPIDA - PRODUCTOS ===================== *@
@if (mostrarModalProductos)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModales">
        <div class="gp-modal vt-modal-grande" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Volver" @onclick="VolverACategorias"><i class="bi bi-arrow-left"></i></button>
                <div>
                    <h3>@categoriaSeleccionada?.Nombre</h3>
                    <p>Tocá el producto para agregarlo.</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModales"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <div class="gp-search" style="max-width:none">
                    <i class="bi bi-search"></i>
                    <input type="text" class="gp-control" placeholder="Buscar en esta categoría..." @bind="filtroBusquedaRapida" @bind:event="oninput" />
                </div>
                <div class="vt-prods">
                    @foreach (var prod in ProductosFiltrados)
                    {
                        bool esPesable = EsProductoPesable(prod);
                        <button type="button" class="vt-prod" @onclick="() => SeleccionarProductoRapido(prod)">
                            <b>@prod.Nombre</b>
                            <div>
                                @if (esPesable) { <span class="vt-tag peso" style="margin-bottom:.25rem"><i class="bi bi-speedometer2"></i> por peso</span> }
                                <span>$ @PrecioDe(prod).ToString("N2")@(esPesable ? " /kg" : "")</span>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ===================== MODAL: CANTIDAD, IMPORTE O PESO ===================== *@
@if (mostrarModalCantidad && productoSeleccionadoParaVenta != null)
{
    bool esPesableModal = EsProductoPesable(productoSeleccionadoParaVenta);
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarModales">
        <div class="gp-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi @(esPesableModal ? "bi-speedometer2" : "bi-box")"></i></span>
                <div>
                    <h3 style="text-transform:uppercase">@productoSeleccionadoParaVenta.Nombre</h3>
                    <p>$ @PrecioDe(productoSeleccionadoParaVenta).ToString("N2") @(esPesableModal ? "el kilo" : "por unidad")</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarModales"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                @if (esPesableModal)
                {
                    <div class="gp-seg" style="display:flex; margin-bottom:.9rem">
                        <button type="button" style="flex:1" class="@(modoIngresoPesable == "peso" ? "is-active" : "")" @onclick='() => SeleccionarModoPesable("peso")'><i class="bi bi-speedometer2"></i> Por peso</button>
                        <button type="button" style="flex:1" class="@(modoIngresoPesable == "dinero" ? "is-active" : "")" @onclick='() => SeleccionarModoPesable("dinero")'><i class="bi bi-currency-dollar"></i> Por plata</button>
                    </div>

                    @if (modoIngresoPesable == "peso")
                    {
                        <label class="cf-lbl">¿Cuánto pidió?</label>
                        <div style="display:flex; gap:.5rem">
                            <input type="number" step="any" inputmode="decimal" class="gp-control vt-big-input" placeholder="0" onfocus="this.select()"
                                   @bind="valorIngresadoPesable" @bind:event="oninput" />
                            <div class="gp-seg" style="flex:none">
                                <button type="button" class="@(unidadIngresada == "GR" ? "is-active" : "")" @onclick='() => unidadIngresada = "GR"'>Gramos</button>
                                <button type="button" class="@(unidadIngresada == "KG" ? "is-active" : "")" @onclick='() => unidadIngresada = "KG"'>Kilos</button>
                            </div>
                        </div>
                        <div class="vt-rapidos">
                            <button type="button" @onclick="() => PesoRapido(100)">100 g</button>
                            <button type="button" @onclick="() => PesoRapido(150)">150 g</button>
                            <button type="button" @onclick="() => PesoRapido(250)">¼ kg</button>
                            <button type="button" @onclick="() => PesoRapido(500)">½ kg</button>
                            <button type="button" @onclick="() => PesoRapido(1000)">1 kg</button>
                        </div>
                        <div class="vt-calc">
                            <span>@FormatearCantidadPesable(CalcularGramosCalculados())</span>
                            <strong>$ @CalcularSubtotalPesable().ToString("N2")</strong>
                        </div>
                    }
                    else
                    {
                        <label class="cf-lbl">¿Cuánta plata quiere gastar?</label>
                        <div class="vt-addon">
                            <span>$</span>
                            <InputMonto class="gp-control vt-big-input ok" Placeholder="0" Value="valorIngresadoPesable" ValueChanged="v => valorIngresadoPesable = v ?? 0" />
                        </div>
                        <div class="vt-calc">
                            <span>Hay que pesar</span>
                            <strong style="color:var(--gp-primary)">@FormatearCantidadPesable(CalcularGramosCalculados())</strong>
                        </div>
                    }
                }
                else
                {
                    @if (productoSeleccionadoParaVenta.AdmiteImporte)
                    {
                        <div class="gp-seg" style="display:flex; margin-bottom:.9rem">
                            <button type="button" style="flex:1" class="@(modoIngreso == "cantidad" ? "is-active" : "")" @onclick='() => modoIngreso = "cantidad"'>Por cantidad</button>
                            <button type="button" style="flex:1" class="@(modoIngreso == "importe" ? "is-active" : "")" @onclick='() => modoIngreso = "importe"'>Por plata</button>
                        </div>
                    }

                    @if (modoIngreso == "cantidad")
                    {
                        <label class="cf-lbl">Cantidad</label>
                        <div class="vt-qty" style="width:100%; justify-content:space-between">
                            <button type="button" @onclick="() => cantidadIngresada = Math.Max(1, cantidadIngresada - 1)"><i class="bi bi-dash-lg"></i></button>
                            <input type="number" min="1" inputmode="numeric" style="flex:1 1 auto" @bind="cantidadIngresada" @bind:event="oninput" />
                            <button type="button" @onclick="() => cantidadIngresada++"><i class="bi bi-plus-lg"></i></button>
                        </div>
                    }
                    else
                    {
                        <label class="cf-lbl">¿Cuánta plata paga?</label>
                        <div class="vt-addon">
                            <span>$</span>
                            <InputMonto class="gp-control vt-big-input ok" Placeholder="0" Value="importeIngresado" ValueChanged="v => importeIngresado = v ?? 0" />
                        </div>
                        <div class="vt-calc">
                            <span>Equivale a</span>
                            <strong style="color:var(--gp-primary)">@UnidadesPorImporte() unidad(es)</strong>
                        </div>
                    }
                }
            </div>
            <div class="gp-modal-foot">
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarModales">Cancelar</button>
                <button type="button" class="gp-btn gp-btn-ok" disabled="@(esPesableModal && CalcularGramosCalculados() <= 0)" @onclick="ConfirmarAgregarDesdeModal">
                    <i class="bi bi-cart-plus-fill"></i> @(itemEditando != null ? "Cambiar peso" : "Agregar a la venta")
                </button>
            </div>
        </div>
    </div>
}

<style>
    /* "Llevando 1 más paga menos" (precios por cantidad) */
    .vt-sugerencia { display: inline-flex; align-items: center; gap: .35rem; margin-top: .3rem; padding: .25rem .55rem; border: 1px dashed #e0a800; border-radius: 10px; background: #fff8e1; color: #7a5500; font: inherit; font-size: .78rem; font-weight: 700; cursor: pointer; }
    .vt-sugerencia i { color: #e0a800; }
    .vt-sugerencia b { padding: .05rem .4rem; border-radius: 7px; background: #e0a800; color: #fff; }
    .vt-sugerencia:hover { background: #ffefb3; }
</style>

@code {
    [Parameter] public string RutaCobrar { get; set; } = "/producto/cobrar";

    private AvisosPagina avisos = default!;
    private bool mostrarPrimeraLista = true;
    private bool mostrarSegundaLista = false;
    private BuscadorProducto? buscadorRef;
    private string columnaPrecioActiva = "precio_venta";
    private string nombreListaActiva = "";

    /// <summary>En el celular hay una barra de menú abajo: la barra del total se fija arriba de esa barra.</summary>
    private bool EsCelular => RutaCobrar == "/producto/cobrar";

    // Venta rápida
    private bool mostrarModalCategorias = false;
    private bool mostrarModalProductos = false;
    private bool mostrarModalCantidad = false;
    private List<CategoriaVentaRapida> listaCategorias = new();
    private List<Producto> listaProductosRapidos = new();
    private CategoriaVentaRapida? categoriaSeleccionada;
    private Producto? productoSeleccionadoParaVenta;
    private ItemCarrito? itemEditando;              // si se está cambiando el peso de algo que ya está en la venta
    private string filtroBusquedaRapida = "";
    private string modoIngreso = "cantidad";        // "cantidad" o "importe"
    private int cantidadIngresada = 1;
    private decimal importeIngresado = 0;

    // Productos por peso (la cantidad va en gramos y el precio es por kilo)
    private string modoIngresoPesable = "peso";     // "peso" o "dinero"
    private string unidadIngresada = "GR";          // "GR" o "KG"
    private decimal valorIngresadoPesable = 0;

    // Producto sin código (varios)
    private bool mostrarModalVarios = false;
    private int cantidadVarios = 1;
    private decimal precioVarios = 0;
    private string descripcionVarios = "";
    private string codigoNoEncontrado = "";

    private IEnumerable<Producto> ProductosFiltrados =>
        string.IsNullOrWhiteSpace(filtroBusquedaRapida)
            ? listaProductosRapidos
            : listaProductosRapidos.Where(p => (p.Nombre ?? "").Contains(filtroBusquedaRapida, StringComparison.OrdinalIgnoreCase));

    private bool EsProductoPesable(Producto? prod) =>
        prod != null && !string.IsNullOrWhiteSpace(prod.UnidadMedida) && Utilidades.EsMedidaGramos(prod.UnidadMedida.Trim());

    /// <summary>Precio con la lista activa: la misma regla que usa el carrito y que muestra el buscador.</summary>
    private static string TextoEscalas(List<PrecioCantidad> escalas) =>
        string.Join(" · ", escalas.Select(e => e.Cantidad + " u x $ " + e.Precio.ToString("N0")));

    private decimal PrecioDe(Producto p) => PrecioService.PrecioSegunLista(p, columnaPrecioActiva, State.KioscoId);

    // ======================= INICIO =======================
    protected override async Task OnInitializedAsync()
    {
        // ETAPA 7: sin internet la lista por horario sale de la copia guardada en la PC
        var off = VentaSinInternet.Actual;
        await PrecioServ.AsegurarReglasAsync(State.KioscoId);   // horarios, listas y recargos (con o sin internet)
        ActualizarLista(avisar: false);
        // cada 15 s mira si empezó/terminó el horario de una lista (solo cambia cuando no hay una venta en curso)
        timerLista = new System.Threading.Timer(_ => InvokeAsync(() => { if (ActualizarLista(avisar: true)) StateHasChanged(); }), null, 15000, 15000);

        // precios por cantidad (ej: gomitas 10 u x $250 · 23 u x $500)
        if (off?.ModoLimitado == true) Carrito.FijarEscalas(off.Escalas());
        else
        {
            try
            {
                long k = State.KioscoId;
                var r = await SupaClient.From<PrecioCantidad>().Where(x => x.KioscoId == k).Get();
                Carrito.FijarEscalas(r.Models);
            }
            catch (Exception ex) when (off != null && VentaSinInternet.EsErrorDeRed(ex)) { Carrito.FijarEscalas(off.Escalas()); }
            catch { /* falta el script 27: se vende como siempre */ }
        }
    }

    // ======================= LISTA DE PRECIOS DE LA VENTA =======================
    private System.Threading.Timer? timerLista;
    private bool listaIniciada;

    /// <summary>
    /// La lista se decide al EMPEZAR cada venta y queda fija hasta cobrar (CarritoService.ListaDeLaVenta).
    /// Sin venta en curso, sigue al horario. Devuelve true si cambió.
    /// </summary>
    private bool ActualizarLista(bool avisar)
    {
        string col = Carrito.Items.Any() && !string.IsNullOrEmpty(Carrito.ListaDeLaVenta)
            ? Carrito.ListaDeLaVenta!
            : PrecioService.ColumnaSegunMomento(State.KioscoId, DateTime.Now) ?? "precio_venta";
        if (listaIniciada && col == columnaPrecioActiva) return false;

        bool eraOtra = listaIniciada;
        listaIniciada = true;
        columnaPrecioActiva = col;
        mostrarSegundaLista = col == "precio_lista2";
        mostrarPrimeraLista = !mostrarSegundaLista;
        nombreListaActiva = col == "precio_venta" ? "" : PrecioService.NombreLista(State.KioscoId, col);

        if (eraOtra && avisar)
            avisos.Toast(col == "precio_venta"
                ? "Terminó el horario de la lista: desde ahora se cobra con el precio de venta."
                : $"Empezó el horario de la lista {nombreListaActiva}: desde ahora se cobra con esos precios.", "info", 6000);
        return true;
    }

    public void Dispose() => timerLista?.Dispose();

    /// <summary>Al abrir Vender, el cursor queda en el buscador (listo para escanear o escribir).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.Delay(80);   // que el buscador termine de dibujarse
        try { if (buscadorRef != null) await buscadorRef.Enfocar(); } catch { }
    }

    // ======================= AGREGAR DESDE EL BUSCADOR =======================
    private void AgregarAlCarrito(Producto prod)
    {
        if (EsProductoPesable(prod))
        {
            AbrirModalCantidad(prod);
        }
        else
        {
            Carrito.Agregar(prod, columnaPrecioActiva);
            StateHasChanged();
        }
    }

    /// <summary>Se escaneó un código que no existe: se ofrece venderlo como producto sin código.</summary>
    private void AlNoEncontrar(string codigo)
    {
        avisos.Toast("No está cargado: podés venderlo como producto sin código", "aviso", 3500);
        AbrirModalVentaVarios(codigo);
    }

    // ======================= PRODUCTO SIN CÓDIGO =======================
    private void AbrirModalVentaVarios(string codigo)
    {
        CerrarModales();
        var texto = codigo?.Trim() ?? "";
        bool esCodigo = texto.Length > 0 && texto.All(char.IsDigit);
        codigoNoEncontrado = esCodigo ? texto : "";
        cantidadVarios = 1;
        precioVarios = 0;
        descripcionVarios = esCodigo ? "" : texto.ToUpper();   // si buscó por nombre, queda como descripción
        mostrarModalVarios = true;
    }

    private void ConfirmarVentaVarios()
    {
        if (precioVarios <= 0 || cantidadVarios <= 0) return;

        var productoVarios = new Producto
        {
            Id = -Math.Abs(Guid.NewGuid().GetHashCode()),
            Nombre = string.IsNullOrWhiteSpace(descripcionVarios) ? "VARIOS" : descripcionVarios.Trim().ToUpper(),
            PrecioVenta = precioVarios,
        };

        // el precio lo pone el vendedor: no se le aplica la lista de la noche ni ningún recargo
        Carrito.AgregarConPrecio(productoVarios, precioVarios, cantidadVarios, esProductoVario: true);

        CerrarModales();
    }

    // ======================= VENTA RÁPIDA =======================
    private async Task AbrirModalCategorias()
    {
        var off = VentaSinInternet.Actual;
        if (off?.ModoLimitado == true)
        {
            listaCategorias = off.Categorias();   // sin internet: de la copia de la PC
            CerrarModales();
            mostrarModalCategorias = true;
            return;
        }
        try
        {
            var response = await SupaClient.From<CategoriaVentaRapida>()
                .Where(x => x.KioscoId == State.KioscoId)
                .Where(x => x.Habilitado == true)
                .Order("orden", Ordering.Ascending)
                .Get();

            listaCategorias = response.Models ?? new();
            CerrarModales();
            mostrarModalCategorias = true;
        }
        catch (Exception ex) when (off != null && VentaSinInternet.EsErrorDeRed(ex))
        {
            off.MarcarSinConexion();
            listaCategorias = off.Categorias();
            CerrarModales();
            mostrarModalCategorias = true;
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron cargar las categorías", ex.Message, "peligro");
        }
    }

    private async Task SeleccionarCategoria(CategoriaVentaRapida cat)
    {
        categoriaSeleccionada = cat;
        filtroBusquedaRapida = "";

        var off = VentaSinInternet.Actual;
        if (off?.ModoLimitado == true)
        {
            listaProductosRapidos = off.ProductosDeCategoria(cat.Id);   // sin internet: de la copia de la PC
            mostrarModalCategorias = false;
            mostrarModalProductos = true;
            return;
        }
        try
        {
            long catId = cat.Id;
            var response = await SupaClient.From<Producto>()
               .Where(x => x.KioscoId == State.KioscoId)
               .Where(x => x.CategoriaVentaRapidaId == catId && x.MostrarEnVentaRapida == true)
               .Order("orden_venta_rapida", Ordering.Ascending)
               .Get();

            listaProductosRapidos = response.Models ?? new();
            mostrarModalCategorias = false;
            mostrarModalProductos = true;
        }
        catch (Exception ex) when (off != null && VentaSinInternet.EsErrorDeRed(ex))
        {
            off.MarcarSinConexion();
            listaProductosRapidos = off.ProductosDeCategoria(cat.Id);
            mostrarModalCategorias = false;
            mostrarModalProductos = true;
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudieron cargar los productos", ex.Message, "peligro");
        }
    }

    private void VolverACategorias()
    {
        mostrarModalProductos = false;
        mostrarModalCategorias = true;
    }

    private void SeleccionarProductoRapido(Producto prod) => AbrirModalCantidad(prod);

    // ======================= MODAL DE CANTIDAD / PESO =======================
    private void AbrirModalCantidad(Producto prod, ItemCarrito? editar = null)
    {
        productoSeleccionadoParaVenta = prod;
        itemEditando = editar;

        if (EsProductoPesable(prod))
        {
            modoIngresoPesable = "peso";
            unidadIngresada = "GR";
            valorIngresadoPesable = editar != null ? editar.Cantidad : 0;
        }
        else
        {
            cantidadIngresada = 1;
            importeIngresado = PrecioDe(prod);
            modoIngreso = "cantidad";
        }

        mostrarModalCategorias = false;
        mostrarModalProductos = false;
        mostrarModalCantidad = true;
    }

    private void EditarPeso(ItemCarrito item) => AbrirModalCantidad(item.Producto, item);

    private void SeleccionarModoPesable(string modo)
    {
        modoIngresoPesable = modo;
        valorIngresadoPesable = 0;
    }

    private void PesoRapido(int gramos)
    {
        unidadIngresada = "GR";
        valorIngresadoPesable = gramos;
    }

    private int CalcularGramosCalculados()
    {
        if (productoSeleccionadoParaVenta == null || !EsProductoPesable(productoSeleccionadoParaVenta)) return 0;

        decimal precioKilo = PrecioDe(productoSeleccionadoParaVenta);
        if (precioKilo <= 0 || valorIngresadoPesable <= 0) return 0;

        if (modoIngresoPesable == "peso")
        {
            decimal gramos = unidadIngresada == "KG" ? (valorIngresadoPesable * 1000m) : valorIngresadoPesable;
            return (int)Math.Round(gramos);
        }

        // "dinero": cuántos gramos se pueden dar con esa plata
        return (int)Math.Round((valorIngresadoPesable / precioKilo) * 1000m);
    }

    private decimal CalcularSubtotalPesable()
    {
        if (productoSeleccionadoParaVenta == null) return 0;
        if (modoIngresoPesable == "dinero") return valorIngresadoPesable;

        decimal precioKilo = PrecioDe(productoSeleccionadoParaVenta);
        return (int)Math.Round((CalcularGramosCalculados() / 1000m) * precioKilo);
    }

    private int UnidadesPorImporte()
    {
        if (productoSeleccionadoParaVenta == null) return 0;
        var precio = PrecioDe(productoSeleccionadoParaVenta);
        if (precio <= 0) return 1;
        return Math.Max(1, (int)(importeIngresado / precio));
    }

    private static string FormatearCantidadPesable(int gramos) =>
        gramos < 1000 ? $"{gramos} g" : $"{(gramos / 1000m).ToString("0.###", CultureInfo.GetCultureInfo("es-AR"))} kg";

    private void ConfirmarAgregarDesdeModal()
    {
        if (productoSeleccionadoParaVenta == null) return;

        if (EsProductoPesable(productoSeleccionadoParaVenta))
        {
            int gramosTotal = CalcularGramosCalculados();
            if (gramosTotal > 0)
            {
                if (itemEditando != null) Carrito.FijarCantidad(itemEditando, gramosTotal);   // se cambia el peso, no se suma
                else Carrito.AgregarManual(productoSeleccionadoParaVenta, columnaPrecioActiva, false, gramosTotal);
            }
        }
        else
        {
            int cantidadFinal = modoIngreso == "importe" && productoSeleccionadoParaVenta.AdmiteImporte
                ? UnidadesPorImporte()
                : (cantidadIngresada > 0 ? cantidadIngresada : 1);

            Carrito.AgregarManual(productoSeleccionadoParaVenta, columnaPrecioActiva, false, cantidadFinal);
        }

        CerrarModales();
    }

    private void CerrarModales()
    {
        mostrarModalCategorias = false;
        mostrarModalProductos = false;
        mostrarModalCantidad = false;
        mostrarModalVarios = false;
        productoSeleccionadoParaVenta = null;
        itemEditando = null;
        valorIngresadoPesable = 0;
    }

    // ======================= CARRITO =======================
    private void DecrementarCantidad(ItemCarrito item)
    {
        if (item.Cantidad > 1) item.Cantidad--;
        else Carrito.Eliminar(item);
    }

    /// <summary>La cantidad escrita a mano REEMPLAZA la que había (antes se sumaba).</summary>
    private void ActualizarCantidadManual(ItemCarrito item, object? value)
    {
        if (int.TryParse(value?.ToString(), out int nuevaCantidad) && nuevaCantidad > 0)
            Carrito.FijarCantidad(item, nuevaCantidad);
    }

    private async Task VaciarCarritoAsync()
    {
        if (!await avisos.ConfirmarAsync("¿Vaciar la venta?", "Se quitan todos los productos cargados.", "Vaciar")) return;
        Carrito.Vaciar();
        buscadorRef?.LimpiarTodo();
    }

    private void FinalizarVenta()
    {
        if (!Carrito.Items.Any()) return;

        State.TotalVentaActual = Carrito.Total;
        State.CarritoActual = Carrito.Items.ToList();

        if (!string.IsNullOrEmpty(RutaCobrar))
            Nav.NavigateTo(RutaCobrar);
    }
