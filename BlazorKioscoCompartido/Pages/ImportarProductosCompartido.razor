            ["utilidad"] = new[] { "utilidad", "utilidadpv", "margen", "markup", "ganancia" },
            ["venta"] = new[] { "venta", "pventa", "precioventa", "pvp", "preciopublico", "preciofinal" },
            ["lista2"] = l2.ToArray(),
            ["familia"] = new[] { "familia", "categoria", "rubro", "linea", "grupo", "seccion" },
            ["subfamilia"] = new[] { "subfamilia", "subrubro", "subcategoria", "subgrupo", "sublinea", "subseccion" },
            ["proveedor"] = new[] { "proveedor", "mayorista", "distribuidor" }
        };
