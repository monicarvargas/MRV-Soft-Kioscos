    private string Monto(decimal? v) => v is decimal d ? d.ToString(d == Math.Truncate(d) ? "#,0" : "#,0.00", cultura) : "";

    /// <summary>Lee "3.000", "1.500,50" o "1500,5" (el punto es de miles; la coma, de centavos).</summary>
    private static bool TryMontoInput(object? v, out decimal r)
    {
        var s = (v?.ToString() ?? "").Replace("$", "").Replace(" ", "").Trim();
