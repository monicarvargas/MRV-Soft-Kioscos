    private static string Clave(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var d = s.Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(d.Length);
        foreach (var c in d)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) == UnicodeCategory.NonSpacingMark) continue;
            if (char.IsLetterOrDigit(c)) sb.Append(char.ToLowerInvariant(c));
        }
        return sb.ToString();
    }

    private static int BuscarColumna(string[] claves, HashSet<int> usados, string[] sinonimos, bool exacto)
    {
        foreach (var s in sinonimos)
        {
            for (int i = 0; i < claves.Length; i++)
            {
                if (usados.Contains(i) || claves[i] == "") continue;
                if (exacto ? claves[i] == s : claves[i].Contains(s)) return i;
            }
        }
        return -1;
    }

    /// <summary>Reconoce las columnas: primero las que se usaron la última vez con ese proveedor, después por nombre.</summary>
    private void DetectarMapa(Dictionary<string, string>? recordado)
    {
        mapa = new();
        var usados = new HashSet<int>();
        var claves = encabezados.Select(Clave).ToArray();
        var visibles = CamposVisibles();

        if (recordado != null)
        {
            foreach (var k in visibles)
            {
                if (!recordado.TryGetValue(k, out var nombre)) continue;
                var idx = Array.FindIndex(claves, c => c != "" && c == Clave(nombre));
                if (idx >= 0 && !usados.Contains(idx)) { mapa[k] = idx; usados.Add(idx); }
            }
        }

        var sin = Sinonimos();

        // Muchos mayoristas usan "ARTICULO" para el NÚMERO de artículo y "DESCRIPCIÓN" para el nombre.
        // Si están las dos columnas y no hay otra de código, "ARTICULO" es el código.
        if (visibles.Contains("codigo") && !mapa.ContainsKey("codigo"))
        {
            int iArt = Array.FindIndex(claves, c => c == "articulo" || c == "nroarticulo" || c == "numeroarticulo");
            bool hayDescripcion = claves.Any(c => c is "descripcion" or "detalle" or "producto" or "nombre" or "descripcionarticulo");
            bool hayCodigo = sin["codigo"].Any(x => claves.Contains(x));
            if (iArt >= 0 && hayDescripcion && !hayCodigo && !usados.Contains(iArt)) { mapa["codigo"] = iArt; usados.Add(iArt); }
        }

        // la subfamilia se busca antes que la familia: si no, "SUB FAMILIA" quedaría como familia (contiene "familia")
        var orden = visibles.OrderBy(k => k == "subfamilia" ? 0 : 1).ToList();
        foreach (var exacto in new[] { true, false })
        {
            foreach (var k in orden)
            {
                if (mapa.ContainsKey(k)) continue;
                var idx = BuscarColumna(claves, usados, sin[k], exacto);
                if (idx >= 0) { mapa[k] = idx; usados.Add(idx); }
            }
        }

        foreach (var k in visibles)
            if (!mapa.ContainsKey(k)) mapa[k] = -1;
    }

