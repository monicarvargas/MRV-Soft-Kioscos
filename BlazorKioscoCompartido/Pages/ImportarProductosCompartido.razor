        if (!string.IsNullOrWhiteSpace(nombreLista2)) l2.Add(Clave(nombreLista2));

        return new Dictionary<string, string[]>
        {
            ["codigo"] = new[] { "codigo", "codigodebarras", "codbarras", "codbarra", "ean", "sku", "cod", "codart", "codigoarticulo", "codigoproveedor", "codprov", "codigoprov", "codigoprod" },
