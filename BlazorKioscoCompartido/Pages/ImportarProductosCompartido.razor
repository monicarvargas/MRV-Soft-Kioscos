    private async Task ProcesarArchivoSeleccionado(InputFileChangeEventArgs e)
    {
        cargandoArchivo = true;
        mensajeErrorGeneral = string.Empty;
        productosPreview.Clear();

        try
        {
            var archivo = e.File;
            if (archivo == null) return;

            // Validamos tamaño límite (10 MB)
            if (archivo.Size > 10 * 1024 * 1024)
            {
                mensajeErrorGeneral = "El archivo excede el límite permitido de 10 MB.";
                cargandoArchivo = false;
                return;
            }

            // Cargamos el archivo en memoria de forma segura
            using var stream = archivo.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            // --- ACÁ EMPIEZA EL CÓDIGO NUEVO QUE TE PASÉ ---
            System.Text.Encoding.RegisterProvider(System.Text.CodePagesEncodingProvider.Instance);

            using var reader = ExcelReaderFactory.CreateReader(ms);
            bool esPrimeraFila = true;

            // Diccionario para mapear las cabeceras reales que traiga el Excel
            var mapaColumnas = new Dictionary<string, int>();

            while (reader.Read())
            {
                // Leer la primera fila (Cabeceras del Excel)
                if (esPrimeraFila)
                {
                    for (int i = 0; i < reader.FieldCount; i++)
                    {
                        string cabecera = reader.GetValue(i)?.ToString()?.Trim().ToLower() ?? "";
                        if (!string.IsNullOrEmpty(cabecera))
                        {
                            mapaColumnas[cabecera] = i;
                        }
                    }
                    esPrimeraFila = false;
                    continue;
                }

                // Evitar procesar filas que vengan totalmente vacías
                if (reader.GetValue(0) == null && reader.GetValue(1) == null) continue;

                var prod = new ProductoImportarPreview();
                try
                {
                    // Función interna para obtener el dato por nombre o por el índice fijo (fallback)
                    string ObtenerValor(string nombreCabecera, int indiceFallback)
                    {
                        string nombreLimpio = nombreCabecera.ToLower();
                        int indiceFinal = mapaColumnas.ContainsKey(nombreLimpio) ? mapaColumnas[nombreLimpio] : indiceFallback;

                        if (indiceFinal >= 0 && indiceFinal < reader.FieldCount)
                        {
                            return reader.GetValue(indiceFinal)?.ToString()?.Trim() ?? "";
                        }
                        return "";
                    }

                    // Asignación inteligente con fallback indexado automático
                    prod.Codigo = ObtenerValor("CODIGO", 0);
                    // if (string.IsNullOrEmpty(prod.Codigo)) prod.Codigo = ObtenerValor("CODIGO", 0);

                    prod.Descripcion = ObtenerValor("DESCRIPCION", 1);
                    // if (string.IsNullOrEmpty(prod.Descripcion)) prod.Descripcion = ObtenerValor("DESCRIPCION", 1);

                    string stockRaw = ObtenerValor("STOCK", 2);
                    if (int.TryParse(stockRaw, out int stock)) prod.Stock = stock;
                   
                    string pCompraRaw = ObtenerValor("P. COSTO", 3);
                    if (decimal.TryParse(pCompraRaw, out decimal pCompra)) prod.PrecioCosto = pCompra;

                    string pVentaRaw = ObtenerValor("P. VENTA", 4);
                    if (decimal.TryParse(pVentaRaw, out decimal pVenta)) prod.PrecioVenta = pVenta;

                    string pLista2Raw = ObtenerValor("P. LISTA2", 5);
                    if (decimal.TryParse(pLista2Raw, out decimal pLista2)) prod.PrecioLista2 = pLista2;

                    string pLista3Raw = ObtenerValor("P. LISTA3", 6);
                    if (decimal.TryParse(pLista2Raw, out decimal pLista3)) prod.PrecioLista3 = pLista3;

                    prod.Familia = ObtenerValor("FAMILIA", 2);
                    // if (string.IsNullOrEmpty(prod.Familia)) prod.Familia = ObtenerValor("FAMILIA", 7);

                    prod.Proveedor = ObtenerValor("PROVEEDOR", 8);
                   

                    // Validaciones obligatorias de negocio
                    if (string.IsNullOrEmpty(prod.Codigo)) prod.MensajeError += "Falta el Código. ";
                    if (string.IsNullOrEmpty(prod.Descripcion)) prod.MensajeError += "Falta la Descripción. ";
                }
                catch (Exception ex)
                {
                    prod.MensajeError = $"Error al procesar la fila: {ex.Message}";
                }

                productosPreview.Add(prod);
            }
            // --- ACÁ TERMINA EL CÓDIGO NUEVO ---

            if (productosPreview.Any())
            {
                pasoActual = 2; // Avanza automáticamente al Paso 2 (Vista previa)
            }
            else
            {
                mensajeErrorGeneral = "No se encontraron filas válidas en el archivo.";
            }
        }
        catch (Exception ex)
        {
            mensajeErrorGeneral = $"Error crítico al procesar el archivo: {ex.Message}";
        }
        finally
        {
            cargandoArchivo = false;
        }
    }
    public class ProductoImportarPreview
    {
        public string Codigo { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public string Familia { get; set; } = string.Empty;
        public decimal PrecioCosto { get; set; }
        public decimal PrecioVenta { get; set; }
        public decimal PrecioLista2 { get; set; }
        public decimal PrecioLista3 { get; set; }
        public int Stock { get; set; }
        public string Proveedor { get; set; } = string.Empty;

        // Propiedades de control para avisarle al usuario si hay un error en la fila
        public bool TieneError => string.IsNullOrWhiteSpace(Codigo) || string.IsNullOrWhiteSpace(Descripcion);
        public string MensajeError { get; set; } = string.Empty;
    }
    private void LimpiarArchivo()
    {
        nombreArchivo = null;
        archivoSeleccionado = null;
    }

    private bool procesandoBD = false;
    private string mensajeExitoGeneral = string.Empty;

    private async Task EjecutarImportacionBD()
    {
        // 1. Validaciones previas de seguridad
        if (productosPreview == null || !productosPreview.Any())
        {
            mensajeErrorGeneral = "No hay productos válidos para importar.";
            return;
        }

        // Si hay filas marcadas con error, podés frenar o avisar.
        // Acá filtramos para guardar solo los que están perfectos.
        var productosValidos = productosPreview.Where(p => !p.TieneError).ToList();

        if (!productosValidos.Any())
        {
            mensajeErrorGeneral = "Todos los productos de la lista contienen errores de formato. Corregilos antes de continuar.";
            return;
        }

        procesandoBD = true;
        mensajeErrorGeneral = string.Empty;
        mensajeExitoGeneral = string.Empty;

        try
        {
            int creados = 0;
            int actualizados = 0;

            // 2. Iterar e impactar en la Base de Datos
            foreach (var item in productosValidos)
            {
                
                // 1. Guardamos o actualizamos el producto usando ese familiaId
                await Consultas.GuardarOActualizarProductoAsync(item, State.KioscoId);
            }

            // 3. Notificar éxito y limpiar
            mensajeExitoGeneral = $"¡Importación finalizada con éxito! Se crearon {creados} productos nuevos y se actualizaron {actualizados}.";

            // Opcional: Limpiamos la lista y volvemos al paso 1 o mostramos pantalla de éxito
            productosPreview.Clear();
            pasoActual = 1;
        }
        catch (Exception ex)
        {
            mensajeErrorGeneral = $"Ocurrió un error al guardar en la base de datos: {ex.Message}";
        }
        finally
        {
            procesandoBD = false;
        }
    }
