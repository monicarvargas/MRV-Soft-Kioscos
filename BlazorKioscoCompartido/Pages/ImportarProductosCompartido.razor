                top: 1rem;
                right: 50%;
                width: 100%;
                height: 2px;
                background: var(--gp-line);
                z-index: 0;
            }

            .imp-steps li.is-done + li::before, .imp-steps li.is-current::before {
                background: var(--gp-ok);
            }

            .imp-steps li span {
                position: relative;
