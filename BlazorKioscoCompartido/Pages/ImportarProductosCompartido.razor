    public class FilaHist
    {
        public int Fila { get; set; }
        public string Codigo { get; set; } = "";
        public string Nombre { get; set; } = "";
        public string Resultado { get; set; } = "";   // creado, actualizado, en_compra, omitida, error, sin_asociar, no_existe
        public string? Mensaje { get; set; }
        public decimal? Cantidad { get; set; }
        public int Bulto { get; set; } = 1;
        public decimal CostoAnt { get; set; }
        public decimal? CostoNuevo { get; set; }
