@using BlazorKioscoCompartido.Components
@using BlazorKioscoCompartido.Models
@using System.Globalization
@using System.IO
@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using ExcelDataReader
@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State
@inject Supabase.Client SupaClient
@inject PrecioService PrecioServ
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PedidosEstilos />
<AvisosPagina @ref="avisos" />

@if (preguntaCodigo != null)
{
    <div class="imp-cod-fondo" @onclick="() => ResponderCodigo(false)">
        <div class="imp-cod-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="imp-cod-head">
                <i class="bi bi-upc-scan"></i>
                <div>
                    <h3>¿Qué código llevan los @cntNuevosCodigo nuevos?</h3>
                </div>
                <button type="button" class="imp-cod-x" title="Cancelar" @onclick="() => ResponderCodigo(false)"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="imp-cod-ops">
                @foreach (var op in OpcionesCodigo)
                {
                    <button type="button" class="imp-cod-op @(codigoNuevos == op.Clave ? "is-active" : "")" @onclick="() => codigoNuevos = op.Clave">
                        <i class="bi @op.Icono"></i>
                        <span><b>@op.Titulo</b><small>@op.Detalle</small></span>
                        @if (codigoNuevos == op.Clave) { <i class="bi bi-check-circle-fill imp-cod-ok"></i> }
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(ejemploCodigo))
            {
                <p class="imp-cod-ej">Ejemplo del Excel: <b>@ejemploCodigo</b></p>
            }
            <div class="imp-cod-acc">
                <button type="button" class="imp-cod-btn is-cancelar" @onclick="() => ResponderCodigo(false)">Cancelar</button>
                <button type="button" class="imp-cod-btn is-ok" @onclick="() => ResponderCodigo(true)"><i class="bi bi-check-lg"></i> Continuar</button>
            </div>
        </div>
    </div>
}

<div class="container-fluid px-3 py-2 min-vh-100 style-notebook gp-scope gp-page">
    <EncabezadoPagina Titulo="Importar desde Excel"
                      Subtitulo="Facturas del proveedor, listas de precios o carga de productos"
                      IconoClass="bi-file-earmark-excel-fill"
                      ColorBorde="success"
                      ColorIcono="success"
                      MostrarBotonAyuda="false"
                      RutaVolver="/productos" />

    <!-- PESTAÑAS -->
    <div class="gp-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="@(pestana == "importar")"
                class="gp-tab @(pestana == "importar" ? "is-active" : "")" @onclick='() => CambiarPestana("importar")'>
            <i class="bi bi-file-earmark-arrow-up"></i> <span>Importar</span>
        </button>
        <button type="button" role="tab" aria-selected="@(pestana == "historial")"
                class="gp-tab @(pestana == "historial" ? "is-active" : "")" @onclick='() => CambiarPestana("historial")'>
            <i class="bi bi-journal-text"></i> <span>Historial</span>
        </button>
    </div>

    @if (pestana == "importar")
    {
        <!-- PASOS -->
        <ol class="imp-steps" aria-label="Pasos de la importación">
            @for (int i = 0; i < NombresPasos.Length; i++)
            {
                var n = i + 1;
                <li class="@(paso == n ? "is-current" : paso > n ? "is-done" : "")">
                    <span>@(paso > n ? "✓" : n.ToString())</span>
                    <b>@NombresPasos[i]</b>
                </li>
            }
        </ol>

        @* ===================== PASO 1: QUÉ Y QUÉ ARCHIVO ===================== *@
        @if (paso == 1)
        {
            <section class="gp-card gp-card-pad mb-3">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-question-lg"></i></span>
                    <h2>¿Qué vas a importar?</h2>
                </div>
                <div class="imp-tipos">
                    <button type="button" class="imp-tipo @(tipo == ImportacionTipo.Factura ? "is-active" : "")" @onclick="() => CambiarTipo(ImportacionTipo.Factura)">
                        <span class="gp-bubble"><i class="bi bi-receipt"></i></span>
                        <strong>Factura o remito</strong>
                        <span>Trae cantidades. Suma al stock y actualiza costos.</span>
                    </button>
                    <button type="button" class="imp-tipo @(tipo == ImportacionTipo.Precios ? "is-active" : "")" @onclick="() => CambiarTipo(ImportacionTipo.Precios)">
                        <span class="gp-bubble"><i class="bi bi-tags"></i></span>
                        <strong>Lista de precios</strong>
                        <span>Actualiza costos y precios sin tocar el stock. Los que no existen se pueden crear.</span>
                    </button>
                    <button type="button" class="imp-tipo @(tipo == ImportacionTipo.Carga ? "is-active" : "")" @onclick="() => CambiarTipo(ImportacionTipo.Carga)">
                        <span class="gp-bubble"><i class="bi bi-box-seam"></i></span>
                        <strong>Carga de productos</strong>
                        <span>Crea productos nuevos y actualiza los existentes.</span>
                    </button>
                </div>
            </section>

            <section class="gp-card gp-card-pad mb-3">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-truck"></i></span>
                    <h2>Proveedor</h2>
                </div>
                <div class="imp-grid">
                    <div class="gp-field">
                        <label class="gp-field-label" for="impProv"><i class="bi bi-truck"></i> ¿De qué proveedor es el archivo?</label>
                        <select id="impProv" class="gp-control" value="@proveedorId" @onchange="OnProveedorChanged">
                            <option value="0">-- Ninguno / varios --</option>
                            @foreach (var prov in proveedores.Where(p => !EsSinProveedor(p) && p.EstaActivo()))
                            {
                                <option value="@prov.Id">@prov.Nombre</option>
                            }
                        </select>
                    </div>

                    <div class="gp-field">
                        <label class="gp-field-label" for="impFam"><i class="bi bi-tags-fill"></i> Familia de los productos nuevos</label>
                        <select id="impFam" class="gp-control" @bind="familiaElegida" @bind:after="RecalcularNuevos">
                            <option value="">-- La del Excel (si no trae: ARTICULOS) --</option>
                            @foreach (var fam in familiasLista)
                            {
                                <option value="@fam.Nombre">@fam.Nombre</option>
                            }
                            <option value="__nueva__">+ Nueva familia...</option>
                        </select>
                        @if (familiaElegida == "__nueva__")
                        {
                            <input class="gp-control" style="margin-top:.4rem" placeholder="Ej: FIAMBRES" maxlength="60" @bind="familiaNueva" @bind:after="RecalcularNuevos" />
                        }
                        <small class="imp-util-grupo"><i class="bi bi-percent"></i> @TextoUtilidadElegida</small>
                    </div>

                    @if (proveedorId > 0 && tipo != ImportacionTipo.Carga)
                    {
                        <div class="gp-field">
                            <span class="gp-field-label"><i class="bi bi-upc-scan"></i> Los códigos del Excel son</span>
                            <div class="gp-seg" role="group" aria-label="Tipo de código" style="flex-wrap:wrap">
                                <button type="button" class="@(!codigosDelProveedor && !codigosIguales ? "is-active" : "")" @onclick="() => ElegirTipoCodigo(false, false)">Mis códigos de barras</button>
                                <button type="button" class="@(codigosDelProveedor ? "is-active" : "")" @onclick="() => ElegirTipoCodigo(true, false)">Los del proveedor</button>
                                <button type="button" class="@(codigosIguales ? "is-active" : "")" title="El proveedor usa el mismo código de barras que vos (típico de los mayoristas de mercadería)" @onclick="() => ElegirTipoCodigo(false, true)">Son los mismos</button>
                            </div>
                        </div>
                    }
                </div>
                <p class="imp-nota">
                    <i class="bi bi-info-circle"></i>
                    @if (proveedorId > 0)
                    {
                        <span>Los productos del archivo quedan asociados a este proveedor y se guarda el código que usa cada uno.</span>
                    }
                    else
                    {
                        <span>Si elegís un proveedor no hace falta una columna de proveedor en el Excel.</span>
                    }
                </p>
            </section>

            <section class="gp-card gp-card-pad mb-3">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-file-earmark-excel"></i></span>
                    <h2>Archivo</h2>
                </div>

                <div class="imp-drop">
                    <InputFile OnChange="OnArchivoAsync" accept=".xlsx,.xls,.csv" class="imp-drop-input" />
                    <span class="gp-bubble"><i class="bi bi-cloud-arrow-up"></i></span>
                    <strong>Elegí el archivo o arrastralo acá</strong>
                    <span>.xlsx, .xls o .csv · hasta 10 MB y @MaxFilas filas</span>
                </div>

                @if (leyendo)
                {
                    <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Leyendo el archivo...</p></div>
                }

                @if (!string.IsNullOrEmpty(errorArchivo))
                {
                    <div class="gp-banner is-danger" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <p>@errorArchivo</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(nombreArchivo) && string.IsNullOrEmpty(errorArchivo) && !leyendo)
                {
                    <div class="imp-file">
                        <i class="bi bi-file-earmark-check-fill"></i>
                        <div>
                            <b>@nombreArchivo</b>
                            <small>@filasDatos.Count(r => r.Any(c => c != "")) filas con datos · @encabezados.Count(h => h != "") columnas</small>
                        </div>
                        <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Quitar archivo" @onclick="() => LimpiarArchivo(true)"><i class="bi bi-x-lg"></i></button>
                    </div>
                }

                @if (importacionPrevia != null)
                {
                    <div class="gp-banner" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <p>Este mismo archivo ya se importó el <b>@FechaLocal(importacionPrevia).ToString("dd/MM/yyyy HH:mm")</b>. Si lo volvés a importar, el stock se suma otra vez.</p>
                    </div>
                }

                <div class="imp-formato">
                    <div class="imp-formato-top">
                        <b><i class="bi bi-table"></i> Columnas que reconozco</b>
                        <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="DescargarPlantillaAsync"><i class="bi bi-download"></i> Descargar plantilla</button>
                    </div>
                    <div class="imp-cols">
                        @foreach (var k in CamposVisibles())
                        {
                            <span class="imp-col @(EsObligatorio(k) ? "req" : "")">@EtiquetaCampo(k)@(EsObligatorio(k) ? " *" : "")</span>
                        }
                    </div>
                    <small class="gp-muted">No hace falta el mismo orden ni los mismos nombres: las busco solas y, si dudo, te las muestro para que las elijas. * obligatorias.</small>
                </div>
            </section>
        }

        @* ===================== PASO 2: COLUMNAS ===================== *@
        @if (paso == 2)
        {
            <section class="gp-card gp-card-pad mb-3">
                <div class="gp-card-head">
                    <span class="gp-bubble"><i class="bi bi-layout-three-columns"></i></span>
                    <h2>¿Qué columna es cada dato?</h2>
                </div>

                @if (FaltanObligatorias())
                {
                    <div class="gp-banner" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <p>No pude reconocer todas las columnas obligatorias (*). Elegilas abajo.</p>
                    </div>
                }

                <div class="imp-map">
                    @foreach (var k in CamposVisibles())
                    {
                        <div class="gp-field">
                            <label class="gp-field-label">@EtiquetaCampo(k)@(EsObligatorio(k) ? " *" : "")</label>
                            <select class="gp-control" value="@IndiceMapa(k)" @onchange="e => CambiarMapa(k, e)">
                                <option value="-1">-- No viene en el archivo --</option>
                                @for (int c = 0; c < encabezados.Length; c++)
                                {
                                    <option value="@c">@NombreColumna(c)</option>
                                }
                            </select>
                            <small class="gp-muted">@EjemploColumna(k)</small>
                        </div>
                    }
                </div>
            </section>
        }

        @* ===================== PASO 3: REVISIÓN ===================== *@
        @if (paso == 3)
        {
            @if (tipo == ImportacionTipo.Factura)
            {
                <section class="gp-card gp-card-pad mb-3">
                    <div class="gp-card-head">
                        <span class="gp-bubble"><i class="bi bi-receipt"></i></span>
                        <h2>Datos de la factura</h2>
                    </div>
                    <div class="imp-grid">
                        <div class="gp-field">
                            <label class="gp-field-label" for="impNro"><i class="bi bi-hash"></i> N° remito / factura</label>
                            <input id="impNro" type="text" class="gp-control" maxlength="40" placeholder="Ej: 0001-000452" @bind="numeroComprobante" />
                        </div>
                        <div class="gp-field">
                            <label class="gp-field-label" for="impFecha"><i class="bi bi-calendar-event"></i> Fecha de la factura</label>
                            <input id="impFecha" type="date" class="gp-control" @bind="fechaCompra" />
                        </div>
                        <div class="gp-field">
                            <label class="gp-field-label" for="impTotal"><i class="bi bi-cash-coin"></i> Total de la factura <small>(opcional)</small></label>
                            <input id="impTotal" type="text" inputmode="decimal" class="gp-control js-monto" placeholder="Para controlar lo importado" value="@Monto(totalBoleta)" @onchange="CambiarTotalBoleta" onfocus="this.select()" />
                        </div>
                    </div>
                    <p class="imp-nota"><i class="bi bi-info-circle"></i> <span>Esto arma la compra con origen "Excel". El stock y los precios se actualizan recién cuando la confirmás en <b>Recibir mercadería</b>, donde podés corregir cantidades y costos.</span></p>
                </section>
            }
            else
            {
                <section class="gp-card gp-card-pad mb-3">
                    <div class="gp-card-head">
                        <span class="gp-bubble"><i class="bi bi-currency-dollar"></i></span>
                        <h2>¿Cómo actualizo los precios?</h2>
                    </div>
                    <div class="imp-reglas">
                        <button type="button" class="imp-regla @(regla == ReglaCosto ? "is-active" : "")" @onclick="() => CambiarRegla(ReglaCosto)">
                            <strong>Solo el costo</strong>
                            <span>No toco los precios de venta.</span>
                        </button>
                        <button type="button" class="imp-regla @(regla == ReglaRecalcular ? "is-active" : "")" @onclick="() => CambiarRegla(ReglaRecalcular)">
                            <strong>Recalcular con mis reglas</strong>
                            <span>Costo + la utilidad de cada producto, con el redondeo del negocio@(nombreLista2 != "" ? $" ({nombreLista2} con su regla automática)" : "").</span>
                        </button>
                        <button type="button" class="imp-regla @(regla == ReglaExcel ? "is-active" : "")" disabled="@(!HayPreciosEnExcel)" @onclick="() => CambiarRegla(ReglaExcel)">
                            <strong>Usar los precios del Excel</strong>
                            <span>@(HayPreciosEnExcel ? "Toma la venta" + (nombreLista2 != "" ? $" y {nombreLista2}" : "") + " que trae el archivo." : "El archivo no trae precios de venta.")</span>
                        </button>
                    </div>

                    @if (regla != ReglaCosto)
                    {
                        <p class="imp-nota"><i class="bi bi-lightbulb"></i>
                            <span>
                                <b>¿De dónde sale la utilidad?</b> Si el Excel trae la columna Utilidad, uso esa. Si no, la que ya tiene cargada cada producto
                                (por eso algunos dan 30% y otros 40%). Los productos nuevos arrancan con la utilidad de su subfamilia o familia
                                (se define en <b>Configuración → Familias</b>); si el grupo no tiene una, con el @Subfamilia.UtilidadGeneral.ToString("0")%.
                                "Volver a la regla" deshace lo que cambiaste a mano en la fila y vuelve a esto.
                                <b>En la tabla podés cambiar la utilidad o el precio de venta de cada fila.</b>
                            </span>
                        </p>
                    }

                    <div class="imp-opciones">
                        @if (tipo == ImportacionTipo.Precios)
                        {
                            <label class="gp-switch">
                                <input type="checkbox" @bind="crearInexistentes" @bind:after="AlCambiarCrearInexistentes" />
                                <span class="gp-switch-track"></span>
                                <span class="gp-switch-text">Crear los productos que no existen <small>(entran con stock 0)</small></span>
                            </label>
                        }
                        @if (tipo == ImportacionTipo.Carga)
                        {
                            <label class="gp-switch">
                                <input type="checkbox" @bind="crearInexistentes" @bind:after="AlCambiarCrearInexistentes" />
                                <span class="gp-switch-track"></span>
                                <span class="gp-switch-text">Crear los productos que no existen</span>
                            </label>
                            @if (mapa.TryGetValue("cantidad", out var ic) && ic >= 0)
                            {
                                <label class="gp-switch">
                                    <input type="checkbox" @bind="reemplazarStock" />
                                    <span class="gp-switch-track"></span>
                                    <span class="gp-switch-text">Reemplazar el stock actual por el del archivo <small>(si no, se suma)</small></span>
                                </label>
                            }
                        }
                    </div>
                </section>
            }

            @if (tipo == ImportacionTipo.Factura)
            {
                <div class="imp-opciones" style="margin:0 0 1rem">
                    <label class="gp-switch">
                        <input type="checkbox" @bind="crearInexistentes" @bind:after="AlCambiarCrearInexistentes" />
                        <span class="gp-switch-track"></span>
                        <span class="gp-switch-text">Crear los productos que no existen (entran con stock 0 y se suman al recibir)</span>
                    </label>
                </div>
            }

            <!-- RESUMEN -->
            <div class="imp-resumen">
                <div><b>@filas.Count</b><span>filas</span></div>
                <div class="ok"><b>@CntExisten</b><span>existentes</span></div>
                <div class="nuevo"><b>@CntNuevos</b><span>nuevos</span></div>
                @if (CntSinAsociar > 0)
                {
                    <div class="warn"><b>@CntSinAsociar</b><span>sin asociar</span></div>
                }
                @if (CntNoExiste > 0)
                {
                    <div class="warn"><b>@CntNoExiste</b><span>no existen</span></div>
                }
                @if (CntError > 0)
                {
                    <div class="err"><b>@CntError</b><span>con error</span></div>
                }
            </div>

            @if (CntAlertaCosto > 0)
            {
                <div class="gp-banner" role="alert">
                    <i class="bi bi-graph-up-arrow"></i>
                    <p><b>@CntAlertaCosto</b> producto(s) cambian su costo un 30% o más. Revisalos por si hay un error en el archivo.</p>
                    <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick='() => filtroVista = "problemas"'>Verlos</button>
                </div>
            }
            @if (CntSinAsociar > 0)
            {
                <div class="gp-banner" role="alert" style="flex-wrap:wrap">
                    <i class="bi bi-link-45deg"></i>
                    <p>
                        <b>@CntSinAsociar</b> código(s) del proveedor todavía no están asociados a ningún producto, y esas filas no se importan.
                        Buscá el producto en cada fila, o creálos todos juntos como productos nuevos.
                        @if (coincidenConMisCodigos > 0)
                        {
                            <span><br /><b>@coincidenConMisCodigos de esos códigos son iguales a tus códigos de barras:</b> seguramente el proveedor usa los mismos.</span>
                        }
                    </p>
                    <div class="imp-acciones" style="margin:0">
                        @if (coincidenConMisCodigos > 0)
                        {
                            <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" disabled="@construyendo" @onclick="UsarCodigosIgualesAsync"><i class="bi bi-arrow-repeat"></i> Son los mismos: volver a buscar</button>
                        }
                        <button type="button" class="gp-btn gp-btn-ok-soft gp-btn-sm" @onclick="CrearTodosSinAsociar"><i class="bi bi-plus-lg"></i> Crear todos como nuevos</button>
                    </div>
                </div>
            }
            @if (CntSugeridosBulto > 0)
            {
                <div class="gp-banner" role="alert" style="flex-wrap:wrap">
                    <i class="bi bi-box-seam"></i>
                    <p><b>@CntSugeridosBulto</b> producto(s) parecen venir por bulto según la descripción (ej: "X 100 UNID"). Si el costo del Excel es el del bulto, aplicalo y calculo el costo por unidad@(tipo == ImportacionTipo.Factura ? " y las unidades que entran" : "").</p>
                    <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" @onclick="AplicarTodosSugeridos"><i class="bi bi-check2-all"></i> Aplicar a todos</button>
                </div>
            }
            @if (CntPorPeso > 0)
            {
                <div class="gp-banner" role="alert" style="flex-wrap:wrap">
                    <i class="bi bi-basket3-fill"></i>
                    <p><b>@CntPorPeso</b> producto(s) nuevo(s) se cargan <b>por peso</b> (la descripción dice "X KG"). El precio del Excel se guarda por kilo; en pantalla y en el cartel se ve x 100 g, y al vender se pesa en gramos. Si alguno no lo dice pero también es por peso (ej: un fiambre), tocá "por peso" en su fila.</p>
                    @if (FamiliasConPesoMezclado.Any())
                    {
                        <div class="imp-acciones" style="margin:0">
                            @foreach (var fam in FamiliasConPesoMezclado)
                            {
                                <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="() => MarcarFamiliaPorPeso(fam)"><i class="bi bi-check2-all"></i> Todos los de @fam por peso</button>
                            }
                        </div>
                    }
                </div>
            }
            @if (CntParecidos > 0)
            {
                <div class="gp-banner" role="alert" style="flex-wrap:wrap">
                    <i class="bi bi-intersect"></i>
                    <p><b>@CntParecidos</b> producto(s) "nuevos" se parecen mucho a uno que ya tenés (ej: mismo nombre con distinto código o con "X 100 UNID"). Si son el mismo, no se duplican: se actualiza el que tenés y se le suma este proveedor. Revisalos en cada fila.</p>
                    <div class="imp-acciones" style="margin:0">
                        <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick='() => filtroVista = "parecidos"'>Verlos</button>
                        <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" @onclick="UsarTodosLosParecidos"><i class="bi bi-check2-all"></i> Son los mismos: usar los existentes</button>
                    </div>
                </div>
            }
            @if (CntIncluidas == 0 && filas.Any())
            {
                <div class="gp-banner is-danger" role="alert">
                    <i class="bi bi-slash-circle"></i>
                    <p><b>Por ahora no se puede importar ninguna fila.</b> @MotivoSinFilas</p>
                </div>
            }

            <section class="gp-card gp-card-pad">
                <div class="gp-toolbar">
                    <div class="gp-seg" role="group" aria-label="Filtrar filas">
                        <button type="button" class="@(filtroVista == "todas" ? "is-active" : "")" @onclick='() => filtroVista = "todas"'>Todas <span class="gp-n">@filas.Count</span></button>
                        <button type="button" class="@(filtroVista == "nuevos" ? "is-active" : "")" @onclick='() => filtroVista = "nuevos"'>Nuevos <span class="gp-n">@CntNuevos</span></button>
                        <button type="button" class="@(filtroVista == "problemas" ? "is-active" : "")" @onclick='() => filtroVista = "problemas"'>Para revisar <span class="gp-n">@CntRevisar</span></button>
                        @if (CntParecidos > 0)
                        {
                            <button type="button" class="@(filtroVista == "parecidos" ? "is-active" : "")" @onclick='() => filtroVista = "parecidos"'>Parecidos <span class="gp-n">@CntParecidos</span></button>
                        }
                    </div>
                    <div class="gp-summary"><span>Se importan <strong>@CntIncluidas</strong> de <strong>@filas.Count</strong></span></div>
                </div>

                <div class="gp-table-wrap gp-stack-wrap">
                    <table class="gp-table gp-stack imp-tabla">
                        <thead>
                            <tr>
                                <th class="gp-th-check"><input class="gp-check" type="checkbox" aria-label="Seleccionar todas" checked="@TodasMarcadas" @onchange="ToggleTodas" /></th>
                                <th>Fila</th>
                                <th>Código</th>
                                <th>Producto</th>
                                @if (tipo != ImportacionTipo.Precios)
                                {
                                    <th class="t-center">@(tipo == ImportacionTipo.Carga ? "Stock" : "Cantidad")</th>
                                }
                                <th class="t-right">Costo</th>
                                @if (tipo != ImportacionTipo.Factura)
                                {
                                    <th class="t-right">@(regla == ReglaCosto ? "Venta" : "Utilidad · Venta")</th>
                                    @if (nombreLista2 != "")
                                    {
                                        <th class="t-right">@nombreLista2</th>
                                    }
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!FilasVisibles.Any())
                            {
                                <tr class="gp-empty-row">
                                    <td colspan="9">
                                        <div class="gp-empty">
                                            <span class="gp-bubble"><i class="bi bi-check2-all"></i></span>
                                            <strong>No hay filas en esta vista</strong>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var f in FilasVisibles)
                                {
                                    <tr class="@ClaseFila(f)">
                                        <td class="gp-td-check" data-label="">
                                            @if (f.Importable)
                                            {
                                                <input class="gp-check" type="checkbox" aria-label="Incluir esta fila" checked="@f.Incluir" disabled="@f.Procesada" @onchange="e => ToggleFila(f, e)" />
                                            }
                                        </td>
                                        <td class="gp-nowrap" data-label="Fila">@f.NumeroFila</td>
                                        <td class="gp-td-code" data-label="Código">@(string.IsNullOrEmpty(f.Codigo) ? "—" : f.Codigo)</td>
                                        <td class="gp-td-main" data-label="Producto">
                                            <div class="gp-product">@NombreMostrado(f)</div>
                                            <div class="imp-tags">
                                                <span class="gp-pill @ClasePill(f)">@TextoEstado(f)</span>
                                                @foreach (var a in f.Avisos)
                                                {
                                                    <span class="imp-aviso">@a</span>
                                                }
                                                @if (f.Estado == EstError || f.Estado == EstNoExiste)
                                                {
                                                    <span class="imp-aviso">@f.Mensaje</span>
                                                }
                                                @if (!string.IsNullOrEmpty(f.ErrorGuardado))
                                                {
                                                    <span class="imp-aviso err">@f.ErrorGuardado</span>
                                                }
                                            </div>
                                            @if (f.Estado == EstNuevo && !f.Procesada)
                                            {
                                                <div class="imp-nombre">
                                                    <label>Se guarda como</label>
                                                    <input type="text" class="gp-control" maxlength="150" value="@f.NombreSistema"
                                                           @onchange="e => CambiarNombreFila(f, e)" title="Nombre del producto en tu sistema (el del proveedor queda guardado aparte)" />
                                                </div>
                                                <div class="imp-peso @(EsPesoFila(f) ? "is-on" : "")">
                                                    <i class="bi bi-basket3-fill"></i>
                                                    <span>Se vende</span>
                                                    <button type="button" class="@(!EsPesoFila(f) ? "is-active" : "")" @onclick="() => CambiarPesoFila(f, false)">por unidad</button>
                                                    <button type="button" class="@(EsPesoFila(f) ? "is-active" : "")" @onclick="() => CambiarPesoFila(f, true)">por peso</button>
                                                    @if (EsPesoFila(f))
                                                    {
                                                        <small>precio del Excel = x kilo · se muestra x 100 g · al vender se pesa</small>
                                                    }
                                                    else if (EsPorKilo(f.Descripcion))
                                                    {
                                                        <small class="imp-peso-sug">la descripción dice X KG</small>
                                                    }
                                                </div>
                                                @if (f.Parecido != null)
                                                {
                                                    <div class="imp-parecido">
                                                        <i class="bi bi-intersect"></i>
                                                        <span>¿Es el mismo que <b>@f.Parecido.Nombre</b>@(string.IsNullOrWhiteSpace(f.Parecido.CodigoBarras) ? "" : $" (cód. {f.Parecido.CodigoBarras})")?</span>
                                                        <button type="button" class="gp-btn gp-btn-primary gp-btn-sm" @onclick="() => UsarParecido(f)">Sí, es ese</button>
                                                        <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm" @onclick="() => DescartarParecido(f)">No, es otro</button>
                                                    </div>
                                                }
                                            }
                                            else if (f.Estado == EstExiste && f.Producto != null && !string.Equals(f.Producto.Nombre?.Trim(), f.Descripcion.Trim(), StringComparison.OrdinalIgnoreCase))
                                            {
                                                <div class="imp-mini" style="white-space:normal; margin-top:.2rem"><i class="bi bi-arrow-return-right"></i> En tu sistema: <b>@f.Producto.Nombre</b></div>
                                            }
                                            @if (MuestraBulto(f))
                                            {
                                                <div class="imp-bulto @(f.UnidadesBulto > 1 ? "is-on" : "")">
                                                    <i class="bi bi-box-seam"></i>
                                                    <span>Viene por</span>
                                                    <input type="number" min="1" class="imp-in" title="Unidades que trae el bulto (1 = suelto)" disabled="@f.Procesada"
                                                           value="@f.UnidadesBulto" @onchange="e => CambiarBultoFila(f, e)" onfocus="this.select()" />
                                                    <span>u.</span>
                                                    @if (f.BultoSugerido > 1 && f.UnidadesBulto != f.BultoSugerido && !f.Procesada)
                                                    {
                                                        <button type="button" class="imp-sug" @onclick="() => AplicarSugerido(f)">¿x @f.BultoSugerido? (lo dice la descripción)</button>
                                                    }
                                                    @if (f.BultoDeRelacion && f.UnidadesBulto > 1)
                                                    {
                                                        <small class="gp-muted">(guardado para este proveedor)</small>
                                                    }
                                                </div>
                                            }
                                            @if (f.Estado == EstSinAsociar)
                                            {
                                                <div class="imp-acciones">
                                                    <button type="button" class="gp-btn gp-btn-soft gp-btn-sm" @onclick="() => AbrirBuscarProducto(f)"><i class="bi bi-search"></i> Buscar producto</button>
                                                    <button type="button" class="gp-btn gp-btn-ok-soft gp-btn-sm" @onclick="() => CrearComoNuevo(f)"><i class="bi bi-plus-lg"></i> Crear nuevo</button>
                                                </div>
                                            }
                                        </td>

                                        @if (tipo != ImportacionTipo.Precios)
                                        {
                                            <td class="t-center" data-label="@(tipo == ImportacionTipo.Carga ? "Stock" : "Cantidad")">
                                                @if (f.Importable && (f.Cantidad ?? 0m) != 0m)
                                                {
                                                    <div class="imp-cell">
                                                        @if (f.UnidadesBulto > 1 && tipo == ImportacionTipo.Factura)
                                                        {
                                                            <span class="imp-mini">@((f.CantidadExcel ?? 0m).ToString("0.##", cultura)) bulto(s) x @f.UnidadesBulto</span>
                                                        }
                                                        <b>@(f.Cantidad!.Value.ToString("0.##", cultura))@(f.UnidadesBulto > 1 && tipo == ImportacionTipo.Factura ? " u." : "")</b>
                                                        <span class="imp-chip">Stock @f.StockAnterior → @StockNuevo(f)</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="gp-muted">@(f.Cantidad.HasValue? f.Cantidad.Value.ToString("0.##", cultura) : "—")</span>
                                                }
                                            </td>
                                        }

                                        <td class="t-right" data-label="Costo">
                                            @if ((f.Costo ?? 0m) > 0m)
                                            {
                                                <div class="imp-cell right">
                                                    @if (f.Importable && f.OrigCosto > 0m)
                                                    {
                                                        <span class="imp-ant">Ant: $@f.OrigCosto.ToString("N2", cultura)</span>
                                                    }
                                                    @if (f.UnidadesBulto > 1)
                                                    {
                                                        <span class="imp-mini">Bulto: $@((f.CostoExcel ?? 0m).ToString("N2", cultura))</span>
                                                    }
                                                    <b>$@f.Costo!.Value.ToString("N2", cultura)@(f.UnidadesBulto > 1 ? " c/u" : "")</b>
                                                    @if (f.Importable && f.OrigCosto > 0m && Math.Abs(f.DeltaCosto) >= 0.05m)
                                                    {
                                                        <span class="imp-delta @(f.DeltaCosto > 0 ? "up" : "down") @(f.AlertaCosto ? "alert" : "")">@(f.DeltaCosto > 0 ? "▲ +" : "▼ ")@f.DeltaCosto.ToString("0.#", cultura)%</span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="gp-muted">—</span>
                                            }
                                        </td>

                                        @if (tipo != ImportacionTipo.Factura)
                                        {
                                            <td class="t-right" data-label="Venta">
                                                @if (f.Importable && (f.Costo ?? 0m) > 0m && regla != ReglaCosto)
                                                {
                                                    <div class="imp-cell right">
                                                        @if (f.OrigVenta > 0m)
                                                        {
                                                            <span class="imp-ant">Ant: $@f.OrigVenta.ToString("N2", cultura)@(f.OrigUtil > 0m ? $" ({f.OrigUtil.ToString("0.#", cultura)}%)" : "")</span>
                                                        }
                                                        <div class="imp-edit">
                                                            <input type="number" step="any" class="imp-in util" title="Utilidad %" disabled="@f.Procesada"
                                                                   value="@f.UtilUsada.ToString("0.##", CultureInfo.InvariantCulture)" @onchange="e => CambiarUtilFila(f, e)" onfocus="this.select()" />
                                                            <span>%</span>
                                                            <span>$</span>
                                                            <input type="text" inputmode="decimal" class="imp-in venta js-monto" title="Precio de venta" disabled="@f.Procesada"
                                                                   value="@Monto(f.VentaNueva)" @onchange="e => CambiarVentaFila(f, e)" onfocus="this.select()" />
                                                        </div>
                                                        @if ((f.UtilManual.HasValue || f.VentaManual.HasValue) && !f.Procesada)
                                                        {
                                                            <button type="button" class="gp-link imp-mini" @onclick="() => QuitarManual(f)">Editado · volver a la regla</button>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="gp-muted">@(f.Importable && f.OrigVenta > 0m ? "$" + f.OrigVenta.ToString("N2", cultura) : "—")</span>
                                                }
                                            </td>
                                            @if (nombreLista2 != "")
                                            {
                                                <td class="t-right" data-label="@nombreLista2">
                                                    @if (f.Importable && (f.Costo ?? 0m) > 0m && regla != ReglaCosto)
                                                    {
                                                        <div class="imp-cell right">
                                                            @if (f.OrigL2 > 0m)
                                                            {
                                                                <span class="imp-ant">Ant: $@f.OrigL2.ToString("N2", cultura)</span>
                                                            }
                                                            <b class="imp-venta">$@f.Lista2Nueva.ToString("N2", cultura)</b>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="gp-muted">@(f.Importable && f.OrigL2 > 0m ? "$" + f.OrigL2.ToString("N2", cultura) : "—")</span>
                                                    }
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (FilasFiltradas.Count() > mostrarHasta)
                {
                    <div style="text-align:center; margin-top:.9rem">
                        <button type="button" class="gp-btn gp-btn-outline" @onclick="() => mostrarHasta += 150">
                            <i class="bi bi-chevron-down"></i> Mostrar más (@(FilasFiltradas.Count() - mostrarHasta) restantes)
                        </button>
                    </div>
                }
            </section>
        }

        @* ===================== PASO 4: LISTO ===================== *@
        @if (paso == 4)
        {
            <section class="gp-card gp-card-pad imp-final">
                <span class="imp-final-icon @(resErrores > 0 ? "warn" : "")"><i class="bi @(resErrores > 0 ? "bi-exclamation-lg" : "bi-check-lg")"></i></span>
                @if (tipo == ImportacionTipo.Factura)
                {
                    <h2>Factura lista para recibir</h2>
                    <p>Se armó la compra con <b>@resActualizados</b> producto(s)@(resCreados > 0 ? $", de los cuales {resCreados} son nuevos" : ""). Falta confirmarla para que se sume el stock y se actualicen los precios.</p>
                }
                else
                {
                    <h2>@(resErrores > 0 ? "Importación con errores" : "¡Importación exitosa!")</h2>
                    <p>
                        @if (resCreados > 0)
                        {
                            <span><b>@resCreados</b> producto(s) nuevo(s). </span>
                        }
                        <span><b>@resActualizados</b> producto(s) actualizado(s).</span>
                        @if (resErrores > 0)
                        {
                            <span> <b>@resErrores</b> con error.</span>
                        }
                    </p>
                }

                @if (resMensajes.Any())
                {
                    <ul class="imp-errores">
                        @foreach (var m in resMensajes.Take(15))
                        {
                            <li>@m</li>
                        }
                        @if (resMensajes.Count > 15)
                        {
                            <li>... y @(resMensajes.Count - 15) más (están en el historial).</li>
                        }
                    </ul>
                }

                <div class="imp-final-btns">
                    @if (tipo == ImportacionTipo.Factura && resCompraId.HasValue)
                    {
                        <button type="button" class="gp-btn gp-btn-ok" @onclick="IrARecibir"><i class="bi bi-box-arrow-in-down"></i> Ir a Recibir mercadería</button>
                    }
                    @if (resErrores > 0 && tipo != ImportacionTipo.Factura)
                    {
                        <button type="button" class="gp-btn gp-btn-primary" @onclick="() => paso = 3"><i class="bi bi-arrow-repeat"></i> Reintentar los que fallaron</button>
                    }
                    <button type="button" class="gp-btn gp-btn-outline" @onclick="Reiniciar"><i class="bi bi-file-earmark-arrow-up"></i> Importar otro archivo</button>
                    <button type="button" class="gp-btn gp-btn-ghost" @onclick='() => CambiarPestana("historial")'>Ver historial</button>
                </div>
            </section>
        }

        @* ===================== BARRA INFERIOR ===================== *@
        @if (paso < 4)
        {
            <div class="imp-bar-wrap">
                <div class="gp-selbar imp-bar">
                    <div class="imp-bar-info">
                        @if (paso == 3)
                        {
                            <div>
                                <span class="imp-bar-label">@TextoAccion</span>
                                <span class="imp-bar-total">@CntIncluidas fila(s)</span>
                                @if (CntIncluidas == 0)
                                {
                                    <span class="imp-bar-why"><i class="bi bi-info-circle"></i> Mirá el cartel rojo de arriba: ahí te digo por qué.</span>
                                }
                            </div>
                            @if (tipo == ImportacionTipo.Factura)
                            {
                                <div class="imp-bar-meta">
                                    <span>Total: $@TotalFactura.ToString("N2", cultura)</span>
                                    @if (totalBoleta.HasValue && totalBoleta.Value > 0m)
                                    {
                                        @if (Math.Abs(TotalFactura - totalBoleta.Value) < 1m)
                                        {
                                            <span class="imp-chk ok"><i class="bi bi-check-circle-fill"></i> Coincide con la factura</span>
                                        }
                                        else
                                        {
                                            <span class="imp-chk bad"><i class="bi bi-exclamation-triangle-fill"></i> Difiere $@Math.Abs(TotalFactura - totalBoleta.Value).ToString("N2", cultura)</span>
                                        }
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            <span class="imp-bar-label">@(paso == 1 ? "Elegí el archivo para continuar" : "Revisá las columnas")</span>
                        }
                    </div>
                    <div class="gp-btn-group">
                        @if (paso == 1)
                        {
                            <button type="button" class="gp-btn gp-btn-ghost" @onclick="Cancelar">Cancelar</button>
                            <button type="button" class="gp-btn gp-btn-ok" style="height:3rem" disabled="@(!HayArchivo || leyendo || construyendo)" @onclick="ContinuarDesdeArchivoAsync">
                                @if (construyendo)
                                {
                                    <span class="gp-spinner" style="width:1rem;height:1rem;border-width:2px;border-color:rgba(255,255,255,.4);border-top-color:#fff"></span>
                                }
                                <span>Continuar</span> <i class="bi bi-arrow-right-circle-fill"></i>
                            </button>
                        }
                        @if (paso == 2)
                        {
                            <button type="button" class="gp-btn gp-btn-ghost" @onclick="() => paso = 1"><i class="bi bi-arrow-left"></i> Volver</button>
                            <button type="button" class="gp-btn gp-btn-ok" style="height:3rem" disabled="@(FaltanObligatorias() || construyendo)" @onclick="IrAVistaPreviaAsync">
                                @if (construyendo)
                                {
                                    <span class="gp-spinner" style="width:1rem;height:1rem;border-width:2px;border-color:rgba(255,255,255,.4);border-top-color:#fff"></span>
                                }
                                <span>Ver vista previa</span> <i class="bi bi-arrow-right-circle-fill"></i>
                            </button>
                        }
                        @if (paso == 3)
                        {
                            <button type="button" class="gp-btn gp-btn-ghost" @onclick="() => paso = 1"><i class="bi bi-arrow-left"></i> Volver</button>
                            <button type="button" class="gp-btn gp-btn-outline" @onclick="() => paso = 2"><i class="bi bi-layout-three-columns"></i> Ajustar columnas</button>
                            <button type="button" class="gp-btn gp-btn-ok" style="height:3rem" disabled="@(guardando || CntIncluidas == 0)" @onclick="ConfirmarAsync">
                                <i class="bi bi-check-circle-fill"></i> <span>@TextoBotonConfirmar</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        @* ===================== HISTORIAL ===================== *@
        <section class="gp-card gp-card-pad">
            @if (cargandoHistorial)
            {
                <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando historial...</p></div>
            }

            <div class="gp-table-wrap gp-stack-wrap">
                <table class="gp-table gp-stack">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Archivo</th>
                            <th>Tipo</th>
                            <th>Proveedor</th>
                            <th>Resultado</th>
                            <th class="t-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!historial.Any() && !cargandoHistorial)
                        {
                            <tr class="gp-empty-row">
                                <td colspan="6">
                                    <div class="gp-empty">
                                        <span class="gp-bubble"><i class="bi bi-journal-x"></i></span>
                                        <strong>Todavía no importaste ningún archivo</strong>
                                        <span>Cada importación queda registrada acá.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var h in historial)
                            {
                                <tr>
                                    <td class="gp-nowrap" data-label="Fecha">@FechaLocal(h).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="gp-td-main" data-label="Archivo"><span class="gp-product">@h.NombreArchivo</span></td>
                                    <td data-label="Tipo"><span class="gp-pill @(h.Tipo == ImportacionTipo.Factura ? "is-rec" : h.Tipo == ImportacionTipo.Precios ? "is-pend" : "is-env")">@TextoTipo(h.Tipo)</span></td>
                                    <td data-label="Proveedor">@NombreProveedor(h.ProveedorId)</td>
                                    <td data-label="Resultado">
                                        <div class="imp-res">
                                            @if (h.Creados > 0)
                                            {
                                                <span>@h.Creados nuevos</span>
                                            }
                                            <span>@h.Actualizados @(h.Tipo == ImportacionTipo.Factura ? "en la compra" : "actualizados")</span>
                                            @if (h.Errores > 0)
                                            {
                                                <span class="bad">@h.Errores con error</span>
                                            }
                                        </div>
                                        @if (h.Tipo == ImportacionTipo.Factura && h.CompraId.HasValue)
                                        {
                                            var estadoCompra = comprasDeImportaciones.TryGetValue(h.CompraId.Value, out var cm) ? cm.Estado : null;
                                            <span class="gp-pill @(estadoCompra == CompraEstado.Confirmada ? "is-env" : "is-pend")" style="margin-top:.3rem">@(estadoCompra == CompraEstado.Confirmada ? "Compra confirmada" : estadoCompra == null ? "Compra eliminada" : "Falta confirmar")</span>
                                        }
                                    </td>
                                    <td class="t-center gp-td-actions" data-label="">
                                        <div class="gp-cell-actions">
                                            <button type="button" class="gp-btn gp-btn-soft gp-btn-sm gp-btn-icon" title="Ver detalle" @onclick="() => VerDetalleHistorialAsync(h)"><i class="bi bi-eye-fill"></i></button>
                                            @if (h.Tipo == ImportacionTipo.Factura && h.CompraId.HasValue && comprasDeImportaciones.TryGetValue(h.CompraId.Value, out var cc) && cc.Estado == CompraEstado.Cerrada)
                                            {
                                                <button type="button" class="gp-btn gp-btn-ok-soft gp-btn-sm" title="Seguir en Recibir mercadería" @onclick="() => IrARecibirCompra(h.CompraId!.Value)"><i class="bi bi-box-arrow-in-down"></i> Recibir</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@* ===================== VENTANAS ===================== *@
@if (filaAsignando != null)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="() => filaAsignando = null">
        <div class="gp-modal" role="dialog" aria-modal="true" style="max-width: 34rem;" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-link-45deg"></i></span>
                <div>
                    <h3>¿A qué producto corresponde?</h3>
                    <p>Código del proveedor <b>@filaAsignando.Codigo</b>@(string.IsNullOrWhiteSpace(filaAsignando.Descripcion) ? "" : " · " + filaAsignando.Descripcion)</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="() => filaAsignando = null"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <div class="gp-buscador">
                    <BuscadorProducto CargarAlInicio="false" MostrarPrimeraLista="false" MostrarSegundaLista="false" OnProductoEncontrado="AsignarProducto" />
                </div>
                <p class="imp-nota"><i class="bi bi-info-circle"></i> <span>Al confirmar, ese código queda guardado para este proveedor y la próxima vez se reconoce solo.</span></p>
            </div>
        </div>
    </div>
}

@if (detalleHistorial != null)
{
    <div class="gp-scope gp-modal-backdrop" @onclick="CerrarDetalleHistorial">
        <div class="gp-modal imp-hist-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="gp-modal-head">
                <span class="gp-bubble gp-bubble-sm"><i class="bi bi-file-earmark-excel"></i></span>
                <div>
                    <h3>@detalleHistorial.NombreArchivo</h3>
                    <p>@TextoTipo(detalleHistorial.Tipo) · @FechaLocal(detalleHistorial).ToString("dd/MM/yyyy HH:mm") · @NombreProveedor(detalleHistorial.ProveedorId)</p>
                </div>
                <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon gp-modal-x" aria-label="Cerrar" @onclick="CerrarDetalleHistorial"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="gp-modal-body">
                <div class="imp-hist-chips">
                    <span class="gp-chip"><i class="bi bi-list-ol"></i> @detalleHistorial.FilasTotal filas</span>
                    @if (detalleHistorial.Creados > 0)
                    {
                        <span class="gp-chip"><i class="bi bi-plus-circle"></i> @detalleHistorial.Creados nuevos</span>
                    }
                    <span class="gp-chip"><i class="bi bi-check2-circle"></i> @detalleHistorial.Actualizados @(detalleHistorial.Tipo == ImportacionTipo.Factura ? "en la compra" : "actualizados")</span>
                    @if (detalleHistorial.Omitidos > 0)
                    {
                        <span class="gp-chip"><i class="bi bi-dash-circle"></i> @detalleHistorial.Omitidos omitidos</span>
                    }
                    @if (detalleHistorial.Errores > 0)
                    {
                        <span class="gp-chip" style="color:var(--gp-danger)"><i class="bi bi-x-circle"></i> @detalleHistorial.Errores con error</span>
                    }
                    @if (!string.IsNullOrEmpty(detalleHistorial.StockModo))
                    {
                        <span class="gp-chip"><i class="bi bi-boxes"></i> Stock @(detalleHistorial.StockModo == "reemplaza" ? "reemplazado" : "sumado")</span>
                    }
                    @if (!string.IsNullOrEmpty(detalleHistorial.ReglaPrecios))
                    {
                        <span class="gp-chip"><i class="bi bi-currency-dollar"></i> @TextoReglaGuardada(detalleHistorial.ReglaPrecios)</span>
                    }
                </div>

                @if (cargandoDetalleHist)
                {
                    <div class="gp-banner is-neutral"><span class="gp-spinner"></span><p>Cargando el contenido...</p></div>
                }
                else if (filasHistorial == null)
                {
                    <div class="gp-banner is-neutral"><i class="bi bi-info-circle"></i><p>Esta importación es anterior al cambio: no tiene guardado el detalle de cada fila. Las próximas sí.</p></div>
                }
                else
                {
                    <div class="gp-toolbar" style="margin-top:.9rem">
                        <div class="gp-search">
                            <i class="bi bi-search"></i>
                            <input type="text" class="gp-control" placeholder="Buscar por código o nombre..." @bind="busquedaHist" @bind:event="oninput" />
                        </div>
                        <div class="gp-seg" role="group" aria-label="Filtrar">
                            <button type="button" class="@(filtroHist == "" ? "is-active" : "")" @onclick='() => filtroHist = ""'>Todas <span class="gp-n">@filasHistorial.Count</span></button>
                            <button type="button" class="@(filtroHist == "precio" ? "is-active" : "")" @onclick='() => filtroHist = "precio"'>Cambió el precio</button>
                            <button type="button" class="@(filtroHist == "error" ? "is-active" : "")" @onclick='() => filtroHist = "error"'>No entraron</button>
                        </div>
                    </div>

                    <div class="gp-table-wrap gp-stack-wrap">
                        <table class="gp-table gp-stack">
                            <thead>
                                <tr>
                                    <th>Fila</th>
                                    <th>Código</th>
                                    <th>Producto</th>
                                    @if (detalleHistorial.Tipo != ImportacionTipo.Precios)
                                    {
                                        <th class="t-center">Cant.</th>
                                    }
                                    <th class="t-right">Costo</th>
                                    @if (detalleHistorial.Tipo != ImportacionTipo.Factura)
                                    {
                                        <th class="t-right">Venta</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ var visiblesHist = FilasHistorialFiltradas.ToList(); }
                                @if (!visiblesHist.Any())
                                {
                                    <tr class="gp-empty-row"><td colspan="6"><div class="gp-empty"><strong>No hay filas en esta vista</strong></div></td></tr>
                                }
                                @foreach (var r in visiblesHist.Take(mostrarHastaHist))
                                {
                                    <tr class="@(r.Resultado == "error" || r.Resultado == "omitida" ? "is-off" : "")">
                                        <td class="gp-nowrap" data-label="Fila">@r.Fila</td>
                                        <td class="gp-td-code" data-label="Código">@r.Codigo</td>
                                        <td class="gp-td-main" data-label="Producto">
                                            <div class="gp-product">@r.Nombre</div>
                                            <div class="imp-tags">
                                                <span class="gp-pill @ClasePillHist(r.Resultado)">@TextoResultadoHist(r.Resultado)</span>
                                                @if (r.Bulto > 1)
                                                {
                                                    <span class="imp-mini"><i class="bi bi-box-seam"></i> bulto x @r.Bulto</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(r.Mensaje))
                                                {
                                                    <span class="imp-aviso">@r.Mensaje</span>
                                                }
                                            </div>
                                        </td>
                                        @if (detalleHistorial.Tipo != ImportacionTipo.Precios)
                                        {
                                            <td class="t-center" data-label="Cant.">@(r.Cantidad?.ToString("0.##", cultura) ?? "—")</td>
                                        }
                                        <td class="t-right" data-label="Costo">
                                            <div class="imp-cell right">
                                                @if (r.CostoAnt > 0m && r.CostoNuevo.HasValue && r.CostoAnt != r.CostoNuevo)
                                                {
                                                    <span class="imp-ant">Ant: $@r.CostoAnt.ToString("N2", cultura)</span>
                                                }
                                                <b>@(r.CostoNuevo.HasValue ? "$" + r.CostoNuevo.Value.ToString("N2", cultura) : "—")</b>
                                            </div>
                                        </td>
                                        @if (detalleHistorial.Tipo != ImportacionTipo.Factura)
                                        {
                                            <td class="t-right" data-label="Venta">
                                                <div class="imp-cell right">
                                                    @if (r.VentaAnt > 0m && r.VentaNueva.HasValue && r.VentaAnt != r.VentaNueva)
                                                    {
                                                        <span class="imp-ant">Ant: $@r.VentaAnt.ToString("N2", cultura)</span>
                                                    }
                                                    <b class="imp-venta">@(r.VentaNueva.HasValue ? "$" + r.VentaNueva.Value.ToString("N2", cultura) : "sin cambio")</b>
                                                    @if (r.Utilidad.HasValue && r.VentaNueva.HasValue)
                                                    {
                                                        <span class="imp-mini">@r.Utilidad.Value.ToString("0.#", cultura)% de utilidad</span>
                                                    }
                                                </div>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (visiblesHist.Count > mostrarHastaHist)
                    {
                        <div style="text-align:center; margin-top:.8rem">
                            <button type="button" class="gp-btn gp-btn-outline gp-btn-sm" @onclick="() => mostrarHastaHist += 200"><i class="bi bi-chevron-down"></i> Mostrar más (@(visiblesHist.Count - mostrarHastaHist) restantes)</button>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(detalleHistorial.Observaciones))
                {
                    <div class="gp-banner is-neutral" style="margin-top:1rem"><i class="bi bi-chat-left-text"></i><p style="white-space:pre-line">@detalleHistorial.Observaciones</p></div>
                }
            </div>
            <div class="gp-modal-foot">
                @if (detalleHistorial.Tipo == ImportacionTipo.Factura && detalleHistorial.CompraId.HasValue && comprasDeImportaciones.ContainsKey(detalleHistorial.CompraId.Value))
                {
                    <button type="button" class="gp-btn gp-btn-ok-soft" @onclick="() => IrARecibirCompra(detalleHistorial!.CompraId!.Value)"><i class="bi bi-box-arrow-in-down"></i> Ver la compra</button>
                }
                <button type="button" class="gp-btn gp-btn-ghost" @onclick="CerrarDetalleHistorial">Cerrar</button>
            </div>
        </div>
    </div>
}

@if (guardando)
{
    <div class="gp-scope gp-modal-backdrop">
        <div class="gp-modal" role="alertdialog" aria-modal="true" style="max-width: 22rem; text-align:center;">
            <div class="gp-modal-body" style="padding:1.6rem">
                <span class="gp-spinner" style="width:2rem;height:2rem"></span>
                <h3 style="margin:.9rem 0 .2rem; font-size:1.1rem; font-weight:900">Guardando...</h3>
                <p class="gp-muted" style="margin:0">@progreso de @progresoTotal</p>
            </div>
        </div>
    </div>
}

<style>
    .imp-cod-fondo { position: fixed; inset: 0; z-index: 3000; background: rgba(15, 23, 42, .45); display: flex; align-items: center; justify-content: center; padding: .75rem; }
    .imp-cod-modal { width: min(520px, 100%); max-height: calc(100dvh - 1.5rem); display: flex; flex-direction: column; overflow: hidden; background: #fff; border-radius: 18px; box-shadow: 0 20px 50px rgba(0,0,0,.25); }
    .imp-cod-head { flex: none; display: flex; gap: .6rem; align-items: center; padding: .7rem .9rem; color: #fff;
        background: linear-gradient(135deg, #2563eb, #7c3aed); }
    .imp-cod-head > i { font-size: 1.3rem; }
    .imp-cod-head h3 { margin: 0; font-size: 1rem; font-weight: 900; }
