    .imp-cod-op.is-active { border-color: #2563eb; background: #eff5ff; }
    .imp-cod-op.is-active > i:first-child { color: #2563eb; }
    .imp-cod-ok { color: #2563eb; font-size: 1.2rem; }
    .imp-cod-ej { flex: none; margin: 0; padding: 0 .9rem; color: #64748b; font-size: .78rem; }
    .imp-cod-acc { flex: none; display: flex; gap: .6rem; margin-top: .6rem; padding: .8rem .9rem .9rem; background: #f7f8fc; border-top: 1px solid #e8ebf3; }
    .imp-cod-btn { flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: .4rem; height: 2.9rem; border-radius: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; }
    .imp-cod-btn.is-cancelar { border: 2px solid #d6dbe8; background: #fff; color: #1b2540; }
    .imp-cod-btn.is-ok { border: 0; color: #fff; background: linear-gradient(135deg, #2563eb, #7c3aed); box-shadow: 0 6px 16px rgba(79, 70, 229, .35); }
    .imp-cod-btn.is-ok:hover { filter: brightness(1.08); }
    .imp-steps {
        display: flex;
        gap: .5rem;
        max-width: 640px;
        margin: 0 auto 1.2rem;
        padding: 0;
        list-style: none;
    }

        .imp-steps li {
            flex: 1 1 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .35rem;
            text-align: center;
            color: var(--gp-muted);
            position: relative;
        }

            .imp-steps li + li::before {
                content: "";
