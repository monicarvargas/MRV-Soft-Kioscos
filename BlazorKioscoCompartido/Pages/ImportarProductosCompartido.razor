    // ---------------------------------------------------------------- bultos
    private static readonly System.Text.RegularExpressions.Regex RxBultoUnid = new(
        @"\bX\s*(\d{1,4})\s*(U|UN|UNI|UNID|UNIDS|UNIDADES|UDS|UNDS)(?![A-Z])",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    /// <summary>"X100", "X 100" o "44MMX100" sin unidad atrás (que no sea una medida: X 2 L, X 500 GR, X 3/4...).</summary>
    private static readonly System.Text.RegularExpressions.Regex RxBultoSolo = new(
        @"(?:(?<![A-Z0-9])|(?<=\d(MM|CM|M)))X\s*(\d{1,4})(?![\d.,/""'])(?!\s*(G|GR|GRS|KG|ML|L|LT|LTS|CC|MM|CM|M|MTS|MT|W|V|PULG|MTR)\b)",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    private static readonly System.Text.RegularExpressions.Regex RxBultoCaja = new(
        @"\b(CAJA|BULTO|PACK|DISPLAY|PAQUETE|BOLSA|CAJON|CAJÓN)\s*(X\s*)?(\d{1,4})(?!\s*(G|GR|GRS|KG|ML|L|LT|LTS|CC|MM|CM|M|MTS|MT|W)\b)(?![\d.,])",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    /// <summary>Lee de la descripción cuántas unidades trae el bulto: "ABRAZADERA 16MM X 100 UNID" → 100, "CAJA X 24" → 24.</summary>
    private static int? DetectarBulto(string? descripcion)
    {
        if (string.IsNullOrWhiteSpace(descripcion)) return null;
        var m = RxBultoUnid.Match(descripcion);
        if (m.Success && int.TryParse(m.Groups[1].Value, out var n1) && n1 > 1) return n1;
        m = RxBultoCaja.Match(descripcion);
        if (m.Success && int.TryParse(m.Groups[3].Value, out var n2) && n2 > 1) return n2;
        m = RxBultoSolo.Match(descripcion);
        if (m.Success && int.TryParse(m.Groups[2].Value, out var n3) && n3 > 1) return n3;
        return null;
    }

    /// <summary>El costo del Excel pasa a ser el del bulto: costo por unidad = costo / n. En una factura, la cantidad son bultos: unidades = cantidad × n.</summary>
    private void AplicarBultoFila(FilaImport f, int n)
    {
        n = Math.Max(1, n);
        f.UnidadesBulto = n;
        f.Costo = f.CostoExcel.HasValue ? Math.Round(f.CostoExcel.Value / n, 4) : null;
        if (tipo == ImportacionTipo.Factura)
            f.Cantidad = f.CantidadExcel.HasValue ? f.CantidadExcel.Value * n : null;

        // producto nuevo que viene por bulto: el nombre del sistema va sin "X 100 UNID" (si no lo cambiaron a mano)
        if (n > 1 && f.Estado == EstNuevo && !f.NombreEditado)
        {
            f.NombreSistema = QuitarBultoDelNombre(f.Descripcion);
            if (f.Producto != null) f.Producto.Nombre = f.NombreSistema;
        }
    }

    /// <summary>"ABRAZADERA 16MM X 100 UNID" → "ABRAZADERA 16MM".</summary>
    private static string QuitarBultoDelNombre(string? descripcion)
    {
        var t = descripcion ?? "";
        t = RxBultoUnid.Replace(t, " ");
        t = RxBultoCaja.Replace(t, " ");
        t = RxBultoSolo.Replace(t, " ");
        t = System.Text.RegularExpressions.Regex.Replace(t, @"\s+", " ").Trim(' ', '-', ',', '.', '/');
        return string.IsNullOrWhiteSpace(t) ? (descripcion ?? "").Trim() : t;
    }

    private void CambiarNombreFila(FilaImport f, ChangeEventArgs e)
    {
        var v = e.Value?.ToString()?.Trim().ToUpper() ?? "";
        if (v == "") return;
        f.NombreSistema = v;
        f.NombreEditado = true;
        if (f.Producto != null && f.Estado == EstNuevo) f.Producto.Nombre = v;
