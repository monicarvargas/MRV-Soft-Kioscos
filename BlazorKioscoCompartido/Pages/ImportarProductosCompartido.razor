            if (archivo.Size > MaxBytes)
            {
                errorArchivo = "El archivo supera los 10 MB permitidos.";
                return;
            }

            using var stream = archivo.OpenReadStream(MaxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            hashArchivo = Convert.ToHexString(SHA256.HashData(ms.ToArray()));
            ms.Position = 0;

            Encoding.RegisterProvider(CodePagesEncodingProvider.Instance);
            var todas = LeerHoja(ms);

            // el encabezado es la primera fila con al menos 2 celdas de texto (hay archivos con títulos arriba)
            int hi = 0;
            for (int i = 0; i < Math.Min(todas.Count, 20); i++)
            {
                var noVacias = todas[i].Where(c => c != "").ToList();
                if (noVacias.Count >= 2 && noVacias.Count(c => !TryParseNumero(c, out _)) * 2 >= noVacias.Count) { hi = i; break; }
            }

            int ancho = todas.Count == 0 ? 0 : todas.Max(r => r.Length);
            encabezados = Enumerable.Range(0, ancho)
                .Select(c => c < todas[hi].Length ? todas[hi][c] : "")
                .ToArray();
            filasDatos = todas.Skip(hi + 1).ToList();
            primeraFilaDatosExcel = hi + 2;

            if (!filasDatos.Any(r => r.Any(c => c != "")))
            {
                errorArchivo = "No encontré filas con datos en el archivo.";
                return;
            }

            await BuscarImportacionPreviaAsync();
        }
        catch (Exception ex)
        {
            errorArchivo = "No se pudo leer el archivo: " + ex.Message;
            filasDatos = new();
        }
        finally
        {
            leyendo = false;
        }
    }

    private static List<string[]> LeerHoja(MemoryStream ms)
    {
        IExcelDataReader reader;
        try { reader = ExcelReaderFactory.CreateReader(ms); }
        catch
        {
            ms.Position = 0;
            reader = ExcelReaderFactory.CreateCsvReader(ms);
        }

        using (reader)
        {
            var filas = new List<string[]>();
            int conDatos = 0;
            int vaciasSeguidas = 0;

            while (reader.Read())
            {
                var celdas = new string[reader.FieldCount];
                bool alguna = false;
                for (int i = 0; i < celdas.Length; i++)
                {
                    celdas[i] = CeldaATexto(reader.GetValue(i));
                    if (celdas[i] != "") alguna = true;
                }
                filas.Add(celdas);

                // Excel suele guardar miles de filas vacías con formato: solo cuentan las que tienen datos
                if (alguna) { conDatos++; vaciasSeguidas = 0; }
                else if (++vaciasSeguidas > 300 && conDatos > 0) break;

                if (conDatos > MaxFilas)
                    throw new InvalidOperationException($"El archivo tiene más de {MaxFilas} filas con datos. Dividilo en partes.");
            }

            // se descartan las filas vacías del final
            while (filas.Count > 0 && filas[^1].All(c => c == "")) filas.RemoveAt(filas.Count - 1);
            return filas;
        }
    }

    private static string CeldaATexto(object? v)
    {
        switch (v)
        {
            case null: return "";
            case double d:
                // los códigos de barras vienen como número: sin notación científica ni ".0"
                if (Math.Abs(d) < 1e15 && Math.Abs(d - Math.Round(d)) < 1e-9) return ((long)Math.Round(d)).ToString(CultureInfo.InvariantCulture);
                return d.ToString("R", CultureInfo.InvariantCulture);
            case DateTime dt: return dt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            case bool b: return b ? "1" : "0";
            default: return Convert.ToString(v, CultureInfo.InvariantCulture)?.Trim() ?? "";
        }
    }

    private static string LimpiarCodigo(string? s)
    {
        var c = (s ?? "").Trim().TrimStart('\'');
        if (c.EndsWith(".0", StringComparison.Ordinal) && c[..^2].All(char.IsDigit)) c = c[..^2];
        return c;
    }

    /// <summary>Acepta 1234.56, 1.234,56, 1,234.56, "$ 850,00", "40%".</summary>
    private static bool TryParseNumero(string? raw, out decimal valor)
    {
        valor = 0m;
        if (string.IsNullOrWhiteSpace(raw)) return false;

        var s = new string(raw.Where(c => char.IsDigit(c) || c == ',' || c == '.' || c == '-').ToArray());
        if (s == "" || s == "-") return false;

        int ic = s.LastIndexOf(','), ip = s.LastIndexOf('.');
        if (ic >= 0 && ip >= 0)
        {
            if (ic > ip) s = s.Replace(".", "").Replace(',', '.');
            else s = s.Replace(",", "");
        }
        else if (ic >= 0)
        {
            s = s.IndexOf(',') != ic ? s.Replace(",", "") : s.Replace(',', '.');
        }
        else if (ip >= 0 && s.IndexOf('.') != ip)
        {
            s = s.Replace(".", "");   // varios puntos: separador de miles
        }

        return decimal.TryParse(s, NumberStyles.Number | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out valor);
    }

    private async Task BuscarImportacionPreviaAsync()
    {
        importacionPrevia = null;
        if (string.IsNullOrEmpty(hashArchivo)) return;

        try
        {
            long kiosco = State.KioscoId;
            var hash = hashArchivo;
            var res = await SupaClient.From<ImportacionExcel>()
                .Where(i => i.KioscoId == kiosco)
                .Where(i => i.HashArchivo == hash)
                .Select(ColumnasHistorial)
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(1)
                .Get();
            importacionPrevia = res.Models?.FirstOrDefault();
        }
        catch { /* es un aviso: si falla no frena la importación */ }
    }

    private async Task<Dictionary<string, string>?> MapeoRecordadoAsync()
    {
        if (proveedorId <= 0) return null;
        try
        {
            long kiosco = State.KioscoId;
            long prov = proveedorId;
            var t = tipo;
            var res = await SupaClient.From<ImportacionExcel>()
                .Where(i => i.KioscoId == kiosco)
                .Where(i => i.ProveedorId == prov)
                .Where(i => i.Tipo == t)
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(5)
                .Get();

            var json = res.Models?.FirstOrDefault(i => !string.IsNullOrWhiteSpace(i.Mapeo))?.Mapeo;
            return string.IsNullOrWhiteSpace(json) ? null : JsonSerializer.Deserialize<Dictionary<string, string>>(json);
        }
        catch { return null; }
    }

