    // ---------------------------------------------------------------- consultas de apoyo
    // Las consultas van en tandas de 150 y hasta 4 a la vez (antes: de a 100 y una detrás de otra).
    // Con internet lenta lo que más tarda es cada ida y vuelta, no la base.
    private const int TamTanda = 150;
    private const int TandasALaVez = 4;

    private async Task<List<Producto>> CargarProductosPorCodigosAsync(List<string> codigos)
    {
        long k = State.KioscoId;
        var tandas = codigos.Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().Chunk(TamTanda).ToList();
        return await EnParaleloAsync(tandas, async tanda =>
        {
            var criterio = tanda.Cast<object>().ToList();
            var res = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == k)
                .Filter(p => p.CodigoBarras, Supabase.Postgrest.Constants.Operator.In, criterio)
                .Get();
            return res.Models ?? new List<Producto>();
        });
    }

    private async Task<List<Producto>> CargarProductosPorIdsAsync(List<long> ids)
    {
        long k = State.KioscoId;
        var tandas = ids.Distinct().Chunk(TamTanda).ToList();
        return await EnParaleloAsync(tandas, async tanda =>
        {
            var criterio = tanda.Cast<object>().ToList();
            var res = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == k)
                .Filter(p => p.Id, Supabase.Postgrest.Constants.Operator.In, criterio)
                .Get();
            return res.Models ?? new List<Producto>();
        });
    }

    /// <summary>Corre las consultas de a varias a la vez y junta los resultados.</summary>
    private static async Task<List<T>> EnParaleloAsync<TIn, T>(List<TIn> tandas, Func<TIn, Task<List<T>>> consulta)
    {
        var lista = new List<T>();
        for (int i = 0; i < tandas.Count; i += TandasALaVez)
        {
            var grupo = tandas.Skip(i).Take(TandasALaVez).Select(consulta).ToList();
            foreach (var r in await Task.WhenAll(grupo)) lista.AddRange(r);
        }
        return lista;
    }

    /// <summary>Todas las relaciones de un proveedor, de a 1000 (la base devuelve como máximo esa cantidad por consulta).</summary>
    private async Task<List<ProductoProveedor>> RelacionesDeProveedorAsync(long prov)
    {
        var todas = new List<ProductoProveedor>();
        const int pagina = 1000;
        int desde = 0;
        while (true)
        {
            var res = await SupaClient.From<ProductoProveedor>()
                .Where(r => r.IdProveedor == prov)
                .Where(r => r.IdKiosco == State.KioscoId)
                .Range(desde, desde + pagina - 1)
                .Get();
            var lote = res.Models ?? new List<ProductoProveedor>();
            todas.AddRange(lote);
            if (lote.Count < pagina) break;
            desde += pagina;
        }
        return todas;
    }

    /// <summary>
    /// Subfamilia dentro de esa familia (la crea si no existe). Vacía en el Excel = sin subfamilia (null).
    /// </summary>
    private async Task<long?> ResolverSubfamiliaAsync(long familiaId, string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre) || familiaId <= 0 || sinTablaSubfamilias) return null;
        try
        {
            if (subfamiliasCache == null)
            {
                long k = State.KioscoId;
                subfamiliasCache = ((await SupaClient.From<Subfamilia>().Where(s => s.KioscoId == k).Get()).Models ?? new())
                    .GroupBy(s => s.FamiliaId + "|" + Clave(s.Nombre)).ToDictionary(g => g.Key, g => g.First().Id);
            }
            var n = nombre.Trim().ToUpper();
            var clave = familiaId + "|" + Clave(n);
            if (subfamiliasCache.TryGetValue(clave, out var id)) return id;

            var res = await SupaClient.From<Subfamilia>().Insert(new Subfamilia { KioscoId = State.KioscoId, FamiliaId = familiaId, Nombre = n });
            var creada = res.Models.FirstOrDefault() ?? throw new Exception($"No se pudo crear la subfamilia '{n}'.");
            subfamiliasCache[clave] = creada.Id;
            return creada.Id;
        }
        catch (Exception ex) when (ex.Message.Contains("subfamilias"))
        {
            sinTablaSubfamilias = true;   // falta el script 26
            return null;
        }
    }

    // ---------------------------------------------------------------- código de barras propio
    private readonly HashSet<string> codigosAsignados = new();

    /// <summary>
    /// Si el producto NO tiene código de barras propio, se le pone el código del Excel (casi seguro es el del mayorista,
    /// que es el mismo que trae el producto). Así no queda sin código aunque se hayan olvidado de elegir "Son los mismos".
    /// No se pone si otro producto del negocio ya usa ese código. Devuelve true si se lo puso.
    /// </summary>
    private async Task<bool> CompletarCodigoPropioAsync(Producto p, string? codigo)
    {
        var c = (codigo ?? "").Trim();
        if (!string.IsNullOrWhiteSpace(p.CodigoBarras) || c == "") return false;
        lock (codigosAsignados) { if (codigosAsignados.Contains(c)) return false; }
        try
        {
            long k = State.KioscoId, id = p.Id;
            var res = await SupaClient.From<Producto>().Select("id").Where(x => x.KioscoId == k).Where(x => x.CodigoBarras == c).Get();
            if ((res.Models ?? new()).Any(x => x.Id != id)) return false;   // ya lo usa otro producto
        }
        catch { return false; }
        lock (codigosAsignados) { if (!codigosAsignados.Add(c)) return false; }   // dos filas con el mismo código: solo la primera
        p.CodigoBarras = c;
        return true;
    }

    private async Task<long> ResolverFamiliaAsync(string? nombre)
    {
        familiasCache ??= (await SupaClient.From<Familia>().Where(f => f.KioscoId == State.KioscoId).Get())
            .Models.GroupBy(f => Clave(f.Nombre)).ToDictionary(g => g.Key, g => (long)g.First().Id);

        var n = string.IsNullOrWhiteSpace(nombre) ? "ARTICULOS" : nombre.Trim();
        var clave = Clave(n);
        if (familiasCache.TryGetValue(clave, out var id)) return id;

        var res = await SupaClient.From<Familia>().Insert(new Familia
        {
            Nombre = n.ToUpper(),
            Descripcion = n.ToUpper(),
            KioscoId = State.KioscoId,
            FechaCreacion = DateTime.Now
        });
        var creada = res.Models.FirstOrDefault() ?? throw new Exception($"No se pudo crear la familia '{n}'.");
        familiasCache[clave] = creada.Id;
        return creada.Id;
    }

    private async Task<long> ResolverProveedorAsync(string? nombre)
    {
        proveedoresCache ??= (await SupaClient.From<Proveedor>().Where(p => p.KioscoId == State.KioscoId).Get())
            .Models.GroupBy(p => Clave(p.Nombre)).ToDictionary(g => g.Key, g => (long)g.First().Id);

        var n = string.IsNullOrWhiteSpace(nombre) ? "SIN PROVEEDOR" : nombre.Trim();
        var clave = Clave(n);
        if (proveedoresCache.TryGetValue(clave, out var id)) return id;

        var res = await SupaClient.From<Proveedor>().Insert(new Proveedor { Nombre = n, KioscoId = State.KioscoId });
        var creado = res.Models.FirstOrDefault() ?? throw new Exception($"No se pudo crear el proveedor '{n}'.");
        proveedoresCache[clave] = (long)creado.Id;
        return (long)creado.Id;
    }

    private async Task<long> ProveedorDeFilaAsync(FilaImport f)
    {
        if (proveedorId > 0) return proveedorId;
        if (tipo == ImportacionTipo.Carga && !string.IsNullOrWhiteSpace(f.ProveedorTexto))
            return await ResolverProveedorAsync(f.ProveedorTexto);
        return 0;
    }

