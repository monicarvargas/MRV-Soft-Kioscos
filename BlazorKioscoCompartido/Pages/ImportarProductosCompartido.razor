    // ---------------------------------------------------------------- productos parecidos
    private static readonly HashSet<string> PalabrasVacias = new(StringComparer.OrdinalIgnoreCase)
        { "DE", "DEL", "LA", "EL", "LOS", "LAS", "CON", "SIN", "Y", "P", "PARA", "X", "EN", "A" };

    /// <summary>Palabras normalizadas del nombre: sin acentos, sin "X 100 UNID", "16 MM" → "16MM".</summary>
    private static List<string> Tokens(string? nombre)
    {
        var t = QuitarBultoDelNombre(nombre).ToUpperInvariant().Normalize(NormalizationForm.FormD);
        var sb = new StringBuilder(t.Length);
        foreach (var ch in t)
        {
            if (CharUnicodeInfo.GetUnicodeCategory(ch) == UnicodeCategory.NonSpacingMark) continue;
            sb.Append(char.IsLetterOrDigit(ch) || ch == '.' || ch == ',' ? ch : ' ');
        }
        var limpio = System.Text.RegularExpressions.Regex.Replace(sb.ToString(),
            @"(\d)\s+(MM|CM|MT|MTS|M|G|GR|GRS|KG|ML|CC|L|LT|LTS|W|V|A|PULG)\b", "$1$2");
        return limpio.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim('.', ','))
            .Where(x => x != "" && !PalabrasVacias.Contains(x))
            .Distinct()
            .ToList();
    }

    private static string ClaveParecido(List<string> tk) =>
        (tk.FirstOrDefault(x => !x.Any(char.IsDigit)) ?? "") + "|" + string.Join(",", tk.Where(x => x.Any(char.IsDigit)).OrderBy(x => x));

    private async Task BuscarParecidosAsync()
    {
        var candidatas = filas.Where(f => f.Estado == EstNuevo && !f.Procesada).ToList();
        foreach (var f in filas) f.Parecido = null;
        if (!candidatas.Any()) return;

        try
        {
            // todos los productos del negocio, pero SOLO id y nombre (antes bajaba todas las columnas: muy lento con internet lenta).
            // Se guardan mientras dure la importación: "Volver" y "Siguiente" otra vez no los baja de nuevo.
            if (nombresCache == null || nombresCacheKiosco != State.KioscoId)
            {
                var todosNombres = new List<Producto>();
                const int pagina = 1000;
                for (int desde = 0; ; desde += pagina)
                {
                    var res = await SupaClient.From<Producto>()
                        .Select("id,nombre")
                        .Where(p => p.KioscoId == State.KioscoId)
                        .Range(desde, desde + pagina - 1)
                        .Get();
                    var lote = res.Models ?? new List<Producto>();
                    todosNombres.AddRange(lote);
                    if (lote.Count < pagina) break;
                }
                nombresCache = todosNombres;
                nombresCacheKiosco = State.KioscoId;
            }
            var todos = nombresCache;

            // índice: primera palabra + números (16MM, 500ML...): los números tienen que coincidir exactos
            var indice = new Dictionary<string, List<(Producto p, List<string> tk)>>();
            foreach (var p in todos)
            {
                var tk = Tokens(p.Nombre);
                if (tk.Count == 0) continue;
                var k = ClaveParecido(tk);
                if (!indice.TryGetValue(k, out var l)) indice[k] = l = new();
                l.Add((p, tk));
            }

            foreach (var f in candidatas)
            {
                var tk = Tokens(f.Descripcion);
                if (tk.Count < 2) continue;
                if (!indice.TryGetValue(ClaveParecido(tk), out var lista)) continue;

                Producto? mejor = null;
                double mejorScore = 0, segundo = 0;
                foreach (var (p, tp) in lista)
                {
                    double inter = tk.Intersect(tp).Count();
                    double union = tk.Union(tp).Count();
                    double score = union == 0 ? 0 : inter / union;
                    if (score > mejorScore) { segundo = mejorScore; mejorScore = score; mejor = p; }
                    else if (score > segundo) segundo = score;
                }

                // bien parecido y sin empate con otro producto
                if (mejor != null && mejorScore >= 0.75 && mejorScore - segundo >= 0.1)
                    f.Parecido = mejor;
            }

            // los elegidos vinieron solo con id y nombre: se traen completos (precios, stock...) solo esos
            var idsParecidos = candidatas.Where(f => f.Parecido != null).Select(f => f.Parecido!.Id).Distinct().ToList();
            if (idsParecidos.Any())
            {
                var completos = (await CargarProductosPorIdsAsync(idsParecidos)).ToDictionary(p => p.Id);
                foreach (var f in candidatas.Where(f => f.Parecido != null))
                    f.Parecido = completos.TryGetValue(f.Parecido!.Id, out var pc) ? pc : null;
            }
        }
        catch
        {
            // es una ayuda: si falla, se sigue como antes
        }
    }

    // nombres de los productos del negocio para buscar parecidos (se bajan una vez por importación)
    private List<Producto>? nombresCache;
    private long nombresCacheKiosco;

    private int CntParecidos => filas.Count(f => f.Estado == EstNuevo && f.Parecido != null && !f.Procesada);

    /// <summary>La fila no es un producto nuevo: es el existente parecido. Se actualiza ese y se le asocia este proveedor con su código.</summary>
    private void UsarParecido(FilaImport f)
    {
        if (f.Parecido == null || f.Procesada) return;
        var p = f.Parecido;
        f.Parecido = null;
        f.Producto = p;
        f.Estado = EstExiste;
        f.Mensaje = "";
        f.CodigoProveedor = f.Codigo;          // el código del Excel queda como código de este proveedor
        Capturar(f);
        if (bultoPorProducto.TryGetValue(p.Id, out var nRel) && nRel > 1 && f.UnidadesBulto <= 1 && !p.EsVentaPorPeso())
        {
            AplicarBultoFila(f, nRel);
            f.BultoDeRelacion = true;
        }
        var avisosPrevios = f.Avisos.ToList();
        Validar(f);
        f.Avisos = avisosPrevios;
        f.Avisos.Remove(AvisoPorKilo);   // ya no es nuevo: se usa la unidad del producto que ya tenías
        if (!f.Avisos.Contains("Unido con un producto que ya tenías")) f.Avisos.Add("Unido con un producto que ya tenías");
        Recalcular(f);
    }

    private void DescartarParecido(FilaImport f) => f.Parecido = null;

    private void UsarTodosLosParecidos()
    {
        int n = 0;
        foreach (var f in filas.Where(x => x.Estado == EstNuevo && x.Parecido != null && !x.Procesada).ToList())
        {
            UsarParecido(f);
            n++;
