    // ---------------------------------------------------------------- confirmar
    private async Task ConfirmarAsync()
    {
        if (guardando) return;

        var aGuardar = filas.Where(f => f.Importable && f.Incluir && !f.Procesada).ToList();
        if (!aGuardar.Any())
        {
            await avisos.InformarAsync("No hay nada para importar", "Tildá al menos una fila.", "aviso");
            return;
        }

        int nuevos = aGuardar.Count(f => f.Estado == EstNuevo);
        int existentes = aGuardar.Count - nuevos;

        // los nuevos: confirmar qué es el código del Excel (se olvidan de elegirlo al principio)
        var nuevosACrear = aGuardar.Where(f => f.Estado == EstNuevo && f.Producto != null && f.Producto.Id == 0).ToList();
        if (nuevosACrear.Any())
        {
            if (!await PreguntarCodigoNuevosAsync(nuevosACrear)) return;
            AplicarCodigoNuevos(nuevosACrear);
        }
        int sinAsociar = filas.Count(f => f.Estado == EstSinAsociar);
        bool repetido = importacionPrevia != null;
        bool hayAlertas = repetido || CntAlertaCosto > 0 || sinAsociar > 0;

        var m = new StringBuilder();
        switch (tipo)
        {
            case ImportacionTipo.Factura:
                m.Append($"Se arma una compra con {aGuardar.Count} producto(s)");
                if (nuevos > 0) m.Append($" ({nuevos} nuevo(s) que se crean ahora)");
                m.Append(". El stock y los precios se actualizan cuando la confirmes en Recibir mercadería.");
                break;
            case ImportacionTipo.Precios:
                m.Append($"Se actualiza el costo de {existentes} producto(s)");
                if (nuevos > 0) m.Append($" y se crean {nuevos} producto(s) nuevo(s) con stock 0");
                m.Append(regla == ReglaCosto ? ". Los precios de venta no se tocan." : " y se recalculan sus precios de venta.");
                m.Append(" El stock no cambia.");
                break;
            default:
                m.Append($"Se actualizan {existentes} producto(s) y se crean {nuevos}.");
                if (mapa.TryGetValue("cantidad", out var ic) && ic >= 0)
                    m.Append(reemplazarStock ? " El stock se REEMPLAZA por el del archivo." : " El stock del archivo se SUMA al actual.");
                break;
        }
        if (repetido) m.Append($"\nATENCIÓN: este archivo ya se importó el {FechaLocal(importacionPrevia!):dd/MM/yyyy}.");
        if (CntAlertaCosto > 0) m.Append($"\n{CntAlertaCosto} producto(s) cambian su costo un 30% o más.");
        if (sinAsociar > 0) m.Append($"\n{sinAsociar} fila(s) sin asociar quedan afuera.");

        if (!await avisos.ConfirmarAsync("¿Confirmar la importación?", m.ToString(), TextoBotonConfirmar, hayAlertas ? "aviso" : "exito")) return;

        if (tipo == ImportacionTipo.Carga && reemplazarStock && aGuardar.Any(f => f.Estado == EstExiste && f.Cantidad.HasValue))
        {
            int n = aGuardar.Count(f => f.Estado == EstExiste && f.Cantidad.HasValue);
            if (!await avisos.ConfirmarAsync("Vas a reemplazar el stock",
                    $"El stock actual de {n} producto(s) se va a pisar con el valor del archivo. Esto no se puede deshacer. ¿Seguro?",
                    "Sí, reemplazar", "peligro")) return;
        }

        if (tipo == ImportacionTipo.Factura) await GuardarFacturaAsync(aGuardar);
        else await GuardarActualizacionAsync(aGuardar);
    }

    /// <summary>
    /// La fila viene por bulto (el usuario indicó "x N u."): el producto guarda el precio del bulto y cuántas unidades trae,
    /// igual que "Lo compro por bulto" en el producto (script 32). Así después se ve si el bulto aumentó.
    /// </summary>
    private static bool MarcarBulto(FilaImport f)
    {
        var p = f.Producto;
        if (p == null || f.UnidadesBulto <= 1 || (f.CostoExcel ?? 0m) <= 0m || p.EsVentaPorPeso()) return false;
        p.BultoPrecio = Math.Round(f.CostoExcel!.Value, 2);
        p.BultoUnidades = f.UnidadesBulto;
        p.BultoFecha = DateTime.UtcNow;
        return true;
    }

    /// <summary>Para los que ya existían y no se guardan enteros (factura): actualiza solo los datos del bulto.</summary>
    private async Task GuardarBultoAsync(FilaImport f)
    {
        if (f.Producto == null || f.Producto.Id <= 0 || !MarcarBulto(f)) return;
        var p = f.Producto;
        long idP = p.Id;
        try
        {
            await SupaClient.From<Producto>().Where(x => x.Id == idP)
                .Set(x => x.BultoPrecio!, p.BultoPrecio)
                .Set(x => x.BultoUnidades!, p.BultoUnidades)
                .Set(x => x.BultoFecha!, p.BultoFecha)
                .Update();
        }
        catch { /* sin el script 32 no hay dónde guardarlo: no frena la importación */ }
    }

