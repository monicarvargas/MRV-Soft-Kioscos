    private Task<bool> PreguntarCodigoNuevosAsync(List<FilaImport> nuevos)
    {
        codigoNuevos = codigosIguales ? CodIguales : codigosDelProveedor ? CodProv : CodMio;   // lo que eligió al principio
        if (proveedorId <= 0 && codigoNuevos != CodMio) codigoNuevos = CodMio;
        cntNuevosCodigo = nuevos.Count;
        ejemploCodigo = nuevos.Select(f => f.Codigo).FirstOrDefault(c => !string.IsNullOrWhiteSpace(c));
        preguntaCodigo = new TaskCompletionSource<bool>();
        StateHasChanged();
        return preguntaCodigo.Task;
    }

    private void ResponderCodigo(bool ok)
    {
        var t = preguntaCodigo;
        preguntaCodigo = null;
        t?.TrySetResult(ok);
    }

    /// <summary>Deja cada fila nueva con el código propio y el del proveedor según lo que se confirmó.</summary>
    private void AplicarCodigoNuevos(List<FilaImport> nuevos)
    {
        foreach (var f in nuevos)
        {
            var p = f.Producto!;
            var c = string.IsNullOrWhiteSpace(f.Codigo) ? null : f.Codigo.Trim();
            switch (codigoNuevos)
            {
                case CodProv:    p.CodigoBarras = null; f.CodigoProveedor = c; break;
                case CodIguales: p.CodigoBarras = c;    f.CodigoProveedor = c; break;
                case CodGenerar: p.CodigoBarras = null; f.CodigoProveedor = proveedorId > 0 ? c : null; break;
                default:         p.CodigoBarras = c;    f.CodigoProveedor = null; break;
            }
        }
    }

    /// <summary>Código propio nuevo (29…) que no use otro producto ni otra fila de esta importación.</summary>
    private async Task<string> GenerarCodigoUnicoAsync()
    {
        for (int i = 0; i < 10; i++)
        {
            var cod = await BlazorKioscoCompartido.Services.CodigoBarras.CrearCodigoPropioAsync(SupaClient, State.KioscoId);
            lock (codigosAsignados) { if (codigosAsignados.Add(cod)) return cod; }
        }
        throw new Exception("No se pudo crear un código nuevo. Probá de nuevo.");
    }

    private async Task InsertarProductoNuevoAsync(FilaImport f, int stockInicial)
    {
        var p = f.Producto!;
        p.KioscoId = State.KioscoId;
        p.Nombre = string.IsNullOrWhiteSpace(f.NombreSistema) ? f.Descripcion.Trim() : f.NombreSistema.Trim();
        if (string.IsNullOrWhiteSpace(p.UnidadMedida)) p.UnidadMedida = UnidadSegunDescripcion(f.Descripcion);   // la que se eligió en la fila
        p.Activo = true;
        p.StockActual = stockInicial;
        p.FamiliaId = await ResolverFamiliaAsync(FamiliaDeFila(f));
        p.SubfamiliaId = await ResolverSubfamiliaAsync(p.FamiliaId ?? 0, f.Subfamilia);
        p.ProveedorId = proveedorId > 0 ? proveedorId : await ResolverProveedorAsync(f.ProveedorTexto);
        if (codigoNuevos == CodGenerar) p.CodigoBarras = await GenerarCodigoUnicoAsync();
        else if (codigoNuevos != CodProv) await CompletarCodigoPropioAsync(p, f.Codigo);   // sin código propio: queda el del Excel
        MarcarBulto(f);

        var res = await SupaClient.From<Producto>().Insert(p);
        f.Producto = res.Models.FirstOrDefault() ?? throw new Exception("No se pudo recuperar el producto creado.");
    }

    // ---------------------------------------------------------------- guardar de a varios
    // Con internet lenta, guardar fila por fila (1 ida y vuelta cada una) tardaba minutos con un Excel largo.
    private const int FilasALaVez = 6;

    /// <summary>Corre la acción para cada fila, de a varias a la vez, y refresca el "Guardando... X de Y".</summary>
    private async Task DeAVariosAsync(List<FilaImport> lista, Func<FilaImport, Task> accion)
    {
        for (int i = 0; i < lista.Count; i += FilasALaVez)
        {
            await Task.WhenAll(lista.Skip(i).Take(FilasALaVez).Select(accion));
            StateHasChanged();
            await Task.Yield();
        }
    }

    /// <summary>
    /// Crea ANTES (una por una) las familias y proveedores nuevos que van a hacer falta.
    /// Así, al guardar varias filas a la vez, no se crea dos veces la misma familia o proveedor.
    /// </summary>
    private async Task PrepararFamiliasYProveedoresAsync(List<FilaImport> lista)
    {
        var familias = lista.Where(f => f.Estado == EstNuevo).Select(FamiliaDeFila)
                            .Concat(lista.Where(f => tipo == ImportacionTipo.Carga && f.Estado != EstNuevo && !string.IsNullOrWhiteSpace(f.Familia)).Select(f => f.Familia))
                            .Distinct().ToList();
        foreach (var fam in familias) await ResolverFamiliaAsync(fam);

        // subfamilias (también una por una, antes, para no crear la misma dos veces)
        var subs = lista.Where(f => !string.IsNullOrWhiteSpace(f.Subfamilia)
                                    && (f.Estado == EstNuevo || (tipo == ImportacionTipo.Carga && !string.IsNullOrWhiteSpace(f.Familia))))
                        .Select(f => (Fam: f.Estado == EstNuevo ? FamiliaDeFila(f) : f.Familia, Sub: f.Subfamilia))
                        .Distinct().ToList();
        foreach (var (fam, sub) in subs) await ResolverSubfamiliaAsync(await ResolverFamiliaAsync(fam), sub);

        if (proveedorId > 0) return;
        var proveedores = lista.Where(f => f.Estado == EstNuevo || (tipo == ImportacionTipo.Carga && !string.IsNullOrWhiteSpace(f.ProveedorTexto)))
                               .Select(f => f.ProveedorTexto).Distinct().ToList();
        foreach (var prov in proveedores) await ResolverProveedorAsync(prov);
    }

    private async Task GuardarFacturaAsync(List<FilaImport> aGuardar)
    {
        guardando = true;
        progreso = 0;
        progresoTotal = aGuardar.Count;
        resMensajes = new();
        resErrores = 0;
        CompraMayorista? cabecera = null;

        try
        {
            // 1. productos nuevos (entran con stock 0: el stock llega al confirmar la compra) — de a varios a la vez
            var nuevosFactura = aGuardar.Where(x => x.Estado == EstNuevo && x.Producto!.Id == 0).ToList();
            await PrepararFamiliasYProveedoresAsync(nuevosFactura);
            await DeAVariosAsync(nuevosFactura, async f =>
            {
                await InsertarProductoNuevoAsync(f, 0);
                resCreados++;
                progreso++;
            });

            // 1b. los que ya existían pero no tienen código de barras propio: queda el del Excel
            foreach (var f in aGuardar.Where(x => x.Estado != EstNuevo && x.Producto != null && x.Producto.Id > 0 && string.IsNullOrWhiteSpace(x.Producto.CodigoBarras)))
            {
                var p = f.Producto!;
                if (await CompletarCodigoPropioAsync(p, f.Codigo))
                {
                    long idP = p.Id;
                    string cod = p.CodigoBarras!;
                    try { await SupaClient.From<Producto>().Where(x => x.Id == idP).Set(x => x.CodigoBarras!, cod).Update(); }
                    catch { p.CodigoBarras = null; }
                }
            }

            // 1c. los que ya existían y vienen por bulto: guardan el precio del bulto y cuántas unidades trae
            await DeAVariosAsync(aGuardar.Where(x => x.Estado != EstNuevo && x.UnidadesBulto > 1).ToList(), GuardarBultoAsync);

            // 2. cabecera
            var nro = numeroComprobante?.Trim();
            decimal total = aGuardar.Sum(SubtotalFila);
            cabecera = new CompraMayorista
            {
                KioscoId = State.KioscoId,
                Fecha = DateTime.UtcNow,
                Origen = CompraOrigen.Excel,
                Estado = CompraEstado.Cerrada,
                Procesado = false,
                ProveedorId = proveedorId > 0 ? proveedorId : (long?)null,
                NumeroComprobante = string.IsNullOrEmpty(nro) ? null : nro,
                FechaCompra = fechaCompra,
                TotalBoleta = totalBoleta.HasValue && totalBoleta.Value > 0m ? totalBoleta : null,
                TotalCompra = total,
                Observaciones = "Importada desde Excel: " + nombreArchivo
            };
            var resCab = await SupaClient.From<CompraMayorista>().Insert(cabecera);
            cabecera = resCab.Models.First();

            // 3. renglones
            var detalles = aGuardar.Select(f => new CompraMayoristaDetalle
            {
                CompraId = cabecera.Id,
                ProductoId = f.Producto!.Id,
                CodigoBarras = f.Producto.CodigoBarras,
                NombreProducto = f.Producto.Nombre ?? f.Descripcion,
                PrecioCosto = f.Costo ?? 0m,
                Cantidad = Cant(f),
                Subtotal = SubtotalFila(f),
                EsNuevo = f.Estado == EstNuevo,
                Procesado = false,
                CodigoBarrasProveedor = string.IsNullOrWhiteSpace(f.CodigoProveedor) ? null : f.CodigoProveedor,
                CostoAnterior = f.OrigCosto,
                UnidadesPorBulto = f.UnidadesBulto > 1 ? f.UnidadesBulto : 1
            }).ToList();

            try
            {
                await SupaClient.From<CompraMayoristaDetalle>().Insert(detalles);
            }
            catch
            {
                // sin renglones no tiene sentido dejar la cabecera
                try { var idc = cabecera.Id; await SupaClient.From<CompraMayorista>().Where(c => c.Id == idc).Delete(); } catch { }
                throw;
            }

            foreach (var f in aGuardar) f.Procesada = true;
            resActualizados += aGuardar.Count;
            resCompraId = cabecera.Id;

            // el proveedor queda vinculado ya mismo con su código, su descripción y el bulto
            if (proveedorId > 0)
                await AsociarProveedoresAsync(aGuardar
                    .Select(f => (f.Producto!.Id, proveedorId, string.IsNullOrWhiteSpace(f.CodigoProveedor) ? (string?)null : f.CodigoProveedor,
                                  f.UnidadesBulto, DescripcionProveedorDe(f)))
                    .ToList());
            await RegistrarHistorialAsync(cabecera.Id);
            paso = 4;
            nombresCache = null;   // se crearon/cambiaron productos: la próxima búsqueda de parecidos los baja de nuevo
        }
        catch (Exception ex)
        {
            resErrores++;
            await avisos.InformarAsync("No se pudo armar la compra",
                ex.Message + (resCreados > 0 ? $"\n\nLos {resCreados} producto(s) nuevos ya se crearon; al reintentar no se duplican." : ""), "peligro");
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task GuardarActualizacionAsync(List<FilaImport> aGuardar)
    {
        guardando = true;
        progreso = 0;
        progresoTotal = aGuardar.Count;

        var paraAsociar = new List<(long productoId, long provId, string? codigo, int bulto, string? descripcion)>();
        int erroresAhora = 0;

        try
        {
            await PrepararFamiliasYProveedoresAsync(aGuardar);

            // cada fila es independiente: se guardan de a varias a la vez (antes, una por una)
            await DeAVariosAsync(aGuardar, async f =>
            {
                f.ErrorGuardado = null;
                try
                {
                    bool hayStock = tipo == ImportacionTipo.Carga && f.Cantidad.HasValue;

                    if (f.Estado == EstNuevo)
                    {
                        await InsertarProductoNuevoAsync(f, hayStock ? Cant(f) : 0);
                        resCreados++;
                    }
                    else
                    {
                        var p = f.Producto!;
                        bool limpiarSub = false;
                        await CompletarCodigoPropioAsync(p, f.Codigo);   // si no tenía código propio, queda el del Excel
                        if (hayStock) p.StockActual = reemplazarStock ? Cant(f) : (p.StockActual ?? 0) + Cant(f);
                        if (tipo == ImportacionTipo.Carga)
                        {
                            if (!string.IsNullOrWhiteSpace(f.Familia))
                            {
                                long famAntes = p.FamiliaId ?? 0;
                                p.FamiliaId = await ResolverFamiliaAsync(f.Familia);
                                var sub = await ResolverSubfamiliaAsync(p.FamiliaId ?? 0, f.Subfamilia);
                                if (sub != null) p.SubfamiliaId = sub;
                                // cambió de familia y el Excel no trae subfamilia: la subfamilia vieja ya no corresponde
                                else if (famAntes != p.FamiliaId && p.SubfamiliaId != null) { p.SubfamiliaId = null; limpiarSub = true; }
                            }
                            p.Activo = true;
                        }
                        MarcarBulto(f);
                        await SupaClient.From<Producto>().Update(p);
                        if (limpiarSub)
                        {
                            long idP = p.Id;
                            await SupaClient.From<Producto>().Where(x => x.Id == idP).Set(x => x.SubfamiliaId!, (object?)null).Update();
                        }
                        resActualizados++;
                    }

                    f.Procesada = true;

                    long prov = await ProveedorDeFilaAsync(f);
                    if (prov > 0) paraAsociar.Add((f.Producto!.Id, prov, string.IsNullOrWhiteSpace(f.CodigoProveedor) ? null : f.CodigoProveedor, f.UnidadesBulto, DescripcionProveedorDe(f)));
                }
                catch (Exception ex)
                {
                    f.ErrorGuardado = ex.Message;
                    erroresAhora++;
                    resMensajes.Add($"Fila {f.NumeroFila} ({f.Codigo}): {ex.Message}");
                }

                progreso++;
            });

            resErrores = filas.Count(f => !string.IsNullOrEmpty(f.ErrorGuardado));
            await AsociarProveedoresAsync(paraAsociar);
            await RegistrarHistorialAsync(null);
            paso = 4;
            nombresCache = null;   // se crearon/cambiaron productos: la próxima búsqueda de parecidos los baja de nuevo
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("La importación se interrumpió",
                $"Se guardaron {aGuardar.Count(f => f.Procesada)} producto(s) y quedaron marcados como \"Guardado\". Podés volver a confirmar: solo se procesan los que faltan.\n\nDetalle: {ex.Message}", "peligro");
        }
        finally
        {
            guardando = false;
        }
    }

    /// <summary>Vincula cada producto con su proveedor y guarda el código que usa el proveedor (sin pisar uno existente).</summary>
    private static string? DescripcionProveedorDe(FilaImport f) =>
        string.IsNullOrWhiteSpace(f.Descripcion) ? null : f.Descripcion.Trim();

    private async Task AsociarProveedoresAsync(List<(long productoId, long provId, string? codigo, int bulto, string? descripcion)> lista)
    {
        if (!lista.Any()) return;

        try
        {
            foreach (var grupo in lista.GroupBy(x => x.provId))
            {
                long prov = grupo.Key;
                var existentes = (await RelacionesDeProveedorAsync(prov))
                    .GroupBy(r => r.IdProducto)
                    .ToDictionary(g => g.Key, g => g.First());

                var nuevas = new List<ProductoProveedor>();
                foreach (var x in grupo.GroupBy(g => g.productoId).Select(g => g.First()))
                {
                    if (!existentes.TryGetValue(x.productoId, out var rel))
                    {
                        nuevas.Add(new ProductoProveedor
                        {
                            IdProducto = x.productoId,
                            IdProveedor = prov,
                            IdKiosco = State.KioscoId,
                            CodigoBarrasProveedor = x.codigo,
                            Habilitado = true,
                            UnidadesPorBulto = x.bulto > 1 ? x.bulto : 1,
                            DescripcionProveedor = x.descripcion
                        });
                        continue;
                    }

                    // cómo lo llama el proveedor: se guarda o se actualiza si cambió
                    if (x.descripcion != null && !string.Equals(rel.DescripcionProveedor?.Trim(), x.descripcion, StringComparison.Ordinal))
                    {
                        long pidD = x.productoId;
                        string desc = x.descripcion;
                        await SupaClient.From<ProductoProveedor>()
                            .Where(r => r.IdProveedor == prov)
                            .Where(r => r.IdProducto == pidD)
                            .Where(r => r.IdKiosco == State.KioscoId)
                            .Set(r => r.DescripcionProveedor, desc)
                            .Update();
                    }

                    // se importó por bulto: se recuerda cuánto trae el bulto de este proveedor
                    if (x.bulto > 1 && rel.UnidadesPorBulto != x.bulto)
                    {
                        long pidB = x.productoId;
                        int nb = x.bulto;
                        await SupaClient.From<ProductoProveedor>()
                            .Where(r => r.IdProveedor == prov)
                            .Where(r => r.IdProducto == pidB)
                            .Where(r => r.IdKiosco == State.KioscoId)
                            .Set(r => r.UnidadesPorBulto, nb)
                            .Update();
                    }

                    if (x.codigo != null && string.IsNullOrWhiteSpace(rel.CodigoBarrasProveedor))
                    {
                        long pid = x.productoId;
                        string cod = x.codigo;
                        await SupaClient.From<ProductoProveedor>()
                            .Where(r => r.IdProveedor == prov)
                            .Where(r => r.IdProducto == pid)
                            .Where(r => r.IdKiosco == State.KioscoId)
                            .Set(r => r.CodigoBarrasProveedor, cod)
                            .Update();
                    }
                }

                if (nuevas.Any()) await SupaClient.From<ProductoProveedor>().Insert(nuevas);
            }
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("Los productos se guardaron", "No se pudo asociar el proveedor a los productos: " + ex.Message, "aviso");
        }
    }

    // ---------------------------------------------------------------- historial
    private async Task RegistrarHistorialAsync(long? compraId)
    {
        try
        {
            var mapeo = mapa
                .Where(kv => kv.Value >= 0 && kv.Value < encabezados.Length && encabezados[kv.Value] != "")
                .ToDictionary(kv => kv.Key, kv => encabezados[kv.Value]);

            int omitidos = filas.Count(f => !f.Procesada && string.IsNullOrEmpty(f.ErrorGuardado));
            string estado = resErrores > 0 ? "parcial" : "ok";
            string detalleJson = ArmarDetalleHistorial();
            string? obs = resMensajes.Any() ? string.Join("\n", resMensajes.Take(20)) : null;

            if (importacionActual == null)
            {
                importacionActual = new ImportacionExcel
                {
                    KioscoId = State.KioscoId,
                    Fecha = DateTime.UtcNow,
                    NombreArchivo = nombreArchivo ?? "archivo",
                    HashArchivo = hashArchivo,
                    Tipo = tipo,
                    ProveedorId = proveedorId > 0 ? proveedorId : (long?)null,
                    FilasTotal = filas.Count,
                    Creados = resCreados,
                    Actualizados = resActualizados,
                    Omitidos = omitidos,
                    Errores = resErrores,
                    StockModo = tipo == ImportacionTipo.Carga && mapa.TryGetValue("cantidad", out var ic) && ic >= 0 ? (reemplazarStock ? "reemplaza" : "suma") : null,
                    ReglaPrecios = tipo == ImportacionTipo.Factura ? null : regla switch { ReglaCosto => "costo", ReglaExcel => "excel", _ => "recalcular" },
                    CompraId = compraId,
                    Mapeo = JsonSerializer.Serialize(mapeo),
                    Estado = estado,
                    Observaciones = obs,
                    Detalle = detalleJson
                };
                var res = await SupaClient.From<ImportacionExcel>().Insert(importacionActual);
                importacionActual = res.Models.FirstOrDefault() ?? importacionActual;
            }
            else
            {
                importacionActual.Creados = resCreados;
                importacionActual.Actualizados = resActualizados;
                importacionActual.Omitidos = omitidos;
                importacionActual.Errores = resErrores;
                importacionActual.Estado = estado;
                importacionActual.Observaciones = obs;
                importacionActual.Detalle = detalleJson;
                await SupaClient.From<ImportacionExcel>().Update(importacionActual);
            }
        }
        catch (Exception ex)
        {
            avisos.Toast("Se guardó, pero no se pudo registrar en el historial: " + ex.Message, "aviso", 5000);
        }
    }

    private async Task CargarHistorialAsync()
    {
        try
        {
            cargandoHistorial = true;
            await CargarDesfaseHorarioAsync();
            long kiosco = State.KioscoId;
            var res = await SupaClient.From<ImportacionExcel>()
                .Select(ColumnasHistorial)
                .Where(i => i.KioscoId == kiosco)
                .Order("fecha", Supabase.Postgrest.Constants.Ordering.Descending)
                .Limit(100)
                .Get();
            historial = res.Models ?? new List<ImportacionExcel>();

            comprasDeImportaciones = new();
            var ids = historial.Where(h => h.CompraId.HasValue).Select(h => (object)h.CompraId!.Value).Distinct().ToList();
            if (ids.Any())
            {
                var rc = await SupaClient.From<CompraMayorista>()
                    .Where(c => c.KioscoId == kiosco)
                    .Filter(c => c.Id, Supabase.Postgrest.Constants.Operator.In, ids)
                    .Get();
                comprasDeImportaciones = (rc.Models ?? new List<CompraMayorista>()).ToDictionary(c => c.Id);
            }
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo cargar el historial", ex.Message, "peligro");
        }
        finally
        {
            cargandoHistorial = false;
        }
    }

    // ---------------------------------------------------------------- hora local
    // La fecha se lee también como texto (fecha_txt) y se pasa a la hora del equipo con el desfase del navegador:
    // leída como DateTime venía corrida 3 horas (mismo problema que tenía la hora de las ventas).
    private int? minutosUtc;

    private async Task CargarDesfaseHorarioAsync()
    {
        if (minutosUtc.HasValue) return;
        try { minutosUtc = await JSRuntime.InvokeAsync<int>("eval", "new Date().getTimezoneOffset()"); }
        catch { minutosUtc = 180; }   // Argentina (UTC-3)
    }

    private DateTime FechaLocal(ImportacionExcel i)
    {
        var t = i.FechaTexto?.Trim().Replace(' ', 'T');
        if (!string.IsNullOrEmpty(t))
        {
            if (System.Text.RegularExpressions.Regex.IsMatch(t, @"[+-]\d{2}$")) t += ":00";   // "+00" → "+00:00"
            if (DateTimeOffset.TryParse(t, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeUniversal, out var dto))
                return dto.UtcDateTime.AddMinutes(-(minutosUtc ?? 180));
        }
        return i.Fecha.ToLocalTime();
    }

