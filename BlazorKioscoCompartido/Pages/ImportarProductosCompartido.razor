@using Microsoft.AspNetCore.Components.Forms
@using System.IO

@using System.Data
@using ExcelDataReader
@* Agregá acá tus injects de servicios si los necesitás (ej. Supabase, Servicios de Productos, etc.) *@
@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State
@inject ConsultasDB Consultas

<div class="importar-container mt-3 px-3">
    @* --- ENCABEZADO --- *@
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-link text-dark p-0 me-3" @onclick="Volver">
            <i class="bi bi-arrow-left fs-4"></i>
        </button>
        <div>
            <h3 class="mb-1 fw-bold text-dark">Importar productos desde Excel</h3>
            <p class="text-muted small mb-0">Subí un archivo Excel para masificar o actualizar el stock del sistema.</p>
        </div>
    </div>

    @* --- PASOS DEL PROCESO (Stepper) --- *@
    <div class="row justify-content-center mb-4 text-center g-0 position-relative target-ancho-maximo">
        <div class="col-4 position-relative">
            <div class="step-circle @(pasoActual >= 1 ? "step-active" : "step-inactive") mx-auto">1</div>
            <span class="small fw-bold d-block mt-2 @(pasoActual == 1 ? "text-primary" : "text-muted")">Seleccionar archivo</span>
        </div>
        <div class="col-4 position-relative">
            <div class="step-circle @(pasoActual >= 2 ? "step-active" : "step-inactive") mx-auto">2</div>
            <span class="small fw-bold d-block mt-2 @(pasoActual == 2 ? "text-primary" : "text-muted")">Vista previa</span>
        </div>
        <div class="col-4 position-relative">
            <div class="step-circle @(pasoActual >= 3 ? "step-active" : "step-inactive") mx-auto">3</div>
            <span class="small fw-bold d-block mt-2 @(pasoActual == 3 ? "text-primary" : "text-muted")">Importar</span>
        </div>
    </div>

    <div class="target-ancho-maximo mx-auto">
        @* === PASO 1: SELECCIONAR ARCHIVO === *@
        @if (pasoActual == 1)
        {
            <div class="card shadow-sm border-0 rounded-4 p-3 text-center mb-4 bg-white zone-drop-container">
                <div class="py-2 structure-dropzone position-relative">
                    <div class="excel-icon-wrapper mb-2">
                        <i class="bi bi-file-earmark-excel-fill text-success fs-1"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-1">Seleccioná un archivo Excel</h6>
                    <p class="text-muted small mb-2">Arrastrá y soltá el archivo aquí o hacé clic para buscar</p>

                    @* Input nativo de Blazor oculto *@
                    <InputFile OnChange="ProcesarArchivoSeleccionado" accept=".xlsx, .xls" class="input-file-overlay" />

                    <button class="btn btn-primary btn-sm px-4 py-1.5 rounded-3 fw-bold shadow-sm">
                        <i class="bi bi-upload me-2"></i> Seleccionar archivo
                    </button>

                    <div class="text-muted xsmall-font mt-2">
                        Formatos permitidos: <strong>.xlsx, .xls</strong> | Máx: 10 MB
                    </div>
                </div>
            </div>

            @* NOMBRE DEL ARCHIVO SELECCIONADO *@
            @if (!string.IsNullOrEmpty(nombreArchivo))
            {
                <div class="alert alert-success d-flex align-items-center justify-content-between rounded-3 border-0 shadow-sm mb-4 animate__animated animate__fadeIn">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                        <span class="small fw-bold">@nombreArchivo</span>
                    </div>
                    <button class="btn btn-sm text-danger p-0" @onclick="LimpiarArchivo"><i class="bi bi-x-lg"></i></button>
                </div>
            }

            @* REQUISITOS DE FORMATO (Formato Requerido) *@
            <div class="card shadow-sm border-0 rounded-4 p-4 bg-white mb-4">
                <h6 class="fw-bold text-dark mb-3 d-flex align-items-center">
                    <i class="bi bi-info-circle text-primary me-2"></i> Formato requerido
                </h6>
                <div class="table-responsive rounded-3 border border-light">
                    <table class="table table-sm table-striped mb-0 text-center align-middle xsmall-font">
                        <thead class="bg-table-header text-white">
                            <tr>
                                <th class="py-2">CODIGO*</th>
                                <th class="py-2">DESCRIPCION*</th>
                                <th class="py-2">STOCK</th>
                                <th class="py-2">P. COSTO</th>
                                <th class="py-2">P. VENTA</th>
                                <th class="py-2">P. LISTA2</th>
                                <th class="py-2">P. LISTA3</th>
                                <th class="py-2">FAMILIA</th>
                                <th class="py-2">PROVEEDOR</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-success fw-bold">7790895001234</td>
                                <td class="text-uppercase">GASEO COCA COLA 500ML</td>
                                <td>10</td>
                                <td>850.00</td>
                                <td>1200.00</td>
                                <td>1250.00</td>
                                <td>1300.00</td>
                                <td>Gaseosas</td>
                                <td>Proveedor SA</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <span class="text-muted xsmall-font mt-2">* Columnas obligatorias</span>
            </div>

            @* NOTAS IMPORTANTES *@
            <div class="card border-0 rounded-4 p-3 bg-warning-light shadow-sm mb-4">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                    <div>
                        <h6 class="fw-bold text-warning-dark mb-1 small">Importante</h6>
                        <ul class="mb-0 text-muted xsmall-font ps-3">
                            <li>Los productos con código existente serán **actualizados** automáticamente.</li>
                            <li>Los productos nuevos serán **agregados** de forma limpia al sistema.</li>
                        </ul>
                    </div>
                </div>
            </div>
        }

        @* === PASO 2: VISTA PREVIA === *@
        @if (pasoActual == 2)
        {
            <div class="alert alert-info border-0 shadow-sm rounded-3 d-flex align-items-center small py-2 mb-3 bg-warning-light text-warning-dark">
                <i class="bi bi-info-circle-fill fs-5 me-2 text-warning"></i>
                <div>
                    Se detectaron <strong>@productosPreview.Count</strong> productos en el archivo. Revisá que la información sea correcta antes de confirmar.
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
                <div class="table-responsive dynamic-preview-scroll">
                    <table class="table table-hover align-middle mb-0 small text-nowrap">
                        <thead class="bg-table-header text-white sticky-top">
                            <tr>
                                <th>CODIGO</th>
                                <th>DESCRIPCION</th>
                                <th class="text-center">STOCK</th>
                                <th class="text-end">P. COSTO</th>
                                <th class="text-end">P. VENTA</th>
                                <th class="text-end">P. LISTA2</th>
                                <th class="text-end">P. LISTA3</th>
                                <th>FAMILIA</th>
                                <th>PROVEEDOR</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in productosPreview)
                            {
                                <tr class="@(prod.TieneError ? "table-danger" : "")">
                                    <td>
                                        @if (prod.TieneError)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-1" title="@prod.MensajeError"></i>
                                        }
                                        <span class="fw-bold">@prod.Codigo</span>
                                    </td>

                                    <td>@prod.Descripcion</td>
                                    <td class="text-center">
                                        <span class="badge @(prod.Stock > 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") px-2">
                                            @prod.Stock
                                        </span>
                                    </td>
                                    <td class="text-end fw-semibold text-secondary">$ @prod.PrecioCosto.ToString("N2")</td>
                                    <td class="text-end fw-bold text-primary">$ @prod.PrecioVenta.ToString("N2")</td>
                                    <td class="text-end fw-bold text-primary">$ @prod.PrecioLista2.ToString("N2")</td>
                                    <td class="text-end fw-bold text-primary">$ @prod.PrecioLista3.ToString("N2")</td>
                                    <td><span class="badge bg-light text-dark border">@prod.Familia</span></td>
                                    <td><span class="text-muted">@prod.Proveedor</span></td>
                                    <td><small class="text-muted font-monospace">@prod.Codigo</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* === PASO 3: ÉXITO / FINALIZACIÓN === *@
        @if (pasoActual == 3)
        {
            <div class="card shadow-sm border-0 rounded-4 p-5 text-center bg-white mb-4 animate__animated animate__zoomIn">
                <div class="success-checkmarkmb-3">
                    <i class="bi bi-check-circle-fill text-success display-1"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">¡Importación Exitosa!</h4>
                <p class="text-muted small mb-4">Los productos se procesaron y guardaron correctamente en la base de datos.</p>
                <button class="btn btn-outline-primary px-4 py-2 rounded-3 fw-bold" @onclick="ReiniciarProceso">
                    Cargar otro archivo
                </button>
            </div>
        }

        @* --- BARRA ACCIONES INFERIOR FIJA / ADAPTABLE --- *@
        @if (pasoActual < 3)
        {
            <div class="fixed-bottom bg-white border-top shadow-lg p-3 seccion-acciones-importar">
                <div class="d-flex justify-content-between align-items-center gap-3 contenedor-ancho-maximo-boton">
                    <button class="btn btn-light btn-lg flex-grow-1 py-2 rounded-3 fw-bold border text-muted"
                            style="font-size: 0.95rem;"
                            @onclick="Cancelar">
                        Cancelar
                    </button>

                    @if (pasoActual == 1)
                    {
                        <button class="btn btn-success btn-lg flex-grow-1 py-2 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 shadow"
                                style="background-color: #4CAF50; border: none; font-size: 0.95rem;"
                                disabled="@(string.IsNullOrEmpty(nombreArchivo))"
                                @onclick="() => pasoActual = 2">
                            <span>Ver vista previa</span>
                            <i class="bi bi-arrow-right-circle-fill"></i>
                        </button>
                    }
                    @* @if (pasoActual == 2)
                    {
                        <button class="btn btn-success btn-lg flex-grow-1 py-2 fw-bold rounded-3 d-flex align-items-center justify-content-center gap-2 shadow"
                                style="background-color: #4CAF50; border: none; font-size: 0.95rem;"
                                @onclick="EjecutarImportacionBD">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                            <span>Procesar e Importar</span>
                        </button>
                    } *@
                    @if (pasoActual == 2)
                    {
                        <button class="btn btn-secondary me-2" @onclick="() => pasoActual = 1" disabled="@procesandoBD">
                            <i class="bi bi-arrow-left me-1"></i> Volver a cargar
                        </button>

                        <button class="btn btn-success fw-bold" @onclick="EjecutarImportacionBD" disabled="@procesandoBD">
                            @if (procesandoBD)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Guardando...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-circle-fill me-1"></i>
                                <span>Confirmar e Importar</span>
                            }
                        </button>
                    }
                </div>
            </div>
            <div class="espaciador-inferior-importar"></div>
        }
    </div>
</div>

<style>
    .xsmall-font {
        font-size: 0.72rem;
    }

    .bg-table-header {
        background-color: #708090; /* Gris azulado institucional */
    }

    .bg-warning-light {
        background-color: #FFF9E6;
    }

    .text-warning-dark {
        color: #8A6D3B;
    }

    /* Ancho máximo del formulario para que en PC/Notebook no quede todo estirado gigante */
    .target-ancho-maximo {
        max-width: 800px;
        margin: 0 auto;
    }

    /* --- STEPPER CIRCLES (Indicador de pasos) --- */
    .step-circle {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .step-active {
        background-color: #0d6efd;
        color: white;
        box-shadow: 0 0 10px rgba(13, 110, 253, 0.4);
    }

    .step-inactive {
        background-color: #e9ecef;
        color: #6c757d;
    }

    /* --- DROPZONE (Área de arrastrar archivo) --- */
    /* --- DROPZONE INTELIGENTE COMPACTO --- */
    .zone-drop-container {
        border: 2px dashed #cbd5e1 !important;
        background-color: #f8fafc !important;
        transition: border-color 0.2s ease-in-out;
    }

        .zone-drop-container:hover {
            border-color: #3b82f6 !important;
        }

    /* Reducimos el tamaño del ícono de Excel para que no sea gigante */
    .excel-icon-wrapper i {
        font-size: 2.5rem !important;
        display: inline-block;
    }

    .input-file-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .dynamic-preview-scroll {
        max-height: 40vh;
        overflow-y: auto;
    }

    /* === DISEÑO ADAPTABLE PARA LA BOTONERA DE ACCIONES === */

    /* Por defecto (Celulares y ventanas chicas de Notebook) */
    .seccion-acciones-importar {
        position: fixed !important;
        bottom: 58px !important; /* Salta con seguridad la barra del menú inferior con los botones circulares */
        left: 0;
        right: 0;
        z-index: 1040 !important;
        border-radius: 16px 16px 0 0;
        background-color: #ffffff;
        padding: 16px !important;
    }

    .contenedor-ancho-maximo-boton {
        max-width: 600px;
        margin: 0 auto;
    }

    .espaciador-inferior-importar {
        height: 140px; /* Evita que el contenido del fondo choque con los botones flotantes */
    }

    /* Cuando se visualiza en una Computadora / Notebook Maximizada (min-width: 992px) */
    @@media (min-width: 992px) {
        .seccion-acciones-importar

    {
        position: static !important; /* Deja de ser flotante, se vuelve un bloque normal de la página */
        border-radius: 16px !important;
        box-shadow: none !important;
        border-top: none !important;
        padding: 24px 0px 0px 0px !important; /* Se integra orgánicamente abajo del formulario */
        margin-top: 15px;
    }

    .contenedor-ancho-maximo-boton {
        max-width: 100% !important;
        justify-content: flex-end !important; /* En PC alinea los botones a la derecha de forma prolija */
    }

        .contenedor-ancho-maximo-boton .btn {
            flex-grow: 0 !important; /* En PC los botones no se estiran al 100% */
            width: auto !important;
            min-width: 180px; /* Tamaño estándar de botón de escritorio */
        }

    .espaciador-inferior-importar {
        display: none !important; /* Desactivamos el colchón de espacio en PC porque ya no hay botones flotantes */
    }

    }
</style>

