        public string Mensaje { get; set; } = "";
        public List<string> Avisos { get; set; } = new();
        public bool Incluir { get; set; }
        public bool Procesada { get; set; }
        public string? ErrorGuardado { get; set; }
        public Producto? Producto { get; set; }

        // valores que tenía el producto antes de importar
        public decimal OrigCosto { get; set; }
        public decimal OrigUtil { get; set; }
        public decimal OrigVenta { get; set; }
        public decimal OrigUtilL2 { get; set; }
        public decimal OrigL2 { get; set; }
