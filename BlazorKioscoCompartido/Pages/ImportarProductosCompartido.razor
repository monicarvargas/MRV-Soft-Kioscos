    // ---------------------------------------------------------------- vista previa
    private static decimal D(decimal? x) => x ?? 0m;

    private async Task ConstruirVistaPreviaAsync()
    {
        try
        {
            familiasCache = null;
            subfamiliasCache = null;
            lock (codigosAsignados) codigosAsignados.Clear();
            proveedoresCache = null;
            crearInexistentes = true;
            reemplazarStock = false;
            var nuevas = new List<FilaImport>();
            var porCodigo = new Dictionary<string, FilaImport>(StringComparer.OrdinalIgnoreCase);
            bool sumaRepetidas = tipo != ImportacionTipo.Precios;

            for (int idx = 0; idx < filasDatos.Count; idx++)
            {
                var fila = filasDatos[idx];
                if (fila.All(c => c == "")) continue;

                string Val(string k) => mapa.TryGetValue(k, out var c) && c >= 0 && c < fila.Length ? fila[c] : "";

                var f = new FilaImport
                {
                    NumeroFila = primeraFilaDatosExcel + idx,
                    Codigo = LimpiarCodigo(Val("codigo")),
                    Descripcion = Val("descripcion").Trim(),
                    Familia = Val("familia").Trim(),
                    Subfamilia = Val("subfamilia").Trim(),
                    ProveedorTexto = Val("proveedor").Trim()
                };

                if (f.Codigo == "" && f.Descripcion == "") continue;   // renglón de total, nota, etc.

                decimal? Num(string k, string nombre)
                {
                    var raw = Val(k);
                    if (string.IsNullOrWhiteSpace(raw)) return null;
                    if (TryParseNumero(raw, out var v)) return v;
                    f.Avisos.Add($"{nombre} no válido ('{raw}')");
                    return null;
                }

                f.Cantidad = Num("cantidad", "Cantidad");
                f.Costo = Num("costo", "Costo");
                f.Utilidad = Num("utilidad", "Utilidad");
                f.Venta = Num("venta", "Venta");
                f.Lista2 = nombreLista2 != "" ? Num("lista2", nombreLista2) : null;

                if (f.Codigo == "")
                {
                    f.Estado = EstError;
                    f.Mensaje = "Falta el código";
                    nuevas.Add(f);
                    continue;
                }

                // el mismo código dos veces en el archivo
                if (porCodigo.TryGetValue(f.Codigo, out var anterior))
                {
                    if (sumaRepetidas && f.Cantidad.HasValue)
                        anterior.Cantidad = (anterior.Cantidad ?? 0m) + f.Cantidad.Value;
                    if ((f.Costo ?? 0m) > 0m) anterior.Costo = f.Costo;
                    if ((f.Venta ?? 0m) > 0m) anterior.Venta = f.Venta;
                    if ((f.Lista2 ?? 0m) > 0m) anterior.Lista2 = f.Lista2;
                    if ((f.Utilidad ?? 0m) > 0m) anterior.Utilidad = f.Utilidad;
                    if (!anterior.Avisos.Contains("Repetido en el archivo")) anterior.Avisos.Add("Repetido en el archivo" + (sumaRepetidas ? " (se sumaron las cantidades)" : " (vale el último)"));
                    continue;
                }

                porCodigo[f.Codigo] = f;
                nuevas.Add(f);
            }

            if (!nuevas.Any())
            {
                await avisos.InformarAsync("No hay filas para importar", "No encontré filas con datos con las columnas elegidas.", "aviso");
                return;
            }

            // valores tal cual vienen en el archivo (el bulto se aplica sobre estos)
            foreach (var f in nuevas)
            {
                f.CostoExcel = f.Costo;
                f.CantidadExcel = f.Cantidad;
                f.BultoSugerido = DetectarBulto(f.Descripcion);
                f.NombreSistema = f.Descripcion.Trim();
            }

            // ---- buscar qué productos ya existen
            var validas = nuevas.Where(f => f.Estado != EstError).ToList();
            var encontrados = new Dictionary<string, Producto>(StringComparer.OrdinalIgnoreCase);
            coincidenConMisCodigos = 0;

            // relaciones con el proveedor elegido (para reconocer sus códigos y saber cuánto trae cada bulto)
            var relProv = proveedorId > 0 ? await RelacionesDeProveedorAsync(proveedorId) : new List<ProductoProveedor>();
            bultoPorProducto = relProv
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => Math.Max(1, g.First().UnidadesPorBulto));

            if (codigosDelProveedor && proveedorId > 0)
            {
                var relaciones = relProv;
                var idPorCodigo = relaciones
                    .Where(r => !string.IsNullOrWhiteSpace(r.CodigoBarrasProveedor))
                    .GroupBy(r => r.CodigoBarrasProveedor!.Trim(), StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.First().IdProducto, StringComparer.OrdinalIgnoreCase);

                var ids = validas.Where(f => idPorCodigo.ContainsKey(f.Codigo)).Select(f => idPorCodigo[f.Codigo]).Distinct().ToList();
                var prods = await CargarProductosPorIdsAsync(ids);
                foreach (var f in validas)
                    if (idPorCodigo.TryGetValue(f.Codigo, out var pid))
                    {
                        var p = prods.FirstOrDefault(x => x.Id == pid);
                        if (p != null) encontrados[f.Codigo] = p;
                    }
            }
            else
            {
                // Mismo código para los dos: primero lo que ya está asociado a este proveedor con ese código
                if (codigosIguales && proveedorId > 0)
                {
                    var relaciones = relProv;
                    var idPorCodigo = relaciones
                        .Where(r => !string.IsNullOrWhiteSpace(r.CodigoBarrasProveedor))
                        .GroupBy(r => r.CodigoBarrasProveedor!.Trim(), StringComparer.OrdinalIgnoreCase)
                        .ToDictionary(g => g.Key, g => g.First().IdProducto, StringComparer.OrdinalIgnoreCase);

                    var ids = validas.Where(f => idPorCodigo.ContainsKey(f.Codigo)).Select(f => idPorCodigo[f.Codigo]).Distinct().ToList();
                    var prodsRel = await CargarProductosPorIdsAsync(ids);
                    foreach (var f in validas)
                        if (idPorCodigo.TryGetValue(f.Codigo, out var pid))
                        {
                            var p = prodsRel.FirstOrDefault(x => x.Id == pid);
                            if (p != null) encontrados[f.Codigo] = p;
                        }
                }

                // ...y después por mi código de barras
                var faltan = validas.Select(f => f.Codigo).Where(c => !encontrados.ContainsKey(c)).Distinct().ToList();
                var prods = await CargarProductosPorCodigosAsync(faltan);
                foreach (var p in prods)
                    if (!string.IsNullOrWhiteSpace(p.CodigoBarras)) encontrados.TryAdd(p.CodigoBarras.Trim(), p);
            }

            // con "los del proveedor": si un código sin asociar es igual a uno de mis códigos de barras, es ese producto
            var porMiCodigo = new Dictionary<string, Producto>(StringComparer.OrdinalIgnoreCase);
            if (codigosDelProveedor)
            {
                var faltanProv = validas.Select(f => f.Codigo).Where(c => !encontrados.ContainsKey(c)).Distinct().ToList();
                if (faltanProv.Any())
                    foreach (var p in await CargarProductosPorCodigosAsync(faltanProv))
                        if (!string.IsNullOrWhiteSpace(p.CodigoBarras)) porMiCodigo.TryAdd(p.CodigoBarras.Trim(), p);
            }

            // ---- estado de cada fila
            foreach (var f in validas)
            {
                f.CodigoProveedor = codigosDelProveedor || codigosIguales ? f.Codigo : null;

                Producto? existente = encontrados.TryGetValue(f.Codigo, out var pe) ? pe : null;
                if (existente == null && porMiCodigo.TryGetValue(f.Codigo, out var pm))
                {
                    existente = pm;
                    f.Avisos.Add("Encontrado por tu código de barras");
                }

                if (existente != null)
                {
                    f.Producto = existente;
                    f.Estado = EstExiste;
                    Capturar(f);

                    // si con este proveedor ya se sabe que viene por bulto, se aplica solo
                    if (bultoPorProducto.TryGetValue(existente.Id, out var nRel) && nRel > 1 && !existente.EsVentaPorPeso())
                    {
                        AplicarBultoFila(f, nRel);
                        f.BultoDeRelacion = true;
                    }
                }
                else if (string.IsNullOrWhiteSpace(f.Descripcion))
                {
                    // sin descripción no se puede crear: con códigos del proveedor se puede buscar a mano
                    if (codigosDelProveedor)
                    {
                        f.Estado = EstSinAsociar;
                        f.Mensaje = "Sin producto asociado y sin descripción para crearlo";
                    }
                    else
                    {
                        f.Estado = EstError;
                        f.Mensaje = "No existe y falta la descripción para crearlo";
                    }
                    continue;
                }
                else
                {
                    // no existe: se crea como nuevo (en cualquier tipo de importación; se puede destildar)
                    ArmarProductoNuevo(f);
                }

                Validar(f);
            }

            filas = nuevas;
            filtroVista = "todas";
            mostrarHasta = 150;

            // productos "nuevos" con un nombre casi igual a uno que ya existe: se ofrece usar el existente
            await BuscarParecidosAsync();

            // códigos "del proveedor" sin asociar que en realidad son mis códigos de barras
            if (codigosDelProveedor && CntSinAsociar > 0)
            {
                try
                {
                    var cods = filas.Where(f => f.Estado == EstSinAsociar).Select(f => f.Codigo).Distinct().ToList();
                    coincidenConMisCodigos = (await CargarProductosPorCodigosAsync(cods)).Count;
                }
                catch { coincidenConMisCodigos = 0; }
            }

            // regla inicial: si el archivo trae los precios de venta, se respetan
            regla = tipo == ImportacionTipo.Carga && HayPreciosEnExcel ? ReglaExcel : ReglaRecalcular;
            RecalcularTodas();

            resCreados = resActualizados = resErrores = 0;
            resMensajes = new();
            resCompraId = null;
            importacionActual = null;
            paso = 3;
        }
        catch (Exception ex)
        {
            await avisos.InformarAsync("No se pudo armar la vista previa", ex.Message, "peligro");
        }
    }

    private void Validar(FilaImport f)
    {
        f.Incluir = true;

        if (tipo == ImportacionTipo.Factura)
        {
            if ((f.Cantidad ?? 0m) <= 0m) { f.Estado = EstError; f.Mensaje = "Falta la cantidad"; f.Incluir = false; return; }
            if ((f.Costo ?? 0m) <= 0m) f.Avisos.Add("Sin costo: solo suma stock");
        }
        else if (tipo == ImportacionTipo.Precios)
        {
            if ((f.Costo ?? 0m) <= 0m) { f.Estado = EstError; f.Mensaje = "Falta el costo"; f.Incluir = false; return; }
        }
        else if ((f.Costo ?? 0m) <= 0m && f.Estado == EstNuevo && mapa.TryGetValue("costo", out var iCosto) && iCosto >= 0)
        {
            // solo si el Excel TIENE columna de costo y a esta fila le falta. Si el archivo no trae precios
            // (ej: solo código, descripción, familia y cantidad) es a propósito: no se marca cada fila.
            f.Avisos.Add("Sin costo: el producto se crea sin precio");
        }

        if (f.Cantidad.HasValue && f.Cantidad.Value < 0m) { f.Estado = EstError; f.Mensaje = "Cantidad negativa"; f.Incluir = false; return; }
        if (f.Cantidad.HasValue && f.Cantidad.Value != Math.Truncate(f.Cantidad.Value)) f.Avisos.Add("La cantidad se redondea a un número entero");

        if (f.Estado == EstNuevo && !crearInexistentes) f.Incluir = false;
    }

    // "SALCHICHON LA COMARCA C/JAMON XKG", "QUESO X KG", "JAMON POR KILO" => el precio es por kilo.
    // No confunde "X 1KG" o "X 500G" (eso es el tamaño del paquete): después de la X tiene que venir KG sin número.
    private static readonly System.Text.RegularExpressions.Regex RxPorKilo = new(
        @"(?<![A-Z0-9])(X|POR)\s*(KG|KGS|KILO|KILOS)(?![A-Z0-9])",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase | System.Text.RegularExpressions.RegexOptions.CultureInvariant);

    // ---------------------------------------------------------------- familia elegida arriba (para los productos NUEVOS)
    private List<Familia> familiasLista = new();
    private string familiaElegida = "";       // "" = la del Excel (o ARTICULOS) · "__nueva__" = escribir una
    private string? familiaNueva;

    private string FamiliaElegidaNombre =>
        familiaElegida == "__nueva__" ? (familiaNueva ?? "").Trim() : familiaElegida;

    // ---------------------------------------------------------------- utilidad por familia / subfamilia (script 37)
    private List<Subfamilia> subfamiliasLista = new();

    /// <summary>Utilidad con la que arranca un producto NUEVO: la de su subfamilia, si no la de su familia, si no la general (40%).</summary>
    private decimal UtilidadGrupo(FilaImport f)
    {
        var nomFam = (FamiliaDeFila(f) ?? "ARTICULOS").Trim();
        var fam = familiasLista.FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), nomFam, StringComparison.OrdinalIgnoreCase));
        if (fam == null) return Subfamilia.UtilidadGeneral;
        var sub = string.IsNullOrWhiteSpace(f.Subfamilia) ? null
            : subfamiliasLista.FirstOrDefault(s => s.FamiliaId == fam.Id && string.Equals(s.Nombre?.Trim(), f.Subfamilia.Trim(), StringComparison.OrdinalIgnoreCase));
        return Subfamilia.Para(familiasLista, subfamiliasLista, fam.Id, sub?.Id);
    }

    private string TextoUtilidadElegida
    {
        get
        {
            if (string.IsNullOrWhiteSpace(FamiliaElegidaNombre))
                return "Los nuevos usan la utilidad de la familia/subfamilia que traiga cada fila (Configuración → Familias).";
            var fam = familiasLista.FirstOrDefault(x => string.Equals(x.Nombre?.Trim(), FamiliaElegidaNombre, StringComparison.OrdinalIgnoreCase));
            var u = fam?.Utilidad ?? Subfamilia.UtilidadGeneral;
            return fam?.Utilidad != null
                ? $"Los nuevos de {fam.Nombre} arrancan con {u:0.##}% de utilidad (si su subfamilia no tiene otra)."
                : $"{FamiliaElegidaNombre} no tiene utilidad propia: los nuevos arrancan con {u:0.##}%.";
        }
    }

    /// <summary>Cambió la familia de arriba: los nuevos que no se editaron a mano toman la utilidad del grupo.</summary>
    private void RecalcularNuevos()
    {
        foreach (var f in filas.Where(x => x.Estado == EstNuevo && !x.Procesada && x.Producto != null).ToList())
            Recalcular(f);
    }

    /// <summary>La del Excel si la trae; si no, la elegida arriba; si no, ARTICULOS.</summary>
    private string? FamiliaDeFila(FilaImport f) =>
        !string.IsNullOrWhiteSpace(f.Familia) ? f.Familia : (string.IsNullOrWhiteSpace(FamiliaElegidaNombre) ? null : FamiliaElegidaNombre);

    // ---------------------------------------------------------------- venta por peso (productos nuevos)
    // El precio del Excel se guarda POR KILO; en pantalla y en el cartel se muestra x 100 g y al vender se pesa en gramos.
    private static bool EsPesoFila(FilaImport f) => f.Producto?.EsVentaPorPeso() ?? false;

    private void CambiarPesoFila(FilaImport f, bool porPeso)
    {
        if (f.Procesada || f.Producto == null || f.Estado != EstNuevo) return;
        f.Producto.UnidadMedida = porPeso ? "KG" : "UNIDAD";
        if (porPeso && f.UnidadesBulto > 1) AplicarBultoFila(f, 1);   // por peso no viene "por bulto"
        f.Avisos.Remove(AvisoPorKilo);
        Recalcular(f);
    }

    private IEnumerable<FilaImport> NuevosPendientes => filas.Where(f => f.Estado == EstNuevo && !f.Procesada && f.Producto != null);
    private int CntPorPeso => NuevosPendientes.Count(EsPesoFila);

    /// <summary>Familias (del Excel) que tienen algún producto por peso y otros que no: para marcarlos todos de una.</summary>
    private List<string> FamiliasConPesoMezclado => NuevosPendientes
        .Where(f => !string.IsNullOrWhiteSpace(f.Familia))
        .GroupBy(f => f.Familia.Trim().ToUpper())
        .Where(g => g.Any(EsPesoFila) && g.Any(f => !EsPesoFila(f)))
        .Select(g => g.Key).Take(4).ToList();

    private void MarcarFamiliaPorPeso(string familia)
    {
        int n = 0;
        foreach (var f in NuevosPendientes.Where(f => string.Equals(f.Familia?.Trim(), familia, StringComparison.OrdinalIgnoreCase) && !EsPesoFila(f)).ToList())
        { CambiarPesoFila(f, true); n++; }
        avisos.Toast($"{n} producto(s) de {familia} pasan a venderse por peso", "exito", 2500);
    }

    private const string AvisoPorKilo = "Se vende por kilo (la descripción dice X KG)";

    private static bool EsPorKilo(string? descripcion) => !string.IsNullOrWhiteSpace(descripcion) && RxPorKilo.IsMatch(descripcion);

    private static string UnidadSegunDescripcion(string? descripcion) => EsPorKilo(descripcion) ? "KG" : "UNIDAD";

    private void ArmarProductoNuevo(FilaImport f)
    {
        if (string.IsNullOrWhiteSpace(f.NombreSistema)) f.NombreSistema = f.Descripcion.Trim();
        f.Producto = new Producto
        {
            KioscoId = State.KioscoId,
            CodigoBarras = codigosDelProveedor ? null : f.Codigo,
            Nombre = f.NombreSistema,
            UnidadMedida = UnidadSegunDescripcion(f.Descripcion),
            Activo = true,
            StockActual = 0,
            UtilidadPV = 40m
        };
        f.Estado = EstNuevo;
        Capturar(f);
    }

    private static void Capturar(FilaImport f)
    {
        var p = f.Producto!;
        f.OrigCosto = D(p.PrecioCosto);
        f.OrigUtil = D(p.UtilidadPV);
        f.OrigVenta = D(p.PrecioVenta);
        f.OrigUtilL2 = D(p.UtilidadLista2);
        f.OrigL2 = D(p.PrecioLista2);
        f.StockAnterior = p.StockActual ?? 0;
    }

    /// <summary>Calcula costo y precios nuevos de la fila según la regla elegida. Parte siempre de los valores originales.</summary>
    private void Recalcular(FilaImport f)
    {
        var p = f.Producto;
        if (p == null) return;

        p.PrecioCosto = f.OrigCosto;
        p.UtilidadPV = f.OrigUtil;
        p.PrecioVenta = f.OrigVenta;
        p.UtilidadLista2 = f.OrigUtilL2;
        p.PrecioLista2 = f.OrigL2;
        f.VentaNueva = f.OrigVenta;
        f.Lista2Nueva = f.OrigL2;

        var costo = f.Costo ?? 0m;
        if (costo <= 0m) return;   // sin costo no se tocan costos ni precios

        p.PrecioCosto = costo;

        // en una factura los precios de los productos nuevos se calculan siempre con las reglas del kiosco
        int efectiva = tipo == ImportacionTipo.Factura ? ReglaRecalcular : regla;
        if (efectiva == ReglaCosto) return;

        decimal util = f.UtilManual
            ?? ((f.Utilidad ?? 0m) > 0m ? f.Utilidad!.Value
                : (f.Estado != EstNuevo && f.OrigUtil > 0m ? f.OrigUtil : UtilidadGrupo(f)));
        bool igual = PrecioService.EraMismoPrecioDiaNoche(p);   // gomitas: mismo precio de día y de noche
        p.UtilidadPV = util;

        decimal venta = p.CalcularPrecioPorUtilidad(costo, util, State) ?? 0m;
        if (f.VentaManual.HasValue && f.VentaManual.Value > 0m)
        {
            // precio escrito a mano en la fila: manda sobre cualquier regla
            venta = f.VentaManual.Value;
            p.UtilidadPV = Math.Round((venta - costo) / costo * 100m, 2);
        }
        else if (!f.UtilManual.HasValue && efectiva == ReglaExcel && (f.Venta ?? 0m) > costo)
        {
            venta = f.Venta!.Value;
            if ((f.Utilidad ?? 0m) <= 0m) p.UtilidadPV = Math.Round((venta - costo) / costo * 100m, 2);
        }
        p.PrecioVenta = venta;

        PrecioService.ProcesarLista2Automatico(p, State.KioscoId, State, igual);

        if (efectiva == ReglaExcel && nombreLista2 != "" && (f.Lista2 ?? 0m) > 0m)
        {
            p.PrecioLista2 = f.Lista2!.Value;
            p.UtilidadLista2 = PrecioService.CalcularPrecioCostoDeLista2desdePrecioLista2(f.Lista2.Value, costo);
        }

        f.VentaNueva = D(p.PrecioVenta);
        f.Lista2Nueva = D(p.PrecioLista2);
        f.UtilUsada = D(p.UtilidadPV);
    }

