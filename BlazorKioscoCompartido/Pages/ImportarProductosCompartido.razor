    }

    // ---------------------------------------------------------------- filas sin asociar en bloque
    private void CrearTodosSinAsociar()
    {
        int creadas = 0, sinDesc = 0;
        foreach (var f in filas.Where(x => x.Estado == EstSinAsociar).ToList())
        {
