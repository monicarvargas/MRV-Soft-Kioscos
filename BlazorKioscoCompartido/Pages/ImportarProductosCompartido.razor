    }

    private string ArmarDetalleHistorial()
    {
        bool cambiaVenta = tipo != ImportacionTipo.Factura && regla != ReglaCosto;
        var lista = filas.Select(f =>
        {
            string resultado =
                f.Procesada ? (tipo == ImportacionTipo.Factura ? "en_compra" : f.Estado == EstNuevo ? "creado" : "actualizado")
                : !string.IsNullOrEmpty(f.ErrorGuardado) || f.Estado == EstError ? "error"
                : f.Estado == EstSinAsociar ? "sin_asociar"
                : f.Estado == EstNoExiste ? "no_existe"
                : "omitida";

            return new FilaHist
            {
                Fila = f.NumeroFila,
                Codigo = f.Codigo,
                Nombre = NombreMostrado(f),
                Resultado = resultado,
                Mensaje = !string.IsNullOrEmpty(f.ErrorGuardado) ? f.ErrorGuardado : string.IsNullOrEmpty(f.Mensaje) ? null : f.Mensaje,
                Cantidad = f.Cantidad,
                Bulto = f.UnidadesBulto,
                CostoAnt = f.OrigCosto,
                CostoNuevo = f.Costo,
                VentaAnt = f.OrigVenta,
                VentaNueva = cambiaVenta && f.Importable && (f.Costo ?? 0m) > 0m ? f.VentaNueva : null,
                Utilidad = cambiaVenta && f.Importable && (f.Costo ?? 0m) > 0m ? f.UtilUsada : null
            };
        }).ToList();
        return JsonSerializer.Serialize(lista);
    }

