    private static decimal SubtotalFila(FilaImport f)
    {
        decimal costo = f.Costo ?? 0m;
        bool gramos = f.Producto != null && f.Producto.IsMedidaGramos();
        return gramos ? (Cant(f) / 1000m) * costo : Cant(f) * costo;
    }

