@implements IDisposable
@inject AppState State
@inject NavigationManager Nav
@inject Supabase.Client Db

@* Cartel fijo mientras el superadmin está "viendo como" un negocio. Va en los dos MainLayout. *@
@if (State.EnModoSoporte)
{
    <div class="ms-bar" style="top:@Arriba">
        <i class="bi bi-eye-fill ms-ico"></i>
        <span class="ms-txt">
            Modo soporte: viendo <b>@State.NombreNegocio</b> como <b>@Roles.Legible(State.UsuarioRol)</b>.
            <small>Lo que hagas se guarda de verdad en este negocio.</small>
        </span>
        <button type="button" class="ms-btn" @onclick="Volver"><i class="bi bi-box-arrow-left"></i> Volver a superadmin</button>
    </div>
}

<style>
    .ms-bar {
        position: sticky; z-index: 1030;
        display: flex; align-items: center; gap: .6rem; flex-wrap: wrap;
        margin: 0 0 .75rem; padding: .55rem .8rem;
        border-radius: 14px; border: 1px solid #f59e0b;
        background: repeating-linear-gradient(135deg, #fffbeb 0 14px, #fef3c7 14px 28px);
        color: #78350f; font-size: .9rem; font-weight: 600;
        box-shadow: 0 6px 18px rgba(120, 53, 15, .15);
    }
    .ms-ico { font-size: 1.2rem; color: #d97706; }
    .ms-txt { flex: 1 1 14rem; min-width: 0; line-height: 1.3; }
    .ms-txt small { display: block; color: #92400e; font-weight: 600; opacity: .85; }
    .ms-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        border: 0; border-radius: 10px; padding: .45rem .8rem;
        background: #b45309; color: #fff; font-weight: 800; font-size: .85rem; cursor: pointer;
    }
    .ms-btn:hover { background: #92400e; }
</style>

@code {
    /// <summary>Distancia desde arriba al quedar pegado (en el celular, debajo de la barra azul).</summary>
    [Parameter] public string Arriba { get; set; } = "0";

    protected override void OnInitialized() => State.OnChange += Refrescar;
    private void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= Refrescar;

    private async Task Volver()
    {
        try { await Db.CambiarNegocioAsync(null); } catch { }   // la base vuelve a dejarle usar su negocio
        State.VolverASuperAdmin();
        Nav.NavigateTo(RutasApp.Celular.AdminNegocios);
    }
}
