@inject NavigationManager Nav
@inject BlazorKioscoCompartido.Services.AppState State

<div class="d-flex justify-content-between align-items-center mb-2 bg-white p-2 rounded-3 shadow-sm border-start border-@ColorBorde border-4">
    <div class="d-flex align-items-center gap-1">

        @if (MostrarBotonVolver)
        {
            @* Botón Flecha Volver *@
            <button class="btn btn-link text-dark p-0 me-1 border-0 shadow-none d-flex align-items-center"
                    @onclick="Navegar"
                    title="@TituloVolver">
                <i class="bi bi-arrow-left-short fs-2 fw-bold"></i>
            </button>
        }

        @* Icono contenedor *@
        <div class="bg-@ColorIcono text-white p-2 rounded-3 me-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
            <i class="bi @IconoClass fs-5"></i>
        </div>

        @* Título y Subtítulo *@
        <div>
            <h5 class="mb-0 fw-bold text-dark-custom">@Titulo</h5>
            @if (!string.IsNullOrWhiteSpace(Subtitulo))
            {
                <span class="text-muted small">@Subtitulo</span>
            }
        </div>
    </div>

    @* === SECCIÓN DE ACCIONES A LA DERECHA === *@
    <div class="d-flex align-items-center gap-2">
        @* Renderiza cualquier botón personalizado que le pases desde afuera *@
        @if (BotonesAccion != null)
        {
            @BotonesAccion
        }

        @if (MostrarBotonAyuda)
        {
            @* Botón de Ayuda *@
            <button type="button"
                    class="btn btn-sm btn-outline-secondary d-none d-md-flex align-items-center gap-1 rounded-3 fw-bold"
                    @onclick="OnAyudaClicked">
                <i class="bi bi-question-circle"></i> Ayuda
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Titulo { get; set; } = "Título";
    [Parameter] public string? Subtitulo { get; set; }
    [Parameter] public string IconoClass { get; set; } = "bi-box-seam";

    [Parameter] public string RutaVolver { get; set; } = "/productos";
    [Parameter] public EventCallback OnVolver { get; set; }

    [Parameter] public string TituloVolver { get; set; } = "Volver a la página principal";
    [Parameter] public bool MostrarBotonVolver { get; set; } = true;
    [Parameter] public bool MostrarBotonAyuda { get; set; } = false; // Por defecto deshabilitado

    [Parameter] public string ColorBorde { get; set; } = "primary";
    [Parameter] public string ColorIcono { get; set; } = "primary";

    // Permite pasar botones o controles adicionales
    [Parameter] public RenderFragment? BotonesAccion { get; set; }

    [Parameter] public EventCallback OnAyudaClicked { get; set; }

    private async Task Navegar()
    {
        if (OnVolver.HasDelegate)
        {
            await OnVolver.InvokeAsync();
        }
        else if (!string.IsNullOrWhiteSpace(RutaVolver))
        {
            // el superadmin (fuera del modo soporte) no usa Productos: su página principal es Administrar negocios
            var esInicio = RutaVolver.TrimEnd('/') == "/productos";
            Nav.NavigateTo(esInicio && BlazorKioscoCompartido.Services.Roles.EsSuperAdmin(State.UsuarioRol)
                ? BlazorKioscoCompartido.Services.RutasApp.Celular.AdminNegocios
                : RutaVolver);
        }
    }
}