@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Services
@using Microsoft.JSInterop
@using Supabase.Postgrest
@using static Supabase.Postgrest.Constants
@using BlazorKioscoCompartido.Services.SinInternet
@implements IDisposable

@inject Supabase.Client SupaClient
@inject IJSRuntime JSRuntime
@inject PrecioService PrecioServ
@inject AppState State

<div class="search-box shadow-sm rounded border bg-white mb-2">
    <div class="input-group">
        <span class="input-group-text bg-white border-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" class="form-control border-0 py-2"
               placeholder="@Placeholder"
               @bind-value="textoActual"
               @oninput="OnInputChanged" 
               @onkeyup="ManejarKeyUp" 
               @ref="txtBuscar" />

        @* CÁMARA DEL CELULAR: abre una ventana con la cámara y el botón Cerrar (la lectora USB escribe en el campo y manda Enter) *@
        <BotonCamara Clase="btn btn-white border-0 text-primary" OnCodigo="ProcesarCodigoEscaneado" />

        @if (!string.IsNullOrEmpty(textoActual))
        {
            <button class="btn btn-white border-0" @onclick="LimpiarBusqueda">
                <i class="bi bi-x-circle text-muted"></i>
            </button>
        }
    </div>
</div>

@if (estaCargando)
{
    <div class="text-center p-3">
        <div class="spinner-border spinner-border-sm text-primary"></div>
    </div>
}

@if (productosFiltrados.Any())
{
    <div class="resultados-container shadow-sm border rounded bg-white">
        <div class="p-2 bg-light border-bottom small fw-bold text-primary">
            Resultados (@productosFiltrados.Count)
        </div>
        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
            @foreach (var prod in productosFiltrados)
            {
                <div class="list-group-item d-flex align-items-center p-2"
                     @onclick="() => SeleccionarProducto(prod)"
                     style="cursor: pointer;">

                    <div class="flex-grow-1">
                        <div class="fw-bold mb-0" style="font-size: 0.85rem; color: #333;">@prod.Nombre</div>
                        <div class="text-muted small">@prod.CodigoBarras</div>
                    </div>

                    <div class="text-end me-3">
                        @if (MostrarPrimeraLista)
                        {
                            @if (EsFeriadoEnVenta)
                            {
                                @* domingo / feriado: el precio que se cobra ahora, en rojo *@
                                <td class="text-center">
                                    <span class="fw-bold fs-5" style="color:#e11d48">$ @PrecioService.PrecioSegunLista(prod, "precio_lista3", idNegocio).ToString("N2")</span>
                                    <div style="font-size:.65rem; font-weight:800; color:#e11d48">@NombreFeriado</div>
                                </td>
                            }
                            else
                            {
                            <td class="text-center @(columnaPrecioActiva == "precio_venta" ? "table-primary border-primary border-start border-end" : "")">
                                <span class="@(columnaPrecioActiva == "precio_venta" ? "fw-bold fs-5 text-primary" : "text-muted small")">
                                     @(prod.PrecioVenta?.ToString("N2") ?? "0.00")
                                </span>
                                @if (columnaPrecioActiva == "precio_venta")
                                {
                                    <div class="badge bg-primary d-block mx-auto mt-1" style="font-size: 0.65rem; max-width: 70px;"></div>
                                }
                            </td>
                            }
                            
                        }
                        @if (MostrarSegundaLista)
                        {
                            // 1. Calculamos el precio real a mostrar en una variable local para no repetir código
                            // Si PrecioLista2 es nulo o es igual a 0, le sumamos un recargo al PrecioVenta
                            // la misma regla que se cobra: cargada (aunque sea igual al de venta) o, si falta / es menor, la regla
                            decimal precioLista2AMostrar = PrecioService.PrecioSegunLista(prod, "precio_lista2", idNegocio);

                            <td class="text-center @(columnaPrecioActiva == "precio_lista2" ? "table-success border-success border-start border-end" : "")">
                                <span class="@(columnaPrecioActiva == "precio_lista2" ? "fw-bold fs-5 text-success" : "text-muted small")">
                                    $ @precioLista2AMostrar.ToString("N2")
                                </span>

                                @* Un plus: Si aplicó el recargo de auxilio, le podemos poner un cartelito sutil al vendedor *@
                                @if (PrecioService.Lista2SinCargar(prod))
                                {
                                    <div class="text-danger" style="font-size: 0.65rem;" title="PrecioLista2 no cargado. Se aplicó un recargo por defecto.">
                                        <i class="bi bi-exclamation-circle"></i> Ajustado
                                    </div>
                                }

                                @if (columnaPrecioActiva == "precio_lista2")
                                {
                                    <div class="badge bg-success d-block mx-auto mt-1" style="font-size: 0.65rem; max-width: 70px;"></div>
                                }
                            </td>
                        }
                    </div>

                </div>
            }
        </div>
    </div>
}

@code {
    private System.Threading.Timer? timer;
    private List<Producto> productosFiltrados = new();
    private bool estaCargando = false;
    private string textoActual = "";
    private string columnaPrecioActiva = "precio_venta"; // Por defecto
    private TimeSpan horaInicioVenta = DateTime.Now.TimeOfDay;
    private long idNegocio=0; // Tu kiosco activo
    private ElementReference txtBuscar;

    [Parameter] public bool CargarAlInicio { get; set; } = false;
    [Parameter] public EventCallback<Producto> OnProductoEncontrado { get; set; }
    [Parameter] public EventCallback<string> OnProductoNoEncontrado { get; set; }
    [Parameter] public bool MostrarPrimeraLista { get; set; } = true;
    [Parameter] public bool MostrarSegundaLista { get; set; } = false;
    /// <summary>Lista que usa la página (Vender la fija por venta). Si no se pasa, el buscador la calcula por horario.</summary>
    [Parameter] public string? ColumnaActiva { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Buscar artículo...";
    /// <summary>Después de elegir un producto vuelve el foco al buscador (Vender). false si la página abre una ventana (Compras al mayorista).</summary>
    [Parameter] public bool EnfocarAlElegir { get; set; } = true;

    /// <summary>En Vender, un domingo / feriado: se muestra el precio de esa lista (no el de venta).</summary>
    private bool EsFeriadoEnVenta => !string.IsNullOrEmpty(ColumnaActiva) && columnaPrecioActiva == "precio_lista3";
    private string NombreFeriado => PrecioService.NombreLista(idNegocio, "precio_lista3") is { Length: > 0 } n ? n : "FERIADO";

    protected override async Task OnInitializedAsync()
    {
        idNegocio = State.KioscoId;
        if (CargarAlInicio)
        {
            
            // Al inicio ponemos false para que no dispare un alta si la base está vacía
            await EjecutarBusqueda("", forzarAlta: false);
        }
        
        // la lista por horario (sin internet sale de la copia guardada en la PC)
        await PrecioServ.AsegurarReglasAsync(idNegocio);
        columnaPrecioActiva = !string.IsNullOrEmpty(ColumnaActiva)
            ? ColumnaActiva
            : await PrecioServ.ObtenerColumnaPrecioActivaAsync(idNegocio, horaInicioVenta);
    }
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ColumnaActiva)) columnaPrecioActiva = ColumnaActiva;
        // Cada vez que el componente padre (Productos.razor) actualice el parámetro,
        // le avisamos a la interfaz del buscador que debe redibujarse con el nuevo valor.
        StateHasChanged();
    }
    private void OnInputChanged(ChangeEventArgs e)
    {
        textoActual = e.Value?.ToString() ?? "";
        ReiniciarTimer();
    }

    private void ReiniciarTimer()
    {
        timer?.Dispose();
        timer = new System.Threading.Timer(async _ =>
        {
           // Las búsquedas automáticas del timer NO deben forzar el alta automática
            await InvokeAsync(async () => await EjecutarBusqueda(textoActual, forzarAlta: false));
        }, null, 400, System.Threading.Timeout.Infinite);
    }
    
    private async Task EjecutarBusqueda(string busqueda, bool forzarAlta)
    {
        if (string.IsNullOrWhiteSpace(busqueda) && !CargarAlInicio)
        {
            productosFiltrados = new();
            estaCargando = false;
            StateHasChanged();
            return;
        }

        estaCargando = true;
        StateHasChanged();

        try
        {
            var query = SupaClient.From<Producto>().Where(p => p.KioscoId == State.KioscoId);
            if (!string.IsNullOrWhiteSpace(busqueda))
            {
                productosFiltrados = await BuscarEnBase(busqueda);
                //Se agrega esta condición para que si el usuario presiona Enter y hay un solo resultado, se seleccione automáticamente
                if (EsCodigoBarras(textoActual))
                {
                    // el código exacto gana aunque haya otros que lo contengan (779123 y 7791234)
                    var exacto = productosFiltrados.Where(p => (p.CodigoBarras ?? "").Trim() == textoActual.Trim()).ToList();
                    if (exacto.Count == 1 && productosFiltrados.Count > 1)
                    {
                        busquedaResuelta = true;
                        await SeleccionarProducto(exacto[0]);
                        return;
                    }

                    if (productosFiltrados.Count == 1)
                    {
                        busquedaResuelta = true;
                        await SeleccionarProducto(productosFiltrados[0]);
                        return;
                    }

                    if (productosFiltrados.Count == 0)
                    {
                        busquedaResuelta = true;
                        await OnProductoNoEncontrado.InvokeAsync(textoActual);
                        return;
                    }
                }
                // !!! FUNCIONALIDAD CLAVE !!!
                // Si la base de datos no devolvió nada Y el usuario presionó Enter (o vino del escáner)
                if (!productosFiltrados.Any() && forzarAlta)
                {
                    busquedaResuelta = true;
                    await OnProductoNoEncontrado.InvokeAsync(busqueda);
                }
            }
            else if (CargarAlInicio && VentaSinInternet.Actual?.ModoLimitado != true)
            {
                var res = await query.Limit(50).Get();
                productosFiltrados = res.Models;
            }
        }
        catch (Exception ex) when (VentaSinInternet.Actual != null && VentaSinInternet.EsErrorDeRed(ex))
        {
            VentaSinInternet.Actual.MarcarSinConexion();
            productosFiltrados = new();
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    // Busca sin importar acentos ni mayúsculas ("cafe" encuentra "CAFÉ") usando la columna nombre_busqueda.
    // Si todavía no se corrió busqueda_sin_acentos.sql, busca por "nombre" como antes.
    private static bool usarSinAcentos = true;

    private async Task<List<Producto>> BuscarEnBase(string busqueda)
    {
        var limpio = System.Text.RegularExpressions.Regex.Replace(busqueda ?? "", @"[,()%""\\*]", " ").Trim();
        var palabras = limpio.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var patronNombre = "%" + string.Join("%", palabras.Select(w => usarSinAcentos ? SinAcentos(w) : w)) + "%";

        // ETAPA 7: sin internet se busca en la copia guardada en la PC
        var off = VentaSinInternet.Actual;
        if (off?.ModoLimitado == true) return off.Buscar(busqueda ?? "");
        try
        {
            var res = await SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Where(x => x.Activo == true)
                .Or(new List<Supabase.Postgrest.Interfaces.IPostgrestQueryFilter>
                {
                    new Supabase.Postgrest.QueryFilter(usarSinAcentos ? "nombre_busqueda" : "nombre", Operator.ILike, patronNombre),
                    new Supabase.Postgrest.QueryFilter("codigo_barras", Operator.ILike, $"%{string.Join("", palabras)}%")
                })
                .Limit(20).Get();
            var lista = res.Models ?? new List<Producto>();

            // también por el CÓDIGO DEL PROVEEDOR (ej: escanean el código que trae la boleta del mayorista)
            var idsProv = await BusquedaProductos.IdsPorCodigoProveedorAsync(SupaClient, State.KioscoId, busqueda);
            var faltanProv = idsProv.Where(id => !lista.Any(p => p.Id == (long)id)).ToList();
            if (faltanProv.Any())
            {
                var extra = await SupaClient.From<Producto>()
                    .Where(p => p.KioscoId == State.KioscoId)
                    .Where(x => x.Activo == true)
                    .Filter("id", Operator.In, faltanProv)
                    .Limit(20).Get();
                lista.AddRange(extra.Models ?? new List<Producto>());
            }
            return lista;
        }
        catch (Exception ex) when (usarSinAcentos && ex.Message.Contains("nombre_busqueda"))
        {
            usarSinAcentos = false;
            return await BuscarEnBase(busqueda);
        }
        catch (Exception ex) when (off != null && VentaSinInternet.EsErrorDeRed(ex))
        {
            // se cortó internet justo ahora: se pasa a la copia y se toma la lista por horario de ahí
            off.MarcarSinConexion();
            columnaPrecioActiva = off.ColumnaPrecioActiva(DateTime.Now.TimeOfDay);
            return off.Buscar(busqueda ?? "");
        }
    }

    private static string SinAcentos(string s)
    {
        var d = (s ?? "").ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        return new string(d.Where(c => System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark).ToArray())
            .Normalize(System.Text.NormalizationForm.FormC);
    }

    // --- LÓGICA DEL ESCÁNER (la cámara la maneja BotonCamara) ---

    public async Task ProcesarCodigoEscaneado(string code)
    {
        textoActual = code;

        // Al venir de la cámara, pasamos forzarAlta: true porque el código ya entró completo
        busquedaResuelta = false;
        await EjecutarBusqueda(code, forzarAlta: true);
        if (busquedaResuelta) return;   // ya se agregó (o ya avisó que no existe): no repetir

        if (productosFiltrados.Count == 1)
            await SeleccionarProducto(productosFiltrados[0]);
    }
    // --- FIN LÓGICA ESCÁNER ---

    private async Task LimpiarBusqueda()
    {
        textoActual = "";
        if (CargarAlInicio && VentaSinInternet.Actual?.ModoLimitado != true)
        {
            // antes traía productos de TODOS los negocios
            var res = await SupaClient.From<Producto>().Where(p => p.KioscoId == State.KioscoId).Where(p => p.Activo == true).Limit(50).Get();
            productosFiltrados = res.Models;
        }
        else
        {
            productosFiltrados = new();
        }
    }

    
    private async Task SeleccionarProducto(Producto p)
    {
        await OnProductoEncontrado.InvokeAsync(p);

        if (!CargarAlInicio)
        {
            LimpiarTodo();

            if (EnfocarAlElegir)
            {
                await Task.Delay(50);
                try { await txtBuscar.FocusAsync(); } catch { }
            }
        }
    }
    /// <summary>La búsqueda ya resolvió sola (agregó el producto o avisó que no existe).</summary>
    private bool busquedaResuelta;

    public void LimpiarTodo()
    {
        textoActual = "";
        productosFiltrados = new();
        StateHasChanged();
    }
   
    private async Task ManejarKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            timer?.Dispose();

            busquedaResuelta = false;
            await EjecutarBusqueda(textoActual, forzarAlta: true);
            // Antes: la búsqueda ya agregaba el producto y limpiaba la lista, y acá se creía que "no había nada"
            // → se abría "Producto sin código" con el producto ya cargado abajo.
            if (busquedaResuelta) return;

            if (productosFiltrados.Count == 1)
                await SeleccionarProducto(productosFiltrados[0]);
        }
    }
    public async Task Enfocar()
    {
        await txtBuscar.FocusAsync();
    }
    private bool EsCodigoBarras(string texto)
    {
        return !string.IsNullOrWhiteSpace(texto)
               && texto.All(char.IsDigit)
               && texto.Length >= 6; 
    }
    public void Dispose() => timer?.Dispose();
    
}