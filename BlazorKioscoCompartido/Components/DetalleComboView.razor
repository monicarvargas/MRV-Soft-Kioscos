@using BlazorKioscoCompartido.Models
@inject Supabase.Client SupaClient

@if (cargando)
{
    <div class="text-center py-2">
        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
        <span class="x-small text-muted ms-1">Cargando componentes...</span>
    </div>
}
else if (detalles != null && detalles.Any())
{
    <div class="d-flex flex-column gap-2">
        @foreach (var det in detalles)
        {
            @* <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                <div class="d-flex align-items-center gap-2 text-truncate me-2">
                    <i class="bi bi-bag text-secondary flex-shrink-0"></i>
                    <span class="small fw-semibold text-dark text-truncate">
                        @(det.ProductoHijo?.Nombre ?? "Producto no disponible")
                    </span>
                </div>
                <span class="badge bg-white text-dark border px-2 py-1 flex-shrink-0">
                    @det.Cantidad @(string.IsNullOrEmpty(det.ProductoHijo?.UnidadMedida) ? "un" : det.ProductoHijo.UnidadMedida)
                </span>
            </div> *@
            <div class="d-flex justify-content-between align-items-center bg-light p-2 rounded-3 border">
                <!-- Columna izquierda: Nombre y Código de Barras -->
                <div class="d-flex align-items-start gap-2 me-2 overflow-hidden">
                    <i class="bi bi-bag text-secondary flex-shrink-0 mt-1"></i>
                    <div class="d-flex flex-column text-truncate">
                        <!-- Línea 1: Nombre del Producto -->
                        <span class="small fw-semibold text-dark text-truncate lh-sm">
                            @(det.ProductoHijo?.Nombre ?? "Producto no disponible")
                        </span>
                        <!-- Línea 2: Código de Barras / SKU -->
                        <span class="text-muted extra-small d-flex align-items-center gap-1 mt-1">
                            <i class="bi bi-barcode opacity-75"></i>
                            <span>@(string.IsNullOrWhiteSpace(det.ProductoHijo?.CodigoBarras) ? "Sin código" : det.ProductoHijo.CodigoBarras)</span>
                        </span>
                    </div>
                </div>

                <!-- Badge derecha: Cantidad y Unidad -->
                <span class="badge bg-white text-dark border px-2 py-1 flex-shrink-0 align-self-center">
                    @det.Cantidad @(string.IsNullOrEmpty(det.ProductoHijo?.UnidadMedida) ? "un" : det.ProductoHijo.UnidadMedida)
                </span>
            </div>
        }
    </div>
}
else
{
    <div class="text-muted small py-1 text-center">
        <i class="bi bi-exclamation-circle me-1"></i> Sin detalles cargados.
    </div>
}

@code {
    [Parameter] public long ComboId { get; set; }

    // Parámetro opcional por si ya tenés los detalles cargados en memoria y querés evitar consultar Supabase de nuevo
    [Parameter] public List<ComboDetalle>? DetallesPrecargados { get; set; }

    private List<ComboDetalle>? detalles;
    private bool cargando = false;
    private long comboIdAnterior = 0;

    protected override async Task OnParametersSetAsync()
    {
        // Solo ejecuta si cambió el ComboId o si pasamos una lista nueva
        if (ComboId != comboIdAnterior)
        {
            comboIdAnterior = ComboId;

            if (DetallesPrecargados != null && DetallesPrecargados.Any())
            {
                detalles = DetallesPrecargados;
            }
            else if (ComboId > 0)
            {
                await CargarDetallesAsync();
            }
            else
            {
                detalles = new List<ComboDetalle>();
            }
        }
    }

    private async Task CargarDetallesAsync()
    {
        cargando = true;
        try
        {
            // Consultamos la tabla intermedia combo_detalle de la base de datos
            var resDetalles = await SupaClient.From<ComboDetalle>()
                .Where(d => d.ComboId == ComboId)
                .Get();

            detalles = resDetalles.Models ?? new List<ComboDetalle>();

            // Cargar datos de los productos hijos correspondientes
            foreach (var det in detalles)
            {
                if (det.ProductoHijoId > 0)
                {
                    var resProd = await SupaClient.From<Producto>()
                        .Where(p => p.Id == det.ProductoHijoId)
                        .Single();

                    det.ProductoHijo = resProd;
                }
            }
        }
        catch
        {
            detalles = new List<ComboDetalle>();
        }
        finally
        {
            cargando = false;
        }
    }
}