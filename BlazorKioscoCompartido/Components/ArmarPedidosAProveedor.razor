    /// <summary>Código, bulto, "viene por" y nombre que usa el proveedor para cada producto (tabla productos_proveedores).</summary>
    private async Task CargarRelacionesProveedorAsync(long proveedorId)
    {
        codigosProveedor = new();
        bultosProveedor = new();
        tiposBultoProveedor = new();
        descripcionesProveedor = new();
        if (proveedorId <= 0) return;

        var resRel = await SupaClient.From<ProductoProveedor>()
            .Where(r => r.IdProveedor == proveedorId)
            .Where(r => r.IdKiosco == State.KioscoId)
            .Where(r => r.Habilitado == true)
            .Get();
        var rel = resRel.Models ?? new();
        codigosProveedor = rel.GroupBy(r => r.IdProducto).ToDictionary(g => g.Key, g => g.First().CodigoBarrasProveedor);
        bultosProveedor = rel.GroupBy(r => r.IdProducto).ToDictionary(g => g.Key, g => Math.Max(1, g.First().UnidadesPorBulto));
        tiposBultoProveedor = rel.GroupBy(r => r.IdProducto).ToDictionary(g => g.Key, g => g.First().TipoBulto);
        descripcionesProveedor = rel.GroupBy(r => r.IdProducto).ToDictionary(g => g.Key, g => g.First().DescripcionProveedor);
    }

    private async Task<List<Producto>> ObtenerProductosAsync(long proveedorId, long familiaId)
    {
        var productos = new List<Producto>();

        if (proveedorId > 0)
        {
            // 1. Relaciones habilitadas de este proveedor (tabla productos_proveedores)
            var resRel = await SupaClient.From<ProductoProveedor>()
                .Where(r => r.IdProveedor == proveedorId)
                .Where(r => r.IdKiosco == State.KioscoId)
                .Where(r => r.Habilitado == true)
                .Get();

            // Guardamos el código de barras que usa el proveedor para cada producto
            codigosProveedor = resRel.Models
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => g.First().CodigoBarrasProveedor);
            bultosProveedor = resRel.Models
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => Math.Max(1, g.First().UnidadesPorBulto));
            tiposBultoProveedor = resRel.Models
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => g.First().TipoBulto);
            descripcionesProveedor = resRel.Models
                .GroupBy(r => r.IdProducto)
                .ToDictionary(g => g.Key, g => g.First().DescripcionProveedor);

            var idsProductos = resRel.Models.Select(r => r.IdProducto).Distinct().ToList();

            // 2. Traer los productos de a tandas (para no armar una URL demasiado larga)
            foreach (var tanda in idsProductos.Chunk(100))
            {
                var criterio = tanda.Cast<object>().ToList();

                // Consulta nueva en cada vuelta (los filtros se acumulan en el mismo objeto)
                var q = SupaClient.From<Producto>()
                    .Where(p => p.KioscoId == State.KioscoId)
                    .Where(p => p.Activo == true);

                if (familiaId > 0)
                    q = q.Where(p => p.FamiliaId == familiaId);
                if (familiaId > 0 && subfamiliaSeleccionadaId > 0)
                {
                    long sub = subfamiliaSeleccionadaId;
                    q = q.Where(p => p.SubfamiliaId == sub);
                }

                var res = await q.Filter(p => p.Id, Constants.Operator.In, criterio).Get();
                productos.AddRange(res.Models);
            }
        }
        else
        {
            // Solo familia (y subfamilia): productos de esa familia, de cualquier proveedor
            var qf = SupaClient.From<Producto>()
                .Where(p => p.KioscoId == State.KioscoId)
                .Where(p => p.Activo == true)
                .Where(p => p.FamiliaId == familiaId);
            if (subfamiliaSeleccionadaId > 0)
            {
                long sub = subfamiliaSeleccionadaId;
                qf = qf.Where(p => p.SubfamiliaId == sub);
            }
            var res = await qf.Get();

            productos.AddRange(res.Models);
        }

        return productos;
    }

    private ItemPedidoViewModelDTO CrearItem(Producto p)
    {
        var item = new ItemPedidoViewModelDTO
        {
            Producto = p,
            StockActualLocal = (decimal)(p.StockActual ?? 0),
            IncluirEnPedido = true
        };
        AplicarDatosProveedor(item);
        return item;
    }

    /// <summary>
    /// Toma del proveedor elegido el bulto y el nombre. Si vende por bulto, la cantidad sugerida se redondea
    /// hacia arriba a bultos completos y el costo estimado pasa a ser el del bulto (costo por unidad × unidades del bulto).
    /// </summary>
    private void AplicarDatosProveedor(ItemPedidoViewModelDTO item)
    {
        var p = item.Producto;
        item.UnidadesPorBulto = !p.EsVentaPorPeso() && bultosProveedor.TryGetValue(p.Id, out var n) && n > 1 ? n : 1;
        item.TipoBulto = !p.EsVentaPorPeso() && tiposBultoProveedor.TryGetValue(p.Id, out var tb) ? tb : null;
        item.DescripcionProveedor = descripcionesProveedor.TryGetValue(p.Id, out var d) && !string.IsNullOrWhiteSpace(d) ? d : null;
        item.BultoDeOtroLado = false;

        // no es del proveedor elegido: "viene por" del último proveedor cargado; si no tiene, el bulto del producto
        if (!p.EsVentaPorPeso() && !TieneRelacionConElegido(p.Id))
        {
            if (ultimaRelacion.TryGetValue(p.Id, out var ult) && ult != null
                && !BlazorKioscoCompartido.Constants.TiposBulto.EsSuelto(ult.TipoBulto, ult.UnidadesPorBulto))
            {
                item.UnidadesPorBulto = Math.Max(1, ult.UnidadesPorBulto);
                item.TipoBulto = ult.TipoBulto;
                item.BultoDeOtroLado = true;
            }
            else if ((p.BultoUnidades ?? 0) > 1 && (p.BultoPrecio ?? 0) > 0)
            {
                item.UnidadesPorBulto = p.BultoUnidades!.Value;
                item.TipoBulto = "BULTO";
                item.BultoDeOtroLado = true;
            }
        }

        // viene por bolsa / caja... sin decir cuántas trae: se toman las unidades del bulto cargado en el producto
        if (item.TieneTipo && item.UnidadesPorBulto <= 1 && (p.BultoUnidades ?? 0) > 1) item.UnidadesPorBulto = p.BultoUnidades!.Value;

        // costo: si viene por bulto/caja/bolsa, el PRECIO DEL BULTO que se cargó en el producto ("Lo compro por bulto")
        item.CostoDelBulto = item.TieneTipo && (p.BultoPrecio ?? 0) > 0 && item.UnidadesPorBulto > 1;
        item.PrecioCostoLocal = item.CostoDelBulto
            ? p.BultoPrecio!.Value
            : (p.PrecioCosto ?? 0) * item.UnidadesPorBulto;
        RecalcularSugerencia(item);
    }

    /// <summary>La grilla muestra todo lo que se agregó al pedido (los filtros de stock están en el modal); solo se filtra por el texto.</summary>
    private void AplicarFiltros()
    {
        itemsFiltrados = todosLosItems.ToList();
        itemsVisibles = FiltrarPorTexto(itemsFiltrados);
    }

    // Busca por nombre, código de barras propio y código del proveedor (sin importar tildes ni mayúsculas).
    // Se pueden escribir varias palabras: tienen que estar todas.
    private List<ItemPedidoViewModelDTO> FiltrarPorTexto(List<ItemPedidoViewModelDTO> items)
    {
        var terminos = Normalizar(textoBusqueda)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        if (terminos.Length == 0) return items.ToList();

        return items.Where(item =>
        {
            var texto = Normalizar($"{item.Producto.Nombre} {item.Producto.CodigoBarras} {ObtenerCodigoProveedor(item.Producto)}");
            return terminos.All(t => texto.Contains(t));
        }).ToList();
    }

    private static string Normalizar(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";

        var descompuesto = s.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(descompuesto.Length);
        foreach (var c in descompuesto)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().ToLowerInvariant();
    }

    private void LimpiarBusqueda()
    {
        textoBusqueda = string.Empty;
        AplicarFiltros();
    }

    private void RecalcularSugerencia(ItemPedidoViewModelDTO item)
    {
        // cuánto falta para llegar al stock ideal (sin ideal cargado: hasta el doble del mínimo; sin ninguno: 1)
        decimal stkIdeal = (decimal)(item.Producto.StockIdeal ?? 0);
        if (stkIdeal <= 0) stkIdeal = (decimal)(item.Producto.StockMinimo ?? 0) * 2;
        decimal faltan = stkIdeal > item.StockActualLocal ? stkIdeal - item.StockActualLocal : 1;   // en unidades
        decimal sugerido = item.PorBulto ? Math.Ceiling(faltan / item.UnidadesPorBulto)    // en bultos si corresponde
                         : item.TieneTipo ? 1                                              // caja sin saber cuántas trae: 1, y lo corrige
                         : faltan;
        item.CantidadAComprar = sugerido < 1 ? 1 : sugerido;
    }

    private async Task CorregirStockEnBD(ItemPedidoViewModelDTO item)
