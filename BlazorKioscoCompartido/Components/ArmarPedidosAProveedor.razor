@using BlazorKioscoCompartido.Models
@using BlazorKioscoCompartido.Models.DTO
@inject BlazorKioscoCompartido.Services.AppState State
@using Supabase.Postgrest
@inject PrecioService PrecioServ
@inject Supabase.Client SupaClient
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav

<PedidosEstilos />
<AvisosPagina @ref="avisos" />

@if (modalAgregar)
{
    <div class="ap-m-fondo" @onclick="CerrarModalAgregar">
        <div class="ap-m gp-scope" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="ap-m-head">
                <i class="bi bi-cart-plus-fill"></i>
                <div>
                    <h3>Agregar productos al pedido</h3>
                    <p>@(proveedorSeleccionadoId > 0 ? $"Productos de {NombreProveedorElegido}" : "Sin proveedor: elegí una familia o buscá productos")</p>
                </div>
                <button type="button" class="ap-m-x" title="Cerrar" @onclick="CerrarModalAgregar"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="ap-m-body">
                <!-- FILTROS -->
                <div class="ap-m-filtros">
                    <div class="gp-field">
                        <label class="gp-field-label" for="apFam"><i class="bi bi-tags"></i> Familia</label>
                        <select id="apFam" class="gp-control" value="@familiaSeleccionadaId" @onchange="OnFamiliaChanged">
                            <option value="0">@(proveedorSeleccionadoId > 0 ? "-- Todas --" : "-- Elegí una --")</option>
                            @foreach (var f in familiasVisibles.OrderBy(x => x.Nombre))
                            {
                                <option value="@f.Id">@f.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="gp-field">
                        <label class="gp-field-label" for="apSub"><i class="bi bi-diagram-3"></i> Subfamilia</label>
                        <select id="apSub" class="gp-control" value="@subfamiliaSeleccionadaId" @onchange="OnSubfamiliaChanged" disabled="@(familiaSeleccionadaId == 0 || !SubfamiliasDeLaFamilia.Any())">
                            <option value="0">-- Todas --</option>
                            @foreach (var s in SubfamiliasDeLaFamilia)
                            {
                                <option value="@s.Id">@s.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="gp-field">
                        <label class="gp-field-label" for="apMax"><i class="bi bi-box"></i> Stock actual hasta</label>
                        <input id="apMax" type="number" min="0" class="gp-control" disabled="@soloStockMinimo"
                               @bind="filtroStockMax" @bind:event="oninput" @bind:after="FiltrarCandidatos" />
                    </div>
                </div>
                <label class="gp-switch ap-m-switch">
                    <input type="checkbox" @bind="soloStockMinimo" @bind:after="FiltrarCandidatos" />
                    <span class="gp-switch-track"></span>
                    <span class="gp-switch-text">Solo los que tienen stock mínimo <small>(y están por debajo)</small></span>
                </label>
                <p class="ap-m-ayuda"><i class="bi bi-info-circle"></i>
                    @if (soloStockMinimo)
                    {
                        <span>Se muestran solo los que tienen menos stock que su mínimo (no se usa "Stock actual hasta").</span>
                    }
                    else
                    {
                        <span>Se muestran los que tienen hasta @filtroStockMax de stock, y también los que tienen menos stock que su mínimo.</span>
                    }
                </p>

                <!-- RESULTADO -->
                @if (cargandoCandidatos)
                {
                    <div class="ap-m-vacio"><span class="gp-spinner"></span> Buscando productos...</div>
                }
                else if (proveedorSeleccionadoId == 0 && familiaSeleccionadaId == 0)
                {
                    <div class="ap-m-vacio"><i class="bi bi-funnel"></i> Elegí una familia (o un proveedor en Datos del pedido) para ver los productos.</div>
                }
                else if (!candidatosFiltrados.Any())
                {
                    <div class="ap-m-vacio"><i class="bi bi-emoji-smile"></i> No hay productos que cumplan los filtros.</div>
                }
                else
                {
                    <div class="ap-m-listhead">
                        <label><input class="gp-check" type="checkbox" checked="@TodosCandidatosMarcados" @onchange="MarcarTodosCandidatos" /> Todos</label>
                        <span><b>@CandidatosParaAgregar.Count</b> marcados de @candidatosFiltrados.Count</span>
                    </div>
                    <div class="ap-m-lista">
                        @foreach (var c in candidatosFiltrados)
                        {
                            bool ya = YaEnPedido(c.Producto.Id);
                            var ideal = c.Producto.StockIdeal ?? 0;
                            var minimo = c.Producto.StockMinimo ?? 0;
                            <label class="ap-m-item @(ya ? "is-ya" : "")">
                                <input class="gp-check" type="checkbox" disabled="@ya" checked="@(ya || marcadosModal.Contains(c.Producto.Id))" @onchange="() => AlternarCandidato(c.Producto.Id)" />
                                <span class="ap-m-nom">@NombreParaProveedor(c)
                                    @if (ya) { <small class="ap-m-ya">ya está en el pedido</small> }
                                </span>
                                <span class="ap-m-stk" title="Stock actual / mínimo / ideal">
                                    <b class="@(minimo > 0 && c.StockActualLocal < minimo ? "is-low" : "")">@c.StockActualLocal.ToString("0.##")</b>
                                    <small>mín @minimo@(ideal > 0 ? $" · ideal {ideal}" : "")</small>
                                </span>
                            </label>
                        }
                    </div>
                }

                <!-- BUSCAR UNO EN PARTICULAR -->
                <details class="ap-m-buscar">
                    <summary><i class="bi bi-search"></i> ¿Buscás uno en particular? Buscalo y tildalo (se agrega directo)</summary>
                    <BuscadorMultiple EstaElegido="@(id => todosLosItems.Any(i => i.Producto.Id == id && i.IncluirEnPedido))"
                                      OnAlternar="AlternarDesdeBuscador"
                                      OnAgregarTodos="AgregarVariosAlListado"
                                      Placeholder="Nombre, marca o código..." />
                </details>
            </div>

            <div class="ap-m-acc">
                <button type="button" class="ap-m-btn is-cancelar" @onclick="CerrarModalAgregar">Cerrar</button>
                <button type="button" class="ap-m-btn is-ok" disabled="@(!CandidatosParaAgregar.Any())" @onclick="ConfirmarAgregarAsync">
                    <i class="bi bi-check-lg"></i> Agregar @(CandidatosParaAgregar.Any() ? CandidatosParaAgregar.Count.ToString() : "") al pedido
                </button>
            </div>
        </div>
    </div>
}

<style>
    .ap-agregar { margin-top: 1rem; }
    .ap-agregar-btn { width: 100%; display: flex; align-items: center; gap: .8rem; padding: .85rem 1rem; text-align: left; cursor: pointer;
        border: 2px dashed #a5b4fc; border-radius: 14px; background: linear-gradient(135deg, #eef2ff, #f5f3ff); color: #3730a3; }
    .ap-agregar-btn:hover { border-style: solid; filter: brightness(1.02); }
    .ap-agregar-btn > i { font-size: 1.8rem; color: #4f46e5; }
    .ap-agregar-btn span { display: flex; flex-direction: column; }
    .ap-agregar-btn b { font-size: 1.05rem; font-weight: 900; }
    .ap-agregar-btn small { color: #6366f1; font-weight: 600; }

    .ap-m-fondo { position: fixed; inset: 0; z-index: 3000; background: rgba(15, 23, 42, .45); display: flex; align-items: center; justify-content: center; padding: .75rem; }
    .ap-m { width: min(760px, 100%); max-height: calc(100dvh - 1.5rem); display: flex; flex-direction: column; overflow: hidden; background: #fff; border-radius: 18px; box-shadow: 0 20px 50px rgba(0,0,0,.25); }
    .ap-m-head { flex: none; display: flex; gap: .7rem; align-items: center; padding: .8rem 1rem; color: #fff; background: linear-gradient(135deg, #4f46e5, #7c3aed); }
    .ap-m-head > i { font-size: 1.5rem; }
    .ap-m-head h3 { margin: 0; font-size: 1.05rem; font-weight: 900; }
    .ap-m-head p { margin: .1rem 0 0; font-size: .8rem; opacity: .9; }
    .ap-m-x { margin-left: auto; border: 0; background: rgba(255,255,255,.2); color: #fff; width: 2rem; height: 2rem; border-radius: 10px; flex: none; }
    .ap-m-body { flex: 1 1 auto; overflow-y: auto; padding: .9rem 1rem; background: linear-gradient(180deg, #f5f3ff, #fff 30%); }
    .ap-m-filtros { display: grid; grid-template-columns: 1fr 1fr 9rem; gap: .6rem; }
    .ap-m-switch { margin-top: .7rem; }
    .ap-m-switch small { color: var(--gp-muted, #64748b); font-weight: 600; }
    .ap-m-ayuda { display: flex; gap: .4rem; margin: .4rem 0 .7rem; color: #64748b; font-size: .8rem; }
    .ap-m-vacio { display: flex; align-items: center; justify-content: center; gap: .5rem; padding: 1.4rem .5rem; color: #64748b; font-weight: 700; border: 1px dashed #d6dbe8; border-radius: 12px; background: #fff; }
    .ap-m-listhead { display: flex; justify-content: space-between; align-items: center; padding: .3rem .2rem; font-size: .85rem; color: #475569; }
    .ap-m-listhead label { display: inline-flex; align-items: center; gap: .4rem; font-weight: 800; cursor: pointer; }
    .ap-m-lista { display: grid; gap: .3rem; }
    .ap-m-item { display: flex; align-items: center; gap: .6rem; padding: .45rem .6rem; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; cursor: pointer; }
    .ap-m-item.is-ya { opacity: .55; cursor: default; }
    .ap-m-nom { flex: 1; font-weight: 700; display: flex; flex-direction: column; line-height: 1.2; }
    .ap-m-ya { color: #16a34a; font-weight: 700; font-size: .75rem; }
    .ap-m-stk { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.15; white-space: nowrap; }
    .ap-m-stk b { font-size: 1rem; }
    .ap-m-stk b.is-low { color: #dc2626; }
    .ap-m-stk small { color: #94a3b8; font-size: .72rem; }
    .ap-m-buscar { margin-top: .9rem; border: 1px solid #e2e8f0; border-radius: 12px; background: #fff; padding: .5rem .7rem; }
    .ap-m-buscar summary { cursor: pointer; font-weight: 800; color: #4f46e5; }
    .ap-m-buscar[open] summary { margin-bottom: .6rem; }
    .ap-m-acc { flex: none; display: flex; gap: .6rem; padding: .8rem 1rem .9rem; background: #f7f8fc; border-top: 1px solid #e8ebf3; }
    .ap-m-btn { flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: .4rem; height: 2.9rem; border-radius: 12px; font-size: 1rem; font-weight: 800; cursor: pointer; }
    .ap-m-btn.is-cancelar { border: 2px solid #d6dbe8; background: #fff; color: #1b2540; }
    .ap-m-btn.is-ok { border: 0; color: #fff; background: linear-gradient(135deg, #4f46e5, #7c3aed); box-shadow: 0 6px 16px rgba(79, 70, 229, .35); }
    .ap-m-btn.is-ok:disabled { opacity: .5; box-shadow: none; cursor: default; }
    @@media (max-width: 575.98px) { .ap-m-filtros { grid-template-columns: 1fr 1fr; } .ap-m-filtros > :last-child { grid-column: 1 / -1; } }
</style>

<div class="gp-scope">

    <!-- DATOS DEL PEDIDO -->
    <section class="gp-card gp-card-pad mb-3">
        <div class="gp-card-head">
            <span class="gp-bubble"><i class="bi bi-clipboard2-data"></i></span>
            <h2>Datos del pedido</h2>
        </div>

        <div class="gp-grid-3">
            <div class="gp-field">
                <label class="gp-field-label" for="gpProveedor"><i class="bi bi-truck"></i> Proveedor</label>
                <select id="gpProveedor" class="gp-control" value="@proveedorSeleccionadoId" @onchange="OnProveedorChanged">
                    <option value="0">-- Sin proveedor --</option>
                    @foreach (var p in proveedoresVisibles)
                    {
                        <option value="@p.Id">@p.Nombre</option>
                    }
                </select>
            </div>
            <div class="gp-field">
                <label class="gp-field-label" for="gpNombre"><i class="bi bi-pencil-square"></i> Nombre del listado <small>(opcional)</small></label>
                <input id="gpNombre" type="text" class="gp-control" maxlength="80" placeholder="Ej: Lácteos"
                       @bind="nombreListado" @bind:event="oninput" />
            </div>
        </div>

        <div class="ap-agregar">
            <button type="button" class="ap-agregar-btn" @onclick="AbrirModalAgregar">
                <i class="bi bi-plus-circle-fill"></i>
                <span><b>Agregar productos al pedido</b>
                    <small>Por familia, por stock o buscando uno en particular@(proveedorSeleccionadoId > 0 ? " (de este proveedor)" : "")</small></span>
            </button>
        </div>
    </section>

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="gp-banner is-danger" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <p>@mensajeError</p>
            <button type="button" class="gp-btn gp-btn-ghost gp-btn-sm gp-btn-icon" aria-label="Cerrar" @onclick="() => mensajeError = null"><i class="bi bi-x-lg"></i></button>
        </div>
    }

    <!-- CARTEL INFORMATIVO Y TOTAL -->
    <div class="gp-banner">
        <i class="bi bi-info-circle-fill"></i>
        <p>Los valores de costo y totales son estimativos, basados en la última compra cargada. Pueden variar al recibir la mercadería.</p>
        <div class="gp-total">
            <span>Total estimado</span>
            <strong>$@MontoTotalEstimado.ToString("N2")</strong>
        </div>
    </div>

    <!-- LISTA -->
    <section class="gp-card gp-card-pad">
        <div class="gp-toolbar">
            <div class="gp-search">
                <i class="bi bi-funnel"></i>
                <input type="text" class="gp-control" placeholder="Filtrar la lista por nombre o código..."
                       @bind="textoBusqueda" @bind:event="oninput" @bind:after="AplicarFiltros" />
                @if (!string.IsNullOrEmpty(textoBusqueda))
                {
                    <button type="button" class="gp-search-clear" title="Borrar filtro" @onclick="LimpiarBusqueda"><i class="bi bi-x-lg"></i></button>
                }
            </div>
            <div class="gp-summary">
                @if (itemsVisibles.Count != itemsFiltrados.Count)
                {
                    <span>Mostrando <strong>@itemsVisibles.Count</strong> de <strong>@itemsFiltrados.Count</strong> · los ocultos igual entran si están tildados</span>
                }
                else
                {
                    <span><strong>@itemsFiltrados.Count(i => i.IncluirEnPedido)</strong> de <strong>@itemsFiltrados.Count</strong> productos en el pedido</span>
                }
            </div>
        </div>

        <div class="gp-table-wrap gp-stack-wrap">
            <table class="gp-table gp-stack">
                <thead>
                    <tr>
                        <th class="gp-th-check"><input class="gp-check" type="checkbox" checked="@TodosMarcados" @onchange="ToggleSeleccionarTodos" aria-label="Seleccionar todos" /></th>
                        <th>Código</th>
                        <th>Producto</th>
                        <th class="t-center">Stock actual</th>
                        <th class="t-center">Stock mín.</th>
                        <th class="t-center">Stock ideal</th>
                        <th class="t-right">Costo est.</th>
                        <th class="t-center">Comprar</th>
                        <th class="t-right">Subtotal est.</th>
                        <th class="t-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!itemsVisibles.Any())
                    {
                        <tr class="gp-empty-row">
                            <td colspan="10">
                                <div class="gp-empty">
                                    <span class="gp-bubble"><i class="bi bi-box-seam"></i></span>
                                    <strong>@(itemsFiltrados.Any() ? "Sin coincidencias" : "Todavía no hay productos")</strong>
                                    <span>
                                        @(itemsFiltrados.Any()
                                            ? "Ningún producto coincide con el filtro de búsqueda."
                                            : "Elegí el proveedor y tocá Agregar productos al pedido para elegir qué pedir.")
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in itemsVisibles)
                        {
                            var bajoMinimo = item.StockActualLocal <= (decimal)(item.Producto.StockMinimo ?? 0);
                            <tr class="@(item.IncluirEnPedido ? "" : "is-off")">
                                <td class="gp-td-check" data-label=""><input class="gp-check" type="checkbox" @bind="item.IncluirEnPedido" /></td>
                                <td class="gp-td-code" data-label="Código">@(string.IsNullOrEmpty(item.Producto.CodigoBarras) ? "-" : item.Producto.CodigoBarras)</td>
                                <td class="gp-td-main" data-label="Producto">
                                    <div class="gp-product">@NombreParaProveedor(item)</div>
                                    @if (!string.IsNullOrWhiteSpace(item.DescripcionProveedor) && !string.Equals(item.DescripcionProveedor.Trim(), item.Producto.Nombre?.Trim(), StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="gp-sub"><i class="bi bi-arrow-return-right"></i> En tu sistema: @item.Producto.Nombre</div>
                                    }
                                    @{ var codProv = ObtenerCodigoProveedor(item.Producto); }
                                    @if (codProv != null)
                                    {
                                        <div class="gp-sub"><i class="bi bi-upc-scan"></i> @codProv</div>
                                    }
                                    @if (item.TieneTipo)
                                    {
                                        <div class="gp-sub" style="color:var(--gp-primary)"><i class="bi bi-box-seam"></i> Viene por @TipoTxt(item, 1)@(item.PorBulto ? $" de {item.UnidadesPorBulto} u." : "")
                                            @if (item.BultoDeOtroLado) { <span style="color:var(--gp-muted)"> (último cargado)</span> }</div>
                                    }
                                </td>
                                <td class="t-center" data-label="Stock actual">
                                    <input type="number" class="gp-input-sm @(bajoMinimo ? "is-low" : "")"
                                           @bind="item.StockActualLocal" @bind:event="oninput" @onchange="() => RecalcularSugerencia(item)" />
                                </td>
                                <td class="t-center gp-num" data-label="Stock mín.">@(item.Producto.StockMinimo ?? 0)</td>
                                <td class="t-center gp-num" data-label="Stock ideal">@(item.Producto.StockIdeal ?? 0)</td>
                                <td class="t-right gp-num" data-label="Costo est.">
                                    $@item.PrecioCostoLocal.ToString("N2")
                                    @if (item.PorBulto || item.CostoDelBulto)
                                    {
                                        <div class="gp-sub">x @TipoTxt(item, 1)</div>
                                    }
                                </td>
                                <td class="t-center" data-label="Comprar">
                                    <input type="number" class="gp-input-sm gp-input-buy" @bind="item.CantidadAComprar" min="1" />
                                    @if (item.PorBulto)
                                    {
                                        <div class="gp-sub">@TipoTxt(item, item.CantidadAComprar) = @((item.CantidadAComprar * item.UnidadesPorBulto).ToString("0.##")) u.</div>
                                    }
                                    else if (item.TieneTipo)
                                    {
                                        <div class="gp-sub">@TipoTxt(item, item.CantidadAComprar)</div>
                                    }
                                </td>
                                <td class="t-right gp-money" data-label="Subtotal est.">$@item.SubtotalEstimado.ToString("N2")</td>
                                <td class="t-center gp-td-actions" data-label="">
                                    <div class="gp-cell-actions">
                                        <button type="button" class="gp-btn gp-btn-soft gp-btn-sm" @onclick="() => CorregirStockEnBD(item)">
                                            <i class="bi bi-arrow-repeat"></i> Actualizar stock
                                        </button>
                                        <button type="button" class="gp-btn gp-btn-danger-soft gp-btn-sm gp-btn-icon" title="Sacar de la lista" @onclick="() => QuitarDeLaLista(item)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(mensajeOk))
        {
            <div class="gp-banner is-ok" role="status">
                <i class="bi bi-check-circle-fill"></i>
                <p>@mensajeOk</p>
                <button type="button" class="gp-btn gp-btn-outline-ok gp-btn-sm" @onclick="NuevoPedido"><i class="bi bi-plus-circle"></i> Nuevo pedido</button>
            </div>
        }

        <div class="gp-actions">
            <button type="button" class="gp-btn gp-btn-outline-ok" @onclick="CopiarListaParaWhatsapp"
                    disabled="@(!itemsFiltrados.Any(i => i.IncluirEnPedido))">
                <i class="bi bi-clipboard-check"></i> Copiar para WhatsApp
            </button>
            <button type="button" class="gp-btn gp-btn-primary" @onclick="GuardarListaPedidoAsync"
                    disabled="@(guardando || !itemsFiltrados.Any(i => i.IncluirEnPedido))">
                @if (guardando)
                {
                    <span class="gp-spinner" style="width:1rem;height:1rem;border-width:2px;border-color:rgba(255,255,255,.4);border-top-color:#fff"></span> <span>Guardando...</span>
                }
                else
                {
                    <i class="bi bi-floppy-fill"></i> <span>Guardar lista de pedido</span>
                }
            </button>
        </div>
    </section>
</div>

@code {
    private AvisosPagina avisos = default!;

    private List<Proveedor> proveedores = new();
    private List<Familia> familia = new();
    private List<ItemPedidoViewModelDTO> todosLosItems = new();
    private List<ItemPedidoViewModelDTO> itemsFiltrados = new();   // lo que entra en el pedido (filtros de stock)
    private List<ItemPedidoViewModelDTO> itemsVisibles = new();    // lo que se ve en la grilla (además, filtrado por el texto)

    private long proveedorSeleccionadoId = 0;
    private long familiaSeleccionadaId = 0;
    private long subfamiliaSeleccionadaId = 0;
    private List<Subfamilia> subfamilias = new();
    private List<Subfamilia> SubfamiliasDeLaFamilia => subfamilias.Where(s => s.FamiliaId == familiaSeleccionadaId).OrderBy(s => s.Nombre).ToList();

    // Nombre del listado (Lácteos, Galletitas...) para poder identificarlo y agrupar varios en un solo documento
    private string nombreListado = "";
    private string nombreListadoAuto = "";   // último nombre puesto automáticamente a partir de la familia

    /// <summary>Se dispara cuando el pedido se guardó correctamente (para que la página refresque el historial).</summary>
    [Parameter] public EventCallback OnPedidoGuardado { get; set; }
    private int filtroStockMax = 5;
    private bool soloStockMinimo = false;
    private string textoBusqueda = string.Empty;

    // Productos agregados a mano desde el buscador (se muestran siempre, sin importar proveedor ni filtros de stock)
    private HashSet<long> idsAgregadosManualmente = new();
    private HashSet<long> idsQuitados = new();   // los que se sacaron con la X: no vuelven al cambiar los filtros
    // último proveedor cargado de cada producto (para los que no son del proveedor elegido)
    private Dictionary<long, ProductoProveedor?> ultimaRelacion = new();

    private void QuitarDeLaLista(ItemPedidoViewModelDTO item)
    {
        todosLosItems.Remove(item);
        idsAgregadosManualmente.Remove(item.Producto.Id);
        idsQuitados.Add(item.Producto.Id);
        AplicarFiltros();
        avisos.Toast($"{item.Producto.Nombre} salió de la lista", "info", 1800);
    }

    /// <summary>
    /// Productos que no son del proveedor elegido (o no hay proveedor): se busca el último proveedor que se le cargó
    /// y se toman de ahí "viene por" (bolsa, caja...) y las unidades.
    /// </summary>
    private async Task CompletarConUltimoProveedorAsync(IEnumerable<ItemPedidoViewModelDTO> items)
    {
        var faltan = items.Where(i => !TieneRelacionConElegido(i.Producto.Id) && !ultimaRelacion.ContainsKey(i.Producto.Id))
                          .Select(i => (object)i.Producto.Id).Distinct().ToList();
        if (faltan.Any())
        {
            try
            {
                foreach (var t in faltan.Chunk(100))
                {
                    var r = await SupaClient.From<ProductoProveedor>()
                        .Select("id, id_producto, id_proveedor, id_kiosco, habilitado, es_principal, unidades_por_bulto, tipo_bulto")
                        .Where(x => x.IdKiosco == State.KioscoId)
                        .Filter("id_producto", Supabase.Postgrest.Constants.Operator.In, t.ToList())
                        .Get();
                    foreach (var g in (r.Models ?? new()).GroupBy(x => x.IdProducto))
                        ultimaRelacion[g.Key] = g.OrderByDescending(x => x.Id).First();
                }
            }
            catch { /* sin script 34 o sin conexión: queda como suelto */ }
            foreach (var id in faltan.Cast<long>()) ultimaRelacion.TryAdd(id, null);
        }
        foreach (var i in items.Where(i => !TieneRelacionConElegido(i.Producto.Id))) AplicarDatosProveedor(i);
        StateHasChanged();
    }

    private bool TieneRelacionConElegido(long productoId) => proveedorSeleccionadoId > 0 && bultosProveedor.ContainsKey(productoId);

