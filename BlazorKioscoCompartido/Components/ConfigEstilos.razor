@* Estilos de las páginas de configuración (prefijo cf-). Se usan junto con <PedidosEstilos /> dentro de un .gp-scope *@
<style>
    /* ===== Configuración (prefijo cf-) — se apoya en los estilos gp- de PedidosEstilos ===== */
    /* En PC / tablet las pestañas bajan a otra fila en vez de ensanchar la página */
    /* solapas más anchas (menos por fila) y letra un poco más chica: se lee el nombre entero */
    .cf-tabs-wrap { position: relative; margin: 0 0 1.6rem; }
    .cf-tabs-wrap .cf-tabs { margin: 0; }
    .cf-flecha { display: none; }
    .cf-tabs { display: grid; grid-template-columns: repeat(auto-fill, minmax(12.5rem, 1fr)); gap: .45rem; }
    .cf-tabs .gp-tab { min-width: 0; padding: .65rem .7rem; font-size: .88rem; white-space: nowrap; justify-content: flex-start; }
    .cf-tabs .gp-tab span { overflow: visible; }

    .cf-head-text { min-width: 0; }
    .cf-head-text p { margin: .15rem 0 0; color: var(--gp-muted); font-size: .86rem; font-weight: 600; line-height: 1.35; }
    .cf-head-btn { margin-left: auto; }
    .cf-tools .gp-summary { margin-left: 0; }

    /* Panel de alta / edición */
    .cf-form {
        margin: 0 0 1.25rem; padding: 1rem 1.1rem 1.1rem;
        background: #f8f9fd; border: 2px solid var(--gp-primary-line); border-radius: var(--gp-radius-md);
        box-shadow: 0 0 0 4px var(--gp-primary-soft);   /* bien marcado: acá se completan los datos */
    }
    .cf-form.is-editing { background: var(--gp-primary-soft); border-color: var(--gp-primary); }
    .cf-form-title { display: flex; align-items: center; gap: .5rem; margin: 0 0 .85rem; font-size: .95rem; font-weight: 800; }
    .cf-form-title i { color: var(--gp-primary); }
    .cf-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: .85rem 1rem; align-items: end; }
    .cf-col-2 { grid-column: span 2; }
    .cf-col-full { grid-column: 1 / -1; }
    .cf-lbl { display: block; margin: 0 0 .35rem; color: var(--gp-muted); font-size: .74rem; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
    .cf-switches { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; min-height: 2.75rem; }
    /* formulario de alta / edición como ventana (modal): mismo diseño que las ventanas "+" de Productos */
    .cf-modal-fondo { position: fixed; inset: 0; z-index: 2050; display: flex; align-items: center; justify-content: center; padding: 1rem;
                      background: rgba(15,23,42,.55); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
    .cf-form.cf-modal { --mc: var(--tema-principal, #4f5bd5); --mc-suave: var(--tema-suave, #eceefc);
                        position: relative; width: 100%; max-width: 40rem; max-height: calc(100dvh - 2rem); overflow: auto; margin: 0; padding: 0;
                        border: 0; border-radius: 22px; background: #fff; box-shadow: 0 28px 70px rgba(15,23,42,.4); animation: cf-pop .18s ease-out; }
    .cf-m-prov   { --mc: #2563eb !important; --mc-suave: #e8f0fe !important; }
    .cf-m-fam    { --mc: #7c4dff !important; --mc-suave: #f1ebff !important; }
    .cf-m-cli    { --mc: #0d9488 !important; --mc-suave: #e3f6f3 !important; }
    .cf-m-pago   { --mc: #16a34a !important; --mc-suave: #e7f7ec !important; }
    .cf-m-usu    { --mc: #4f46e5 !important; --mc-suave: #eceefc !important; }
    .cf-m-turno  { --mc: #ea580c !important; --mc-suave: #fff1e6 !important; }
    .cf-form.cf-modal.is-editing { background: #fff; }
    /* encabezado de color con el ícono en un cuadrito */
    .cf-form.cf-modal .cf-form-title { display: flex; align-items: center; gap: .85rem; margin: 0; padding: 1.15rem 3.6rem 1.05rem 1.25rem;
                                       color: #fff; font-size: 1.2rem; font-weight: 900; line-height: 1.2;
                                       background: linear-gradient(135deg, var(--mc), color-mix(in srgb, var(--mc) 70%, #000)); }
    .cf-form.cf-modal .cf-form-title > i { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 2.7rem; height: 2.7rem;
                                           border-radius: 14px; background: rgba(255,255,255,.22); color: #fff; font-size: 1.3rem; }
    .cf-modal-x { position: absolute; top: 1.05rem; right: 1.05rem; display: inline-flex; align-items: center; justify-content: center; width: 2.1rem; height: 2.1rem;
                  border: 0; border-radius: 10px; background: rgba(255,255,255,.18); color: #fff; cursor: pointer; }
    .cf-modal-x:hover { background: rgba(255,255,255,.3); }
    /* cuerpo con un degradé suave del color */
    .cf-form.cf-modal > .cf-grid { padding: 1.1rem 1.25rem 1.2rem; background: linear-gradient(180deg, var(--mc-suave), #fff 85%); }
    .cf-form.cf-modal > :not(.cf-form-title):not(.cf-grid):not(.cf-form-actions) { margin-left: 1.25rem; margin-right: 1.25rem; }
    .cf-form.cf-modal .cf-lbl { color: #3b4664; }
    .cf-form.cf-modal .gp-control { min-height: 2.8rem; border: 2px solid #d6dbe8; border-radius: 12px; font-weight: 700; }
    .cf-form.cf-modal .gp-control:focus { border-color: var(--mc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--mc) 18%, transparent); }
    /* pie gris con los botones grandes */
    .cf-form.cf-modal .cf-form-actions { display: flex; gap: .6rem; margin: 0; padding: .95rem 1.25rem 1.15rem; background: #f7f8fc; border-top: 1px solid #e8ebf3; }
    .cf-form.cf-modal .cf-form-actions .gp-btn { flex: 1 1 0; justify-content: center; height: 2.9rem; border-radius: 12px; font-size: 1rem; font-weight: 800; }
    .cf-form.cf-modal .cf-form-actions .gp-btn-outline { border: 2px solid #d6dbe8; background: #fff; color: #1b2540; }
    .cf-form.cf-modal .cf-form-actions .gp-btn-ok { border: 0; background: var(--mc); color: #fff; box-shadow: 0 6px 16px color-mix(in srgb, var(--mc) 35%, transparent); }
    .cf-form.cf-modal .cf-form-actions .gp-btn-ok:hover { filter: brightness(1.08); }
    @@keyframes cf-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } to { opacity: 1; transform: none; } }
    .cf-form-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; margin-top: 1rem; }
    .cf-control:disabled { background: #f1f3f9; color: #9aa3bd; cursor: not-allowed; }

    /* Etiquetas chicas */
    .cf-tag { display: inline-flex; align-items: center; gap: .3rem; margin-left: .45rem; padding: .1rem .55rem; border-radius: 999px; background: #eef1f8; color: var(--gp-muted); font-size: .7rem; font-weight: 800; vertical-align: middle; white-space: nowrap; }
    .cf-tag.is-me { background: var(--gp-primary-soft); color: var(--gp-primary); }
    .cf-pill-admin { background: var(--gp-primary-soft); color: var(--gp-primary); }
    .cf-pill-off { background: var(--gp-danger-soft); color: var(--gp-danger); }
    .cf-pill-neutral { background: #eef1f8; color: var(--gp-muted); }
    .cf-code { padding: .1rem .45rem; border-radius: 6px; background: #f1f3f9; color: var(--gp-primary); font-family: Consolas, monospace; font-size: .82rem; font-weight: 700; }
    .cf-order { display: inline-flex; gap: .25rem; }
    .cf-switch-sm .gp-switch-track { width: 2.5rem; height: 1.4rem; }
    .cf-switch-sm .gp-switch-track::after { width: 1rem; height: 1rem; }
    .cf-switch-sm input:checked + .gp-switch-track::after { transform: translateX(1.1rem); }
    .cf-foot-note { margin: .9rem 0 0; }

    /* Campo con botón al costado (ej: código + generar) */
    .cf-input-btn { display: flex; gap: .4rem; }
    .cf-input-btn .gp-control { flex: 1 1 auto; min-width: 0; }
    .cf-input-btn .gp-btn { flex: none; }
    textarea.gp-control { height: auto; min-height: 4.6rem; resize: vertical; line-height: 1.4; }
    .cf-section { display: flex; align-items: center; gap: .5rem; margin: 1.1rem 0 .7rem; padding-top: 1rem; border-top: 1px dashed var(--gp-line); font-size: .92rem; font-weight: 800; }
    .cf-section i { color: var(--gp-primary); }
    .cf-section small { color: var(--gp-muted); font-weight: 600; }
    .cf-pill-warn { background: var(--gp-warn-soft); color: var(--gp-warn); }
    .cf-vence { display: flex; flex-direction: column; align-items: flex-start; gap: .25rem; }

    @@media (max-width: 767.98px) {
        .gp-stack td .cf-vence { align-items: flex-end; }
        .cf-col-2 { grid-column: auto; }
        .cf-head-btn { width: 100%; margin-left: 0; }
        .cf-form-actions .gp-btn { flex: 1 1 auto; }
    }
    @@media (max-width: 575.98px) {
        /* En el celular: una sola fila que se corre con el dedo */
        .cf-tabs { display: flex; overflow-x: auto; scrollbar-width: none; }
        .cf-tabs::-webkit-scrollbar { display: none; }
        .cf-tabs .gp-tab { flex: 0 0 auto; min-width: 5.6rem; }
        .cf-tabs { padding-right: 2.6rem; padding-left: .45rem; scroll-padding: 0 2.6rem; }

        /* flechitas: avisan que el menú sigue y se tocan para correrlo */
        .cf-tabs-wrap .cf-flecha {
            display: flex; align-items: center; justify-content: center;
            position: absolute; top: 50%; transform: translateY(-50%); z-index: 3;
            width: 2.1rem; height: 2.1rem; padding: 0; border-radius: 50%;
            border: 1px solid var(--gp-line); background: #fff; color: var(--gp-primary);
            font-size: 1.05rem; box-shadow: 0 3px 10px rgba(22,33,72,.22); cursor: pointer;
        }
        .cf-flecha-der { right: .3rem; animation: cf-flecha-aviso 1.4s ease-in-out 3; }
        .cf-flecha-izq { left: .3rem; }
        .cf-tabs-wrap:not(.hay-izq) .cf-flecha-izq { display: none; }
        .cf-tabs-wrap.fin .cf-flecha-der { display: none; }
        .cf-tabs-wrap.hay-izq .cf-tabs { padding-left: 2.6rem; }
    }
    @@keyframes cf-flecha-aviso {
        0%, 100% { transform: translateY(-50%) translateX(0); }
        50% { transform: translateY(-50%) translateX(4px); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .cf-flecha-der { animation: none; }
    }
</style>
