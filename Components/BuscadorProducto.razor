@using BlazorKioscos_v1.Models
@using BlazorKioscos_v1.Services
@using Supabase.Postgrest
@using static Supabase.Postgrest.Constants
@implements IDisposable

@inject Supabase.Client SupaClient
@inject IJSRuntime JSRuntime
@inject PrecioService PrecioServ

<div class="search-box shadow-sm rounded border bg-white mb-2">
    <div class="input-group">
        <span class="input-group-text bg-white border-0">
            <i class="bi bi-search text-muted"></i>
        </span>
        <input type="text" class="form-control border-0 py-2"
               placeholder="Buscar artículo..."
               @bind-value="textoActual"
               @oninput="OnInputChanged" />

        @* BOTÓN DEL ESCÁNER *@
        <button class="btn btn-white border-0 text-primary" @onclick="AbrirScanner" title="Escanear código">
            <i class="bi bi-qr-code-scan"></i>
        </button>

        @if (!string.IsNullOrEmpty(textoActual))
        {
            <button class="btn btn-white border-0" @onclick="LimpiarBusqueda">
                <i class="bi bi-x-circle text-muted"></i>
            </button>
        }
    </div>
</div>

@* CONTENEDOR PARA LA CÁMARA (Se muestra solo cuando se activa) *@
<div id="reader" style="width: 100%; max-width: 400px; margin: auto;"></div>

@if (estaCargando)
{
    <div class="text-center p-3">
        <div class="spinner-border spinner-border-sm text-primary"></div>
    </div>
}

@if (productosFiltrados.Any())
{
    <div class="resultados-container shadow-sm border rounded bg-white">
        <div class="p-2 bg-light border-bottom small fw-bold text-primary">
            Resultados (@productosFiltrados.Count)
        </div>
        <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
            @foreach (var prod in productosFiltrados)
            {
                <div class="list-group-item d-flex align-items-center p-2"
                     @onclick="() => SeleccionarProducto(prod)"
                     style="cursor: pointer;">

                    <div class="flex-grow-1">
                        <div class="fw-bold mb-0" style="font-size: 0.85rem; color: #333;">@prod.Nombre</div>
                        <div class="text-muted small">@prod.CodigoBarras</div>
                    </div>

                    <div class="text-end me-3">
                        @if (MostrarPrimeraLista)
                        {
                            @* <div class="fw-bold text-primary">$@prod.PrecioVenta?.ToString("N2")</div> *@
                            <td class="text-center @(columnaPrecioActiva == "precio_venta" ? "table-primary border-primary border-start border-end" : "")">
                                <span class="@(columnaPrecioActiva == "precio_venta" ? "fw-bold fs-5 text-primary" : "text-muted small")">
                                     @(prod.PrecioVenta?.ToString("N2") ?? "0.00")
                                </span>
                                @if (columnaPrecioActiva == "precio_venta")
                                {
                                    <div class="badge bg-primary d-block mx-auto mt-1" style="font-size: 0.65rem; max-width: 70px;"></div>
                                }
                            </td>
                            
                        }
                    
                        @* @if (MostrarSegundaLista)
                        {
                           
                            <td class="text-center @(columnaPrecioActiva == "precio_lista2" ? "table-success border-success border-start border-end" : "")">
                                <span class="@(columnaPrecioActiva == "precio_lista2" ? "fw-bold fs-5 text-success" : "text-muted small")">
                                     @(prod.PrecioLista2?.ToString("N2") ?? "0.00")
                                </span>
                                @if (columnaPrecioActiva == "precio_lista2")
                                {
                                    <div class="badge bg-success d-block mx-auto mt-1" style="font-size: 0.65rem; max-width: 70px;"></div>
                                }
                            </td>
                        } *@
                        @if (MostrarSegundaLista)
                        {
                            // 1. Calculamos el precio real a mostrar en una variable local para no repetir código
                            // Si PrecioLista2 es nulo o es igual a 0, le sumamos 500 al PrecioVenta
                            decimal precioLista2AMostrar = (prod.PrecioLista2 == null || prod.PrecioLista2 == 0)
                            ? (prod.PrecioVenta ?? 0) + 500
                            : prod.PrecioLista2.Value;

                            <td class="text-center @(columnaPrecioActiva == "precio_lista2" ? "table-success border-success border-start border-end" : "")">
                                <span class="@(columnaPrecioActiva == "precio_lista2" ? "fw-bold fs-5 text-success" : "text-muted small")">
                                    $ @precioLista2AMostrar.ToString("N2")
                                </span>

                                @* Un plus: Si aplicó el recargo de auxilio, le podemos poner un cartelito sutil al vendedor *@
                                @if (prod.PrecioLista2 == null || prod.PrecioLista2 == 0)
                                {
                                    <div class="text-danger" style="font-size: 0.65rem;" title="PrecioLista2 no cargado. Se aplicó +$500 de recargo por defecto.">
                                        <i class="bi bi-exclamation-circle"></i> Ajustado
                                    </div>
                                }

                                @if (columnaPrecioActiva == "precio_lista2")
                                {
                                    <div class="badge bg-success d-block mx-auto mt-1" style="font-size: 0.65rem; max-width: 70px;"></div>
                                }
                            </td>
                        }
                    </div>

                    @* <button class="btn btn-primary btn-sm rounded-3 shadow-sm">
                        <i class="bi bi-plus-lg fs-5"></i>
                    </button> *@
                </div>
            }
        </div>
    </div>
}

@code {
    private System.Threading.Timer? timer;
    private List<Producto> productosFiltrados = new();
    private bool estaCargando = false;
    private string textoActual = "";
    private string columnaPrecioActiva = "precio_venta"; // Por defecto
    private TimeSpan horaInicioVenta = DateTime.Now.TimeOfDay;
    private long idNegocio = 1; // Tu kiosco activo

    [Parameter] public bool CargarAlInicio { get; set; } = false;
    [Parameter] public EventCallback<Producto> OnProductoEncontrado { get; set; }
    [Parameter] public bool MostrarPrimeraLista { get; set; } = true;
    [Parameter] public bool MostrarSegundaLista { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        if (CargarAlInicio)
        {
            await EjecutarBusqueda("");
        }
        
        columnaPrecioActiva = await PrecioServ.ObtenerColumnaPrecioActivaAsync(idNegocio, horaInicioVenta);
    }
    protected override void OnParametersSet()
    {
        // Cada vez que el componente padre (Productos.razor) actualice el parámetro,
        // le avisamos a la interfaz del buscador que debe redibujarse con el nuevo valor.
        StateHasChanged();
    }
    private void OnInputChanged(ChangeEventArgs e)
    {
        textoActual = e.Value?.ToString() ?? "";
        ReiniciarTimer();
    }

    private void ReiniciarTimer()
    {
        timer?.Dispose();
        timer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await EjecutarBusqueda(textoActual));
        }, null, 400, System.Threading.Timeout.Infinite);
    }

    private async Task EjecutarBusqueda(string busqueda)
    {
        if (string.IsNullOrWhiteSpace(busqueda) && !CargarAlInicio)
        {
            productosFiltrados = new();
            estaCargando = false;
            StateHasChanged();
            return;
        }

        estaCargando = true;
        StateHasChanged();

        try
        {
            var query = SupaClient.From<Producto>();
            if (!string.IsNullOrWhiteSpace(busqueda))
            {
                var res = await query.Or(new List<Supabase.Postgrest.Interfaces.IPostgrestQueryFilter>
                {
                    new Supabase.Postgrest.QueryFilter("nombre", Operator.ILike, $"%{busqueda}%"),
                    new Supabase.Postgrest.QueryFilter("codigo_barras", Operator.ILike, $"%{busqueda}%")
                }).Limit(20).Get();
                productosFiltrados = res.Models;
            }
            else if (CargarAlInicio)
            {
                var res = await query.Limit(50).Get();
                productosFiltrados = res.Models;
            }
        }
        finally
        {
            estaCargando = false;
            StateHasChanged();
        }
    }

    // --- LÓGICA DEL ESCÁNER ---

    private async Task AbrirScanner()
    {
        var dotNetHelper = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("methodsJS.iniciarEscaneo", dotNetHelper);
    }

    [JSInvokable]
    public async Task ProcesarCodigoEscaneado(string code)
    {
        textoActual = code;
        await EjecutarBusqueda(code);

        // Si solo hay un resultado (es lo común con código de barras), lo seleccionamos automáticamente
        if (productosFiltrados.Count == 1)
        {
            await SeleccionarProducto(productosFiltrados[0]);
        }
    }

    // --- FIN LÓGICA ESCÁNER ---

    private async Task LimpiarBusqueda()
    {
        textoActual = "";
        if (CargarAlInicio)
        {
            var res = await SupaClient.From<Producto>().Limit(50).Get();
            productosFiltrados = res.Models;
        }
        else
        {
            productosFiltrados = new();
        }
    }

    private async Task SeleccionarProducto(Producto p)
    {
        await OnProductoEncontrado.InvokeAsync(p);

        if (!CargarAlInicio)
        {
            LimpiarTodo();
        }
    }

    public void LimpiarTodo()
    {
        textoActual = "";
        productosFiltrados = new();
        StateHasChanged();
    }

    public void Dispose() => timer?.Dispose();
}