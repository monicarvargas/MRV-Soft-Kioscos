
@inject ILocalStorageService localStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="producto/vender">
                <i class="bi bi-cart-plus me-2"></i> Vender
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="productos">
                <i class="bi bi-box-seam me-2"></i> Productos
            </NavLink>
        </div>

        @if (idNegocio > 0)
        {
            <div class="nav-item px-3 mt-4 border-top pt-2">
                <button class="btn btn-outline-danger btn-sm w-100 d-flex align-items-center justify-content-center"
                        @onclick="LimpiarConfiguracion">
                    <i class="bi bi-box-arrow-left me-2"></i>
                    Desvincular Negocio
                </button>
                <div class="text-center mt-2">
                    <small class="text-muted" style="font-size: 0.7rem;">ID Activo: @idNegocio</small>
                </div>
            </div>
        }
    </nav>
</div>

@code {
    private long idNegocio;

    protected override async Task OnInitializedAsync()
    {
        // IMPORTANTE: Leemos el ID
        idNegocio = await localStorage.GetItemAsync<long>("IdNegocio");
    }

    private async Task LimpiarConfiguracion()
    {
        bool confirmado = await JS.InvokeAsync<bool>("confirm",
            "¿Estás seguro de desvincular este dispositivo?");

        if (confirmado)
        {
            await localStorage.RemoveItemAsync("IdNegocio");
            Nav.NavigateTo("/configuracion", forceLoad: true);
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            idNegocio = await localStorage.GetItemAsync<long>("IdNegocio");
            StateHasChanged(); // <--- ESTO ES LO QUE HACE QUE EL MENÚ SE DIBUJE
        }
    }
}