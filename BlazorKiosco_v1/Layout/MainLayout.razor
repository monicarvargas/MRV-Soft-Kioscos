@using BlazorKioscoCompartido.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject AppState State
@inject NavigationManager Nav

@* Color elegido por el dueño (barra, login, botones) *@
<TemaNegocio />

<div class="page">
    @* NAVBAR SUPERIOR *@
    <nav class="navbar navbar-dark bg-primary fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" @onclick="IrAHome" style="cursor: pointer; text-decoration: none;">
                @if (State.KioscoId == 0)
                {
                    <span>MRV Soft</span>
                }
                else
                {
                    <small class="text-white-50">MRV Soft | </small> <span>@State.NombreNegocio</span>
                }
            </a>
            @if (State.KioscoId != 0)
            {
                <span class="nav-usuario" title="@Roles.Legible(State.UsuarioRol)"><i class="bi bi-person-circle"></i> <b>@State.UsuarioNombre</b><small> · @Roles.Legible(State.UsuarioRol)</small></span>
            }
        </div>
    </nav>

    @* CONTENIDO PRINCIPAL *@
    <main style="margin-top: 60px; padding-bottom: 90px;">
        <div class="container-fluid">
            <ModoSoporte Arriba="64px" />
            <GuardiaFunciones />
            @Body
        </div>
    </main>

    @* EL MENÚ INFERIOR SOLO SE MUESTRA SI HAY LOGUEO *@
    @if (State.KioscoId != 0)
    {
        <div class="footer-nav">
            @if (!Roles.EsSuperAdmin(State.UsuarioRol))
            {
            <NavLink class="nav-item" href="productos">
                <span class="bi bi-tag-fill" aria-hidden="true"></span>
                <span class="nav-label">Productos</span>
            </NavLink>

            <div class="nav-item-center">
                <NavLink class="vender-circle" href="producto/vender">
                    <span class="bi bi-currency-dollar" aria-hidden="true"></span>
                    <span class="vender-label">Vender</span>
                </NavLink>
            </div>
            }

            <button class="nav-item bg-transparent border-0 text-muted p-0 w-auto" @onclick="ToggleMenuMas" style="cursor: pointer;">
                <span class="bi bi-list" aria-hidden="true"></span>
                <span class="nav-label">Más</span>
            </button>
        </div>

        @* --- MENÚ LATERAL (el mismo menú que usa el escritorio) --- *@
        <div class="mobile-sidebar-overlay @(mostrarMenuMas ? "active" : "")" @onclick="ToggleMenuMas"></div>

        <div class="mobile-sidebar @(mostrarMenuMas ? "open" : "")">
            <div class="sidebar-header d-flex align-items-center justify-content-between px-3 py-2 border-bottom">
                <span class="fw-bold text-dark small">Menú</span>
                <button type="button" class="btn-close" @onclick="ToggleMenuMas" aria-label="Cerrar"></button>
            </div>
            <div class="sidebar-body">
                <MenuPrincipal Rutas="RutasApp.Celular" OnNavegar="CerrarMenu" RecargarAlSalir="true" />
            </div>
        </div>
    }
</div>

<style>
    /* Usuario logueado, al lado del nombre del negocio */
    .nav-usuario { display: inline-flex; align-items: center; gap: .35rem; margin-left: auto; padding: .25rem .7rem; max-width: 55%;
                   border-radius: 999px; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.3);
                   color: #fff; font-size: .9rem; white-space: nowrap; overflow: hidden; }
    .nav-usuario b { font-weight: 800; overflow: hidden; text-overflow: ellipsis; }
    .nav-usuario small { color: rgba(255,255,255,.75); }
    @@media (max-width: 480px) { .nav-usuario small { display: none; } .nav-usuario { font-size: .82rem; padding: .2rem .55rem; } }

    /* Fondo opaco detrás del menú lateral */
    .mobile-sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.4);
        z-index: 2000 !important;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    .mobile-sidebar-overlay.active {
        opacity: 1;
        visibility: visible;
    }

    /* Contenedor lateral del menú deslizante */
    .mobile-sidebar {
        position: fixed;
        top: 0;
        right: -100%;
        width: 85%;
        max-width: 380px;
        height: 100vh;
        height: 100dvh;
        background-color: #ffffff;
        z-index: 2001 !important;
        box-shadow: -4px 0 15px rgba(0, 0, 0, 0.15);
        transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }
    .mobile-sidebar.open {
        right: 0;
    }

    .sidebar-body {
        overflow-y: auto;
        flex-grow: 1;
        -webkit-overflow-scrolling: touch;
        padding-bottom: 2rem;
    }

    /* Ajuste para el botón de "Más" del footer para que herede la estética */
    button.nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        font-size: inherit;
    }

    @@media (min-width: 992px) {
        .mobile-sidebar {
            width: 350px;
            right: -360px;
        }
        .mobile-sidebar.open {
            right: 0;
        }
    }
</style>

@code {
    private bool mostrarMenuMas = false;

    protected override void OnInitialized() => State.OnChange += Refrescar;
    private void Refrescar() => InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChange -= Refrescar;

    private void ToggleMenuMas() => mostrarMenuMas = !mostrarMenuMas;
    private void CerrarMenu() => mostrarMenuMas = false;

    private void IrAHome()
    {
        if (State.KioscoId == 0) Nav.NavigateTo("/");
        else Nav.NavigateTo(Roles.EsSuperAdmin(State.UsuarioRol) ? RutasApp.Celular.AdminNegocios : "productos");
    }
}
