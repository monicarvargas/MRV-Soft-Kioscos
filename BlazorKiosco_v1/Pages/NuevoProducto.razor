@page "/producto/nuevo"
@using BlazorKioscos_v1.Models
@using BlazorKioscos_v1.Services
@using Supabase.Postgrest
@using static Supabase.Postgrest.Constants
@inject Supabase.Client SupaClient
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject PrecioService PrecioServ

<div class="container mt-3" style="max-width: 600px;">
    <div class="d-flex align-items-center mb-4">
        <button class="btn btn-link text-dark p-0 me-3" @onclick="Volver">
            <i class="bi bi-arrow-left fs-4"></i>
        </button>
        <h3 class="mb-0">Nuevo Producto</h3>
    </div>

    <EditForm Model="@nuevoProducto" OnValidSubmit="GuardarNuevoProducto">
        <DataAnnotationsValidator />

        @* Código de Barras con Escáner Integrado *@
        <div class="mb-3">
            <label class="form-label fw-bold small">Código de Barras</label>
            <div class="input-group shadow-sm rounded border bg-white">
                <span class="input-group-text bg-white border-0"><i class="bi bi-barcode"></i></span>

                <InputText class="form-control border-0 py-2"
                           @bind-Value="nuevoProducto.CodigoBarras"
                           placeholder="Escaneá o escribí el código" />

                @* BOTÓN DEL ESCÁNER *@
                <button type="button" class="btn btn-white border-0 text-primary" @onclick="AbrirScanner" title="Escanear código">
                    <i class="bi bi-qr-code-scan"></i>
                </button>
            </div>
        </div>

        @* CONTENEDOR PARA LA CÁMARA (Igual al del buscador) *@
        <div id="reader" class="mb-3" style="width: 100%; max-width: 400px; margin: auto;"></div>

        @* Nombre / Descripción *@
        <div class="mb-3">
            <label class="form-label fw-bold small">Descripción / Nombre *</label>
            <InputText class="form-control" @bind-Value="nuevoProducto.Nombre" placeholder="Ej: Alfajor Jorgito Chocolate" required />
        </div>

        <div class="row">
            @* Precio Costo  *@
            <div class="col-6 mb-3">
                <label class="form-label fw-bold small text-primary">Precio Costo</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <InputNumber class="form-control" @bind-Value="nuevoProducto.PrecioCosto" TValue="decimal?" step="0.01" />
                </div>
            </div>
            @* Precio Venta (Lista 1) *@
            <div class="col-6 mb-3">
                <label class="form-label fw-bold small text-primary">Precio Venta (General)</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <InputNumber class="form-control" @bind-Value="nuevoProducto.PrecioVenta" TValue="decimal?" step="0.01" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(nombreLista2))
            {
                @* Precio Lista 2 (Noche/Comisión) *@
                <div class="col-6 mb-3">
                    <label class="form-label fw-bold small text-success">@nombreLista2</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <InputNumber class="form-control" @bind-Value="nuevoProducto.PrecioLista2" TValue="decimal?" step="0.01" />
                    </div>
                </div>
                @* Stock Actual *@
                <div class="mb-4 col-6">
                    <label class="form-label fw-bold small">Stock Actual</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-box-seam"></i></span>
                        <InputNumber class="form-control" @bind-Value="nuevoProducto.StockActual" TValue="int" />
                    </div>
                </div>
            }
        </div>



        @* Botones *@
        <div class="d-flex gap-2 justify-content-end border-top pt-3">
            <button type="button" class="btn btn-light rounded-pill px-4" @onclick="Volver">Cancelar</button>
            <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-check-lg me-1"></i> Registrar
            </button>
        </div>
    </EditForm>
</div>

@code {
    [SupplyParameterFromQuery(Name = "codigo")]
    public string? CodigoSugerido { get; set; }
    private string nombreLista2 = "Precio Lista 2";
    private Producto nuevoProducto = new();
    private long idNegocio = 1;

    protected override async Task OnInitializedAsync()
    {
        nombreLista2 = await PrecioServ.ObtenerNombreColumnaAsync(1, "precio_lista2") ?? "";
    
        nuevoProducto = new Producto
        {
            KioscoId = idNegocio,
            StockActual = 0
        };

        if (!string.IsNullOrEmpty(CodigoSugerido))
        {
            nuevoProducto.CodigoBarras = CodigoSugerido;
        }
        
    }

    // --- LÓGICA DEL ESCÁNER REUTILIZADA ---

    private async Task AbrirScanner()
    {
        // Pasamos la referencia de ESTA página a JS
        var dotNetHelper = DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync("methodsJS.iniciarEscaneo", dotNetHelper);
    }

    [JSInvokable]
    public Task ProcesarCodigoEscaneado(string code)
    {
        // Asignamos el código capturado directamente al modelo del formulario
        nuevoProducto.CodigoBarras = code;

        // Forzamos a Blazor a refrescar el input para que se vea el código en pantalla
        StateHasChanged();

        return Task.CompletedTask;
    }

    // --- FIN LÓGICA ESCÁNER ---

    private async Task GuardarNuevoProducto()
    {
        try
        {
            await SupaClient.From<Producto>().Insert(nuevoProducto);
            Volver();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al insertar el producto: {ex.Message}");
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/productos");
    }

    // Liberamos recursos si el operador sale de la página con la cámara encendida
    public void Dispose()
    {
        // Si tu JS requiere apagar la cámara al destruir el componente, podés llamarlo acá
    }
}