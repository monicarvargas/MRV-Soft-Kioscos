@page "/configuracion"

@using BlazorKioscoCompartido.Models
@inject ILocalStorageService localStorage
@inject NavigationManager Nav
@inject Supabase.Client SupaClient

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-4 p-4 text-center">
        <h3 class="fw-bold text-primary">Vincular Negocio</h3>
        <p class="text-muted">Ingresá el código de 6 caracteres</p>

        <div class="mb-3">
            <input type="text" class="form-control form-control-lg text-center fw-bold"
                   @bind="codigoIngresado" placeholder="Ej: A7B2X9" maxlength="6" />
        </div>

        <button class="btn btn-primary btn-lg w-100 rounded-pill" @onclick="GuardarConfiguracion">
            CONFIRMAR
        </button>
    </div>
</div>

@code {
    private string codigoIngresado = "";

    private async Task GuardarConfiguracion()
    {
        if (string.IsNullOrWhiteSpace(codigoIngresado)) return;

        var res = await SupaClient.From<Kiosco>()
                    .Where(x => x.CodigoVinculacion == codigoIngresado)
                    .Get();

        var kioscoEncontrado = res.Models.FirstOrDefault();

        if (kioscoEncontrado != null)
        {
            await localStorage.SetItemAsync("IdNegocio", kioscoEncontrado.Id);
            await localStorage.SetItemAsync("NombreNegocio", kioscoEncontrado.NombreKiosco);

            // IMPORTANTE: forceLoad: true hace que el menú se recargue y detecte el ID
            Nav.NavigateTo("/producto/vender", forceLoad: true);
        }
        else
        {
            Console.WriteLine("El código ingresado no existe.");
        }
    }
}